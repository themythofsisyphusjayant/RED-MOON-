import "autograd2.fg";

fn main() {
    let mut s: TAg = t_leaf(ttape_new(), [2], [4.0, 9.0]);
    let a: int = s.last;
    s = t_leaf(s.tape, [2], [2.0, 3.0]);
    let b: int = s.last;
    s = t_div(s, a, b);
    let q: int = s.last;
    s = t_exp(s, q);
    let r: int = s.last;
    s = t_log(s, r);
    let l: int = s.last;
    let targets: [float] = [2.5, 2.5];
    s = t_mse_loss(s, l, targets);
    let loss_node: int = s.last;
    let qv: [float] = tvals_of(s.tape, q);
    println(qv[0]);
    println(qv[1]);
    let rv: [float] = tvals_of(s.tape, r);
    println(rv[0]);
    println(rv[1]);
    let lv: [float] = tvals_of(s.tape, l);
    println(lv[0]);
    println(lv[1]);
    let lossv: [float] = tvals_of(s.tape, loss_node);
    println(lossv[0]);
    let grads: [float] = t_backward(s.tape, loss_node);
    let ga: [float] = t_grad_of(s.tape, grads, a);
    println(ga[0]);
    println(ga[1]);
    let gb: [float] = t_grad_of(s.tape, grads, b);
    println(gb[0]);
    println(gb[1]);
    s = ag2_sub(s, a, b);
    let sub_id: int = s.last;
    let subv: [float] = tvals_of(s.tape, sub_id);
    println(subv[0]);
    println(subv[1]);
    s = ag2_neg(s, a);
    let neg_id: int = s.last;
    let negv: [float] = tvals_of(s.tape, neg_id);
    println(negv[0]);
    println(negv[1]);
    println(ag2_tape_size(s));
    println(ag2_tape_floats(s));
    let freed: TAg = ag2_tape_free(s, 3);
    println(ag2_tape_size(freed));
    println(ag2_tape_floats(freed));
}
