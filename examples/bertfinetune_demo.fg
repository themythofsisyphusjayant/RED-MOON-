import "bertfinetune.fg";

fn main() -> int {
    let tokens: [int] = [0, 1, 2];
    let emb: [float] = bf_mean_embed(tokens);
    let w: [float] = [0.5, -0.5, 0.25, 0.75];
    let lg: [float] = bf_logits(emb, w);
    println(lg[0], lg[1]);
    let probs: [float] = bf_softmax(lg);
    println(probs[0], probs[1]);
    println(bf_ce_loss(probs, 1));
    let w2: [float] = bf_sgd_step(emb, w, probs, 1, 0.5);
    let lg2: [float] = bf_logits(emb, w2);
    let probs2: [float] = bf_softmax(lg2);
    println(bf_ce_loss(probs2, 1));
    return 0;
}
