import "callhier.fg";

fn main() {
    let edges: [Edge] = [
        Edge { from: "main", to: "parse" },
        Edge { from: "test", to: "parse" },
        Edge { from: "main", to: "parse" },
        Edge { from: "parse", to: "lex" }
    ];
    let callers: [str] = ch_callers(edges, "parse");
    println(len(callers));
    let mut i: int = 0;
    while i < len(callers) {
        println(callers[i]);
        i = i + 1;
    }
    let callees: [str] = ch_callees(edges, "parse");
    println(len(callees));
    println(callees[0]);
    let lc: [str] = ch_callers(edges, "lex");
    println(len(lc));
    println(lc[0]);
    let mc: [str] = ch_callees(edges, "main");
    println(len(mc));
    println(mc[0]);
}
