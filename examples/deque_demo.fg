import "deque.fg";

fn main() {
    let mut d: Deque = deque_new();
    d = deque_push_back(d, 1);
    d = deque_push_back(d, 2);
    d = deque_push_front(d, 0);
    println(deque_front(d));
    println(deque_back(d));
    println(deque_len(d));
    d = deque_pop_front(d);
    println(deque_front(d));
    d = deque_pop_back(d);
    println(deque_back(d));
    println(deque_len(d));
}
