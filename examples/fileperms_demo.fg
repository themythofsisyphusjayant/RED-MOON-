import "fileperms.fg";
import "errcode.fg";

fn main() {
    let base = "/tmp/fs_demo_perms";
    println(mkdir(base));
    let w = write_file(base + "/f.txt", "data");
    println(w);
    println(err_name(perm_set(base + "/f.txt", 384)));
    println(perm_mode(base + "/f.txt"));
    println(err_name(perm_set(base + "/f.txt", 420)));
    println(perm_mode(base + "/f.txt"));
    let uid = perm_uid(base + "/f.txt");
    let gid = perm_gid(base + "/f.txt");
    println(err_name(perm_chown(base + "/f.txt", uid, gid)));
    println(perm_uid(base + "/f.txt") == uid);
    println(perm_gid(base + "/f.txt") == gid);
    println(err_name(perm_chown(base + "/missing.txt", 0, 0)));
    println(perm_is_dir(base));
    println(perm_is_dir(base + "/f.txt"));
    println(perm_mode(base + "/missing.txt"));
}
