import "gym.fg";

fn main() {
    let b0: [int] = gym_bandit_step(0, 7);
    println(b0[0]);
    println(b0[1]);
    let b1: [int] = gym_bandit_step(1, 7);
    println(b1[0]);
    let g1: [int] = gym_gridworld_step(3, 1);
    println(g1[0], g1[1], g1[2]);
    let g2: [int] = gym_gridworld_step(0, 0);
    println(g2[0], g2[1], g2[2]);
    let c: [float] = gym_cartpole_step([0.0, 0.0, 0.1, 0.0], 1);
    println(c[0], c[1], c[2], c[3]);
    let m: [float] = gym_mountaincar_step(-0.5, 0.0, 2);
    println(m[0], m[1]);
}
