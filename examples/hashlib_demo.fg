import "hashlib.fg";

fn main() {
    println(sha256_hex([97, 98, 99]));
    let empty: [int] = [];
    println(sha256_hex(empty));
    println(sha256_hex([104, 101, 108, 108, 111]));
    println(sha256_hex([97, 98, 99, 100, 98, 99, 100, 101, 99, 100, 101, 102, 100, 101, 102, 103, 101, 102, 103, 104, 102, 103, 104, 105, 103, 104, 105, 106, 104, 105, 106, 107, 105, 106, 107, 108, 106, 107, 108, 109, 107, 108, 109, 110, 108, 109, 110, 111, 109, 110, 111, 112, 110, 111, 112, 113]));
}
