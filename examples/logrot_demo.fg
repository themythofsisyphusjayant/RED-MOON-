// Log-rotation demo — Top-500 #196.
// max 3 lines: a, b, c fill the buffer; d rotates all three
// out and starts a fresh buffer.
import "logrot.fg";

fn main() -> int {
    let mut r: LogRot = lr_new(3);
    let o1: LrOut = lr_add(r, "a");
    r = o1.rot;
    println(len(o1.rotated));
    let o2: LrOut = lr_add(r, "b");
    r = o2.rot;
    let o3: LrOut = lr_add(r, "c");
    r = o3.rot;
    println(lr_len(r));
    let o4: LrOut = lr_add(r, "d");
    r = o4.rot;
    println(len(o4.rotated));
    println(o4.rotated[0]);
    println(o4.rotated[2]);
    println(lr_len(r));
    println(lr_lines(r)[0]);
    let o5: LrOut = lr_add(r, "e");
    r = o5.rot;
    println(lr_len(r));
    println(lr_lines(r)[1]);
    return 0;
}
