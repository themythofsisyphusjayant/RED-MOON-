import "matrix2.fg";

fn main() {
    let mut m: Mat2 = Mat2 { a: 1, b: 2, c: 3, d: 4 };
    let mut n: Mat2 = Mat2 { a: 5, b: 6, c: 7, d: 8 };
    let mut p: Mat2 = mat2_mul(m, n);
    let mut s: Mat2 = mat2_add(m, n);
    println(mat2_det(m));
    println(p.a);
    println(p.d);
    println(s.a);
}
