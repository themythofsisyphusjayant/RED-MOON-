fn alias_expand(names: [str], vals: [str], cmd: str) -> str {
    let mut i: int = 0;
    while i < len(names) {
        if names[i] == cmd {
            return vals[i];
        }
        i = i + 1;
    }
    return cmd;
}

fn main() {
    let names: [str] = ["ll", ".."];
    let vals: [str] = ["ls -l", "cd .."];
    println(alias_expand(names, vals, "ll"));
    println(alias_expand(names, vals, ".."));
    println(alias_expand(names, vals, "ps"));
}
