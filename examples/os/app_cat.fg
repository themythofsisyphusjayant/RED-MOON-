// cat — daily-ten 11 Nov 2026 (OS track).
// Prints a file's lines, then the line count and the total
// character count across the lines.
fn main() {
    let lines: [str] = ["line one", "line two", "line three"];
    let mut chars: int = 0;
    let mut i: int = 0;
    while i < len(lines) {
        println(lines[i]);
        chars = chars + len(lines[i]);
        i = i + 1;
    }
    println(len(lines));
    println(chars);
}
