fn perm_triple(d: int) -> str {
    let mut out: str = "";
    let mut v: int = d;
    if v >= 4 {
        out = out + "r";
        v = v - 4;
    } else {
        out = out + "-";
    }
    if v >= 2 {
        out = out + "w";
        v = v - 2;
    } else {
        out = out + "-";
    }
    if v >= 1 {
        out = out + "x";
    } else {
        out = out + "-";
    }
    return out;
}

fn perm_str(mode: int) -> str {
    let owner: int = mode / 100 % 10;
    let group: int = mode / 10 % 10;
    let other: int = mode % 10;
    return perm_triple(owner) + perm_triple(group) + perm_triple(other);
}

fn main() {
    println(perm_str(755));
    println(perm_str(644));
    println(perm_str(600));
}
