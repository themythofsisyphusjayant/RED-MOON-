// date — daily-ten 11 Nov 2026 (OS track).
// Date facts for 2026-11-11 (a Wednesday): the day-of-year
// is summed from the month table (304 days before November,
// plus 11), days remaining are 365 minus that, 2026 is not
// a leap year, and November has 30 days.
fn main() {
    println("2026-11-11");
    println("Wed");
    let months: [int] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut before: int = 0;
    let mut m: int = 0;
    while m < 10 {
        before = before + months[m];
        m = m + 1;
    }
    let doy: int = before + 11;
    println(doy);
    println(365 - doy);
    println(2026 % 4 == 0);
    println(months[10]);
}
