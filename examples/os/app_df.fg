// df — daily-ten 12 Nov 2026 (OS track).
// Reports three fixed filesystems: mount, percent used
// (used * 100 / size, integer division) and free blocks.
// / is 6500/10000 = 65% used, 3500 free; /home is
// 8000/20000 = 40% used, 12000 free; /tmp is 1250/5000 =
// 25% used, 3750 free. Totals: size 35000, used 15750.
fn main() {
    let mounts: [str] = ["/", "/home", "/tmp"];
    let sizes: [int] = [10000, 20000, 5000];
    let used: [int] = [6500, 8000, 1250];
    let mut total_size: int = 0;
    let mut total_used: int = 0;
    let mut i: int = 0;
    while i < len(mounts) {
        let pct: int = used[i] * 100 / sizes[i];
        let free: int = sizes[i] - used[i];
        println(mounts[i], pct, free);
        total_size = total_size + sizes[i];
        total_used = total_used + used[i];
        i = i + 1;
    }
    println(total_size);
    println(total_used);
}
