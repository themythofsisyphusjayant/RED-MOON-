fn main() {
    let mut disk: [int] = [];
    let mut i: int = 0;
    while i < 32 {
        push(disk, 0);
        i = i + 1;
    }
    disk[1 * 8 + 0] = 42;
    disk[1 * 8 + 7] = 7;
    disk[3 * 8 + 3] = 99;
    println(disk[1 * 8 + 0]);
    println(disk[1 * 8 + 7]);
    println(disk[1 * 8 + 1]);
    println(disk[3 * 8 + 3]);
    println(disk[0 * 8 + 0]);
}
