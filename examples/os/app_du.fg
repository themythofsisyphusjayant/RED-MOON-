// du — daily-ten 12 Nov 2026 (OS track).
// Sums fixed file sizes per directory: src holds main.fg
// (1200) and util.fg (800) = 2000; docs holds guide.md
// (2400) and notes.md (600) = 3000; grand total 5000.
fn main() {
    let dirs: [str] = ["src", "src", "docs", "docs"];
    let sizes: [int] = [1200, 800, 2400, 600];
    let mut src_total: int = 0;
    let mut docs_total: int = 0;
    let mut i: int = 0;
    while i < len(sizes) {
        if dirs[i] == "src" {
            src_total = src_total + sizes[i];
        } else {
            docs_total = docs_total + sizes[i];
        }
        i = i + 1;
    }
    println("src", src_total);
    println("docs", docs_total);
    println(src_total + docs_total);
}
