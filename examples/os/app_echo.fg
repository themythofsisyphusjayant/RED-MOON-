// echo — daily-ten 11 Nov 2026 (OS track).
// Joins the argument list with single spaces, then prints the
// argument count, first and last arguments.
fn join_sp(args: [str]) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(args) {
        if i > 0 {
            out = out + " ";
        }
        out = out + args[i];
        i = i + 1;
    }
    return out;
}

fn main() {
    let args: [str] = ["hello", "qasida", "world"];
    println(join_sp(args));
    println(len(args));
    println(args[0]);
    println(args[len(args) - 1]);
}
