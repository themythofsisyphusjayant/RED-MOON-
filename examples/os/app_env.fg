// env — daily-ten 11 Nov 2026 (OS track).
// Environment table: lookup by key, caller-supplied default
// for a missing key, and the table size.
fn env_get(keys: [str], vals: [str], key: str, def: str) -> str {
    let mut i: int = 0;
    while i < len(keys) {
        if keys[i] == key {
            return vals[i];
        }
        i = i + 1;
    }
    return def;
}

fn main() {
    let keys: [str] = ["PATH", "HOME", "LANG", "USER"];
    let vals: [str] = ["/bin:/usr/bin", "/home/jayant", "C.UTF-8", "jayant"];
    println(env_get(keys, vals, "HOME", "none"));
    println(env_get(keys, vals, "SHELL", "/bin/sh"));
    println(env_get(keys, vals, "PATH", "none"));
    println(len(keys));
}
