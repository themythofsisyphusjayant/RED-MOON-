// grep — daily-ten 11 Nov 2026 (OS track).
// Prints the 1-based line numbers and text of the lines
// containing the pattern, then the match count.
fn contains(hay: str, needle: str) -> bool {
    if len(needle) == 0 {
        return true;
    }
    let mut i: int = 0;
    while i + len(needle) <= len(hay) {
        if substr(hay, i, len(needle)) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn main() {
    let lines: [str] = ["error: disk full", "info: boot ok", "error: net down", "info: shutdown"];
    let mut found: int = 0;
    let mut i: int = 0;
    while i < len(lines) {
        if contains(lines[i], "error") {
            println(i + 1, lines[i]);
            found = found + 1;
        }
        i = i + 1;
    }
    println(found);
}
