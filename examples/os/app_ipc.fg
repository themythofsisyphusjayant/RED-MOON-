fn main() {
    let msgs: [str] = ["hi", "yo", "bye"];
    let tos: [int] = [2, 2, 2];
    println(len(msgs));
    let mut head: int = 0;
    while head < len(msgs) {
        if tos[head] == 2 {
            println(msgs[head]);
        }
        head = head + 1;
    }
    println(len(msgs) - head);
}
