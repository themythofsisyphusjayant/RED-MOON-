fn num_str(n: int) -> str {
    if n == 0 {
        return "0";
    }
    let digits: str = "0123456789";
    let mut out: str = "";
    let mut x: int = n;
    while x > 0 {
        out = substr(digits, x % 10, 1) + out;
        x = x / 10;
    }
    return out;
}

fn main() {
    let ids: [int] = [1, 2];
    let states: [str] = ["running", "stopped"];
    let cmds: [str] = ["sleep", "vim"];
    let mut i: int = 0;
    while i < len(ids) {
        println(num_str(ids[i]) + " " + states[i] + " " + cmds[i]);
        i = i + 1;
    }
    println(1);
}
