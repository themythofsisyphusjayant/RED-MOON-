// ls — daily-ten 11 Nov 2026 (OS track).
// Lists directory entries sorted by size, largest first
// (bubble sort over parallel name/size arrays), then the
// total size of the listing.
fn main() {
    let mut names: [str] = ["README.md", "forge.py", "notes.txt", "todo.fg"];
    let mut sizes: [int] = [1200, 8400, 300, 1500];
    let mut i: int = 0;
    while i < len(sizes) {
        let mut j: int = 0;
        while j + 1 < len(sizes) - i {
            if sizes[j] < sizes[j + 1] {
                let t: int = sizes[j];
                sizes[j] = sizes[j + 1];
                sizes[j + 1] = t;
                let ns: str = names[j];
                names[j] = names[j + 1];
                names[j + 1] = ns;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let mut total: int = 0;
    let mut k: int = 0;
    while k < len(names) {
        println(names[k], sizes[k]);
        total = total + sizes[k];
        k = k + 1;
    }
    println(total);
}
