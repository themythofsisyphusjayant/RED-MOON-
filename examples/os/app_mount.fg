fn main() {
    let devs: [str] = ["/dev/sda1", "/dev/sda2", "tmpfs"];
    let dirs: [str] = ["/", "/home", "/tmp"];
    let types: [str] = ["ext4", "ext4", "tmpfs"];
    let mut i: int = 0;
    while i < len(devs) {
        println(devs[i] + " on " + dirs[i] + " " + types[i]);
        i = i + 1;
    }
    println(len(devs));
}
