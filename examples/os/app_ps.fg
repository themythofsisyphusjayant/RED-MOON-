fn ps_list(pids: [int], names: [str], states: [str], alive: [bool]) {
    let mut i: int = 0;
    while i < len(pids) {
        if alive[i] {
            println(pids[i], names[i], states[i]);
        }
        i = i + 1;
    }
}

fn main() {
    let pids: [int] = [1, 2, 3];
    let names: [str] = ["init", "sh", "http"];
    let states: [str] = ["run", "sleep", "run"];
    let mut alive: [bool] = [true, true, true];
    ps_list(pids, names, states, alive);
    alive[1] = false;
    ps_list(pids, names, states, alive);
}
