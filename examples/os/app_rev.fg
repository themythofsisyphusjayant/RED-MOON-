// rev — daily-ten 12 Nov 2026 (OS track).
// Reverses each of three fixed strings character by
// character: qasida -> adisaq, hello -> olleh, abc -> cba.
fn rev_str(s: str) -> str {
    let mut out: str = "";
    let mut i: int = len(s) - 1;
    while i >= 0 {
        out = out + substr(s, i, 1);
        i = i - 1;
    }
    return out;
}

fn main() {
    println(rev_str("qasida"));
    println(rev_str("hello"));
    println(rev_str("abc"));
}
