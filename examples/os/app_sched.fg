fn main() {
    let names: [str] = ["A", "B", "C"];
    let mut left: [int] = [3, 2, 1];
    let mut done: bool = false;
    while !done {
        done = true;
        let mut i: int = 0;
        while i < len(names) {
            if left[i] > 0 {
                println(names[i]);
                left[i] = left[i] - 1;
                done = false;
            }
            i = i + 1;
        }
    }
}
