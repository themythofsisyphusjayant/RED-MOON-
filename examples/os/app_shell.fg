fn main() {
    let cmds: [str] = ["h", "f", "c", "x", ""];
    let mut i: int = 0;
    while i < len(cmds) {
        let cmd: str = cmds[i];
        if cmd == "h" {
            println("help: h f c");
        } else if cmd == "f" {
            println("files: a.txt b.txt");
        } else if cmd == "c" {
            println("cleared");
        } else if cmd == "" {
            println("(empty)");
        } else {
            println("?");
        }
        i = i + 1;
    }
}
