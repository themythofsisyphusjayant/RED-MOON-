// sort — daily-ten 12 Nov 2026 (OS track).
// Sorts six words lexicographically (bubble sort). Qasida has
// no '<' on strings, so comparison walks the words one
// character at a time and ranks each character by its index
// in the alphabet; a shorter word that is a prefix sorts
// first. Sorted order: apple, banana, fig, kiwi, pear, plum.
fn rank(ch: str) -> int {
    let alpha: str = "abcdefghijklmnopqrstuvwxyz";
    let mut i: int = 0;
    while i < len(alpha) {
        if substr(alpha, i, 1) == ch {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn cmp_str(a: str, b: str) -> int {
    let mut i: int = 0;
    while i < len(a) {
        if i >= len(b) {
            return 1;
        }
        let ra: int = rank(substr(a, i, 1));
        let rb: int = rank(substr(b, i, 1));
        if ra < rb {
            return -1;
        }
        if ra > rb {
            return 1;
        }
        i = i + 1;
    }
    if len(a) < len(b) {
        return -1;
    }
    if len(a) > len(b) {
        return 1;
    }
    return 0;
}

fn main() {
    let mut words: [str] = ["pear", "apple", "fig", "banana", "kiwi", "plum"];
    let mut i: int = 0;
    while i < len(words) {
        let mut j: int = 0;
        while j + 1 < len(words) - i {
            if cmp_str(words[j], words[j + 1]) > 0 {
                let t: str = words[j];
                words[j] = words[j + 1];
                words[j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let mut k: int = 0;
    while k < len(words) {
        println(words[k]);
        k = k + 1;
    }
    println(len(words));
}
