// tac — daily-ten 12 Nov 2026 (OS track).
// Prints four fixed lines in reverse order (cat backwards),
// then the line count (4).
fn main() {
    let lines: [str] = ["one", "two", "three", "four"];
    let mut i: int = len(lines) - 1;
    while i >= 0 {
        println(lines[i]);
        i = i - 1;
    }
    println(len(lines));
}
