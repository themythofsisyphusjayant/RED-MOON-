fn num_str(n: int) -> str {
    if n == 0 {
        return "0";
    }
    let digits: str = "0123456789";
    let mut out: str = "";
    let mut x: int = n;
    while x > 0 {
        out = substr(digits, x % 10, 1) + out;
        x = x / 10;
    }
    return out;
}

fn main() {
    let mut names: [str] = ["init", "sh", "http"];
    let mut cpu: [int] = [5, 40, 25];
    let mut i: int = 0;
    while i < len(cpu) {
        let mut j: int = i + 1;
        while j < len(cpu) {
            if cpu[j] > cpu[i] {
                let t: int = cpu[i];
                cpu[i] = cpu[j];
                cpu[j] = t;
                let tn: str = names[i];
                names[i] = names[j];
                names[j] = tn;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(names) {
        println(names[i] + " " + num_str(cpu[i]));
        i = i + 1;
    }
}
