// uniq — daily-ten 12 Nov 2026 (OS track).
// Drops adjacent duplicate lines from a fixed list, keeping
// the first of each run. red, red, blue, blue, blue, green,
// red, red becomes red, blue, green, red — 4 lines.
fn main() {
    let lines: [str] = ["red", "red", "blue", "blue", "blue", "green", "red", "red"];
    let mut prev: str = "";
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(lines) {
        if i == 0 {
            println(lines[i]);
            n = n + 1;
        } else {
            if lines[i] != prev {
                println(lines[i]);
                n = n + 1;
            }
        }
        prev = lines[i];
        i = i + 1;
    }
    println(n);
}
