// ADC sampling driver kernel (Phase F).
//
// Samples 512, 768, 256: sum 1536, average 512, max 768.
// Expected UART: ADC\n512\n768\nDONE, halted.
// Final average word at 0x8000 is 512.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn put_str_done() {
  put(68);
  put(79);
  put(78);
  put(69);
}

fn main() {
  put(65);
  put(68);
  put(67);
  put(10);
  poke32(32768, (512 + 768 + 256) / 3);
  put_num(peek32(32768));
  put(10);
  poke32(32772, 768);
  put_num(peek32(32772));
  put(10);
  put_str_done();
}
