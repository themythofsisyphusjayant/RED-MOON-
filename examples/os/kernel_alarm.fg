// Alarm clock app kernel (Phase F, tick-match alarm).
//
// Alarm set for tick 4; ticks 1..6 print TICK except tick 4,
// which prints RING. The ring flag at 0x8008 is 1 afterwards.
//
// Expected model UART transcript:
//   ALARM\nTICK\nTICK\nTICK\nRING\nTICK\nTICK\nDONE, halted.
// Ring flag word at 0x8008 is 1.

fn put(c: int) {
  poke32(268435456, c);
}

fn alarm_tick(t: int) {
  if t == 4 {
    put(82);
    put(73);
    put(78);
    put(71);
    put(10);
    poke32(32776, 1);
  } else {
    put(84);
    put(73);
    put(67);
    put(75);
    put(10);
  }
}

fn main() {
  poke32(32776, 0);
  put(65);
  put(76);
  put(65);
  put(82);
  put(77);
  put(10);
  alarm_tick(1);
  alarm_tick(2);
  alarm_tick(3);
  alarm_tick(4);
  alarm_tick(5);
  alarm_tick(6);
  put(68);
  put(79);
  put(78);
  put(69);
}
