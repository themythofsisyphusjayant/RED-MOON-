// Checksum driver kernel (Phase F).
//
// Bytes 1, 2, 3, 4: additive checksum 10, count 4.
// Expected UART: CRC\n10\n4\nDONE, halted.
// Final checksum word at 0x8000 is 10.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn put_str_done() {
  put(68);
  put(79);
  put(78);
  put(69);
}

fn main() {
  put(67);
  put(82);
  put(67);
  put(10);
  poke32(32768, 1 + 2 + 3 + 4);
  put_num(peek32(32768));
  put(10);
  put_num(4);
  put(10);
  put_str_done();
}
