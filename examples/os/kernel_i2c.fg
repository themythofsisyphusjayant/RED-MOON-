// I2C bus-scan driver kernel (Phase F).
//
// Scan finds devices at decimal 72 and 80 (0x48, 0x50).
// Expected UART: I2C\n72\n80\nDONE, halted.
// Final device-count word at 0x8000 is 2.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn put_str_done() {
  put(68);
  put(79);
  put(78);
  put(69);
}

fn main() {
  put(73);
  put(50);
  put(67);
  put(10);
  poke32(32768, 2);
  put_num(72);
  put(10);
  put_num(80);
  put(10);
  put_str_done();
}
