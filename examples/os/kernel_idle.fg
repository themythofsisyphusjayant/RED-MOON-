// The idle task — Phase F follow-up: the known limitation fixed.
//
// kernel_drivers.fg states it plainly: with no idle task, sleep()
// with no other ready task degrades to an immediate resume instead
// of blocking. This kernel fixes that: when the scheduler finds no
// ready task, it runs an idle task that waits for the next timer
// interrupt instead of resuming the sleeper.
//
// Design (built on kernel_drivers.fg, which is NOT modified):
//   The idle task is a real spawned task, not a special code path.
//   main spawns it first, so it takes slot 1; real children use
//   slots 2-3 (two child slots, as in kernel_unified.fg). Spawning
//   reuses the proven child-start mechanism (frame copied from the
//   spawner, a0 = 0, resume after the ecall), so no function
//   address is ever needed as an integer.
//   The idle task's body is a tight loop. It never sleeps, never
//   yields, never exits. Timer interrupts preempt it (MIE + MTIE
//   stay set); the handler wakes due sleepers and switches to
//   them. If nothing is due, the handler returns and the idle
//   loop resumes.
//
// Memory map — same table as kernel_drivers.fg, one new state,
// one new scratch cell:
//   Process table in scratch 0x8000, 4 slots x 16 bytes:
//     [state, frame, mepc, exit_code-or-wake_tick]
//   states: 0 free, 1 ready, 2 running, 3 done, 4 sleeping,
//     5 idle (never picked by next_ready; only the explicit
//     no-ready paths switch to it).
//   Scratch: 0x8040 current pid, 0x8044/0x8048 child pids,
//     0x804C tick count, 0x8050 idle pid (-1 until spawned).
//   Syscalls: 2 spawn, 3 yield, 4 exit, 5 sleep(ticks).
//   No new memory region is needed: the idle task uses slot 1's
//   stack (top 0xE000), exactly like any other child.
//   Invariant: the idle task is spawned before any task can
//   sleep, and its pid is recorded before the first real child
//   is spawned, so every no-ready path finds a valid idle pid.
//
// No-ready paths (all three now use the idle task when a sleeper
// exists, so a wake-up is guaranteed to arrive):
//   sleep: sleeper blocks, switch to idle (was: immediate resume).
//   yield: yielder stays ready, switch to idle (was: spin).
//   exit:  exiter is done, switch to idle (was: halt at once,
//     which would have killed the machine while main slept).
//   A no-ready path with NO sleeper keeps the old behaviour
//   (yield returns, exit halts): with nothing that can ever
//   wake, the idle task would spin forever.
//   Interrupt path: switching away from the idle task restores
//   its state to 5, not 1, so it is never picked by round-robin.
//
// Demo: main spawns the idle task, then one task A that sleeps
// 5 ticks with nobody else ready. The kernel waits in the idle
// task (tick count advances), A wakes at its wake tick, prints
// 'A' plus the tick count at wake time (the proof the wait
// happened: with the old immediate-resume behaviour A would
// have printed at tick ~1), exits, main prints DONE and the
// kernel halts cleanly. Expected model UART transcript:
// KERNA8DONE (measured 12 Nov 2026, deterministic for this
// binary: A wakes at tick 8, >= the 5-tick sleep — the tick
// count runs from boot, so pre-sleep setup latency is included;
// with the old immediate-resume behaviour A would have printed
// at tick ~1 and the run would end at ~2 ticks), halted, final
// states [running, idle, done, free].

fn uart_putc(c: int) {
  poke32(268435456, c);
}

fn uart_getc() -> int {
  return peek32(268435460);
}

fn timer_now() -> int {
  return peek32(268435472);
}

fn timer_set_cmp(v: int) {
  poke32(268435480, v);
}

fn timer_enable() {
  csr_set(768, 8);
  csr_set(772, 128);
}

fn task_sleep(ticks: int) {
  let x = ecall(5, ticks);
}

fn do_exit(code: int) {
  let x = ecall(4, code);
}

fn idle_loop() {
  while 1 == 1 {
  }
}

fn body_a() {
  task_sleep(5);
  uart_putc(65);
  let t = peek32(32844);
  uart_putc(48 + t);
}

fn next_ready(cur: int) -> int {
  let mut s = cur + 1;
  while s < 4 {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  s = 0;
  while s < cur {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn any_sleeping() -> int {
  let mut s = 0;
  while s < 4 {
    if peek32(32768 + s * 16) == 4 {
      return 1;
    }
    s = s + 1;
  }
  return 0;
}

fn switch_to(nxt: int) {
  let nbase = 32768 + nxt * 16;
  poke32(nbase, 2);
  csr_write(833, peek32(nbase + 8));
  csr_write(832, peek32(nbase + 4));
  poke32(32832, nxt);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    poke32(32844, peek32(32844) + 1);
    timer_set_cmp(timer_now() + 1000);
    let mut s = 0;
    while s < 4 {
      let base = 32768 + s * 16;
      if peek32(base) == 4 {
        if peek32(base + 12) <= timer_now() {
          poke32(base, 1);
        }
      }
      s = s + 1;
    }
    let cur = peek32(32832);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      return;
    }
    let curbase = 32768 + cur * 16;
    poke32(curbase + 4, frame);
    poke32(curbase + 8, csr_read(833));
    if cur == peek32(32848) {
      poke32(curbase, 5);
    } else {
      poke32(curbase, 1);
    }
    switch_to(nxt);
    return;
  }
  let cur = peek32(32832);
  let curbase = 32768 + cur * 16;
  poke32(curbase + 4, frame);
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  if eid == 2 {
    let mut s = 1;
    let mut slot = 0 - 1;
    while s < 4 {
      if peek32(32768 + s * 16) == 0 {
        slot = s;
        break;
      }
      s = s + 1;
    }
    if slot == 0 - 1 {
      poke32(frame + 32, 0 - 1);
      csr_write(833, ret);
      return;
    }
    let top = 57344 - (slot - 1) * 8192;
    let dst = top - 120;
    let mut i = 0;
    while i < 30 {
      poke32(dst + i * 4, peek32(frame + i * 4));
      i = i + 1;
    }
    poke32(frame + 32, slot);
    poke32(dst + 32, 0);
    let sbase = 32768 + slot * 16;
    poke32(sbase, 1);
    poke32(sbase + 4, dst);
    poke32(sbase + 8, ret);
    poke32(sbase + 12, 0);
    csr_write(833, ret);
    return;
  }
  if eid == 3 {
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      if any_sleeping() == 1 {
        poke32(curbase + 8, ret);
        poke32(curbase, 1);
        switch_to(peek32(32848));
        return;
      }
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  if eid == 4 {
    poke32(curbase, 3);
    poke32(curbase + 12, peek32(frame + 32));
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      if any_sleeping() == 1 {
        switch_to(peek32(32848));
        return;
      }
      csr_write(773, 0);
      let h = ecall(0, 0);
      return;
    }
    switch_to(nxt);
    return;
  }
  if eid == 5 {
    let ticks = peek32(frame + 32);
    poke32(curbase + 12, timer_now() + ticks * 1000);
    poke32(curbase, 4);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      poke32(curbase + 8, ret);
      switch_to(peek32(32848));
      return;
    }
    poke32(curbase + 8, ret);
    switch_to(nxt);
    return;
  }
  csr_write(833, ret);
}

fn main() {
  poke32(32768, 2);
  poke32(32772, 0);
  poke32(32776, 0);
  poke32(32780, 0);
  let mut s = 1;
  while s < 4 {
    poke32(32768 + s * 16, 0);
    s = s + 1;
  }
  poke32(32832, 0);
  poke32(32836, 0 - 1);
  poke32(32840, 0 - 1);
  poke32(32844, 0);
  poke32(32848, 0 - 1);
  uart_putc(75);
  uart_putc(69);
  uart_putc(82);
  uart_putc(78);
  timer_set_cmp(1000);
  timer_enable();
  let ip = ecall(2, 0);
  if ip == 0 {
    idle_loop();
    do_exit(0);
  }
  if ip > 0 {
    poke32(32848, ip);
    poke32(32768 + ip * 16, 5);
  }
  let a = ecall(2, 0);
  if a == 0 {
    body_a();
    do_exit(0);
  }
  if a > 0 {
    poke32(32836, a);
  }
  let pa = peek32(32836);
  while peek32(32768 + pa * 16) != 3 {
    task_sleep(1);
  }
  uart_putc(68);
  uart_putc(79);
  uart_putc(78);
  uart_putc(69);
}
