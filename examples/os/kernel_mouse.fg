// Mouse driver kernel (Phase F, 3-byte packet decode-lite).
//
// Each packet is (buttons, dx, dy) with single-digit values in
// this demo; the driver prints one "btn:dx:dy" line per packet
// and keeps the last dx in RAM scratch.
//
// Expected model UART transcript:
//   MOUSE\n1:5:3\n0:2:1\nDONE, halted.
// Last dx word at 0x8008 is 2.

fn put(c: int) {
  poke32(268435456, c);
}

fn mouse_pkt(btn: int, dx: int, dy: int) {
  put(48 + btn);
  put(58);
  put(48 + dx);
  put(58);
  put(48 + dy);
  put(10);
  poke32(32776, dx);
}

fn main() {
  put(77);
  put(79);
  put(85);
  put(83);
  put(69);
  put(10);
  mouse_pkt(1, 5, 3);
  mouse_pkt(0, 2, 1);
  put(68);
  put(79);
  put(78);
  put(69);
}
