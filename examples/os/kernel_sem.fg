// Semaphore driver kernel (Phase F).
//
// Semaphore starts at 1, acquire takes it to 0, release
// returns it to 1. Expected UART: SEM\n0\n1\nDONE, halted.
// Final count word at 0x8000 is 1.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn put_str_done() {
  put(68);
  put(79);
  put(78);
  put(69);
}

fn main() {
  put(83);
  put(69);
  put(77);
  put(10);
  poke32(32768, 1);
  poke32(32768, peek32(32768) - 1);
  put_num(peek32(32768));
  put(10);
  poke32(32768, peek32(32768) + 1);
  put_num(peek32(32768));
  put(10);
  put_str_done();
}
