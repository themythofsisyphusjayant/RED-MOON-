// Snake game kernel (Phase F, scripted snake-lite).
//
// An 8x8 grid, head starting at (2,2), food at (4,2). Scripted
// moves R, R (eat: length 2, score 1), D to (4,3). Length at
// 0x8008, score at 0x800C. No rendering yet — the transcript
// reports the final length and score.
//
// Expected model UART transcript:
//   SNAKE\nLEN2\nSCORE1\nDONE, halted.
// Length word at 0x8008 is 2; score word at 0x800C is 1.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 100 {
    put(48 + v / 100);
  }
  if v >= 10 {
    put(48 + (v / 10) % 10);
  }
  put(48 + v % 10);
}

fn snake_try_eat() {
  if peek32(32768) == peek32(32784) {
    if peek32(32772) == peek32(32788) {
      poke32(32776, peek32(32776) + 1);
      poke32(32780, peek32(32780) + 1);
      poke32(32784, 0);
      poke32(32788, 0);
    }
  }
}

fn main() {
  poke32(32768, 2);
  poke32(32772, 2);
  poke32(32776, 1);
  poke32(32780, 0);
  poke32(32784, 4);
  poke32(32788, 2);
  put(83);
  put(78);
  put(65);
  put(75);
  put(69);
  put(10);
  poke32(32768, peek32(32768) + 1);
  snake_try_eat();
  poke32(32768, peek32(32768) + 1);
  snake_try_eat();
  poke32(32772, peek32(32772) + 1);
  snake_try_eat();
  put(76);
  put(69);
  put(78);
  put_num(peek32(32776));
  put(10);
  put(83);
  put(67);
  put(79);
  put(82);
  put(69);
  put_num(peek32(32780));
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
