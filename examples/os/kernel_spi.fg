// SPI transfer driver kernel (Phase F).
//
// Master sends 170 (10101010); bit-reversed slave reply is 85
// (01010101). Both are printed as a fixed known transfer.
// Expected UART: SPI\n170\n85\nDONE, halted.
// Final reply word at 0x8000 is 85.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn put_str_done() {
  put(68);
  put(79);
  put(78);
  put(69);
}

fn main() {
  put(83);
  put(80);
  put(73);
  put(10);
  poke32(32768, 170);
  put_num(peek32(32768));
  put(10);
  poke32(32768, 85);
  put_num(peek32(32768));
  put(10);
  put_str_done();
}
