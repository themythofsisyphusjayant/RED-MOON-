// Stopwatch app kernel (Phase F, tick-count stopwatch).
//
// Ticks are loop steps in this demo (no timer interrupt yet):
// lap at tick 3, stop at tick 5. Count lives at 0x8000.
//
// Expected model UART transcript:
//   SW\nLAP3\nSTOP5\nDONE, halted.
// Final count word at 0x8000 is 5.

fn put(c: int) {
  poke32(268435456, c);
}

fn sw_tick() {
  poke32(32768, peek32(32768) + 1);
}

fn main() {
  poke32(32768, 0);
  put(83);
  put(87);
  put(10);
  sw_tick();
  sw_tick();
  sw_tick();
  put(76);
  put(65);
  put(80);
  put(48 + peek32(32768));
  put(10);
  sw_tick();
  sw_tick();
  put(83);
  put(84);
  put(79);
  put(80);
  put(48 + peek32(32768));
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
