// Sound synth kernel (Phase F, note-sequence synth-lite).
//
// Notes are (name, duration-ticks) pairs played in order to
// the beep port in spirit — here the transcript names each
// note, and the total duration accumulates at 0x8008.
//
// Expected model UART transcript:
//   SYNTH\nC\nD\nE\nDONE, halted.
// Total duration word at 0x8008 is 4.

fn put(c: int) {
  poke32(268435456, c);
}

fn synth_note(n: int, dur: int) {
  put(n);
  put(10);
  poke32(32776, peek32(32776) + dur);
}

fn main() {
  poke32(32776, 0);
  put(83);
  put(89);
  put(78);
  put(84);
  put(72);
  put(10);
  synth_note(67, 1);
  synth_note(68, 2);
  synth_note(69, 1);
  put(68);
  put(79);
  put(78);
  put(69);
}
