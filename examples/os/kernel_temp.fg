// Temperature-sensor driver kernel (Phase F).
//
// Raw 250 -> 25 degrees, raw 350 -> 35 degrees, over the
// 30-degree threshold, so the alarm flag is 1.
// Expected UART: TEMP\n25\n35\n1\nDONE, halted.
// Final alarm word at 0x8004 is 1.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn put_str_done() {
  put(68);
  put(79);
  put(78);
  put(69);
}

fn main() {
  put(84);
  put(69);
  put(77);
  put(80);
  put(10);
  poke32(32768, 250 / 10);
  put_num(peek32(32768));
  put(10);
  poke32(32768, 350 / 10);
  put_num(peek32(32768));
  put(10);
  poke32(32772, 1);
  put_num(peek32(32772));
  put(10);
  put_str_done();
}
