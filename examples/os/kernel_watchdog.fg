// Watchdog timer driver kernel (Phase F, countdown + pet).
//
// Countdown from 3: tick to 2, pet back to 3, then ticks to 2,
// 1, 0 — expiry sets the flag at 0x8008 and prints EXPIRED.
//
// Expected model UART transcript:
//   WD\nPET\nEXPIRED\nDONE, halted.
// Expired flag word at 0x8008 is 1.

fn put(c: int) {
  poke32(268435456, c);
}

fn wd_tick() {
  poke32(32768, peek32(32768) - 1);
  if peek32(32768) == 0 {
    put(69);
    put(88);
    put(80);
    put(73);
    put(82);
    put(69);
    put(68);
    put(10);
    poke32(32776, 1);
  }
}

fn main() {
  poke32(32768, 3);
  poke32(32776, 0);
  put(87);
  put(68);
  put(10);
  wd_tick();
  poke32(32768, 3);
  put(80);
  put(69);
  put(84);
  put(10);
  wd_tick();
  wd_tick();
  wd_tick();
  put(68);
  put(79);
  put(78);
  put(69);
}
