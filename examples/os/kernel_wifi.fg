fn put(c: int) {
    poke32(268435456, c);
}

fn put_num(v: int) {
    let mut w = v;
    if w < 0 {
        put(45);
        w = 0 - w;
    }
    if w >= 10000 {
        put(48 + w / 10000);
    }
    if w >= 1000 {
        put(48 + w / 1000 % 10);
    }
    if w >= 100 {
        put(48 + w / 100 % 10);
    }
    if w >= 10 {
        put(48 + w / 10 % 10);
    }
    put(48 + w % 10);
}

fn put_done() {
    put(68);
    put(79);
    put(78);
    put(69);
}

fn main() {
    put(87);
    put(73);
    put(70);
    put(73);
    put(10);
    poke32(32768, 72);
    poke32(32772, 1);
    put_num(72);
    put(10);
    put_num(6);
    put(10);
    put_done();
}
