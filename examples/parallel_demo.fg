import "parallel.fg";

fn main() -> int {
    let xs: [int] = [1, 2, 3, 4];
    let mapped: [int] = pmap_affine(xs, 2, 1, 2);
    println(mapped[0], mapped[1], mapped[2], mapped[3]);
    println(preduce_sum(xs, 2));
    let ys: [int] = [1, 2, 3, 4, 5, 6];
    let evens: [int] = pfilter_even(ys, 3);
    println(evens[0], evens[1], evens[2]);
    return 0;
}
