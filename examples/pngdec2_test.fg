// Qasida — PNG decode test driver (pngdec v2).
// Decodes every fixture in tests/fixtures_png/ (all color types,
// all five filters, stored/fixed/dynamic DEFLATE, interlaced,
// tRNS) and prints, per file in order: width, height, ok, the
// sum of all RGBA bytes, and 1 when the RGBA bytes were written
// to /tmp/pngdec2_<stem>.rgba (byte-exact check by the test).
// Run from the repo root:
// python3 forge.py run examples/pngdec2_test.fg
// The fixture list here must match FIXTURES in
// tests/test_pngdec2.py (the test asserts the order).

import "pngdec.fg";

fn main() -> int {
    let files: [str] = ["tests/fixtures_png/rgb_8x8.png", "tests/fixtures_png/rgb_16x16.png", "tests/fixtures_png/gray_12x7.png", "tests/fixtures_png/palette_10x10.png", "tests/fixtures_png/grayalpha_9x9.png", "tests/fixtures_png/rgba_13x11.png", "tests/fixtures_png/rgb_interlaced_20x14.png", "tests/fixtures_png/photo_64x64.png", "tests/fixtures_png/rgb_trns.png", "tests/fixtures_png/gray_trns.png", "tests/fixtures_png/filt_none_8x8.png", "tests/fixtures_png/filt_sub_8x8.png", "tests/fixtures_png/filt_up_8x8.png", "tests/fixtures_png/filt_avg_8x8.png", "tests/fixtures_png/filt_paeth_8x8.png", "tests/fixtures_png/filt_mixed_8x8.png", "tests/fixtures_png/rgb_stored_8x8.png", "tests/fixtures_png/rgb_fixed_8x8.png", "tests/fixtures_png/rgb_level1_8x8.png", "tests/fixtures_png/rgb_level9_8x8.png"];
    let stems: [str] = ["rgb_8x8", "rgb_16x16", "gray_12x7", "palette_10x10", "grayalpha_9x9", "rgba_13x11", "rgb_interlaced_20x14", "photo_64x64", "rgb_trns", "gray_trns", "filt_none_8x8", "filt_sub_8x8", "filt_up_8x8", "filt_avg_8x8", "filt_paeth_8x8", "filt_mixed_8x8", "rgb_stored_8x8", "rgb_fixed_8x8", "rgb_level1_8x8", "rgb_level9_8x8"];
    let mut k: int = 0;
    while k < len(files) {
        let dec: [int] = png_decode_file(files[k]);
        println(dec[0]);
        println(dec[1]);
        println(dec[3]);
        let mut sum: int = 0;
        let mut i: int = 4;
        while i < len(dec) {
            sum = sum + dec[i];
            i = i + 1;
        }
        println(sum);
        let mut px: [int] = [];
        let mut j: int = 4;
        while j < len(dec) {
            push(px, dec[j]);
            j = j + 1;
        }
        if write_bytes("/tmp/pngdec2_" + stems[k] + ".rgba", px) {
            println(1);
        } else {
            println(0);
        }
        k = k + 1;
    }
    return 0;
}
