import "png.fg";
import "pngdec.fg";

fn main() -> int {
    let png: [int] = png_encode_1x1(200, 100, 50);
    let dec: [int] = pd_decode(png);
    println(dec[0]);
    println(dec[1]);
    println(dec[2]);
    println(dec[3]);
    println(dec[4]);
    println(dec[5]);
    let mut trunc: [int] = [];
    let mut i: int = 0;
    while i < 40 {
        push(trunc, png[i]);
        i = i + 1;
    }
    let bad: [int] = pd_decode(trunc);
    println(bad[5]);
    return 0;
}
