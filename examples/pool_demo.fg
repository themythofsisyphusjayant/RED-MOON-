import "pool.fg";

fn main() {
    let mut p: Pool = pool_new(4);
    println(pool_cap(p));
    println(pool_free_count(p));
    let a = pool_alloc(p);
    println(a.0);
    p = a.1;
    let b = pool_alloc(p);
    println(b.0);
    p = b.1;
    let c = pool_alloc(p);
    println(c.0);
    p = c.1;
    println(pool_used(p));
    let s = pool_set(p, a.0, 100);
    println(s.0);
    p = s.1;
    let g = pool_get(p, a.0);
    println(g.0);
    println(g.1);
    println(pool_full(p));
    let d = pool_alloc(p);
    println(d.0);
    p = d.1;
    println(pool_full(p));
    let e = pool_alloc(p);
    println(e.0);
    p = e.1;
    let f = pool_free(p, b.0);
    println(f.0);
    p = f.1;
    let df = pool_free(p, b.0);
    println(df.0);
    p = df.1;
    let bad = pool_free(p, 9);
    println(bad.0);
    p = bad.1;
    let r = pool_alloc(p);
    println(r.0);
    p = r.1;
    let gs = pool_get(p, r.0);
    println(gs.1);
    p = pool_reset(p);
    println(pool_used(p));
    println(pool_free_count(p));
    let z = pool_alloc(p);
    println(z.0);
    p = z.1;
}
