import "quant.fg";

fn main() -> int {
    let scale: float = qt_scale(-1.0, 1.0);
    let zp: int = qt_zero_point(-1.0, scale);
    println(scale, zp);
    let values: [float] = [0.0, 0.5, 1.0, -0.5];
    println(qt_quantize(values[0], scale, zp), qt_quantize(values[1], scale, zp), qt_quantize(values[2], scale, zp), qt_quantize(values[3], scale, zp));
    println(qt_max_error(values, scale, zp));
    let scale1: float = qt_scale(0.0, 0.5);
    println(scale1, qt_zero_point(0.0, scale1));
    return 0;
}
