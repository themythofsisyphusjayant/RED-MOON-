import "rat.fg";

fn main() {
    println("1/2 + 1/3 = " + rat_to_string(rat_add(rat_new(1, 2), rat_new(1, 3))));
    println("2/3 * 3/4 = " + rat_to_string(rat_mul(rat_new(2, 3), rat_new(3, 4))));
    println("1/2 - 1/3 = " + rat_to_string(rat_sub(rat_new(1, 2), rat_new(1, 3))));
    println("3/4 / 1/2 = " + rat_to_string(rat_div(rat_new(3, 4), rat_new(1, 2))));
    println("2/4 = " + rat_to_string(rat_new(2, 4)));
    println("-1/-2 = " + rat_to_string(rat_new(-1, -2)));
    println("1/2 == 1/3:");
    println(rat_eq(rat_new(1, 2), rat_new(1, 3)));
    println("cmp 1/2 vs 1/3:");
    println(rat_cmp(rat_new(1, 2), rat_new(1, 3)));
    println("cmp 1/3 vs 1/2:");
    println(rat_cmp(rat_new(1, 3), rat_new(1, 2)));
    println("cmp 1/2 vs 2/4:");
    println(rat_cmp(rat_new(1, 2), rat_new(2, 4)));
    println("6/3 = " + rat_to_string(rat_new(6, 3)));
    println("1/2 as float:");
    println(rat_to_float(rat_new(1, 2)));
}
