import "resolver.fg";

fn main() {
    let names: [str] = ["a", "a", "a", "b"];
    let vers: [str] = ["1.0.0", "1.2.0", "2.0.0", "0.9.0"];
    let p1: str = res_pick(names, vers, "a", "^1.0.0");
    println(p1);
    let p2: str = res_pick(names, vers, "a", ">=2.0.0");
    println(p2);
    let p3: str = res_pick(names, vers, "a", "^2.0.0");
    println(p3);
    let p4: str = res_pick(names, vers, "b", "^1.0.0");
    if p4 == "" {
        println("none");
    } else {
        println(p4);
    }
    let p5: str = res_pick(names, vers, "c", "^1.0.0");
    if p5 == "" {
        println("none");
    } else {
        println(p5);
    }
    println(res_found(names, vers, "a", "^1.0.0"));
    println(res_found(names, vers, "b", "^1.0.0"));
}
