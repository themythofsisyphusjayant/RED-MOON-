import "secrets.fg";

fn main() {
    let s: Secret = secret_new("hunter2");
    println(secret_len(s));
    println(secret_redacted(s));
    println(secret_is_zeroed(s));
    let z: Secret = secret_zero(s);
    println(secret_is_zeroed(z));
    println(secret_len(z));
    println(secret_len(s));
}
