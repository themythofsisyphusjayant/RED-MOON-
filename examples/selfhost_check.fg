    if n.name == "try_call" {
        // Top-500 #48: guarded call across a module boundary.
        // try_call(f) / try_call(f, x) calls the foreign function
        // f and returns Result<R, str>: Ok with f's return value,
        // or Err(message) when f fail()s. Only fail() is caught in
        // v1 (runtime faults and assert stay fatal via forge_fail).
        // f must be a bare function name defined in a different
        // .fg file from the caller (the module boundary, fn_files
        // comparison); the Result struct comes from
        // stdlib/result.fg, so the program must define (or import)
        // it. Value arguments are validated by
        // check_indirect_args against the callee's fn type.
        if len(n.kids) < 1 || len(n.kids) > 2 {
            fail_at(n.line, n.col, "try_call() takes a bare function name and 0 or 1 arguments (v1 arity 0-or-1)");
        }
        let callee: Node = n.kids[0];
        if callee.kind != 34 || var_known(c, callee.name) || func_sig(c, callee.name) == "" || enum_of_variant(c, callee.name) != "" {
            fail_at(n.line, n.col, "try_call() takes a bare function name defined in another file (not a closure, fn-typed variable, or method)");
        }
        if func_tparams(c, callee.name) != "" {
            fail_at(n.line, n.col, "generic function '" + callee.name + "' cannot be used as a value; call it (the call instantiates it)");
        }
        if func_is_extern(c, callee.name) {
            fail_at(n.line, n.col, "extern function '" + callee.name + "' cannot be used as a value (its C ABI type differs from the Qasida type)");
        }
        let ft: str = fn_type_of_sig(func_sig(c, callee.name));
        let params: [str] = fn_type_params(ft);
        let ret: str = fn_type_ret(ft);
        if len(params) != len(n.kids) - 1 {
            fail_at(n.line, n.col, "try_call() callee '" + callee.name + "' takes " + itoa(len(params)) + " argument(s), got " + itoa(len(n.kids) - 1));
        }
        if ret == "void" || ret == "never" {
            fail_at(n.line, n.col, "try_call() callee '" + callee.name + "' returns " + ret + "; the guarded call needs a value to wrap in Result");
        }
        if is_opaque_type(ret) {
            fail_at(n.line, n.col, "try_call() callee '" + callee.name + "' returns opaque type '" + ret + "' (no value can be built for the Err arm)");
        }
        if hc_func_file(c, callee.name) == c.current_file {
            fail_at(n.line, n.col, "try_call() is for calls across a module boundary; '" + callee.name + "' is defined in this file");
        }
