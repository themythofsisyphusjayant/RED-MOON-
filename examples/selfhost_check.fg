        c = expect_builtin_msgs(c, n, ["int", "int"], "mmap_grow() takes a mapping id and a new size", "mmap_grow() arguments must be int");
        return COut { c: c, typ: "int" };
    }
    if n.name == "mmap_get32" {
        c = expect_builtin_msgs(c, n, ["int", "int"], "mmap_get32() takes a mapping id and a byte offset", "mmap_get32() arguments must be int");
        return COut { c: c, typ: "int" };
    }
    if n.name == "http_get" {
        c = expect_builtin_msg(c, n, ["str"], "http_get() takes exactly one str URL argument");
        return COut { c: c, typ: "str" };
    }
    if n.name == "http_listen" {
        c = expect_builtin_msg(c, n, ["int"], "http_listen() takes exactly one int port argument");
        return COut { c: c, typ: "int" };
    }
    if n.name == "http_accept" || n.name == "http_close" {
        c = expect_builtin_msg(c, n, ["int"], n.name + "() takes exactly one int fd argument");
        return COut { c: c, typ: "int" };
    }
    if n.name == "http_read_request" {
        c = expect_builtin_msg(c, n, ["int"], "http_read_request() takes exactly one int client fd argument");
        return COut { c: c, typ: "str" };
    }
    if n.name == "http_respond" {
        c = expect_builtin_msg(c, n, ["int", "str"], "http_respond() takes (int client fd, str body)");
        return COut { c: c, typ: "int" };
    }
    if n.name == "http_respond_status" {
        c = expect_builtin_msg(c, n, ["int", "int", "str"], "http_respond_status() takes (int client fd, int status, str body)");
        return COut { c: c, typ: "int" };
    }
    let mut fn_cands: [str] = [];
    let mut fi: int = 0;
    while fi < len(c.func_names) {
        push(fn_cands, c.func_names[fi]);
        fi = fi + 1;
    }
    let blts: [str] = builtin_names();
    let mut bi: int = 0;
    while bi < len(blts) {
        push(fn_cands, blts[bi]);
        bi = bi + 1;
    }
    fail_at(n.line, n.col, "undefined function '" + n.name + "'" + suggest(n.name, fn_cands));
    return COut { c: c, typ: "?" };
}

// BinOp literal adaptation (Python check_binop preamble): when
// one side is a fixed type and the other is an integer literal,
// the literal adapts to the fixed type when it fits. Returns the
// adapted result type, or "" when no adaptation applies. Fails
// when the literal is present but out of range — or when the
// operator takes no adapted result (mirroring Python, which
// raises "does not fit" there too).
fn binop_adapt(op: str, lt: str, rt: str, left: Node, right: Node) -> str {
    if lt != rt && op != "<<" && op != ">>" {
        if is_fixed_int(lt) {
            let lv: [int] = int_literal_value(right);
            if len(lv) > 0 {
                if literal_fits_fixed(right, lt) {
                    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" {
                        return lt;
                    }
                    if op == "<" || op == "<=" || op == ">" || op == ">=" || op == "==" || op == "!=" {
                        return "bool";
                    }
                }
                fail_at(left.line, left.col, "integer literal " + itoa(lv[0]) + " does not fit in " + lt);
            }
        }
        if is_fixed_int(rt) {
            let lv: [int] = int_literal_value(left);
            if len(lv) > 0 {
                if literal_fits_fixed(left, rt) {
                    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" {
                        return rt;
                    }
                    if op == "<" || op == "<=" || op == ">" || op == ">=" || op == "==" || op == "!=" {
                        return "bool";
                    }
                }
                fail_at(left.line, left.col, "integer literal " + itoa(lv[0]) + " does not fit in " + rt);
            }
        }
    }
    return "";
}

// Combine one already-checked BinOp pair into its result type
// (the old check_binop body below the two check_expr calls).
// Pure in the operand TYPES: lt/rt are the checked types, ln/rn
// the operand nodes (for the literal-fit adaptation), line/col
// the BinOp node's position for errors.
fn binop_combine(c0: HChecker, op: str, lt: str, rt: str, ln: Node, rn: Node, line: int, col: int) -> COut {
    let mut c: HChecker = c0;
    let adapted: str = binop_adapt(op, lt, rt, ln, rn);
    if adapted != "" {
        return COut { c: c, typ: adapted };
    }
    // Arithmetic: int/float (mixed int+float promotes to float
    // only via explicit cast in Qasida, so both must match).
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
        if op == "+" && lt == "str" && rt == "str" {
            return COut { c: c, typ: "str" };
        }
        if (lt == "int" && rt == "int") {
            return COut { c: c, typ: "int" };
        }
        if (lt == "float" && rt == "float") {
            return COut { c: c, typ: "float" };
        }
        if lt == rt && is_fixed_int(lt) {
            return COut { c: c, typ: lt };
        }
        fail_at(line, col, "operator '" + op + "' needs matching int or float operands (or str + str), got " + lt + " and " + rt);
    }
    // Comparison: Python allows ==/!= only for the same scalar
    // (int/float/bool/str), the same fixed int, the same enum, or
    // the same newtype over a comparable underlying type
    // (checker.py:2888-2900). Structs, arrays, tuples and unions
    // are NOT comparable (the old hosted check accepted any same
    // type, which let union equality through).
    if op == "==" || op == "!=" {
        if lt == rt && (lt == "int" || lt == "float" || lt == "bool" || lt == "str" || is_fixed_int(lt) || str_in_arr(lt, c.enum_names)) {
            return COut { c: c, typ: "bool" };
        }
        if lt == rt && is_fn_type(lt) {
            // Fn values compare as C pointers (Top-500 #103, FN-C3):
            // same fn type only, no subtyping.
            return COut { c: c, typ: "bool" };
        }
        if lt == rt && str_in_arr(lt, c.nt_names) {
            let under: str = underlying_newtype(c, lt);
            if under == "int" || under == "float" || under == "bool" || under == "str" || str_in_arr(under, c.enum_names) {
                return COut { c: c, typ: "bool" };
            }
        }
        fail_at(line, col, "operator '" + op + "' needs matching int, float, bool, str or enum operands, got " + lt + " and " + rt);
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if (lt == "int" && rt == "int") || (lt == "float" && rt == "float") || (lt == rt && is_fixed_int(lt)) {
            return COut { c: c, typ: "bool" };
        }
        fail_at(line, col, "operator '" + op + "' needs matching int or float operands, got " + lt + " and " + rt);
    }
    // Bitwise / shifts: ints.
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
        if lt == "int" && rt == "int" {
            return COut { c: c, typ: "int" };
        }
        if (op == "&" || op == "|" || op == "^") && lt == rt && is_fixed_int(lt) {
            return COut { c: c, typ: lt };
        }
        if (op == "<<" || op == ">>") && is_fixed_int(lt) && (rt == "int" || rt == lt) {
            return COut { c: c, typ: lt };
        }
        fail_at(line, col, "operator '" + op + "' needs ints, got " + lt + " and " + rt);
    }
    // Logic: bools.
    if op == "&&" || op == "||" {
        if lt == "bool" && rt == "bool" {
            return COut { c: c, typ: "bool" };
        }
        fail_at(line, col, "operator '" + op + "' needs bools, got " + lt + " and " + rt);
    }
    fail_at(line, col, "unknown binary operator '" + op + "'");
    return COut { c: c, typ: "?" };
}

fn check_binop(c0: HChecker, n: Node) -> COut {
    let mut c: HChecker = c0;
    // Flatten a left-nested BinOp spine into an iterative loop.
    // A chain of N terms recursed N deep through check_expr /
    // check_expr_inner (~86KB/frame) + check_binop (~29KB),
    // overflowing the 8MB C stack at ~65 terms (the big-frame
    // program's 300-term return). The flattened walk checks
    // operands left-to-right and combines pairwise with the same
    // rules, nodes and positions as the recursion did: pair i
    // combines the accumulated type with the i-th right operand
    // at the i-th spine node's position, with the i-th spine
    // node's left child as the literal-fit left node. Spine
    // entries are collected outermost-first, so the fold runs
    // from the last entry back to the first. Recursion depth is
    // now bounded by operand depth, not chain length.
    let mut spine_ops: [str] = [];
    let mut spine_rights: [Node] = [];
    let mut spine_lefts: [Node] = [];
    let mut spine_lines: [int] = [];
    let mut spine_cols: [int] = [];
    let mut cur: Node = n;
    while cur.kind == 40 {
        push(spine_ops, cur.name);
        push(spine_rights, cur.kids[1]);
        push(spine_lefts, cur.kids[0]);
        push(spine_lines, cur.line);
        push(spine_cols, cur.col);
        cur = cur.kids[0];
    }
    let first: COut = check_expr(c, cur);
    c = first.c;
    let mut lt: str = first.typ;
    let mut i: int = len(spine_ops) - 1;
    while i >= 0 {
        let r: COut = check_expr(c, spine_rights[i]);
        c = r.c;
        let b: COut = binop_combine(c, spine_ops[i], lt, r.typ, spine_lefts[i], spine_rights[i], spine_lines[i], spine_cols[i]);
        c = b.c;
        lt = b.typ;
        i = i - 1;
    }
    return COut { c: c, typ: lt };
}

// ---------- statement checker ----------

// Path-sensitive join (move v2 / pin v1): after a branch, a
// variable is moved/pinned when it was so before OR on ANY path
// through the branch. Names declared only inside a branch are
// out of scope after the join and must not poison a later
// redeclaration, so only names visible in `before` are joined.
fn join_moved(before: HChecker, results: [HChecker]) -> HChecker {
    // Snapshot: this function writes var_moved/var_pinned in
    // place, which would corrupt the caller's `before` (shared
    // arrays) if it were used directly.
    let mut c: HChecker = checker_snapshot(before);
    let mut i: int = 0;
    while i < len(c.var_names) {
        let mut r: int = 0;
        while r < len(results) {
            let res: HChecker = results[r];
            // Find this name in the result's environment.
            let mut j: int = len(res.var_names) - 1;
            while j >= 0 {
                if res.var_names[j] == c.var_names[i] {
                    if res.var_moved[j] {
                        c.var_moved[i] = true;
                    }
                    if res.var_pinned[j] {
                        c.var_pinned[i] = true;
                    }
                    j = -1;
                }
                j = j - 1;
            }
            r = r + 1;
        }
        i = i + 1;
    }
    // Moved fields: union of all branch results, filtered to roots
    // visible in `before`.
    let mut r2: int = 0;
    while r2 < len(results) {
        let res2: HChecker = results[r2];
        let mut k: int = 0;
        while k < len(res2.moved_fields) {
            let p: str = res2.moved_fields[k];
            let root: str = substr(p, 0, find_top(p, "."));
            let mut vis: bool = false;
            let mut v: int = 0;
            while v < len(c.var_names) {
                if c.var_names[v] == root {
                    vis = true;
                }
                v = v + 1;
            }
            if vis {
                let mut dup: bool = false;
                let mut d: int = 0;
                while d < len(c.moved_fields) {
                    if c.moved_fields[d] == p {
                        dup = true;
                    }
                    d = d + 1;
                }
                if !dup {
                    push(c.moved_fields, p);
                }
            }
            k = k + 1;
        }
        r2 = r2 + 1;
    }
    return c;
}

// Is `name` declared in the current (innermost) scope?
// The environment is a flat list; a scope boundary is marked by
// `mark` (the length before the scope opened). A name is a
// duplicate if it appears at or after `mark`.
fn env_has_since(c: HChecker, name: str, mark: int) -> bool {
    let mut i: int = mark;
    while i < len(c.var_names) {
        if c.var_names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}


// Statement-only builtins: pin, assert, print/println, fail, fail_compile, eprintln.
// Called from ExprStmt when the call names one of these.
fn check_stmt_builtin(c0: HChecker, n: Node) -> HChecker {
    let mut c: HChecker = c0;
    if n.name == "pin" {
        // Pinning (Top-500 #34): pin(x); marks an owned binding
        // immovable for the rest of its scope.
        if len(n.kids) != 1 {
            fail_at(n.line, n.col, "pin() takes exactly one argument");
        }
        let arg: Node = n.kids[0];
        if arg.kind != 34 {
            fail_at(n.line, n.col, "pin needs a variable in v1; pin the whole binding, not a field");
        }
        let mut lv: int = 0;
        while lv < len(c.loop_vars) {
            if c.loop_vars[lv] == arg.name {
                fail_at(n.line, n.col, "pin of a for-loop variable is not supported in v1; copy it into a let first, then pin that");
            }
            lv = lv + 1;
        }
        if is_moved(c, arg.name) {
            fail_at(n.line, n.col, "cannot pin moved value '" + arg.name + "'");
        }
        if is_pinned(c, arg.name) {
            fail_at(n.line, n.col, "'" + arg.name + "' is already pinned");
        }
        let t: str = env_lookup(c, arg.name, n.line, n.col);
        if !is_owned_type(c, t) {
            fail_at(n.line, n.col, "pin needs an owned value (array, str, struct, tuple), got " + t);
        }
        // A struct with a drop method cannot be pinned: pinning
        // forbids moving, and drop runs on move-out.
        if has_method(c, t, "drop") {
            fail_at(n.line, n.col, "cannot pin a value of struct '" + t + "' with a drop method");
        }
        return env_set_pinned(c, arg.name);
    }
    if n.name == "assert" {
        if len(n.kids) != 2 {
            fail_at(n.line, n.col, "assert() takes a bool condition and a str message");
        }
        let a: COut = check_expr(c, n.kids[0]);
        c = a.c;
        if a.typ != "bool" {
            fail_at(n.line, n.col, "assert() condition must be bool");
        }
        let b: COut = check_msg_expr(c, n.kids[1]);
        c = b.c;
        if b.typ != "str" {
            fail_at(n.line, n.col, "assert() message must be str");
        }
        if c.current_fn == "crash_handler" {
            fail_at(n.line, n.col, "assert() inside crash_handler() would recurse (a failing hook re-enters the hook); the hook must not fail");
        }
        return c;
    }
    if n.name == "print" || n.name == "println" {
        if c.freestanding {
            fail_at(n.line, n.col, "print/println need the hosted I/O library (not in freestanding v1); use poke32 for MMIO output");
        }
        let mut i: int = 0;
        while i < len(n.kids) {
            let a: COut = check_expr(c, n.kids[i]);
            c = a.c;
            if is_fn_type(a.typ) {
                // A function value has no printed form (FN-C6).
                fail_at(n.line, n.col, "cannot print a function value (type " + a.typ + ")");
            }
            i = i + 1;
        }
        return c;
    }
    if n.name == "fail" {
        if len(n.kids) != 1 {
            fail_at(n.line, n.col, "fail() takes exactly one str argument");
        }
        let a: COut = check_msg_expr(c, n.kids[0]);
        c = a.c;
        if a.typ != "str" {
            fail_at(n.line, n.col, "fail() takes exactly one str argument");
        }
        if c.current_fn == "crash_handler" {
            fail_at(n.line, n.col, "fail() inside crash_handler() would recurse (a failing hook re-enters the hook); the hook must not fail");
        }
        return c;
    }
    if n.name == "fail_compile" {
        if c.freestanding {
            fail_at(n.line, n.col, "fail_compile() writes to stderr (not in freestanding v1)");
        }
        if len(n.kids) != 1 {
            fail_at(n.line, n.col, "fail_compile() takes exactly one str argument");
        }
        let a: COut = check_expr(c, n.kids[0]);
        c = a.c;
        if a.typ != "str" {
            fail_at(n.line, n.col, "fail_compile() takes exactly one str argument");
        }
        return c;
    }
    if n.name == "eprintln" {
        if c.freestanding {
            fail_at(n.line, n.col, "eprintln needs the hosted I/O library (not in freestanding v1); use poke32 for MMIO output");
        }
        if len(n.kids) != 1 {
            fail_at(n.line, n.col, "eprintln() takes exactly one str argument");
        }
        let a: COut = check_expr(c, n.kids[0]);
        c = a.c;
        if a.typ != "str" {
            fail_at(n.line, n.col, "eprintln() takes exactly one str argument");
        }
        return c;
    }
    if n.name == "push" {
        if c.freestanding {
            fail_at(n.line, n.col, "push() reallocates the heap buffer (not in freestanding v1; freestanding code has no heap allocator)");
        }
        // push(arr, value): the target must be a variable or
        // field, not pinned, an array (not sized, not readonly);
        // the value must match the element type.
        if len(n.kids) != 2 {
            fail_at(n.line, n.col, "push() takes a variable or field and a value");
        }
        let tgt: Node = n.kids[0];
        if tgt.kind != 34 && tgt.kind != 32 {
            fail_at(n.line, n.col, "push() takes a variable or field and a value");
        }
        let root: str = access_root(tgt);
        if root != "" && is_pinned(c, root) {
            fail_at(n.line, n.col, "cannot push to pinned value '" + root + "' (push can reallocate the buffer; grow it before pinning, then write in place)");
        }
        let mut vt: str = "";
        if tgt.kind == 34 {
            vt = env_lookup(c, tgt.name, n.line, n.col);
        } else {
            let b: COut = check_expr(c, tgt);
            c = b.c;
            vt = b.typ;
        }
        // A readonly view is rejected with its own message, not
        // the generic "needs an array" one (Python checks the
        // readonly case before the array case is reached, since
        // elem_type unwraps readonly).
        if is_readonly(vt) {
            fail_at(n.line, n.col, "cannot push to a readonly view " + vt);
        }
        if !is_array(vt) {
            fail_at(n.line, n.col, "push() needs an array, got " + vt);
        }
        if is_sized_array(vt) {
            fail_at(n.line, n.col, "cannot push to a sized array " + vt + " (its length is fixed)");
        }
        let v: COut = check_expr(c, n.kids[1]);
        c = v.c;
        // Pushing a concrete value into an unresolved array
        // resolves it to an array of that value's type.
        if tgt.kind == 34 {
            let rr: ResOut = try_resolve_empty(c, tgt.name, "[" + v.typ + "]");
            c = rr.c;
            if rr.ok {
                vt = "[" + v.typ + "]";
            }
        }
        if v.typ != elem_type(vt) {
            fail_at(n.line, n.col, "push() value must be " + elem_type(vt) + ", got " + v.typ);
        }
        return c;
    }
    if n.name == "poke32" {
        if len(n.kids) != 2 {
            fail_at(n.line, n.col, "poke32() takes exactly two arguments");
        }
        let mut i: int = 0;
        while i < 2 {
            let a: COut = check_expr(c, n.kids[i]);
            c = a.c;
            if a.typ != "int" {
                fail_at(n.line, n.col, "poke32() takes int arguments");
            }
            i = i + 1;
        }
        return c;
    }
    if n.name == "mmap_set" || n.name == "mmap_set32" {
        if c.freestanding {
            fail_at(n.line, n.col, "mmap needs the hosted runtime (not in freestanding v1)");
        }
        if len(n.kids) != 3 {
            fail_at(n.line, n.col, "'" + n.name + "' takes a mapping id, an index, and a value");
        }
        let mut i: int = 0;
        while i < 3 {
            let a: COut = check_expr(c, n.kids[i]);
            c = a.c;
            if a.typ != "int" {
                fail_at(n.line, n.col, "'" + n.name + "' arguments must be int");
            }
            i = i + 1;
        }
        return c;
    }
    if n.name == "mmap_close" {
        if c.freestanding {
            fail_at(n.line, n.col, "mmap needs the hosted runtime (not in freestanding v1)");
        }
        if len(n.kids) != 1 {
            fail_at(n.line, n.col, "mmap_close() takes a mapping id (int)");
        }
        let a: COut = check_expr(c, n.kids[0]);
        c = a.c;
        if a.typ != "int" {
            fail_at(n.line, n.col, "mmap_close() takes a mapping id (int)");
        }
        return c;
    }
    if n.name == "csr_write" || n.name == "csr_set" || n.name == "csr_clear" {
        if len(n.kids) != 2 || n.kids[0].kind != 25 {
            fail_at(n.line, n.col, "'" + n.name + "' takes a literal CSR number and an int value");
        }
        if n.kids[0].ival < 0 || n.kids[0].ival > 4095 {
            fail_at(n.line, n.col, "CSR number must be in 0..4095");
        }
        let a: COut = check_expr(c, n.kids[1]);
        c = a.c;
        if a.typ != "int" {
            fail_at(n.line, n.col, "'" + n.name + "' value must be int");
        }
        return c;
    }
    fail_at(n.line, n.col, "unknown statement builtin '" + n.name + "'");
    return c;
}

fn check_stmt(c0: HChecker, n: Node) -> HChecker {
    let mut c: HChecker = c0;
    if n.kind == 52 {
        // Top-500 #74: unreachable — resolve_generators_prog in
        // check_program desugars every Yield before check_stmt
        // sees one. A Yield here means a new statement-list
        // walker was added without going through the transform.
        fail_at(n.line, n.col, "internal error: unresolved yield");
    }
    if n.kind == 9 {
        // Bare block statement: a new scope (mirrors Python
        // check_stmt dispatching Block to check_block).
        // (Slice-3 gap found by 4b: no slice-3 corpus file has a
        // bare block as a statement, so this was never exercised.)
        let mark: int = len(c.var_names);
        c = check_block(c, n);
        return env_restore(c, mark);
    }
    if n.kind == 10 {
        // Let: duplicate in the same scope, void, then declare.
        // A fresh binding revives a moved/pinned shadowed name.
        if is_c_keyword(n.name) {
            fail_at(n.line, n.col, "'" + n.name + "' is a C keyword and cannot be used as a variable name");
        }
        let init: COut = check_expr(c, n.kids[0]);
        c = init.c;
        // Top-500 #494: same-scope rebind? The top scope mark is
        // the length of var_names at the innermost block's entry;
        // a name declared at or after it is a rebind, not a fresh
        // binding (a loop var is declared BEFORE the body's mark,
        // so shadowing one stays a fresh binding here — the
        // Python checker rejects that shape instead; pre-existing
        // divergence, documented in the #494 entry).
        let mut scope_mark: int = 0;
        if len(c.scope_marks) > 0 {
            scope_mark = c.scope_marks[len(c.scope_marks) - 1];
        }
        let is_rebind: bool = env_has_since(c, n.name, scope_mark);
        if init.typ == "void" {
            // Python checker's void-let messages (checker.py:1260):
            // a call or method call names the function; any other
            // void value gets the bare message.
            if n.kids[0].kind == 35 {
                fail_at(n.line, n.col, "function '" + n.kids[0].name + "' returns void and has no value to bind; call it as a statement instead");
            }
            if n.kids[0].kind == 33 {
                fail_at(n.line, n.col, "method '" + n.kids[0].name + "' returns void and has no value to bind; call it as a statement instead");
            }
            fail_at(n.line, n.col, "void has no value to bind");
        }
        let mut t: str = init.typ;
        if len(split(t, "?")) == 1 && !hc_valid_type(c, t, []) {
            // A value whose type is not a valid value type (a
            // tuple containing void, or a bad union) cannot be
            // bound either (Python checker.py:1272).
            fail_at(n.line, n.col, "type '" + t + "' contains void, which has no value");
        }
        if n.sval == "" && n.kids[0].kind == 29 && len(n.kids[0].kids) == 0 && !is_rebind {
            // Empty literal, no annotation: its element type is
            // unresolved until a constraining use resolves it
            // (or check_func reports it at the end of the body).
            // A rebind takes the old type instead (below), so it
            // never registers as unresolved.
            push(c.unres_names, n.name);
            push(c.unres_lines, n.line);
            push(c.unres_cols, n.col);
        }
        if n.sval != "" {
            // An annotated let constrains an unresolved array
            // value to the annotation's type.
            if n.kids[0].kind == 34 {
                let r: ResOut = try_resolve_empty(c, n.kids[0].name, n.sval);
                c = r.c;
                if r.ok {
                    t = n.sval;
                }
            }
            // A generic-enum placeholder fills from the
            // annotation (None() over OptionE<T> is OptionE<int>
            // here); a bare variant of a generic enum takes the
            // annotation's type the same way.
            let filled: str = fill_placeholder(t, n.sval);
            if filled != t {
                t = filled;
            } else if n.kids[0].kind == 34 {
                let ven2: str = enum_of_variant(c, n.kids[0].name);
                if ven2 != "" && generic_base(n.sval) == ven2 && generic_base(n.sval) != n.sval {
                    t = n.sval;
                }
            }
            // The annotation itself must name a real value type
            // (Python checker.py:1281): a duplicate-member union
            // or an unknown type is rejected here.
            if !hc_valid_type(c, n.sval, []) || n.sval == "void" {
                fail_at(n.line, n.col, "unknown type '" + n.sval + "'" + suggest(n.sval, type_name_cands(c)));
            }
            if !accepts(c, t, n.sval) && !sized_literal_ok(c, n.kids[0], n.sval) && !literal_fits_fixed(n.kids[0], n.sval) {
                let fit_msg: str = literal_fit_msg(n.kids[0], n.sval);
                if fit_msg != "" {
                    fail_at(n.line, n.col, fit_msg);
                }
                fail_at(n.line, n.col, "variable '" + n.name + "' is declared " + n.sval + " but initialised with " + t + cast_hint(t, n.sval));
            }
            t = n.sval;
        }
        if is_rebind {
            // Top-500 #494: same-scope shadowing. The RHS above
            // still read the OLD binding. Same type only in v1
            // (the C variable keeps its declared type); a
            // different type, or a pinned binding, is rejected.
            if is_pinned(c, n.name) {
                fail_at(n.line, n.col, "cannot shadow pinned variable '" + n.name + "' (pin forbids replacing the value; change it in place through its fields or indexes)");
            }
            let old_t: str = env_type_raw(c, n.name);
            if n.sval == "" && n.kids[0].kind == 29 && len(n.kids[0].kids) == 0 {
                // An empty literal carries no element type for
                // the codegen (the infer pass only propagates
                // annotations), so a rebind needs one too — the
                // same error as a fresh empty let.
                fail_at(n.line, n.col, "cannot infer the element type of an empty array literal; add an annotation, e.g. let x: [int] = []");
            } else if t != old_t {
                fail_at(n.line, n.col, "cannot shadow '" + n.name + "' with a different type in v1 (was " + old_t + ", now " + t + "); declare it in a nested block or use a new name");
            }
        }
        c = env_revive(c, n.name);
        return env_declare_mut(c, n.name, t, n.bval);
    }
    if n.kind == 11 {
        // Assign: the target must be mutable and not pinned;
        // reassignment revives a moved variable.
        if !env_is_mut(c, n.name) {
            fail_at(n.line, n.col, "cannot assign to immutable variable '" + n.name + "' (declare it with 'let mut')");
        }
        // Assignment to a captured binding (Top-500 #101, CL-C3):
        // closures capture by value and the binding is read-only
        // inside the lambda in v1.
        if lam_is_capture(c, n.name) {
            fail_at(n.line, n.col, "cannot assign to captured variable '" + n.name + "' (closures capture by value; captured variables are read-only in v1)");
        }
        if is_pinned(c, n.name) {
            fail_at(n.line, n.col, "cannot reassign pinned variable '" + n.name + "' (pin forbids replacing the value; change it in place through its fields or indexes)");
        }
        let val: COut = check_expr(c, n.kids[0]);
        c = val.c;
        // Assigning a fresh value revives a moved variable, so the
        // type read must not fail on moved (Python's lookup does
        // not fail on moved either).
        let mut want: str = env_type_raw(c, n.name);
        if want == "" {
            fail_at(n.line, n.col, "undefined variable '" + n.name + "'");
        }
        // Assigning a concrete value to an unresolved empty array
        // resolves it to the value's type.
        let rr: ResOut = try_resolve_empty(c, n.name, val.typ);
        c = rr.c;
        if rr.ok {
            want = val.typ;
        }
        if !accepts(c, val.typ, want) && !sized_literal_ok(c, n.kids[0], want) && !literal_fits_fixed(n.kids[0], want) {
            let fit_msg: str = literal_fit_msg(n.kids[0], want);
            if fit_msg != "" {
                fail_at(n.line, n.col, fit_msg);
            }
            fail_at(n.line, n.col, "cannot assign " + val.typ + " to " + want + " variable '" + n.name + "'" + cast_hint(val.typ, want));
        }
        return env_revive(c, n.name);
    }
    if n.kind == 12 {
        // IndexAssign (Python checker.py:1396): an in-place
        // index write is NOT a rebinding, so mutability of the
        // root variable is NOT required — a parameter array, or
        // a struct field's array, can be written through
        // (map_put/db_put do m.vals[i] = v with m a parameter;
        // heap_init does heap[0] = 1024 with heap a parameter).
        // The old code lumped this with FieldAssign and required
        // the root mutable; that rejected every stdlib helper
        // that writes through an array it was handed.
        let idx_node: Node = n.kids[0];
        let base_node: Node = idx_node.kids[0];
        let mut vt: str = "";
        let mut et: str = "";
        if base_node.kind == 34 {
            // Plain variable base: a moved array is a
            // use-after-move; the type comes from a raw lookup
            // (Python types the base by lookup alone — no
            // moved-field or pinned check on an in-place
            // index write).
            if is_moved(c, base_node.name) {
                fail_at(n.line, n.col, "use of moved value '" + base_node.name + "'");
            }
            vt = env_type_raw(c, base_node.name);
            if vt == "" {
                fail_at(n.line, n.col, "undefined variable '" + base_node.name + "'");
            }
            if is_array(vt) {
                et = elem_type(vt);
            }
        } else if base_node.kind == 32 || base_node.kind == 36 {
            // FieldAccess (m.vals[i] = v) or chained Index
            // (m[i][j] = v): the array type comes from checking
            // the base expression, with the write root set so
            // an in-place write into a pinned value is not a
            // use of the pinned value.
            let root: str = access_root(base_node);
            if root == "" {
                fail_at(n.line, n.col, "index assignment target must be a variable or a field");
            }
            c.pinned_write_root = root;
            let bout: COut = check_expr(c, base_node);
            c = bout.c;
            c.pinned_write_root = "";
            vt = bout.typ;
            if is_array(vt) {
                et = elem_type(vt);
            }
        } else {
            fail_at(n.line, n.col, "index assignment target must be a variable or a field");
        }
        if is_readonly(vt) {
            fail_at(n.line, n.col, "cannot assign through a readonly view " + vt);
        }
        if vt == "str" {
            fail_at(n.line, n.col, "cannot assign to a string index; strings are immutable");
        }
        if et == "" {
            fail_at(n.line, n.col, "cannot index a non-array value of type " + vt);
        }
        let ix: COut = check_expr(c, idx_node.kids[1]);
        c = ix.c;
        if ix.typ != "int" {
            fail_at(n.line, n.col, "array index must be int");
        }
        let val: COut = check_expr(c, n.kids[1]);
        c = val.c;
        // Storing a concrete element through an unresolved array
        // resolves it to an array of that element type.
        if base_node.kind == 34 {
            let rr: ResOut = try_resolve_empty(c, base_node.name, "[" + val.typ + "]");
            c = rr.c;
            if rr.ok {
                et = val.typ;
            }
        }
        if val.typ != et {
            fail_at(n.line, n.col, "cannot assign " + val.typ + " to element of type " + et + cast_hint(val.typ, et));
        }
        return c;
    }
    if n.kind == 13 {
        // FieldAssign (Python checker.py:1348): the OUTERMOST
        // variable must be mutable; the field type comes from
        // checking the target FieldAccess itself.
        let mut node: Node = n.kids[0];
        while node.kind == 32 {
            node = node.kids[0];
        }
        if node.kind != 34 {
            fail_at(n.line, n.col, "field assignment target must start from a variable");
        }
        if !env_is_mut(c, node.name) {
            fail_at(n.line, n.col, "cannot assign to a field of immutable variable '" + node.name + "' (declare it with 'let mut')");
        }
        // An in-place field write is not a use of the pinned
        // value: the struct stays put, only the field changes.
        c.pinned_write_root = node.name;
        // Assigning a field revives it after a field move, so the
        // target check alone must not reject a moved field.
        c.moved_field_target = field_path(n.kids[0]);
        let base: COut = check_expr(c, n.kids[0]);
        c = base.c;
        c.pinned_write_root = "";
        c.moved_field_target = "";
        let val: COut = check_expr(c, n.kids[1]);
        c = val.c;
        // Storing an unresolved array into a concretely typed field
        // resolves it to the field's type.
        let mut vt2: str = val.typ;
        if n.kids[1].kind == 34 {
            let rr: ResOut = try_resolve_empty(c, n.kids[1].name, base.typ);
            c = rr.c;
            if rr.ok {
                vt2 = base.typ;
            }
        }
        if vt2 != base.typ && !sized_literal_ok(c, n.kids[1], base.typ) {
            fail_at(n.line, n.col, "cannot assign " + vt2 + " to field of type " + base.typ + cast_hint(vt2, base.typ));
        }
        // Assigning a field revives it after a field move, and
        // assigning a whole intermediate struct revives the
        // fields under it too (replacing o.inner replaces
        // o.inner.vals).
        let target_path: str = field_path(n.kids[0]);
        if target_path != "" {
            let mut kept: [str] = [];
            let mut j: int = 0;
            while j < len(c.moved_fields) {
                let p: str = c.moved_fields[j];
                if p != target_path && !starts_with(p, target_path + ".") {
                    push(kept, p);
                }
                j = j + 1;
            }
            c.moved_fields = kept;
        }
        return c;
    }
    if n.kind == 14 {
        // If: condition must be bool; moved/pinned state joins
        // across both branches (moved on ANY path counts).
        let cond: COut = check_expr(c, n.kids[0]);
        c = cond.c;
        if cond.typ != "bool" {
            fail_at(n.line, n.col, "if condition must be bool, got " + cond.typ);
        }
        let before: HChecker = checker_snapshot(c);
        let mark: int = len(c.var_names);
        c.branch_depth = c.branch_depth + 1;
        c = check_block(c, n.kids[1]);
        c.branch_depth = c.branch_depth - 1;
        let then_c: HChecker = env_restore(c, mark);
        c = checker_snapshot(before);
        let else_c: HChecker = before;
        if len(n.kids) > 2 {
            let mark2: int = len(c.var_names);
            c.branch_depth = c.branch_depth + 1;
            c = check_block(c, n.kids[2]);
            c.branch_depth = c.branch_depth - 1;
            let e2: HChecker = env_restore(c, mark2);
            let joined: HChecker = join_moved(before, [then_c, e2]);
            return joined;
        }
        return join_moved(before, [then_c, else_c]);
    }
    if n.kind == 15 {
        // While: condition must be bool; the body may run zero
        // times, so moved-on-any-path still counts after it.
        let cond: COut = check_expr(c, n.kids[0]);
        c = cond.c;
        if cond.typ != "bool" {
            fail_at(n.line, n.col, "while condition must be bool, got " + cond.typ);
        }
        // Top-500 #62: labels shadow (choice 3) — an inner loop may
        // reuse an outer label name, innermost wins; no
        // duplicate-label error. The push goes BEFORE the snapshot
        // so the join below keeps the stack intact, and the pop
        // after the join drops it.
        if n.label != "" {
            push(c.label_names, n.label);
        }
        let before: HChecker = checker_snapshot(c);
        let mark: int = len(c.var_names);
        c.loop_depth = c.loop_depth + 1;
        c = check_block(c, n.kids[1]);
        c.loop_depth = c.loop_depth - 1;
        let body_c: HChecker = env_restore(c, mark);
        let mut result: HChecker = join_moved(before, [body_c]);
        if n.label != "" {
            result.label_names = trunc_str(result.label_names, len(result.label_names) - 1);
        }
        return result;
    }
    if n.kind == 16 {
        // For: iterating a pinned array reads its elements without
        // moving the array itself (read-only observation). A
        // readonly view iterates like the array it views.
        c.pinned_observe = c.pinned_observe + 1;
        let r: COut = check_expr(c, n.kids[0]);
        c = r.c;
        c.pinned_observe = c.pinned_observe - 1;
        let mut it_typ: str = r.typ;
        if is_readonly(it_typ) {
            it_typ = readonly_inner(it_typ);
        }
        if it_typ != "range" && !is_array(it_typ) {
            fail_at(n.line, n.col, "for needs a range or array, got " + r.typ);
        }
        // Top-500 #62: labels shadow (choice 3), pushed before the
        // snapshot (same shape as the While branch above).
        if n.label != "" {
            push(c.label_names, n.label);
        }
        let before: HChecker = checker_snapshot(c);
        let mark: int = len(c.var_names);
        let mut vt: str = "int";
        if is_array(it_typ) {
            vt = elem_type(it_typ);
        }
        c = env_declare(c, n.name, vt);
        push(c.loop_vars, n.name);
        c.loop_depth = c.loop_depth + 1;
        // The iterable's buffer is read again on every iteration:
        // record it so a move of it inside the body is rejected
        // (the moved-to binding's scope-end free would leave the
        // next iteration reading freed memory, even if the body
        // reassigns the variable afterwards). The join below
        // starts from `before`, captured before this push, so
        // the entry is gone again after the loop — no pop needed.
        let iter_root: str = access_root(n.kids[0]);
        if iter_root != "" {
            push(c.for_iter_roots, iter_root);
            push(c.for_iter_paths, field_path(n.kids[0]));
            push(c.for_iter_scopes, env_decl_index(c, iter_root));
        }
        c = check_block(c, n.kids[1]);
        c.loop_depth = c.loop_depth - 1;
        let body_c: HChecker = env_restore(c, mark);
        // Pop the loop var (it was declared at `mark`, so the
        // restore already dropped it from var_names; drop it
        // from loop_vars too).
        let mut lv: [str] = [];
        let mut li: int = 0;
        while li < len(c.loop_vars) - 1 {
            push(lv, c.loop_vars[li]);
            li = li + 1;
        }
        c.loop_vars = lv;
        // Top-500 #62: the join result keeps the label the snapshot
        // captured, so pop it here (the loop is out of scope).
        let mut result: HChecker = join_moved(before, [body_c]);
        if n.label != "" {
            result.label_names = trunc_str(result.label_names, len(result.label_names) - 1);
        }
        return result;
    }
    if n.kind == 17 {
        // Return: value must match the enclosing function's type.
        if len(n.kids) == 0 {
            if c.ret_type != "void" {
                fail_at(n.line, n.col, "function must return " + c.ret_type + "; add a return statement of type " + c.ret_type + " at the end of the function");
            }
            return c;
        }
        // A void function cannot return a value at all (Python
        // checker.py:1734).
        if c.ret_type == "void" {
            fail_at(n.line, n.col, "void function cannot return a value; remove the value after 'return'");
        }
        let v: COut = check_expr(c, n.kids[0]);
        c = v.c;
        // Returning an unresolved array from a concretely typed
        // function resolves it to the return type.
        let mut vt: str = v.typ;
        if n.kids[0].kind == 34 {
            let rr: ResOut = try_resolve_empty(c, n.kids[0].name, c.ret_type);
            c = rr.c;
            if rr.ok {
                vt = c.ret_type;
            }
        }
        vt = fill_placeholder(vt, c.ret_type);
        if !accepts(c, vt, c.ret_type) && !sized_literal_ok(c, n.kids[0], c.ret_type) && !literal_fits_fixed(n.kids[0], c.ret_type) {
            let fit_msg: str = literal_fit_msg(n.kids[0], c.ret_type);
            if fit_msg != "" {
                fail_at(n.line, n.col, fit_msg);
            }
            fail_at(n.line, n.col, "return type is " + v.typ + ", function returns " + c.ret_type + cast_hint(v.typ, c.ret_type));
        }
        return c;
    }
    if n.kind == 18 {
        // Top-500 #62: a labeled break must name an enclosing loop.
        if n.label != "" {
            let mut found: bool = false;
            let mut fi: int = 0;
            while fi < len(c.label_names) {
                if c.label_names[fi] == n.label {
                    found = true;
                }
                fi = fi + 1;
            }
            if !found {
                fail_at(n.line, n.col, "break label '" + n.label + "' does not name an enclosing loop");
            }
            return c;
        }
        if c.loop_depth == 0 {
            fail_at(n.line, n.col, "break outside a loop; move it inside a 'while' or 'for' loop");
        }
        return c;
    }
    if n.kind == 19 {
        // Top-500 #62: a labeled continue must name an enclosing loop.
        if n.label != "" {
            let mut found: bool = false;
            let mut fi: int = 0;
            while fi < len(c.label_names) {
                if c.label_names[fi] == n.label {
                    found = true;
                }
                fi = fi + 1;
            }
            if !found {
                fail_at(n.line, n.col, "continue label '" + n.label + "' does not name an enclosing loop");
            }
            return c;
        }
        if c.loop_depth == 0 {
            fail_at(n.line, n.col, "continue outside a loop; move it inside a 'while' or 'for' loop");
        }
        return c;
    }
    if n.kind == 20 {
        // Match on an enum: arms are variants (with optional
        // payload binding); exhaustiveness required unless a
        // trailing wildcard arm is present.
        let et: COut = check_expr(c, n.kids[0]);
        c = et.c;
        if is_union_type(et.typ) {
            // Narrowing a union: arms are member types, each
            // binding the narrowed value; exhaustiveness is over
            // the members, or a trailing wildcard.
            let members: [str] = union_members(et.typ);
            let before: HChecker = checker_snapshot(c);
            let mut seen: [str] = [];
            let mut has_wildcard: bool = false;
            let mut results: [HChecker] = [];
            let mut a: int = 1;
            while a < len(n.kids) {
                let arm: Node = n.kids[a];
                if arm.label == "wildcard" {
                    has_wildcard = true;
                    if a != len(n.kids) - 1 {
                        fail_at(n.line, n.col, "match wildcard '_' must be the last arm");
                    }
                    let mark: int = len(c.var_names);
                    c.branch_depth = c.branch_depth + 1;
                    c = check_block(c, arm.kids[0]);
                    c.branch_depth = c.branch_depth - 1;
                    let ac: HChecker = env_restore(c, mark);
                    push(results, ac);
                    c = checker_snapshot(before);
                    a = a + 1;
                    continue;
                }
                if arm.label != "" {
                    fail_at(n.line, n.col, "'" + arm.name + "' is not a member of union '" + et.typ + "'");
                }
                let mut is_member: bool = false;
                let mut mi: int = 0;
                while mi < len(members) {
                    if members[mi] == arm.name {
                        is_member = true;
                    }
                    mi = mi + 1;
                }
                if !is_member {
                    fail_at(n.line, n.col, "'" + arm.name + "' is not a member of union '" + et.typ + "'");
                }
                let mut dup: bool = false;
                let mut di: int = 0;
                while di < len(seen) {
                    if seen[di] == arm.name {
                        dup = true;
                    }
                    di = di + 1;
                }
                if dup {
                    fail_at(n.line, n.col, "duplicate match arm '" + arm.name + "'");
                }
                push(seen, arm.name);
                if arm.sval == "" {
                    fail_at(n.line, n.col, "member '" + arm.name + "' has a value; write " + arm.name + "(name) => ...");
                }
                let mark: int = len(c.var_names);
                c = env_declare(c, arm.sval, arm.name);
                c.branch_depth = c.branch_depth + 1;
                c = check_block(c, arm.kids[0]);
                c.branch_depth = c.branch_depth - 1;
                let ac: HChecker = env_restore(c, mark);
                push(results, ac);
                c = checker_snapshot(before);
                a = a + 1;
            }
            if !has_wildcard {
                let mut missing: bool = false;
                let mut mi: int = 0;
                while mi < len(members) {
                    let mut found: bool = false;
                    let mut si: int = 0;
                    while si < len(seen) {
                        if seen[si] == members[mi] {
                            found = true;
                        }
                        si = si + 1;
                    }
                    if !found {
                        missing = true;
                    }
                    mi = mi + 1;
                }
                if missing {
                    fail_at(n.line, n.col, "match is not exhaustive");
                }
            }
            return join_moved(before, results);
        }
        // Top-500 #69: value patterns — int/bool/str literals and
        // struct patterns. First-match-wins; `_` is required for
        // int/str/struct (no finite missing list), and for bool
        // unless both literals appear. Value matches skip the #50
        // ES verdict entirely (no pending-match record; the
        // verdict walk only fires for enum scrutinees).
        let base0: str = generic_base(et.typ);
        if et.typ == "int" || et.typ == "bool" || et.typ == "str" || is_struct_type(c, et.typ) {
            let before: HChecker = checker_snapshot(c);
            let mut seen: [str] = [];
            let mut has_wildcard: bool = false;
            let mut results: [HChecker] = [];
            let mut a: int = 1;
            while a < len(n.kids) {
                let arm: Node = n.kids[a];
                if arm.label == "wildcard" {
                    has_wildcard = true;
                    if a != len(n.kids) - 1 {
                        fail_at(n.line, n.col, "match wildcard '_' must be the last arm");
                    }
                    let mark: int = len(c.var_names);
                    c.branch_depth = c.branch_depth + 1;
                    c = check_block(c, arm.kids[0]);
                    c.branch_depth = c.branch_depth - 1;
                    let ac: HChecker = env_restore(c, mark);
                    push(results, ac);
                    c = checker_snapshot(before);
                    a = a + 1;
                    continue;
                }
                let key: str = value_pattern_key(c, arm, et.typ);
                let mut dup: bool = false;
                let mut di: int = 0;
                while di < len(seen) {
                    if seen[di] == key {
                        dup = true;
                    }
                    di = di + 1;
                }
                if dup {
                    fail_at(n.line, n.col, "duplicate match arm '" + arm_pat_text(arm) + "'");
                }
                push(seen, key);
                let mark: int = len(c.var_names);
                if arm.label == "struct" {
                    // Field bindings in scope for the arm body,
                    // with the fields' (substituted) types.
                    let mut fi: int = 1;
                    while fi < len(arm.kids) {
                        let fp: Node = arm.kids[fi];
                        if fp.label == "binding" {
                            let ft0: str = struct_field_type(c, base0, fp.name, arm.line, arm.col);
                            let mut ft: str = ft0;
                            let tps: str = struct_tparams(c, base0);
                            if tps != "" {
                                let args: [str] = generic_args(et.typ);
                                let tnames: [str] = split(tps, "~");
                                ft = substitute_type(ft0, tnames, args);
                            }
                            c = env_declare(c, fp.sval, ft);
                        }
                        fi = fi + 1;
                    }
                }
                c.branch_depth = c.branch_depth + 1;
                c = check_block(c, arm.kids[0]);
                c.branch_depth = c.branch_depth - 1;
                let ac: HChecker = env_restore(c, mark);
                push(results, ac);
                c = checker_snapshot(before);
                a = a + 1;
            }
            if !has_wildcard {
                if et.typ != "bool" || !value_seen_both_bool(seen) {
                    fail_at(n.line, n.col, "match on " + et.typ + " is not exhaustive; a '_' arm is required");
                }
            }
            return join_moved(before, results);
        }
        let base: str = generic_base(et.typ);
        if !is_enum(c, base) {
            fail_at(n.line, n.col, "match needs an enum, union, int, bool, str, or struct value, got " + et.typ);
        }
        // Top-500 #50: the exhaustiveness verdict moved to
        // the second pass (es_infer's verdict walk), where
        // the inferred error set narrows it. Phase 1 still
        // checks the arm names, payloads, duplicates, and
        // the wildcard-last rule; it no longer verdicts.
        let before: HChecker = checker_snapshot(c);
        let mut seen: [str] = [];
        let mut has_wildcard: bool = false;
        let mut results: [HChecker] = [];
        let mut a: int = 1;
        while a < len(n.kids) {
            let arm: Node = n.kids[a];
            if arm.label == "wildcard" {
                has_wildcard = true;
                if a != len(n.kids) - 1 {
                    fail_at(n.line, n.col, "match wildcard '_' must be the last arm");
                }
                let mark: int = len(c.var_names);
                c.branch_depth = c.branch_depth + 1;
                c = check_block(c, arm.kids[0]);
                c.branch_depth = c.branch_depth - 1;
                let ac: HChecker = env_restore(c, mark);
                push(results, ac);
                c = checker_snapshot(before);
                a = a + 1;
                continue;
            }
            if arm.label != "" || !enum_has_variant(c, base, arm.name) {
                fail_at(n.line, n.col, "'" + arm_pat_text(arm) + "' is not a variant of enum '" + base + "'");
            }
            let mut dup: bool = false;
            let mut di: int = 0;
            while di < len(seen) {
                if seen[di] == arm.name {
                    dup = true;
                }
                di = di + 1;
            }
            if dup {
                fail_at(n.line, n.col, "duplicate match arm '" + arm.name + "'");
            }
            push(seen, arm.name);
            let payload: str = enum_payload(c, base, arm.name, n.line, n.col);
            if payload == "" && arm.sval != "" {
                fail_at(n.line, n.col, "variant '" + arm.name + "' has no payload to bind");
            }
            if payload != "" && arm.sval == "" {
                fail_at(n.line, n.col, "variant '" + arm.name + "' has a payload; write " + arm.name + "(name) => ...");
            }
            let mark: int = len(c.var_names);
            if arm.sval != "" {
                // Substitute the scrutinee's concrete type args
                // into the payload (generic enums): the binding
                // of Some(v) over OptionE<int> is int, not T.
                let mut bpt: str = payload;
                let gargs: [str] = generic_args(et.typ);
                let etps: str = enum_tparams(c, base);
                if len(gargs) > 0 && etps != "" {
                    let enames: [str] = split(etps, "~");
                    if len(enames) == len(gargs) {
                        bpt = substitute_type(payload, enames, gargs);
                    }
                }
                c = env_declare(c, arm.sval, bpt);
            }
            c.branch_depth = c.branch_depth + 1;
            c = check_block(c, arm.kids[0]);
            c.branch_depth = c.branch_depth - 1;
            let ac: HChecker = env_restore(c, mark);
            push(results, ac);
            c = checker_snapshot(before);
            a = a + 1;
        }
        return join_moved(before, results);
    }
    if n.kind == 21 {
        if c.freestanding {
            fail_at(n.line, n.col, "spawn needs the hosted thread runtime (not in freestanding v1)");
        }
        // Spawn: the function must exist, return void, and take
        // 0 or 1 int arguments.
        let call: Node = n.kids[0];
        let sig: str = func_sig(c, call.name);
        if sig == "" {
            fail_at(n.line, n.col, "spawn: undefined function '" + call.name + "'");
        }
        let mut ai: int = -1;
        let mut i: int = 0;
        while i + 1 < len(sig) {
            if substr(sig, i, 1) == "=" && substr(sig, i + 1, 1) == ">" {
                ai = i;
            }
            i = i + 1;
        }
        let ret: str = substr(sig, ai + 2, len(sig) - ai - 2);
        if ret != "void" {
            fail_at(n.line, n.col, "spawn: function must return void");
        }
        if len(call.kids) > 1 {
            fail_at(n.line, n.col, "spawn: function must take 0 or 1 int argument");
        }
        if len(call.kids) == 1 {
            let a: COut = check_expr(c, call.kids[0]);
            c = a.c;
            if a.typ != "int" {
                fail_at(n.line, n.col, "spawn: argument must be int");
            }
        }
        return c;
    }
    if n.kind == 22 {
        if c.freestanding {
            fail_at(n.line, n.col, "scope needs the hosted thread runtime (not in freestanding v1)");
        }
        // Scope: the block's lets are scoped to it.
        let mark: int = len(c.var_names);
        c = check_block(c, n.kids[0]);
        return env_restore(c, mark);
    }
    if n.kind == 23 {
        // Defer: the deferred call is checked like an expression
        // statement; its value (if any) is discarded at exit.
        let call: Node = n.kids[0];
        if call.kind != 35 && call.kind != 33 {
            fail_at(n.line, n.col, "defer needs a call");
        }
        let e: COut = check_expr(c, call);
        return e.c;
    }
    if n.kind == 24 {
        // ExprStmt: a statement builtin (pin/assert/print/fail/
        // fail_compile/eprintln) goes to check_stmt_builtin;
        // anything else is checked as an expression and its value
        // discarded.
        let e0: Node = n.kids[0];
        if e0.kind == 35 && (e0.name == "pin" || e0.name == "assert" || e0.name == "print" || e0.name == "println" || e0.name == "fail" || e0.name == "fail_compile" || e0.name == "eprintln" || e0.name == "push" || e0.name == "poke32" || e0.name == "mmap_set" || e0.name == "mmap_close" || e0.name == "mmap_set32" || e0.name == "csr_write" || e0.name == "csr_set" || e0.name == "csr_clear") {
            return check_stmt_builtin(c, e0);
        }
        // An expression builtin used as a statement is an error
        // (Python: "'run_command' is an expression, not a
        // statement; use its value").
        if e0.kind == 35 && is_expr_builtin(e0.name) {
            fail_at(n.line, n.col, "'" + e0.name + "' is an expression, not a statement; use its value");
        }
        // Top-500 #72: a walrus as a bare statement is a named
        // error (Python: "walrus cannot be used as a bare
        // statement in v1 (use 'let mut <name> = ...;' instead)"
        // — the literal text `<name>`, not the variable name).
        // The hosted ExprStmt handler otherwise accepts any
        // expression as a statement, so this needs its own
        // check — without it the kind-51 guard below would
        // fire with the (wrong) position error.
        if e0.kind == 51 {
            fail_at(n.line, n.col, "walrus cannot be used as a bare statement in v1 (use 'let mut <name> = ...;' instead)");
        }
        let e: COut = check_expr(c, e0);
        return e.c;
    }
    fail_at(n.line, n.col, "unsupported statement kind " + node_kind_name(n.kind));
    return c;
}

fn check_block(c0: HChecker, n: Node) -> HChecker {
    let mut c: HChecker = c0;
    // Top-500 #494: scope mark for same-scope rebind detection
    // (the Let handler reads the top mark; balanced here, so
    // branch snapshots never need to copy it).
    push(c.scope_marks, len(c.var_names));
    let mut i: int = 0;
    while i < len(n.kids) {
        c = check_stmt(c, n.kids[i]);
        i = i + 1;
    }
    c.scope_marks = trunc_int(c.scope_marks, len(c.scope_marks) - 1);
    return c;
}

// Return type of a function ("never", "int", ...), or "" if unknown.
fn func_ret(c: HChecker, name: str) -> str {
    let sig: str = func_sig(c, name);
    if sig == "" {
        return "";
    }
    let parts: [str] = split(sig, "=>");
    if len(parts) != 2 {
        return "";
    }
    return parts[1];
}

// True when a return statement appears anywhere under node
// (including nested blocks and branches).
fn node_has_return(n: Node) -> bool {
    if n.kind == 17 {
        return true;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if node_has_return(n.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// True when evaluating e necessarily diverges: it contains a
// fail call or a call to a never function. Only the expression
// itself is walked, never nested statement bodies (those are
// conditional).
fn expr_diverges(c: HChecker, e: Node) -> bool {
    if e.kind == 35 {
        if e.name == "fail" || e.name == "fail_compile" {
            return true;
        }
        if func_ret(c, e.name) == "never" {
            return true;
        }
    }
    let mut i: int = 0;
    while i < len(e.kids) {
        if expr_diverges(c, e.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// True when a top-level statement necessarily diverges.
// Blocks and scopes recurse (they run unconditionally);
// if/while/for/match count only through their conditions
// and scrutinees (evaluated unconditionally), never their
// bodies (control can skip those). Returns are not
// divergers here: they are exits, handled by the return
// rule, and are rejected outright inside never functions.
fn stmt_diverges(c: HChecker, s: Node) -> bool {
    if s.kind == 9 {
        let mut i: int = 0;
        while i < len(s.kids) {
            if stmt_diverges(c, s.kids[i]) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if s.kind == 22 {
        if len(s.kids) > 0 {
            return stmt_diverges(c, s.kids[0]);
        }
        return false;
    }
    if s.kind == 14 || s.kind == 15 || s.kind == 16 || s.kind == 20 {
        if len(s.kids) > 0 {
            return expr_diverges(c, s.kids[0]);
        }
        return false;
    }
    if s.kind == 17 {
        return false;
    }
    let mut i: int = 0;
    while i < len(s.kids) {
        if expr_diverges(c, s.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// True when a function body cannot fall off its end: some
// top-level statement necessarily diverges.
fn body_diverges(c: HChecker, body: Node) -> bool {
    let mut i: int = 0;
    while i < len(body.kids) {
        if stmt_diverges(c, body.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn check_lambda(c0: HChecker, n: Node) -> COut {
    // Lambda expression (Top-500 #101, CL-C1). Node kind 47:
    // kids are Param nodes (kind 43, name + sval) then the body
    // Block; sval is the return type ("void" when `-> R` is
    // omitted). Params must be annotated, like fn declarations.
    // The body is checked in a fresh function context (loop depth
    // reset — a `break` inside a lambda must not break the
    // enclosing loop), starting from a COPY of the enclosing
    // move/pin state (a variable moved before the lambda was
    // created stays unusable inside it; a move inside the lambda
    // moves only the lambda's own copy). Captures are collected
    // by the Var branch (CL-C2) into the frame pushed here. The
    // checker cannot stamp the node (nodes are values), so the
    // captures live only in the frame — for the CL-C3 assign
    // check — and the infer pass re-derives them for codegen.
    let mut c: HChecker = c0;
    let ret: str = n.sval;
    if c.freestanding {
        fail_at(n.line, n.col, "lambda expressions need the heap allocator (not in freestanding v1; use a named function instead)");
    }
    let mut params: [str] = [];
    let mut pnames: [str] = [];
    let mut i: int = 0;
    while i < len(n.kids) - 1 {
        let k: Node = n.kids[i];
        if is_c_keyword(k.name) {
            fail_at(n.line, n.col, "'" + k.name + "' is a C keyword and cannot be used as a parameter name; rename it");
        }
        if str_in_arr(k.name, pnames) {
            fail_at(n.line, n.col, "duplicate parameter '" + k.name + "' in lambda");
        }
        if !hc_valid_type(c, k.sval, []) || k.sval == "void" {
            fail_at(n.line, n.col, "lambda parameter type '" + k.sval + "' is not a value type");
        }
        push(pnames, k.name);
        push(params, k.sval);
        i = i + 1;
    }
    if ret != "void" && !hc_valid_type(c, ret, []) {
        fail_at(n.line, n.col, "unknown lambda return type '" + ret + "'");
    }
    let body: Node = n.kids[len(n.kids) - 1];
    // Save enclosing state; the lambda starts from copies that
    // are discarded after (see checker_snapshot's note: plain
    // assignment shares the arrays, so snapshot deep-copies).
    let saved: HChecker = checker_snapshot(c);
    let mark: int = len(c.var_names);
    c = lam_push(c, mark);
    let mut pi: int = 0;
    while pi < len(pnames) {
        c = env_declare(c, pnames[pi], params[pi]);
        pi = pi + 1;
    }
    c.ret_type = ret;
    c.current_fn = "";
    c.loop_depth = 0;
    c.branch_depth = 0;
    c.loop_vars = trunc_str(c.loop_vars, 0);
    // Top-500 #62: a lambda is a fresh function scope — the outer
    // function's labels are invisible inside it.
    c.label_names = trunc_str(c.label_names, 0);
    c.for_iter_roots = trunc_str(c.for_iter_roots, 0);
    c.for_iter_paths = trunc_str(c.for_iter_paths, 0);
    c.for_iter_scopes = trunc_int(c.for_iter_scopes, 0);
    c.unres_names = trunc_str(c.unres_names, 0);
    c.unres_lines = trunc_int(c.unres_lines, 0);
    c.unres_cols = trunc_int(c.unres_cols, 0);
    c.moved_fields = trunc_str(c.moved_fields, 0);
    c.moved_field_target = "";
    c.pinned_base_depth = 0;
    c.pinned_observe = 0;
    c.field_base_depth = 0;
    c.pinned_write_root = "";
    c = check_block(c, body);
    if len(c.unres_names) > 0 {
        // An empty array literal no use in this lambda
        // constrained: inference found no element type.
        fail_at(c.unres_lines[0], c.unres_cols[0], "cannot infer the element type of an empty array literal; add an annotation, e.g. let x: [int] = []");
    }
    // Return rules, like check_func.
    if ret == "never" {
        if node_has_return(body) {
            fail_at(n.line, n.col, "never lambda cannot return; its body must diverge instead");
        }
        if !body_diverges(c, body) {
            fail_at(n.line, n.col, "never lambda must end with a diverging statement (fail or a call to a never function); its body can fall off the end");
        }
    } else if ret != "void" {
        let mut ends_return: bool = false;
        if len(body.kids) > 0 && body.kids[len(body.kids) - 1].kind == 17 {
            ends_return = true;
        }
        if !ends_return && !body_diverges(c, body) {
            fail_at(n.line, n.col, "lambda returns " + ret + " but its body does not end with a return; add a return statement of type " + ret + " at the end of the lambda");
        }
    }
    // The lambda's own declarations (params + body lets) leave
    // scope; the enclosing moved/pinned/unres/loop state is
    // restored from the snapshot (a move inside the lambda moves
    // only the lambda's own copy).
    c = env_restore(c, mark);
    c = lam_pop(c);
    c.var_moved = copy_bool(saved.var_moved);
    c.var_pinned = copy_bool(saved.var_pinned);
    c.moved_fields = copy_str(saved.moved_fields);
    c.unres_names = copy_str(saved.unres_names);
    c.unres_lines = copy_int(saved.unres_lines);
    c.unres_cols = copy_int(saved.unres_cols);
    c.for_iter_roots = copy_str(saved.for_iter_roots);
    c.for_iter_paths = copy_str(saved.for_iter_paths);
    c.for_iter_scopes = copy_int(saved.for_iter_scopes);
    c.loop_vars = copy_str(saved.loop_vars);
    c.label_names = copy_str(saved.label_names);
    c.ret_type = saved.ret_type;
    c.current_fn = saved.current_fn;
    c.loop_depth = saved.loop_depth;
    c.branch_depth = saved.branch_depth;
    c.moved_field_target = saved.moved_field_target;
    c.pinned_base_depth = saved.pinned_base_depth;
    c.pinned_observe = saved.pinned_observe;
    c.field_base_depth = saved.field_base_depth;
    c.pinned_write_root = saved.pinned_write_root;
    // Fn type string: fn(p1, p2) -> ret.
    let mut ft: str = "fn(";
    let mut j: int = 0;
    while j < len(params) {
        if j > 0 {
            ft = ft + ", ";
        }
        ft = ft + params[j];
        j = j + 1;
    }
    ft = ft + ") -> " + ret;
    return COut { c: c, typ: ft };
}

fn check_func(c0: HChecker, fn_node: Node, file: str) -> HChecker {
    let mut c: HChecker = c0;
    // Top-500 #48: the file this function was defined in, for
    // try_call's module boundary (passed in by check_program,
    // which knows the exact name — plain fn or Struct__method).
    c.current_file = file;
    // Generic template: the body is checked only on instantiation,
    // when every type parameter is concrete.
    let sp: [str] = split_tparams(fn_node.name);
    // Top-500 #60: the function being checked (fail()/assert()
    // inside crash_handler() is rejected by the stmt-builtin
    // branches below; a lambda clears it, like Python's
    // current_fn = None).
    c.current_fn = sp[0];
    // Parameter and return types must name real value types
    // (Python check_func): validated even for externs and
    // generic templates, against the function's own type params.
    let mut ftp: [str] = [];
    if sp[1] != "" {
        ftp = split(sp[1], "~");
    }
    let mut pi: int = 0;
    while pi < len(fn_node.kids) {
        let k: Node = fn_node.kids[pi];
        if k.kind == 43 {
            if !hc_valid_type(c, k.sval, ftp) || k.sval == "void" {
                fail_at(fn_node.line, fn_node.col, "parameter type '" + k.sval + "' is not a value type");
            }
        }
        pi = pi + 1;
    }
    if fn_node.sval != "void" && !hc_valid_type(c, fn_node.sval, ftp) {
        fail_at(fn_node.line, fn_node.col, "unknown return type '" + fn_node.sval + "'" + suggest(fn_node.sval, type_name_cands(c)));
    }
    if sp[0] == "crash_handler" {
        // Top-500 #60 (stage B): the freestanding crash hook. A
        // top-level fn with this name IS the hook, so its shape
        // is enforced here, in both compilers: exactly
        // (code: int, pc: int) -> void, not generic, not extern,
        // freestanding only.
        if sp[1] != "" {
            fail_at(fn_node.line, fn_node.col, "crash_handler() cannot be generic (the hook signature is (int, int) -> void)");
        }
        if fn_node.bval {
            fail_at(fn_node.line, fn_node.col, "crash_handler() must be defined in Qasida (an extern declaration is not a hook)");
        }
        if !c.freestanding {
            fail_at(fn_node.line, fn_node.col, "crash_handler() is a freestanding-only hook (not in hosted mode)");
        }
        let mut np: int = 0;
        let mut p0: str = "";
        let mut p1: str = "";
        let mut pi2: int = 0;
        while pi2 < len(fn_node.kids) {
            let k2: Node = fn_node.kids[pi2];
            if k2.kind == 43 {
                if np == 0 {
                    p0 = k2.sval;
                }
                if np == 1 {
                    p1 = k2.sval;
                }
                np = np + 1;
            }
            pi2 = pi2 + 1;
        }
        if np != 2 || p0 != "int" || p1 != "int" || fn_node.sval != "void" {
            fail_at(fn_node.line, fn_node.col, "crash_handler() must take exactly (code: int, pc: int) and return nothing");
        }
    }
    if sp[1] != "" {
        return c;
    }
    // kids are Param nodes then the body Block (last kid).
    let mut body: Node = fn_node.kids[len(fn_node.kids) - 1];
    let mut i: int = 0;
    while i < len(fn_node.kids) {
        let k: Node = fn_node.kids[i];
        if k.kind == 43 {
            if is_c_keyword(k.name) {
                fail_at(fn_node.line, fn_node.col, "'" + k.name + "' is a C keyword and cannot be used as a parameter name; rename it");
            }
            c = env_declare(c, k.name, k.sval);
        }
        i = i + 1;
    }
    // Extern declarations have no body to check; in
    // freestanding mode they need link-time C symbols.
    // (mark is taken here so the extern early-return below can
    // restore the parameters it just declared.)
    let mark: int = len(c.var_names);
    if fn_node.bval && c.freestanding {
        let sp: [str] = split_tparams(fn_node.name);
        fail_at(fn_node.line, fn_node.col, "extern fn '" + sp[0] + "' needs link-time C symbols (not in freestanding v1)");
    }
    if fn_node.bval {
        // No body to check (Python check_func returns here too);
        // without this the noreturn rule below would read the
        // last Param node as the body and reject every extern
        // that returns a value (ffi_demo's puts/system).
        c = env_restore(c, mark);
        c.ret_type = "void";
        return c;
    }
    c.ret_type = fn_node.sval;
    // Fresh per-function state.
    c.moved_fields = trunc_str(c.moved_fields, 0);
    c.moved_field_target = "";
    c.unres_names = trunc_str(c.unres_names, 0);
    c.unres_lines = trunc_int(c.unres_lines, 0);
    c.unres_cols = trunc_int(c.unres_cols, 0);
    c.for_iter_roots = trunc_str(c.for_iter_roots, 0);
    c.for_iter_paths = trunc_str(c.for_iter_paths, 0);
    c.for_iter_scopes = trunc_int(c.for_iter_scopes, 0);
    c.loop_depth = 0;
    c.branch_depth = 0;
    c.loop_vars = trunc_str(c.loop_vars, 0);
    // Top-500 #62: labels are function-scoped, like loop_depth.
    c.label_names = trunc_str(c.label_names, 0);
    c.lam_boundaries = trunc_int(c.lam_boundaries, 0);
    c.lam_caps = trunc_str(c.lam_caps, 0);
    c = check_block(c, body);
    if len(c.unres_names) > 0 {
        // An empty array literal no use in this function
        // constrained: inference found no element type.
        fail_at(c.unres_lines[0], c.unres_cols[0], "cannot infer the element type of an empty array literal; add an annotation, e.g. let x: [int] = []");
    }
    // Return rules (Python checker.py:1090): a never function
    // must diverge and must not return; any other non-void
    // function must end with a return (or diverge).
    let ret: str = fn_node.sval;
    if ret == "never" {
        if node_has_return(body) {
            fail_at(fn_node.line, fn_node.col, "never function '" + sp[0] + "' cannot return; its body must diverge instead");
        }
        if !body_diverges(c, body) {
            fail_at(fn_node.line, fn_node.col, "never function '" + sp[0] + "' must end with a diverging statement (fail or a call to a never function); its body can fall off the end");
        }
    } else if ret != "void" {
        let mut ends_return: bool = false;
        if len(body.kids) > 0 && body.kids[len(body.kids) - 1].kind == 17 {
            ends_return = true;
        }
        if !ends_return && !body_diverges(c, body) {
            fail_at(fn_node.line, fn_node.col, "function '" + sp[0] + "' returns " + ret + " but its body does not end with a return; add a return statement of type " + ret + " at the end of the function");
        }
    }
    c = env_restore(c, mark);
    c.ret_type = "void";
    return c;
}

// ---------- type aliases ----------
// Aliases are transparent shorthands: `type UserId = int` means
// UserId IS int everywhere (Python checker.py:434-600). The hosted
// checker cannot rewrite the AST in place (nodes are values), so
// expansion is a tree-rebuilding pass: expand_aliases_prog builds
// the alias table (validating duplicates, collisions, cycles and
// unknown targets with Python's exact messages), then rebuilds the
// program with every type spelling expanded. check_program,
// run_infer and codegen_program each expand their own copy at
// entry (deterministic, so all three see the same program); with
// no aliases in the program the original node is returned
// untouched, so the bootstrap emit stays byte-identical.

fn alias_lookup_idx(names: [str], t: str) -> int {
    let mut i: int = 0;
    while i < len(names) {
        if names[i] == t {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Membership in a "~"-joined list.
fn str_in_split(joined: str, name: str) -> bool {
    if joined == "" {
        return false;
    }
    let parts: [str] = split(joined, "~");
    let mut i: int = 0;
    while i < len(parts) {
        if parts[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// A built-in scalar name (Python checker.py SCALARS).
fn alias_is_scalar(t: str) -> bool {
    return t == "int" || t == "float" || t == "bool" || t == "str" || t == "range" || t == "i8" || t == "i16" || t == "i32" || t == "u8" || t == "u16" || t == "u32" || t == "u64" || t == "never";
}

// Resolve one alias target through the chain (Python's
// _resolve_alias): aliases recurse, arrays recurse on the
// element, generics recurse on the args; a cycle, or an alias
// used with type arguments, is an error at the alias site.
fn alias_resolve_target(names: [str], raw: [str], target: str, seen: str, line: int, col: int) -> str {
    let idx: int = alias_lookup_idx(names, target);
    if idx >= 0 {
        if str_in_split(seen, target) {
            fail_at(line, col, "cyclic type alias involving '" + target + "'");
        }
        return alias_resolve_target(names, raw, raw[idx], seen + "~" + target, line, col);
    }
    if starts_with(target, "[") && substr(target, len(target) - 1, 1) == "]" {
        return "[" + alias_resolve_target(names, raw, substr(target, 1, len(target) - 2), seen, line, col) + "]";
    }
    let lt: int = find_lt(target);
    if lt >= 0 && substr(target, len(target) - 1, 1) == ">" {
        let base: str = substr(target, 0, lt);
        if alias_lookup_idx(names, base) >= 0 {
            fail_at(line, col, "type alias '" + base + "' takes no type arguments");
        }
        let args: [str] = generic_args(target);
        let mut out: str = base + "<";
        let mut i: int = 0;
        while i < len(args) {
            if i > 0 {
                out = out + ", ";
            }
            out = out + alias_resolve_target(names, raw, args[i], seen, line, col);
            i = i + 1;
        }
        return out + ">";
    }
    return target;
}

// Whether a resolved alias target names a real type (Python's
// valid_type, without the current-type-params case: aliases are
// never generic in v1).
fn alias_valid_type(t: str, snames: [str], enames: [str], ntnames: [str]) -> bool {
    if alias_is_scalar(t) {
        return true;
    }
    if str_in_arr(t, snames) || str_in_arr(t, enames) || str_in_arr(t, ntnames) {
        return true;
    }
    if is_tuple(t) {
        let elems: [str] = tuple_elems(t);
        let mut i: int = 0;
        while i < len(elems) {
            if !alias_valid_type(elems[i], snames, enames, ntnames) {
                return false;
            }
            i = i + 1;
        }
        return len(elems) > 0;
    }
    if is_readonly(t) {
        return alias_valid_type(readonly_inner(t), snames, enames, ntnames);
    }
    if is_union_type(t) {
        let members: [str] = union_members(t);
        let mut i: int = 0;
        while i < len(members) {
            if !alias_valid_type(members[i], snames, enames, ntnames) {
                return false;
            }
            i = i + 1;
        }
        return len(members) >= 2;
    }
    if is_sized_array(t) {
        let inner: str = substr(t, 1, len(t) - 2);
        let semi: int = find_top(inner, ";");
        return alias_valid_type(trim_spaces(substr(inner, 0, semi)), snames, enames, ntnames);
    }
    if starts_with(t, "[") && substr(t, len(t) - 1, 1) == "]" {
        return alias_valid_type(substr(t, 1, len(t) - 2), snames, enames, ntnames);
    }
    let lt: int = find_lt(t);
    if lt >= 0 && substr(t, len(t) - 1, 1) == ">" {
        let base: str = substr(t, 0, lt);
        if !str_in_arr(base, snames) && !str_in_arr(base, enames) {
            return false;
        }
        let args: [str] = generic_args(t);
        let mut i: int = 0;
        while i < len(args) {
            if !alias_valid_type(args[i], snames, enames, ntnames) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    return false;
}

// Expand one type spelling through the alias table (Python's
// expand_aliases expand(): exact alias, tuple, sized array
// (element only — the batch-12 gap), dynamic array, generic.
fn alias_expand_type(names: [str], targets: [str], t: str, line: int, col: int) -> str {
    let idx: int = alias_lookup_idx(names, t);
    if idx >= 0 {
        return targets[idx];
    }
    if is_tuple(t) {
        let elems: [str] = tuple_elems(t);
        let mut out: str = "(";
        let mut i: int = 0;
        while i < len(elems) {
            if i > 0 {
                out = out + ", ";
            }
            out = out + alias_expand_type(names, targets, elems[i], line, col);
            i = i + 1;
        }
        return out + ")";
    }
    if is_sized_array(t) {
        let inner: str = substr(t, 1, len(t) - 2);
        let semi: int = find_top(inner, ";");
        let elem: str = trim_spaces(substr(inner, 0, semi));
        return "[" + alias_expand_type(names, targets, elem, line, col) + "; " + itoa(sized_len(t)) + "]";
    }
    if starts_with(t, "[") && substr(t, len(t) - 1, 1) == "]" {
        return "[" + alias_expand_type(names, targets, substr(t, 1, len(t) - 2), line, col) + "]";
    }
    let lt: int = find_lt(t);
    if lt >= 0 && substr(t, len(t) - 1, 1) == ">" {
        let base: str = substr(t, 0, lt);
        if alias_lookup_idx(names, base) >= 0 {
            fail_at(line, col, "type alias '" + base + "' takes no type arguments");
        }
        let args: [str] = generic_args(t);
        let mut out: str = base + "<";
        let mut i: int = 0;
        while i < len(args) {
            if i > 0 {
                out = out + ", ";
            }
            out = out + alias_expand_type(names, targets, args[i], line, col);
            i = i + 1;
        }
        return out + ">";
    }
    return t;
}

// Rebuild one node with every type spelling expanded. Type
// spellings live in: FuncDef ret (sval) + Param types (kind 43),
// StructDef/EnumDef field + payload types (kind 44), NewtypeDef
// target, Let annotation, Cast target, StructLit name (only when
// the alias target is a bare struct name). AliasDefs themselves
// are left as written (the table already holds their resolved
// targets); everything else recurses into kids.
fn expand_alias_node(n: Node, names: [str], targets: [str]) -> Node {
    let mut kids: [Node] = [];
    let mut i: int = 0;
    while i < len(n.kids) {
        push(kids, expand_alias_node(n.kids[i], names, targets));
        i = i + 1;
    }
    let mut out: Node = n;
    out.kids = kids;
    if n.kind == 2 || n.kind == 43 || n.kind == 44 {
        if n.sval != "" {
            out.sval = alias_expand_type(names, targets, n.sval, n.line, n.col);
        }
    }
    if n.kind == 8 || n.kind == 39 {
        out.sval = alias_expand_type(names, targets, n.sval, n.line, n.col);
    }
    if n.kind == 10 {
        if n.sval != "" {
            out.sval = alias_expand_type(names, targets, n.sval, n.line, n.col);
        }
    }
    if n.kind == 31 {
        let idx: int = alias_lookup_idx(names, n.name);
        if idx >= 0 {
            let t: str = targets[idx];
            if find_top(t, "<") < 0 && find_top(t, "[") < 0 {
                out.name = t;
            }
        }
    }
    return out;
}

// Build the alias table from a program's AliasDefs (validating
// with Python's messages) and return the program with every type
// spelling expanded; the program is returned unchanged when it
// declares no aliases.
fn expand_aliases_prog(prog: Node) -> Node {
    let mut names: [str] = [];
    let mut raw: [str] = [];
    let mut lines: [int] = [];
    let mut cols: [int] = [];
    let mut i: int = 0;
    while i < len(prog.kids) {
        let d: Node = prog.kids[i];
        if d.kind == 7 {
            if alias_lookup_idx(names, d.name) >= 0 {
                fail_at(d.line, d.col, "duplicate type alias '" + d.name + "'");
            }
            push(names, d.name);
            push(raw, d.sval);
            push(lines, d.line);
            push(cols, d.col);
        }
        i = i + 1;
    }
    if len(names) == 0 {
        return prog;
    }
    // Struct/enum/newtype names, and which structs/enums are generic.
    let mut snames: [str] = [];
    let mut enames: [str] = [];
    let mut ntnames: [str] = [];
    let mut gnames: [str] = [];
    let mut gkinds: [str] = [];
    let mut j: int = 0;
    while j < len(prog.kids) {
        let d: Node = prog.kids[j];
        if d.kind == 3 {
            let sp: [str] = split_tparams(d.name);
            push(snames, sp[0]);
            if sp[1] != "" {
                push(gnames, sp[0]);
                push(gkinds, "struct");
            }
        }
        if d.kind == 4 {
            let sp: [str] = split_tparams(d.name);
            push(enames, sp[0]);
            if sp[1] != "" {
                push(gnames, sp[0]);
                push(gkinds, "enum");
            }
        }
        if d.kind == 8 {
            push(ntnames, d.name);
        }
        j = j + 1;
    }
    // Collisions and bare-generic targets, for every alias, before
    // resolving any of them.
    let mut k: int = 0;
    while k < len(names) {
        if alias_is_scalar(names[k]) {
            fail_at(lines[k], cols[k], "type alias '" + names[k] + "' collides with the built-in type '" + names[k] + "'");
        }
        if str_in_arr(names[k], snames) || str_in_arr(names[k], enames) {
            fail_at(lines[k], cols[k], "type alias '" + names[k] + "' collides with an existing type of the same name");
        }
        let gi: int = alias_lookup_idx(gnames, raw[k]);
        if gi >= 0 {
            fail_at(lines[k], cols[k], "type alias '" + names[k] + "' cannot target generic " + gkinds[gi] + " '" + raw[k] + "' without type arguments; write " + raw[k] + "<...>");
        }
        k = k + 1;
    }
    // Resolve the chains.
    let mut targets: [str] = [];
    let mut m: int = 0;
    while m < len(names) {
        push(targets, alias_resolve_target(names, raw, raw[m], names[m], lines[m], cols[m]));
        m = m + 1;
    }
    // Every resolved target must name a real type.
    let mut v: int = 0;
    while v < len(names) {
        if !alias_valid_type(targets[v], snames, enames, ntnames) {
            fail_at(lines[v], cols[v], "type alias '" + names[v] + "' targets unknown type '" + targets[v] + "'");
        }
        v = v + 1;
    }
    return expand_alias_node(prog, names, targets);
}

// Opaque type spellings: 'opaque Trait' (a trait name with no
// spaces, unions, generics or arrays after it). Defined here
// (not via infer) because the check-test driver compiles
// check.fg without infer.fg.
fn is_opaque_type(t: str) -> bool {
    if !starts_with(t, "opaque ") || len(t) <= 7 {
        return false;
    }
    let rest: str = substr(t, 7, len(t) - 7);
    if len(split(rest, " ")) > 1 || len(split(rest, "|")) > 1 || len(split(rest, "<")) > 1 || len(split(rest, "[")) > 1 {
        return false;
    }
    return true;
}

fn opaque_trait(t: str) -> str {
    return substr(t, 7, len(t) - 7);
}

// Whether a type spelling names a real, usable value type
// (Python checker's valid_type): scalars, the current type
// params, structs/enums/newtypes, unions (at least two distinct
// scalar members), opaques (a real trait with at least one impl),
// readonly views over plain arrays, tuples (all elements valid),
// generics (base struct/enum, exact arity, all args valid),
// arrays (element valid; sized arrays need a non-negative
// integer size). "void" is never valid here.
fn hc_valid_type(c: HChecker, t: str, tparams: [str]) -> bool {
    if alias_is_scalar(t) {
        return true;
    }
    if str_in_arr(t, tparams) {
        return true;
    }
    if str_in_arr(t, c.struct_names) || str_in_arr(t, c.enum_names) || str_in_arr(t, c.nt_names) {
        return true;
    }
    if is_fn_type(t) {
        // Fn type (Top-500 #103): every param a valid value type
        // (not void, no union anywhere inside — a union nested in
        // a fn type would never get its C typedef emitted), the ret
        // void or a valid value type (same union rule). Type params
        // inside a fn type are valid when in scope (generic map
        // needs fn(T) -> T); they pass through the recursive calls.
        let params: [str] = fn_type_params(t);
        let ret: str = fn_type_ret(t);
        let mut i: int = 0;
        while i < len(params) {
            // Any "|" anywhere inside (even nested in an array or
            // generic arg) rejects, matching the Python checker.
            if len(split(params[i], "|")) > 1 || params[i] == "void" {
                return false;
            }
            if !hc_valid_type(c, params[i], tparams) {
                return false;
            }
            i = i + 1;
        }
        if len(split(ret, "|")) > 1 {
            return false;
        }
        return ret == "void" || hc_valid_type(c, ret, tparams);
    }
    if is_union_type(t) {
        let members: [str] = union_members(t);
        if len(members) < 2 {
            return false;
        }
        let mut i: int = 0;
        while i < len(members) {
            let m: str = members[i];
            if m != "int" && m != "float" && m != "bool" && m != "str" {
                return false;
            }
            let mut j: int = 0;
            while j < i {
                if members[j] == m {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }
    if is_opaque_type(t) {
        let tr: str = opaque_trait(t);
        if !str_in_arr(tr, c.trait_names) {
            return false;
        }
        let mut n: int = 0;
        let mut k: int = 0;
        while k < len(c.impl_traits) {
            if c.impl_traits[k] == tr {
                n = n + 1;
            }
            k = k + 1;
        }
        return n >= 1;
    }
    if is_readonly(t) {
        let inner: str = readonly_inner(t);
        if is_readonly(inner) {
            return false;
        }
        if !starts_with(inner, "[") || substr(inner, len(inner) - 1, 1) != "]" {
            return false;
        }
        return hc_valid_type(c, inner, tparams);
    }
    if is_tuple(t) {
        let elems: [str] = tuple_elems(t);
        if len(elems) == 0 {
            return false;
        }
        let mut i: int = 0;
        while i < len(elems) {
            if !hc_valid_type(c, elems[i], tparams) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    let lt: int = find_lt(t);
    if lt >= 0 && substr(t, len(t) - 1, 1) == ">" {
        let base: str = substr(t, 0, lt);
        let args: [str] = generic_args(t);
        let mut want_n: int = -1;
        let mut si: int = 0;
        while si < len(c.struct_names) {
            if c.struct_names[si] == base {
                if c.struct_tparams[si] == "" {
                    want_n = 0;
                } else {
                    want_n = len(split(c.struct_tparams[si], "~"));
                }
            }
            si = si + 1;
        }
        let mut ei: int = 0;
        while ei < len(c.enum_names) {
            if c.enum_names[ei] == base {
                if c.enum_tparams[ei] == "" {
                    want_n = 0;
                } else {
                    want_n = len(split(c.enum_tparams[ei], "~"));
                }
            }
            ei = ei + 1;
        }
        if want_n < 0 || len(args) != want_n {
            return false;
        }
        let mut i: int = 0;
        while i < len(args) {
            if !hc_valid_type(c, args[i], tparams) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if is_sized_array(t) {
        let inner: str = substr(t, 1, len(t) - 2);
        let semi: int = find_top(inner, ";");
        let size_part: str = trim_spaces(substr(inner, semi + 1, len(inner) - semi - 1));
        // The size must be a non-negative integer literal.
        if len(size_part) == 0 {
            return false;
        }
        let mut d: int = 0;
        while d < len(size_part) {
            let ch: str = substr(size_part, d, 1);
            if ch != "0" && ch != "1" && ch != "2" && ch != "3" && ch != "4" && ch != "5" && ch != "6" && ch != "7" && ch != "8" && ch != "9" {
                return false;
            }
            d = d + 1;
        }
        return hc_valid_type(c, trim_spaces(substr(inner, 0, semi)), tparams);
    }
    if starts_with(t, "[") && substr(t, len(t) - 1, 1) == "]" {
        return hc_valid_type(c, substr(t, 1, len(t) - 2), tparams);
    }
    return false;
}

// Type-name candidates for "Did you mean" on an unknown type
// (Python: SCALARS + structs + enums).
fn type_name_cands(c: HChecker) -> [str] {
    let mut out: [str] = ["int", "float", "bool", "str", "range", "i8", "i16", "i32", "u8", "u16", "u32", "u64", "never"];
    let mut i: int = 0;
    while i < len(c.struct_names) {
        push(out, c.struct_names[i]);
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(c.enum_names) {
        push(out, c.enum_names[j]);
        j = j + 1;
    }
    return out;
}

// ---------- Top-500 #50: inferred error sets ----------
// Second checker pass (option A, DESIGN.md in
// ~/workspace/blackmoon-iso/errsets-slice/): for every function
// returning Result<T, E> where E is an enum, the checker computes
// the set of E-variants it can produce (own literal Err-returns,
// `?`-propagated callee sets, directly returned callee Results,
// enum-typed locals), by a worklist fixpoint over the call graph.
// A match on a value with a known inferred set is exhaustive over
// that set, not the whole enum (ES-C5). Sets are compile-time only
// and erased at runtime: no codegen change, no new syntax.
//
// Sets are encoded as "~"-joined variant names in enum-declaration
// order; "" is the empty set; "TOP" is the full enum (unknown).
// Soundness invariant (ES-SOUND): the set is always an
// over-approximation; anything unprovable widens to TOP, never to
// empty. Empty means "provably never returns an error" (ES-C7:
// fail()/faults/assert are never members).
//
// Verbatim mirror of forge_lang/checker.py's second pass, with one
// deliberate asymmetry: the Python checker records pending matches
// in phase 1 and verdicts them after the fixpoint; the hosted
// checker RE-DERIVES the verdict in the second-pass walk (a record
// pushed on the checker after the arm loop would be lost —
// join_moved rebuilds from a snapshot of `before`, and
// checker_snapshot deep-copies only the var/env arrays). Both
// verdict logics are identical (missing = variants - seen, same
// message format) and the own test runs both compilers on the same
// cases, so any divergence fails the test.
//
// Hosted gaps (documented, not bugs): the hosted checker never
// checks generic template bodies, so a generic call's summary is
// TOP (ES-C4) while Python narrows per-instantiation; the own
// test asserts exactly that split.

struct ESExpr {
    typ: str;
    kind: str;
    enm: str;
    set: str;
}

struct ESOut {
    c: HChecker;
    e: ESExpr;
}

struct ESFnOut {
    c: HChecker;
    err_enum: str;
    err_set: str;
    val_enum: str;
    val_set: str;
}

// ---------- set helpers ----------
// Sets are "~"-joined variant names (declaration order), "" for
// empty, "TOP" for the full enum (unknown).

fn es_join(parts: [str]) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(parts) {
        if i > 0 {
            out = out + "~";
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

fn es_join_comma(parts: [str]) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(parts) {
        if i > 0 {
            out = out + ", ";
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

fn es_has(set: str, variant: str) -> bool {
    if set == "TOP" {
        return true;
    }
    if set == "" {
        return false;
    }
    let parts: [str] = split(set, "~");
    let mut i: int = 0;
    while i < len(parts) {
        if parts[i] == variant {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn es_union(a: str, b: str) -> str {
    if a == "TOP" || b == "TOP" {
        return "TOP";
    }
    if a == "" {
        return b;
    }
    if b == "" {
        return a;
    }
    let av: [str] = split(a, "~");
    let bv: [str] = split(b, "~");
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(av) {
        push(out, av[i]);
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(bv) {
        if !es_has(a, bv[j]) {
            push(out, bv[j]);
        }
        j = j + 1;
    }
    return es_join(out);
}

// Alphabetical sort (insertion sort; string < does not exist,
// str_compare is the ordering primitive). The verdict's missing
// list is sorted to match Python's message (sorted(variants -
// seen)); the dump keeps declaration order instead.
fn es_sort_str(parts: [str]) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(parts) {
        push(out, parts[i]);
        i = i + 1;
    }
    let mut j: int = 1;
    while j < len(out) {
        let key: str = out[j];
        let mut k: int = j - 1;
        while k >= 0 && str_compare(out[k], key) > 0 {
            out[k + 1] = out[k];
            k = k - 1;
        }
        out[k + 1] = key;
        j = j + 1;
    }
    return out;
}

// ---------- type helpers ----------

// The enum a type denotes (itself, or the base of a generic
// instantiation), or "" when it is not an enum.
fn es_enum_base(c: HChecker, t: str) -> str {
    if is_enum(c, t) {
        return t;
    }
    let base: str = generic_base(t);
    if base != "" && base != t && is_enum(c, base) {
        return base;
    }
    return "";
}

// The E of a Result<T, E> spelling, or "".
fn es_result_err(t: str) -> str {
    if generic_base(t) == "Result" {
        let args: [str] = generic_args(t);
        if len(args) == 2 {
            return args[1];
        }
    }
    return "";
}

// "result" when t is Result<T, E> with E an enum, "enum" when t
// is an enum, "other" otherwise.
fn es_kind_of(c: HChecker, t: str) -> str {
    let e: str = es_result_err(t);
    if e != "" && es_enum_base(c, e) != "" {
        return "result";
    }
    if es_enum_base(c, t) != "" {
        return "enum";
    }
    return "other";
}

// The enum a set-bearing value's set is over: E for a Result,
// the type itself for a bare enum, "" otherwise.
fn es_enum_of(c: HChecker, t: str) -> str {
    let e: str = es_result_err(t);
    if e != "" && es_enum_base(c, e) != "" {
        return e;
    }
    return es_enum_base(c, t);
}

// The return type of a "params=>ret" signature.
fn es_sig_ret(sig: str) -> str {
    let mut ai: int = -1;
    let mut i: int = 0;
    while i + 1 < len(sig) {
        if substr(sig, i, 1) == "=" && substr(sig, i + 1, 1) == ">" {
            ai = i;
        }
        i = i + 1;
    }
    if ai < 0 {
        return "?";
    }
    return substr(sig, ai + 2, len(sig) - ai - 2);
}

// The return type of a call: the "=>ret" part of the signature,
// with generic type params substituted from the argument types
// (mirrors check_call's generic handling; a failed unify leaves
// that param as "?", which makes the return untypeable and the
// call site widen to TOP — phase 1 already validated the call,
// so this walker never fails here).
fn es_call_ret(c: HChecker, name: str, sig: str, arg_typs: [str]) -> str {
    let mut ai: int = -1;
    let mut i: int = 0;
    while i + 1 < len(sig) {
        if substr(sig, i, 1) == "=" && substr(sig, i + 1, 1) == ">" {
            ai = i;
        }
        i = i + 1;
    }
    if ai < 0 {
        return "?";
    }
    let param_part: str = substr(sig, 0, ai);
    let ret0: str = substr(sig, ai + 2, len(sig) - ai - 2);
    let tps: str = func_tparams(c, name);
    if tps == "" {
        return ret0;
    }
    let bnames: [str] = split(tps, "~");
    let mut btypes: [str] = [];
    let mut q: int = 0;
    while q < len(bnames) {
        push(btypes, "?");
        q = q + 1;
    }
    let mut want: [str] = [];
    if param_part != "" {
        want = split(param_part, "~");
    }
    let mut j: int = 0;
    while j < len(want) && j < len(arg_typs) {
        let u: UOut = unify(want[j], arg_typs[j], bnames, btypes);
        if u.ok {
            btypes = u.types;
        }
        j = j + 1;
    }
    return substitute_type(ret0, bnames, btypes);
}

// Index of the "__" in a mangled method name, or -1.
fn es_find_dunder(name: str) -> int {
    let mut i: int = 0;
    while i + 1 < len(name) {
        if substr(name, i, 1) == "_" && substr(name, i + 1, 1) == "_" {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ---------- summary store ----------
// es_names/es_kinds/es_enums/es_sets: one row per (function, kind)
// where kind is "S" (error-set) or "V" (value-set). A stored set
// is the last walk's result; "TOP" means unknown/widened, "" means
// provably empty.

// The stored set for (name, kind), or "" when no row exists yet
// (behaves exactly like the empty set: a walkable function that
// has not been walked yet contributes nothing until its first
// walk lands).
fn es_get_set(c: HChecker, name: str, kind: str) -> str {
    let mut i: int = 0;
    while i < len(c.es_names) {
        if c.es_names[i] == name && c.es_kinds[i] == kind {
            return c.es_sets[i];
        }
        i = i + 1;
    }
    return "";
}

fn es_put_set(c0: HChecker, name: str, kind: str, enm: str, set: str) -> HChecker {
    let mut c: HChecker = c0;
    let mut i: int = 0;
    while i < len(c.es_names) {
        if c.es_names[i] == name && c.es_kinds[i] == kind {
            c.es_enums[i] = enm;
            c.es_sets[i] = set;
            return c;
        }
        i = i + 1;
    }
    push(c.es_names, name);
    push(c.es_kinds, kind);
    push(c.es_enums, enm);
    push(c.es_sets, set);
    return c;
}

// A callee's summary as seen by a caller. A stored row wins.
// Otherwise: an extern, a generic template (no per-instantiation
// summary exists in hosted — its body is never checked), or an
// unknown name is TOP (ES-C4); a concrete function or method the
// fixpoint will walk contributes the empty set until its first
// walk lands.
fn es_summary_members(c: HChecker, name: str, kind: str) -> str {
    // A stored row wins (including a stored empty set).
    let mut i: int = 0;
    while i < len(c.es_names) {
        if c.es_names[i] == name && c.es_kinds[i] == kind {
            return c.es_sets[i];
        }
        i = i + 1;
    }
    // No row yet. An extern, a generic template (no
    // per-instantiation summary exists in hosted — its body is
    // never checked), or an unknown name is TOP (ES-C4); a
    // concrete function or method the fixpoint will walk
    // contributes the empty set until its first walk lands.
    if func_sig(c, name) != "" {
        if func_is_extern(c, name) {
            return "TOP";
        }
        if func_tparams(c, name) != "" {
            return "TOP";
        }
        return "";
    }
    // A mangled method name (Struct__method): methods live in the
    // method table, not func_names. Walkable when the method
    // exists there.
    let us: int = es_find_dunder(name);
    if us >= 0 {
        let sname: str = substr(name, 0, us);
        let mname: str = substr(name, us + 2, len(name) - us - 2);
        if method_sig(c, sname, mname) != "" {
            return "";
        }
    }
    return "TOP";
}

fn es_has_edge(c: HChecker, edge: str) -> bool {
    let mut i: int = 0;
    while i < len(c.es_edges) {
        if c.es_edges[i] == edge {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ---------- walk locals ----------
// The locals table mirrors the source scopes: es_marks holds the
// length of the locals arrays at each scope entry, so a scope
// exit truncates back to it. Lookup scans from the end, so an
// inner binding shadows an outer one (and reappears when the
// inner scope is popped).

fn es_loc_lookup(c: HChecker, name: str) -> ESExpr {
    let mut i: int = len(c.es_loc_names) - 1;
    while i >= 0 {
        if c.es_loc_names[i] == name {
            return ESExpr { typ: c.es_loc_typs[i], kind: c.es_loc_kinds[i], enm: c.es_loc_enums[i], set: c.es_loc_sets[i] };
        }
        i = i - 1;
    }
    return ESExpr { typ: "", kind: "", enm: "", set: "" };
}

fn es_loc_bind(c0: HChecker, name: str, e: ESExpr) -> HChecker {
    let mut c: HChecker = c0;
    push(c.es_loc_names, name);
    push(c.es_loc_typs, e.typ);
    push(c.es_loc_kinds, e.kind);
    push(c.es_loc_enums, e.enm);
    push(c.es_loc_sets, e.set);
    return c;
}

// Reassignment unions the new set into the local (ES-C3: sets
// only grow within a body). A kind/enum change widens to TOP.
fn es_loc_assign_union(c0: HChecker, name: str, e: ESExpr) -> HChecker {
    let mut c: HChecker = c0;
    let mut i: int = len(c.es_loc_names) - 1;
    while i >= 0 {
        if c.es_loc_names[i] == name {
            if c.es_loc_kinds[i] == "result" || c.es_loc_kinds[i] == "enum" {
                if e.kind == c.es_loc_kinds[i] && e.enm == c.es_loc_enums[i] {
                    c.es_loc_sets[i] = es_union(c.es_loc_sets[i], e.set);
                } else {
                    c.es_loc_sets[i] = "TOP";
                }
            }
            return c;
        }
        i = i - 1;
    }
    return c;
}

fn es_push_scope(c0: HChecker) -> HChecker {
    let mut c: HChecker = c0;
    push(c.es_marks, len(c.es_loc_names));
    return c;
}

fn es_pop_scope(c0: HChecker) -> HChecker {
    let mut c: HChecker = c0;
    let mark: int = c.es_marks[len(c.es_marks) - 1];
    c.es_loc_names = trunc_str(c.es_loc_names, mark);
    c.es_loc_typs = trunc_str(c.es_loc_typs, mark);
    c.es_loc_kinds = trunc_str(c.es_loc_kinds, mark);
    c.es_loc_enums = trunc_str(c.es_loc_enums, mark);
    c.es_loc_sets = trunc_str(c.es_loc_sets, mark);
    c.es_marks = trunc_int(c.es_marks, len(c.es_marks) - 1);
    return c;
}

// A fresh arm state: a copy of the checker whose locals arrays
// are unshared, so index writes inside the arm cannot corrupt
// the `before` snapshot (index assignment writes through a shared
// buffer; push is copy-on-write and needs no copy).
fn es_arm_start(c: HChecker) -> HChecker {
    let mut out: HChecker = c;
    out.es_loc_names = copy_str(c.es_loc_names);
    out.es_loc_typs = copy_str(c.es_loc_typs);
    out.es_loc_kinds = copy_str(c.es_loc_kinds);
    out.es_loc_enums = copy_str(c.es_loc_enums);
    out.es_loc_sets = copy_str(c.es_loc_sets);
    out.es_marks = copy_int(c.es_marks);
    return out;
}

// ---------- accumulators ----------
// es_acc_err_* tracks the error-set of the function being walked
// (its return type's E); es_acc_val_* tracks the value-set of a
// bare-enum return. A function returns one type, so at most one
// is live; both enums are "" for a non-set-bearing return.

fn es_acc_add_error(c0: HChecker, enm: str, set: str) -> HChecker {
    let mut c: HChecker = c0;
    if c.es_acc_err_enum == "" {
        return c;
    }
    if enm == c.es_acc_err_enum {
        c.es_acc_err_set = es_union(c.es_acc_err_set, set);
    } else {
        c.es_acc_err_set = "TOP";
    }
    return c;
}

fn es_acc_add_return(c0: HChecker, e: ESExpr) -> HChecker {
    let mut c: HChecker = c0;
    if c.es_acc_err_enum != "" {
        if e.kind == "result" && e.enm == c.es_acc_err_enum {
            c.es_acc_err_set = es_union(c.es_acc_err_set, e.set);
        } else {
            c.es_acc_err_set = "TOP";
        }
    }
    if c.es_acc_val_enum != "" {
        if e.kind == "enum" && e.enm == c.es_acc_val_enum {
            c.es_acc_val_set = es_union(c.es_acc_val_set, e.set);
        } else {
            c.es_acc_val_set = "TOP";
        }
    }
    return c;
}

// The locals-table entry for a let with an annotation: the kind
// and enum come from the annotation, the set from the value when
// the value agrees with the annotation, else TOP (ES-C3).
fn es_local_for_ann(c: HChecker, ann: str, e: ESExpr) -> ESExpr {
    if ann == "" {
        return e;
    }
    let kind: str = es_kind_of(c, ann);
    let enm: str = es_enum_of(c, ann);
    if kind == "other" {
        return ESExpr { typ: ann, kind: "other", enm: "", set: "TOP" };
    }
    if e.kind == kind && e.enm == enm {
        return ESExpr { typ: ann, kind: kind, enm: enm, set: e.set };
    }
    return ESExpr { typ: ann, kind: kind, enm: enm, set: "TOP" };
}

// ---------- expression walker ----------
// Returns (updated checker, ESExpr). The typ is the best-known
// type string ("?" when unknowable); kind is "result" / "enum" /
// "other"; enm is the set's enum ("" when not set-bearing); set
// is the "~"-joined set, "TOP" when unknown, "" when empty.
// Anything untypeable is ("?", "other", "", "TOP"): a
// return/store of such a value in a set-bearing position falls
// back to TOP of the enclosing/declared enum (sound).

fn es_expr(c0: HChecker, n: Node) -> ESOut {
    let mut c: HChecker = c0;
    if n.kind == 34 {
        // Bare name: a local, a bare enum variant, or a fn value.
        let lv: ESExpr = es_loc_lookup(c, n.name);
        if lv.typ != "" {
            return ESOut { c: c, e: lv };
        }
        let en: str = enum_of_variant(c, n.name);
        if en != "" {
            return ESOut { c: c, e: ESExpr { typ: en, kind: "enum", enm: en, set: n.name } };
        }
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 35 {
        return es_call(c, n);
    }
    if n.kind == 31 {
        return es_structlit(c, n);
    }
    if n.kind == 32 {
        return es_fieldaccess(c, n);
    }
    if n.kind == 33 {
        return es_methodcall(c, n);
    }
    if n.kind == 42 {
        // `?`: the operand's error set propagates to the enclosing
        // function (ES-C2b), wherever the `?` appears.
        let inner: ESOut = es_expr(c, n.kids[0]);
        c = inner.c;
        if inner.e.kind == "result" && inner.e.enm != "" {
            c = es_acc_add_error(c, inner.e.enm, inner.e.set);
        }
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 46 {
        return es_indirectcall(c, n);
    }
    if n.kind == 47 {
        // Lambda value: TOP; the body is NOT walked — its `?`s
        // and returns belong to the lambda, never the enclosing
        // function, and a lambda value is only ever called
        // indirectly (= TOP), so its body summary is unobservable
        // in v1 (ES-C8).
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 40 {
        let l: ESOut = es_expr(c, n.kids[0]);
        c = l.c;
        let r: ESOut = es_expr(c, n.kids[1]);
        c = r.c;
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 41 {
        let o: ESOut = es_expr(c, n.kids[0]);
        c = o.c;
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 39 {
        // Cast: the target type, widened to TOP.
        let o: ESOut = es_expr(c, n.kids[0]);
        c = o.c;
        let kind: str = es_kind_of(c, n.sval);
        let enm: str = es_enum_of(c, n.sval);
        return ESOut { c: c, e: ESExpr { typ: n.sval, kind: kind, enm: enm, set: "TOP" } };
    }
    if n.kind == 36 {
        // Index: the element type, widened to TOP (ES-C4: array
        // elements are untracked sources).
        let b: ESOut = es_expr(c, n.kids[0]);
        c = b.c;
        let ix: ESOut = es_expr(c, n.kids[1]);
        c = ix.c;
        if is_array(b.e.typ) {
            let et: str = elem_type(b.e.typ);
            return ESOut { c: c, e: ESExpr { typ: et, kind: es_kind_of(c, et), enm: es_enum_of(c, et), set: "TOP" } };
        }
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 37 {
        let b: ESOut = es_expr(c, n.kids[0]);
        c = b.c;
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 29 || n.kind == 30 {
        let mut i: int = 0;
        while i < len(n.kids) {
            let o: ESOut = es_expr(c, n.kids[i]);
            c = o.c;
            i = i + 1;
        }
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if n.kind == 38 {
        let s: ESOut = es_expr(c, n.kids[0]);
        c = s.c;
        let e: ESOut = es_expr(c, n.kids[1]);
        c = e.c;
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    // Literals (25/26/27/28) and anything else: a plain value,
    // never an enum/Result.
    return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
}

fn es_call(c0: HChecker, n: Node) -> ESOut {
    let mut c: HChecker = c0;
    // Variant construction first (mirrors check_call order).
    let ven: str = enum_of_variant(c, n.name);
    if ven != "" {
        let mut i: int = 0;
        while i < len(n.kids) {
            let o: ESOut = es_expr(c, n.kids[i]);
            c = o.c;
            i = i + 1;
        }
        return ESOut { c: c, e: ESExpr { typ: ven, kind: "enum", enm: ven, set: n.name } };
    }
    // try_call: Result<R, str> — E is str, never set-bearing.
    // Walk only the value args (kids[0] is a bare fn name). The
    // func_sig guard keeps a user-defined try_call (which phase 1
    // resolves as a normal function) from being mistaken for the
    // builtin.
    if n.name == "try_call" && func_sig(c, n.name) == "" {
        let mut i: int = 1;
        while i < len(n.kids) {
            let o: ESOut = es_expr(c, n.kids[i]);
            c = o.c;
            i = i + 1;
        }
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    let sig: str = func_sig(c, n.name);
    if sig != "" {
        // Direct call to a known function.
        let mut i: int = 0;
        let mut arg_typs: [str] = [];
        while i < len(n.kids) {
            let o: ESOut = es_expr(c, n.kids[i]);
            c = o.c;
            push(arg_typs, o.e.typ);
            i = i + 1;
        }
        push(c.es_callees, n.name);
        let ret: str = es_call_ret(c, n.name, sig, arg_typs);
        let kind: str = es_kind_of(c, ret);
        let enm: str = es_enum_of(c, ret);
        if kind == "result" {
            // A generic callee's summary is TOP in hosted (ES-C4:
            // no per-instantiation summary exists — template
            // bodies are never checked); Python narrows
            // per-instantiation. The own test asserts exactly
            // that split.
            if func_tparams(c, n.name) != "" {
                return ESOut { c: c, e: ESExpr { typ: ret, kind: "result", enm: enm, set: "TOP" } };
            }
            return ESOut { c: c, e: ESExpr { typ: ret, kind: "result", enm: enm, set: es_summary_members(c, n.name, "S") } };
        }
        if kind == "enum" {
            if func_tparams(c, n.name) != "" {
                return ESOut { c: c, e: ESExpr { typ: ret, kind: "enum", enm: enm, set: "TOP" } };
            }
            return ESOut { c: c, e: ESExpr { typ: ret, kind: "enum", enm: enm, set: es_summary_members(c, n.name, "V") } };
        }
        return ESOut { c: c, e: ESExpr { typ: ret, kind: "other", enm: "", set: "TOP" } };
    }
    // Indirect call through a fn-typed variable (FN-C2), or a
    // builtin / unknown name: walk the args, TOP. (The walker's
    // own locals table is the source here — phase 1's var table
    // is stale in the second pass, so var_type_or_empty would
    // read the last function phase 1 checked.)
    let lv: ESExpr = es_loc_lookup(c, n.name);
    if lv.typ != "" && is_fn_type(lv.typ) {
        let mut i: int = 0;
        while i < len(n.kids) {
            let o: ESOut = es_expr(c, n.kids[i]);
            c = o.c;
            i = i + 1;
        }
        let ret: str = fn_type_ret(lv.typ);
        return ESOut { c: c, e: ESExpr { typ: ret, kind: es_kind_of(c, ret), enm: es_enum_of(c, ret), set: "TOP" } };
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        let o: ESOut = es_expr(c, n.kids[i]);
        c = o.c;
        i = i + 1;
    }
    return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
}

fn es_structlit(c0: HChecker, n: Node) -> ESOut {
    let mut c: HChecker = c0;
    // kids are StructField nodes (kind 44): name = field, kids[0]
    // = value. The error field's enum tag is the concrete E (the
    // Result literal's error field has type E).
    let mut i: int = 0;
    let mut ok_is_true: bool = false;
    let mut err_e: ESExpr = ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" };
    let mut has_err: bool = false;
    while i < len(n.kids) {
        let f: Node = n.kids[i];
        let o: ESOut = es_expr(c, f.kids[0]);
        c = o.c;
        if f.name == "ok" && f.kids[0].kind == 28 && f.kids[0].bval {
            ok_is_true = true;
        }
        if f.name == "error" {
            err_e = o.e;
            has_err = true;
        }
        i = i + 1;
    }
    if n.name != "Result" {
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    let e: str = err_e.enm;
    if e == "" || es_enum_base(c, e) == "" {
        // E unknown (or not an enum): not set-bearing for the
        // walker; the return-site/local-site fallback supplies
        // TOP(E).
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if ok_is_true {
        return ESOut { c: c, e: ESExpr { typ: "Result", kind: "result", enm: e, set: "" } };
    }
    if !has_err {
        return ESOut { c: c, e: ESExpr { typ: "Result", kind: "result", enm: e, set: "TOP" } };
    }
    if err_e.kind == "enum" && err_e.enm == e {
        return ESOut { c: c, e: ESExpr { typ: "Result", kind: "result", enm: e, set: err_e.set } };
    }
    return ESOut { c: c, e: ESExpr { typ: "Result", kind: "result", enm: e, set: "TOP" } };
}

fn es_fieldaccess(c0: HChecker, n: Node) -> ESOut {
    let mut c: HChecker = c0;
    let b: ESOut = es_expr(c, n.kids[0]);
    c = b.c;
    if b.e.kind == "result" && n.name == "error" {
        return ESOut { c: c, e: ESExpr { typ: b.e.enm, kind: "enum", enm: b.e.enm, set: b.e.set } };
    }
    if b.e.kind == "result" {
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    if b.e.kind == "other" && b.e.typ != "" {
        // A struct field read: the field's type, widened to TOP
        // (ES-C4: values flowing through struct fields are
        // untracked).
        let base: str = generic_base(b.e.typ);
        let mut is_struct: bool = false;
        let mut si: int = 0;
        while si < len(c.struct_names) {
            if c.struct_names[si] == base {
                is_struct = true;
            }
            si = si + 1;
        }
        if is_struct && struct_has_field(c, base, n.name) {
            let ft: str = struct_field_type(c, base, n.name, n.line, n.col);
            let kind: str = es_kind_of(c, ft);
            let enm: str = es_enum_of(c, ft);
            if kind != "other" {
                return ESOut { c: c, e: ESExpr { typ: ft, kind: kind, enm: enm, set: "TOP" } };
            }
        }
    }
    return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
}

fn es_methodcall(c0: HChecker, n: Node) -> ESOut {
    let mut c: HChecker = c0;
    let b: ESOut = es_expr(c, n.kids[0]);
    c = b.c;
    let mut i: int = 1;
    while i < len(n.kids) {
        let o: ESOut = es_expr(c, n.kids[i]);
        c = o.c;
        i = i + 1;
    }
    let bt: str = b.e.typ;
    if bt == "" || bt == "?" {
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    let base: str = generic_base(bt);
    if base != bt {
        // Generic-struct receiver: the method instantiation is
        // not tracked in hosted — TOP (ES-C4).
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    let sig: str = method_sig(c, base, n.name);
    if sig == "" {
        return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
    }
    // sig is "params=>ret" (params after the receiver).
    let ret: str = es_sig_ret(sig);
    let kind: str = es_kind_of(c, ret);
    let enm: str = es_enum_of(c, ret);
    let mangled: str = base + "__" + n.name;
    push(c.es_callees, mangled);
    if kind == "result" {
        return ESOut { c: c, e: ESExpr { typ: ret, kind: "result", enm: enm, set: es_summary_members(c, mangled, "S") } };
    }
    if kind == "enum" {
        return ESOut { c: c, e: ESExpr { typ: ret, kind: "enum", enm: enm, set: es_summary_members(c, mangled, "V") } };
    }
    return ESOut { c: c, e: ESExpr { typ: ret, kind: "other", enm: "", set: "TOP" } };
}

fn es_indirectcall(c0: HChecker, n: Node) -> ESOut {
    let mut c: HChecker = c0;
    let cal: ESOut = es_expr(c, n.kids[0]);
    c = cal.c;
    let mut i: int = 1;
    while i < len(n.kids) {
        let o: ESOut = es_expr(c, n.kids[i]);
        c = o.c;
        i = i + 1;
    }
    // Indirect: the callee is unknown at the call site — TOP
    // (ES-C4). The return type comes from the fn-typed value when
    // it is known.
    if is_fn_type(cal.e.typ) {
        let ret: str = fn_type_ret(cal.e.typ);
        return ESOut { c: c, e: ESExpr { typ: ret, kind: es_kind_of(c, ret), enm: es_enum_of(c, ret), set: "TOP" } };
    }
    return ESOut { c: c, e: ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" } };
}

// ---------- statement walker ----------

fn es_walk_block(c0: HChecker, block: Node) -> HChecker {
    let mut c: HChecker = c0;
    c = es_push_scope(c);
    let mut i: int = 0;
    while i < len(block.kids) {
        c = es_walk_stmt(c, block.kids[i]);
        i = i + 1;
    }
    c = es_pop_scope(c);
    return c;
}

// Merge the arm-end states into `before`: each binding's set is
// the union across the arms (sets only grow, ES-C3), and the
// accumulators/callees are unioned too (they are not scoped —
// returns and `?`s inside a branch still contribute to the
// function). The arms all started from the same snapshot, so
// indices below len(before) are the same bindings in every arm.
fn es_branch_merge(before: HChecker, afters: [HChecker]) -> HChecker {
    let mut out: HChecker = before;
    out.es_loc_names = copy_str(before.es_loc_names);
    out.es_loc_typs = copy_str(before.es_loc_typs);
    out.es_loc_kinds = copy_str(before.es_loc_kinds);
    out.es_loc_enums = copy_str(before.es_loc_enums);
    out.es_loc_sets = copy_str(before.es_loc_sets);
    out.es_marks = copy_int(before.es_marks);
    out.es_callees = copy_str(before.es_callees);
    let mut i: int = 0;
    while i < len(before.es_loc_names) {
        let mut acc: str = before.es_loc_sets[i];
        let mut a: int = 0;
        while a < len(afters) {
            let ac: HChecker = afters[a];
            if i < len(ac.es_loc_names) {
                acc = es_union(acc, ac.es_loc_sets[i]);
            }
            a = a + 1;
        }
        out.es_loc_sets[i] = acc;
        i = i + 1;
    }
    // Accumulators are not scoped: union the arms' contributions
    // (each arm's accumulator started from `before`'s, so the
    // union is before's set plus every arm's additions).
    let mut a2: int = 0;
    while a2 < len(afters) {
        let ac2: HChecker = afters[a2];
        if ac2.es_acc_err_enum != "" {
            out.es_acc_err_enum = ac2.es_acc_err_enum;
            out.es_acc_err_set = es_union(out.es_acc_err_set, ac2.es_acc_err_set);
        }
        if ac2.es_acc_val_enum != "" {
            out.es_acc_val_enum = ac2.es_acc_val_enum;
            out.es_acc_val_set = es_union(out.es_acc_val_set, ac2.es_acc_val_set);
        }
        let mut ci: int = 0;
        while ci < len(ac2.es_callees) {
            let cn: str = ac2.es_callees[ci];
            let mut found: bool = false;
            let mut cj: int = 0;
            while cj < len(out.es_callees) {
                if out.es_callees[cj] == cn {
                    found = true;
                }
                cj = cj + 1;
            }
            if !found {
                push(out.es_callees, cn);
            }
            ci = ci + 1;
        }
        a2 = a2 + 1;
    }
    return out;
}

fn es_walk_stmt(c0: HChecker, n: Node) -> HChecker {
    let mut c: HChecker = c0;
    if n.kind == 9 {
        return es_walk_block(c, n);
    }
    if n.kind == 10 {
        let o: ESOut = es_expr(c, n.kids[0]);
        c = o.c;
        let bound: ESExpr = es_local_for_ann(c, n.sval, o.e);
        c = es_loc_bind(c, n.name, bound);
        return c;
    }
    if n.kind == 11 {
        let o: ESOut = es_expr(c, n.kids[0]);
        c = o.c;
        c = es_loc_assign_union(c, n.name, o.e);
        return c;
    }
    if n.kind == 12 {
        // IndexAssign: the element is stored into an array —
        // untracked (ES-C3). Walk the target and the value for
        // their `?`s and discard.
        let t: ESOut = es_expr(c, n.kids[0]);
        c = t.c;
        let v: ESOut = es_expr(c, n.kids[1]);
        c = v.c;
        return c;
    }
    if n.kind == 13 {
        // FieldAssign: a value stored into a struct field —
        // untracked (ES-C4). Walk the target and the value for
        // their `?`s and discard.
        let t: ESOut = es_expr(c, n.kids[0]);
        c = t.c;
        let v: ESOut = es_expr(c, n.kids[1]);
        c = v.c;
        return c;
    }
    if n.kind == 14 {
        let cond: ESOut = es_expr(c, n.kids[0]);
        c = cond.c;
        let before: HChecker = c;
        let mut then_arm: HChecker = es_arm_start(c);
        then_arm = es_walk_block(then_arm, n.kids[1]);
        if len(n.kids) > 2 {
            let mut else_arm: HChecker = es_arm_start(c);
            else_arm = es_walk_block(else_arm, n.kids[2]);
            return es_branch_merge(before, [then_arm, else_arm]);
        }
        return es_branch_merge(before, [then_arm, before]);
    }
    if n.kind == 15 {
        let cond: ESOut = es_expr(c, n.kids[0]);
        c = cond.c;
        let before: HChecker = c;
        let mut body_arm: HChecker = es_arm_start(c);
        body_arm = es_walk_block(body_arm, n.kids[1]);
        return es_branch_merge(before, [body_arm]);
    }
    if n.kind == 16 {
        let it: ESOut = es_expr(c, n.kids[0]);
        c = it.c;
        let before: HChecker = c;
        let mut body_arm: HChecker = es_arm_start(c);
        body_arm = es_push_scope(body_arm);
        let mut vt: str = "int";
        if is_array(it.e.typ) {
            vt = elem_type(it.e.typ);
        }
        let loop_e: ESExpr = ESExpr { typ: vt, kind: es_kind_of(c, vt), enm: es_enum_of(c, vt), set: "TOP" };
        body_arm = es_loc_bind(body_arm, n.name, loop_e);
        body_arm = es_walk_block(body_arm, n.kids[1]);
        body_arm = es_pop_scope(body_arm);
        return es_branch_merge(before, [body_arm]);
    }
    if n.kind == 17 {
        if len(n.kids) == 0 {
            return c;
        }
        let v: ESOut = es_expr(c, n.kids[0]);
        c = v.c;
        c = es_acc_add_return(c, v.e);
        return c;
    }
    if n.kind == 18 || n.kind == 19 {
        return c;
    }
    if n.kind == 20 {
        let s: ESOut = es_expr(c, n.kids[0]);
        c = s.c;
        // The exhaustiveness verdict, re-derived here (ES-C5):
        // phase 1 no longer verdicts enum matches. Union matches
        // were verdict'd in phase 1 and are skipped.
        if c.es_verdicts && !is_union_type(s.e.typ) {
            let base: str = es_enum_base(c, s.e.typ);
            if base != "" {
                let variants: [str] = enum_variant_names(c, base);
                let mut seen: [str] = [];
                let mut has_wildcard: bool = false;
                let mut a: int = 1;
                while a < len(n.kids) {
                    let arm: Node = n.kids[a];
                    if arm.label == "wildcard" {
                        has_wildcard = true;
                    } else {
                        push(seen, arm.name);
                    }
                    a = a + 1;
                }
                if !has_wildcard {
                    let seen_s: str = es_join(seen);
                    // The scrutinee's set: a concrete set narrows
                    // the verdict; anything else (TOP, or an
                    // untyped scrutinee) uses the full enum.
                    let vset: str = s.e.set;
                    if s.e.kind == "enum" && vset != "TOP" {
                        let parts: [str] = split(vset, "~");
                        let mut missing: [str] = [];
                        let mut pi: int = 0;
                        while pi < len(parts) {
                            if parts[pi] != "" && !es_has(seen_s, parts[pi]) {
                                push(missing, parts[pi]);
                            }
                            pi = pi + 1;
                        }
                        if len(missing) > 0 {
                            let sm: [str] = es_sort_str(missing);
                            fail_at(n.line, n.col, "match is not exhaustive; missing: " + es_join_comma(sm));
                        }
                    } else {
                        // TOP: today's rule (the full enum) and
                        // today's hosted message (bare, no list).
                        let mut missing: bool = false;
                        let mut mi: int = 0;
                        while mi < len(variants) {
                            if !es_has(seen_s, variants[mi]) {
                                missing = true;
                            }
                            mi = mi + 1;
                        }
                        if missing {
                            fail_at(n.line, n.col, "match is not exhaustive");
                        }
                    }
                }
            }
        }
        // Walk the arms for their sets and `?`s, merging locals
        // after. The payload binding (if any) is seeded in the
        // arm's own scope from the scrutinee's concrete type.
        let before: HChecker = c;
        let mut arms: [HChecker] = [];
        let mut a2: int = 1;
        while a2 < len(n.kids) {
            let arm: Node = n.kids[a2];
            let mut arm_c: HChecker = es_arm_start(c);
            arm_c = es_push_scope(arm_c);
            if arm.label == "struct" {
                // Struct-pattern field bindings (#69): in scope
                // with the fields' (substituted) types.
                let gbase: str = generic_base(s.e.typ);
                let mut fi: int = 1;
                while fi < len(arm.kids) {
                    let fp: Node = arm.kids[fi];
                    if fp.label == "binding" {
                        let ft0: str = struct_field_type(c, gbase, fp.name, arm.line, arm.col);
                        let mut ft: str = ft0;
                        let tps: str = struct_tparams(c, gbase);
                        if tps != "" {
                            let args: [str] = generic_args(s.e.typ);
                            let tnames: [str] = split(tps, "~");
                            ft = substitute_type(ft0, tnames, args);
                        }
                        let bind_e: ESExpr = ESExpr { typ: ft, kind: es_kind_of(c, ft), enm: es_enum_of(c, ft), set: "TOP" };
                        arm_c = es_loc_bind(arm_c, fp.sval, bind_e);
                    }
                    fi = fi + 1;
                }
            } else if arm.sval != "" {
                let mbase: str = es_enum_base(c, s.e.typ);
                let mut bpt: str = "?";
                if mbase != "" {
                    let payload: str = enum_payload(c, mbase, arm.name, n.line, n.col);
                    bpt = payload;
                    let gargs: [str] = generic_args(s.e.typ);
                    let etps: str = enum_tparams(c, mbase);
                    if len(gargs) > 0 && etps != "" {
                        let enames: [str] = split(etps, "~");
                        if len(enames) == len(gargs) {
                            bpt = substitute_type(payload, enames, gargs);
                        }
                    }
                }
                let bind_e: ESExpr = ESExpr { typ: bpt, kind: es_kind_of(c, bpt), enm: es_enum_of(c, bpt), set: "TOP" };
                arm_c = es_loc_bind(arm_c, arm.sval, bind_e);
            }
            arm_c = es_walk_block(arm_c, arm.kids[0]);
            arm_c = es_pop_scope(arm_c);
            push(arms, arm_c);
            a2 = a2 + 1;
        }
        return es_branch_merge(before, arms);
    }
    if n.kind == 21 {
        // Spawn: the spawned call runs in another task — its
        // Result is discarded, so only the argument expressions
        // (evaluated in this frame) are walked.
        let call: Node = n.kids[0];
        let mut i: int = 0;
        while i < len(call.kids) {
            let o: ESOut = es_expr(c, call.kids[i]);
            c = o.c;
            i = i + 1;
        }
        return c;
    }
    if n.kind == 22 {
        return es_walk_block(c, n.kids[0]);
    }
    if n.kind == 23 || n.kind == 24 {
        // Defer / ExprStmt: walk the expression and discard the
        // set (`?`s inside still contribute to the accumulator).
        let o: ESOut = es_expr(c, n.kids[0]);
        c = o.c;
        return c;
    }
    return c;
}

// ---------- function walk ----------

fn es_walk_fn(c0: HChecker, fn_node: Node, key: str, verdicts: bool) -> ESFnOut {
    let mut c: HChecker = c0;
    // Reset the per-function walk state. (A bare [] has type
    // [?] and cannot be assigned to a typed field; trunc to 0
    // yields an empty array of the field's element type.)
    c.es_loc_names = trunc_str(c.es_loc_names, 0);
    c.es_loc_typs = trunc_str(c.es_loc_typs, 0);
    c.es_loc_kinds = trunc_str(c.es_loc_kinds, 0);
    c.es_loc_enums = trunc_str(c.es_loc_enums, 0);
    c.es_loc_sets = trunc_str(c.es_loc_sets, 0);
    c.es_marks = trunc_int(c.es_marks, 0);
    c.es_callees = trunc_str(c.es_callees, 0);
    c.es_verdicts = verdicts;
    // Accumulators from the return type.
    let ret: str = fn_node.sval;
    let e: str = es_result_err(ret);
    if e != "" && es_enum_base(c, e) != "" {
        c.es_acc_err_enum = e;
        c.es_acc_err_set = "";
        c.es_acc_val_enum = "";
        c.es_acc_val_set = "";
    } else if es_enum_base(c, ret) != "" {
        c.es_acc_err_enum = "";
        c.es_acc_err_set = "";
        c.es_acc_val_enum = ret;
        c.es_acc_val_set = "";
    } else {
        c.es_acc_err_enum = "";
        c.es_acc_err_set = "";
        c.es_acc_val_enum = "";
        c.es_acc_val_set = "";
    }
    // Seed the parameters (TOP of their enum, ES-C3).
    let mut i: int = 0;
    while i < len(fn_node.kids) {
        let k: Node = fn_node.kids[i];
        if k.kind == 43 {
            let pe: ESExpr = es_local_for_ann(c, k.sval, ESExpr { typ: "?", kind: "other", enm: "", set: "TOP" });
            c = es_loc_bind(c, k.name, pe);
        }
        i = i + 1;
    }
    // The body is the last kid.
    let body: Node = fn_node.kids[len(fn_node.kids) - 1];
    c = es_walk_block(c, body);
    return ESFnOut { c: c, err_enum: c.es_acc_err_enum, err_set: c.es_acc_err_set, val_enum: c.es_acc_val_enum, val_set: c.es_acc_val_set };
}

// The FuncDef node for a walkable function key (plain name, or
// Struct__method for a method), or a kind -1 node when absent.
// Template functions (name carries "~" type params) are skipped:
// their bodies are never checked, so they have no summary.
fn es_find_fn(prog: Node, key: str) -> Node {
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 {
            let sp: [str] = split_tparams(n.name);
            if sp[0] == key && sp[1] == "" {
                return n;
            }
        }
        if n.kind == 6 {
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                let msp: [str] = split_tparams(m.name);
                if n.name + "__" + msp[0] == key && msp[1] == "" {
                    return m;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return new_node(-1, 0, 0);
}

// ---------- fixpoint ----------

// Worklist fixpoint over the call graph (ES-C6). Every walkable
// function is walked once in program order; when a walk grows a
// summary, every caller of that function is enqueued. Summaries
// only grow (union, TOP at most), so the worklist terminates;
// the 10,000-step bound widens everything not yet stable to TOP
// on hit (and records it). After the fixpoint, every function is
// re-walked once with verdicts enabled (ES-C5).
fn es_infer(c0: HChecker, prog: Node, dump: bool) -> HChecker {
    let mut c: HChecker = c0;
    // Collect the walkable functions (key, in program order):
    // concrete FuncDefs with a body, and ImplDef methods with a
    // body. Externs (no body) and generic templates are skipped.
    let mut keys: [str] = [];
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 {
            let sp: [str] = split_tparams(n.name);
            // Externs carry an empty Block body (parse_extern
            // appends one), so the body check alone does not
            // exclude them — the bval flag is the extern test.
            if sp[1] == "" && !n.bval && len(n.kids) > 0 && n.kids[len(n.kids) - 1].kind == 9 {
                push(keys, sp[0]);
            }
        }
        if n.kind == 6 {
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                let msp: [str] = split_tparams(m.name);
                if msp[1] == "" && !m.bval && len(m.kids) > 0 && m.kids[len(m.kids) - 1].kind == 9 {
                    push(keys, n.name + "__" + msp[0]);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    let mut work: [str] = [];
    let mut wi: int = 0;
    let mut k: int = 0;
    while k < len(keys) {
        push(work, keys[k]);
        k = k + 1;
    }
    let mut steps: int = 0;
    while wi < len(work) {
        let name: str = work[wi];
        wi = wi + 1;
        steps = steps + 1;
        if steps > 10000 {
            c.es_bound_hit = true;
            break;
        }
        let fn_node: Node = es_find_fn(prog, name);
        if fn_node.kind == -1 {
            continue;
        }
        let out: ESFnOut = es_walk_fn(c, fn_node, name, false);
        c = out.c;
        // Record the callee edges (reverse graph) from this walk.
        let mut ei: int = 0;
        while ei < len(c.es_callees) {
            let edge: str = name + "~" + c.es_callees[ei];
            if !es_has_edge(c, edge) {
                push(c.es_edges, edge);
            }
            ei = ei + 1;
        }
        // Store the summaries; enqueue callers when one grew.
        let mut grew: bool = false;
        if out.err_enum != "" {
            if out.err_set != es_get_set(c, name, "S") {
                grew = true;
            }
            c = es_put_set(c, name, "S", out.err_enum, out.err_set);
        }
        if out.val_enum != "" {
            if out.val_set != es_get_set(c, name, "V") {
                grew = true;
            }
            c = es_put_set(c, name, "V", out.val_enum, out.val_set);
        }
        if grew {
            let mut ci: int = 0;
            while ci < len(c.es_edges) {
                let parts: [str] = split(c.es_edges[ci], "~");
                if len(parts) == 2 && parts[1] == name {
                    let caller: str = parts[0];
                    let mut queued: bool = false;
                    let mut qi: int = wi;
                    while qi < len(work) {
                        if work[qi] == caller {
                            queued = true;
                        }
                        qi = qi + 1;
                    }
                    if !queued {
                        push(work, caller);
                    }
                }
                ci = ci + 1;
            }
        }
    }
    if c.es_bound_hit {
        // Widen every stored summary to TOP (sound, ES-C4).
        let mut bi: int = 0;
        while bi < len(c.es_names) {
            c.es_sets[bi] = "TOP";
            bi = bi + 1;
        }
    }
    // Final verdict walk (ES-C5): re-walk every walkable function
    // with verdicts enabled (the verdicts use the final
    // summaries).
    let mut vi: int = 0;
    while vi < len(keys) {
        let fn_node: Node = es_find_fn(prog, keys[vi]);
        if fn_node.kind != -1 {
            let out: ESFnOut = es_walk_fn(c, fn_node, keys[vi], true);
            c = out.c;
        }
        vi = vi + 1;
    }
    if dump {
        c = es_dump(c, prog);
    }
    return c;
}

// ---------- dump ----------

fn es_format_set(c: HChecker, enm: str, set: str) -> str {
    if set == "TOP" {
        return "TOP";
    }
    if set == "" {
        return "{}";
    }
    let variants: [str] = enum_variant_names(c, enm);
    let mut names: [str] = [];
    let mut i: int = 0;
    while i < len(variants) {
        if es_has(set, variants[i]) {
            push(names, variants[i]);
        }
        i = i + 1;
    }
    // Any member outside the enum's list (defensive) goes last,
    // in encoded order.
    let parts: [str] = split(set, "~");
    let mut j: int = 0;
    while j < len(parts) {
        if !es_has(es_join(variants), parts[j]) {
            push(names, parts[j]);
        }
        j = j + 1;
    }
    return "{" + es_join_comma(names) + "}";
}

fn es_dump_fn(c: HChecker, key: str, ret: str) -> HChecker {
    let mut k: int = 0;
    while k < len(c.es_names) {
        if c.es_names[k] == key {
            if c.es_kinds[k] == "S" {
                let e: str = es_result_err(ret);
                eprintln("fn " + key + " -> Result<_, " + e + ">: " + es_format_set(c, c.es_enums[k], c.es_sets[k]));
            }
            if c.es_kinds[k] == "V" {
                eprintln("fn " + key + " -> " + ret + ": " + es_format_set(c, c.es_enums[k], c.es_sets[k]));
            }
        }
        k = k + 1;
    }
    return c;
}

// One line per function with a set-bearing return, in program
// order — plain functions first, then methods (matching Python's
// dump order: source funcs, then the method specs appended by
// collect_impls, then generic instantiations, which hosted never
// creates): `fn <name> -> Result<_, E>: {A, B}` or `TOP` or `{}`,
// and `fn <name> -> <Enum>: {...}` for bare-enum returns.
fn es_dump(c0: HChecker, prog: Node) -> HChecker {
    let mut c: HChecker = c0;
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 {
            c = es_dump_fn(c, split_tparams(n.name)[0], n.sval);
        }
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(prog.kids) {
        let n: Node = prog.kids[j];
        if n.kind == 6 {
            let mut m: int = 0;
            while m < len(n.kids) {
                let md: Node = n.kids[m];
                c = es_dump_fn(c, n.name + "__" + split_tparams(md.name)[0], md.sval);
                m = m + 1;
            }
        }
        j = j + 1;
    }
    return c;
}

// ---------- program entry ----------
// Returns true if the program checks clean; fails otherwise.

// ---------- comptime if resolution (Top-500 #70) ----------
// The hosted checker cannot rewrite the AST in place (nodes are
// values — see the alias-expansion note above), so `comptime if`
// resolution is a deterministic tree-rebuilding pass, mirroring
// expand_aliases_prog: resolve_comptime_prog rebuilds the program
// with every ComptimeIf replaced by its taken branch's statements
// (the discarded branch is parsed only, never checked/compiled).
// check_program calls it at entry (so the checker always sees
// resolved code) and compile_to_c calls it on the merged program
// (so run_infer and codegen_program see the SAME resolved program
// the checker saw — the hosted driver's one-mutated-program rule,
// matching Python's in-place splice). With no ComptimeIf in the
// tree the original node is returned untouched, so the bootstrap
// emit stays byte-identical.

// Rebuild a node with a different kids array (the alias expander's
// shape: copy the struct, replace kids, return the new node).
fn ct_with_kids(n: Node, kids: [Node]) -> Node {
    let mut out: Node = n;
    out.kids = kids;
    return out;
}

// True when the tree contains a ComptimeIf (kind 49) anywhere,
// including inside a lambda nested in an expression.
fn ct_has_comptime_if(n: Node) -> bool {
    if n.kind == 49 {
        return true;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if ct_has_comptime_if(n.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Evaluate a Pred node (kind 50) against this check's Target.
// The parser admits only the fixed set, so every kind here is
// known; an undecidable condition is impossible by construction.
fn ct_eval_pred(c: HChecker, pred: Node) -> bool {
    if pred.name == "and" {
        return ct_eval_pred(c, pred.kids[0]) && ct_eval_pred(c, pred.kids[1]);
    }
    if pred.name == "or" {
        return ct_eval_pred(c, pred.kids[0]) || ct_eval_pred(c, pred.kids[1]);
    }
    if pred.name == "not" {
        return !ct_eval_pred(c, pred.kids[0]);
    }
    if pred.name == "debug" {
        return c.debug;
    }
    if pred.name == "freestanding" {
        return c.freestanding;
    }
    let mut actual: str = "";
    if pred.name == "target" {
        actual = c.target;
    } else if pred.name == "arch" {
        actual = c.arch;
    } else if pred.name == "os" {
        actual = c.os;
    } else {
        actual = c.mode;
    }
    if pred.label == "==" {
        return actual == pred.sval;
    }
    return actual != pred.sval;
}

// The taken branch's statements for a ComptimeIf (kind 49):
// kids[0] = Pred, kids[1] = then Block, kids[2] = else Block when
// present. An `else comptime if` is a one-statement Block wrapping
// a nested ComptimeIf, so it resolves recursively.
fn ct_taken_stmts(c: HChecker, n: Node) -> [Node] {
    if ct_eval_pred(c, n.kids[0]) {
        return n.kids[1].kids;
    }
    if len(n.kids) < 3 {
        return [];
    }
    let els: Node = n.kids[2];
    if len(els.kids) == 1 && els.kids[0].kind == 49 {
        return ct_taken_stmts(c, els.kids[0]);
    }
    return els.kids;
}

// Resolve a statement list: each ComptimeIf is replaced by its
// taken branch's statements (recursively resolved); every other
// statement is rebuilt with its nested blocks resolved.
fn ct_resolve_stmts(c: HChecker, stmts: [Node]) -> [Node] {
    let mut out: [Node] = [];
    let mut i: int = 0;
    while i < len(stmts) {
        let n: Node = stmts[i];
        if n.kind == 49 {
            let taken: [Node] = ct_taken_stmts(c, n);
            let resolved: [Node] = ct_resolve_stmts(c, taken);
            let mut j: int = 0;
            while j < len(resolved) {
                push(out, resolved[j]);
                j = j + 1;
            }
        } else {
            push(out, ct_resolve_node(c, n));
        }
        i = i + 1;
    }
    return out;
}

// Rebuild one node with its nested statement lists resolved. A
// Block's kids are statements (resolve_stmts); every other node
// rebuilds with each kid resolved, which walks expressions to
// find lambdas (kind 47) whose bodies are Blocks.
fn ct_resolve_node(c: HChecker, n: Node) -> Node {
    if n.kind == 9 {
        return ct_with_kids(n, ct_resolve_stmts(c, n.kids));
    }
    let mut kids: [Node] = [];
    let mut i: int = 0;
    while i < len(n.kids) {
        push(kids, ct_resolve_node(c, n.kids[i]));
        i = i + 1;
    }
    return ct_with_kids(n, kids);
}

// The entry point: the program with every ComptimeIf resolved,
// or the original node untouched when there is nothing to do.
fn resolve_comptime_prog(c: HChecker, prog: Node) -> Node {
    if !ct_has_comptime_if(prog) {
        return prog;
    }
    return ct_resolve_node(c, prog);
}

// ---------- Top-500 #74: generators / yield ----------
// Checker-side state-machine desugar (the #70/#72 pattern: a
// deterministic program-level tree-rebuilding pass, run once at
// check_program entry and once in compile_to_c on the merged
// program). A generator fn `fn name(...) -> Generator<T>` becomes
// a CONSTRUCTOR (same name, builds the value, body never runs)
// plus a STEP FUNCTION `<name>_next(g: Generator<T>) ->
// Option<T>` (the #75 it_next precedent). The design doc is
// blackmoon-iso/generators-slice/DESIGN.md; the Python mirror is
// forge_lang/generators.py. Error strings are identical in both
// compilers (DESIGN.md §3.5). Order is FORCED (DESIGN.md §3.8):
// generators -> walrus -> comptime, in both check_program and
// compile_to_c, so a walrus or a yield inside a comptime branch
// is a named error here, not silently desugared away.
// State lives in ONE shared generic struct `Generator<T> {
// kind: int, cur: T, slots_i: [int], slots_s: [str], slots_b:
// [bool] }` (forge_lang/stdlib/generators.fg): params/locals are
// lifted into slot arrays, slots_i[0] is the state, cur is a
// type witness holding the zero value. The step fn is a `while
// (true)` dispatch loop over `if (g.slots_i[0] == N)` segments;
// each segment ends with a yield-return, a return-none, or a
// state jump. v1 limits (DESIGN.md §7): element/local/param
// types int/str/bool only; `for x in g` does not work (manual
// next() loop instead); no yield in match arms, comptime
// branches, for-over-array, scope blocks, or nested lambdas; no
// defer and no walrus in a generator body; native only.
// The transform state is threaded through every helper (the
// HChecker pattern: take it by value, return the updated copy);
// helpers that also produce a value return a G*Out wrapper.
// Arrays are copied on assignment, so every array-field
// mutation goes through a local copy and assigns back.
// NOTE: the G* structs live in selfhost_infer.fg, NOT here —
// the codegen emits array-free helpers in struct-registration
// order and emits no forward declarations (the #47 latent bug),
// so a struct containing a Node must be defined in a file
// merged AFTER selfhost_parse.fg (which defines Node), else the
// generated C calls forge_Node_array_free before its static
// definition and the CLI build fails to compile. GState,
// GNodeOut, GNodesOut and GTransformOut hold Nodes; GGen holds
// GState, so the whole group moves together, in dependency
// order.

fn g_new() -> GGen {
    return GGen { fn_names: [], fn_rets: [], fn_param_typs: [], fn_type_params: [], struct_names: [], struct_field_names: [], struct_field_typs: [], struct_type_params: [], fn_name: "", fn_line: 0, fn_col: 0, elem: "", kind: 0, scopes: [], states: [], cur_state: 0, end_state: 0, int_count: 1, str_count: 0, bool_count: 0, loop_labels: [], loop_is_split: [], loop_brk: [], loop_cont: [], kind_counter: 0, syn: 0, target: "", freestanding: false };
}

// A fresh source position for a transform-built node (see the
// `syn` field on GGen): the line is kept, the col is a
// synthetic 100000+syn that no real source line reaches, so no
// two built nodes share a (line, col) map key. Returns the
// updated g (syn incremented) and the fresh position.
fn g_fresh(g0: GGen, line: int, col: int) -> GPosOut {
    let mut g: GGen = g0;
    let c: int = 100000 + g.syn;
    g.syn = g.syn + 1;
    return GPosOut { g: g, line: line, col: c };
}

// Build one node at a fresh synthetic position (see g_fresh).
// Use for every EXPRESSION node the transform builds; statement
// nodes keep new_node (their types are never read from the map,
// and their real position is what backtraces report).
fn g_node(g0: GGen, kind: int, line: int, col: int) -> GNodeOut {
    let po: GPosOut = g_fresh(g0, line, col);
    let nd: Node = new_node(kind, po.line, po.col);
    return GNodeOut { g: po.g, node: nd };
}

// Join a string list with a separator ("" for an empty list).
fn join_strs(parts: [str], sep: str) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(parts) {
        if i > 0 {
            out = out + sep;
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

fn g_is_gen_elem(t: str) -> bool {
    return t == "int" || t == "str" || t == "bool";
}

// The element type of a `Generator<T>` return type, or "" when
// the type is not a Generator instantiation.
fn g_gen_ret(ret: str) -> str {
    if generic_base(ret) != "Generator" {
        return "";
    }
    let args: [str] = generic_args(ret);
    if len(args) != 1 {
        return "";
    }
    return args[0];
}

// The zero literal of a v1 element type (fresh position: see
// g_fresh — every built node gets its own (line, col) key).
fn g_zero(g0: GGen, elem: str, line: int, col: int) -> GNodeOut {
    if elem == "str" {
        let o: GNodeOut = g_node(g0, 27, line, col);
        let mut n: Node = o.node;
        n.sval = "";
        return GNodeOut { g: o.g, node: n };
    }
    if elem == "bool" {
        let o: GNodeOut = g_node(g0, 28, line, col);
        let mut n: Node = o.node;
        n.bval = false;
        return GNodeOut { g: o.g, node: n };
    }
    let o: GNodeOut = g_node(g0, 25, line, col);
    let mut n: Node = o.node;
    n.ival = 0;
    return GNodeOut { g: o.g, node: n };
}

fn g_int(g0: GGen, n: int, line: int, col: int) -> GNodeOut {
    let o: GNodeOut = g_node(g0, 25, line, col);
    let mut nd: Node = o.node;
    nd.ival = n;
    return GNodeOut { g: o.g, node: nd };
}

fn g_var(g0: GGen, name: str, line: int, col: int) -> GNodeOut {
    let o: GNodeOut = g_node(g0, 34, line, col);
    let mut nd: Node = o.node;
    nd.name = name;
    return GNodeOut { g: o.g, node: nd };
}

fn g_str(g0: GGen, s: str, line: int, col: int) -> GNodeOut {
    let o: GNodeOut = g_node(g0, 27, line, col);
    let mut nd: Node = o.node;
    nd.sval = s;
    return GNodeOut { g: o.g, node: nd };
}

fn g_bool(g0: GGen, b: bool, line: int, col: int) -> GNodeOut {
    let o: GNodeOut = g_node(g0, 28, line, col);
    let mut nd: Node = o.node;
    nd.bval = b;
    return GNodeOut { g: o.g, node: nd };
}

// The type params encoded in a fn/struct name's "<T,U>"
// suffix, or [] when the name has none.
fn g_name_type_params(name: str) -> [str] {
    let lt: int = find_lt(name);
    if lt < 0 {
        return [];
    }
    if substr(name, len(name) - 1, 1) != ">" {
        return [];
    }
    let inner: str = substr(name, lt + 1, len(name) - lt - 2);
    if inner == "" {
        return [];
    }
    return split(inner, ",");
}

// The base name without any "<T,U>" suffix.
fn g_name_base(name: str) -> str {
    let lt: int = find_lt(name);
    if lt < 0 {
        return name;
    }
    return substr(name, 0, lt);
}

// Build the fn/struct tables by scanning the program's
// top-level definitions (the transform runs before
// collect_defs, so it cannot use the checker's tables).
fn g_build_tables(g0: GGen, prog: Node) -> GGen {
    let mut g: GGen = g0;
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 {
            let mut fnames: [str] = g.fn_names;
            push(fnames, g_name_base(n.name));
            g.fn_names = fnames;
            let mut frets: [str] = g.fn_rets;
            push(frets, n.sval);
            g.fn_rets = frets;
            let mut pts: [str] = [];
            let mut j: int = 0;
            while j + 1 < len(n.kids) {
                push(pts, n.kids[j].sval);
                j = j + 1;
            }
            let mut fpts: [str] = g.fn_param_typs;
            push(fpts, join_strs(pts, "~"));
            g.fn_param_typs = fpts;
            let mut ftp: [str] = g.fn_type_params;
            push(ftp, join_strs(g_name_type_params(n.name), "~"));
            g.fn_type_params = ftp;
        }
        if n.kind == 3 {
            let mut snames: [str] = g.struct_names;
            push(snames, g_name_base(n.name));
            g.struct_names = snames;
            let mut fns: [str] = [];
            let mut fts: [str] = [];
            let mut j: int = 0;
            while j < len(n.kids) {
                push(fns, n.kids[j].name);
                push(fts, n.kids[j].sval);
                j = j + 1;
            }
            let mut sfn: [str] = g.struct_field_names;
            push(sfn, join_strs(fns, "~"));
            g.struct_field_names = sfn;
            let mut sft: [str] = g.struct_field_typs;
            push(sft, join_strs(fts, "~"));
            g.struct_field_typs = sft;
            let mut stp: [str] = g.struct_type_params;
            push(stp, join_strs(g_name_type_params(n.name), "~"));
            g.struct_type_params = stp;
        }
        i = i + 1;
    }
    return g;
}

fn g_fn_index(g: GGen, name: str) -> int {
    let mut i: int = 0;
    while i < len(g.fn_names) {
        if g.fn_names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn g_struct_index(g: GGen, name: str) -> int {
    let mut i: int = 0;
    while i < len(g.struct_names) {
        if g.struct_names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// The fields of a (possibly generic-instantiated) struct type
// as "~"-joined "name:type" pairs, or "" when unknown.
fn g_struct_fields_of(g: GGen, t: str) -> str {
    let base: str = generic_base(t);
    let si: int = g_struct_index(g, base);
    if si < 0 {
        return "";
    }
    let args: [str] = generic_args(t);
    let mut params: [str] = split(g.struct_type_params[si], "~");
    if len(params) == 1 && params[0] == "" {
        params = [];
    }
    if len(args) != len(params) {
        if len(args) == 0 && len(params) == 0 {
            // A plain (non-generic) struct: no substitution.
        } else {
            return "";
        }
    }
    let names: [str] = split(g.struct_field_names[si], "~");
    let typs: [str] = split(g.struct_field_typs[si], "~");
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(names) {
        let ft: str = substitute_type(typs[i], params, args);
        if out == "" {
            out = names[i] + ":" + ft;
        } else {
            out = out + "~" + names[i] + ":" + ft;
        }
        i = i + 1;
    }
    return out;
}

// Look up one field's type in a "~"-joined "name:type" list,
// or "" when absent.
fn g_field_type(fields: str, name: str) -> str {
    if fields == "" {
        return "";
    }
    let parts: [str] = split(fields, "~");
    let mut i: int = 0;
    while i < len(parts) {
        let kv: [str] = split(parts[i], ":");
        if len(kv) == 2 && kv[0] == name {
            return kv[1];
        }
        i = i + 1;
    }
    return "";
}

// True when node `n` contains a Yield anywhere, not
// crossing a lambda boundary (a yield inside a lambda belongs
// to the lambda, and the pre-scan rejects it separately).
fn g_has_yield(n: Node) -> bool {
    if n.kind == 52 {
        return true;
    }
    if n.kind == 47 {
        return false;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if g_has_yield(n.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn g_has_yield_stmts(stmts: [Node]) -> bool {
    let mut i: int = 0;
    while i < len(stmts) {
        if g_has_yield(stmts[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// First Defer (kind 23) in the body proper, or a kind-0 node
// when there is none. Mirrors g_has_yield: does NOT descend
// into lambdas (kind 47) — a defer inside a lambda is the
// lambda's own business. The caller (resolve_generators_prog)
// raises the defer error only when the fn is a generator; the
// pre-scan itself must not raise it, or ordinary fns with a
// defer (corpus v23/v24/v27/v89) would fail.
fn g_find_defer(n: Node) -> Node {
    if n.kind == 23 {
        return n;
    }
    if n.kind == 47 {
        return new_node(0, 0, 0);
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        let d: Node = g_find_defer(n.kids[i]);
        if d.kind == 23 {
            return d;
        }
        i = i + 1;
    }
    return new_node(0, 0, 0);
}

fn g_find_defer_stmts(stmts: [Node]) -> Node {
    let mut i: int = 0;
    while i < len(stmts) {
        let d: Node = g_find_defer(stmts[i]);
        if d.kind == 23 {
            return d;
        }
        i = i + 1;
    }
    return new_node(0, 0, 0);
}

// Scan a lambda body for a yield: a yield inside a nested
// function or closure is a v1 error (it belongs to the lambda,
// which has no state machine). Returns false; the caller's
// yield does not count.
fn g_scan_lambda_body(g: GGen, body: Node) -> bool {
    if g_has_yield_stmts(body.kids) {
        fail_at(body.line, body.col, "yield cannot appear inside a nested function or closure in v1");
    }
    let mut i: int = 0;
    while i < len(body.kids) {
        g_scan_stmt(g, body.kids[i], true);
        i = i + 1;
    }
    return false;
}

// Scan an expression for a yield (only lambdas can contain
// one; a bare yield is a statement, never an expression).
fn g_scan_expr(g: GGen, e: Node, in_lambda: bool) -> bool {
    if e.kind == 47 {
        return g_scan_lambda_body(g, e.kids[len(e.kids) - 1]);
    }
    let mut i: int = 0;
    while i < len(e.kids) {
        if g_scan_expr(g, e.kids[i], in_lambda) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Scan one statement; raises the position-specific v1 errors
// (yield in a match arm / comptime branch / scope block, defer
// in a generator body). Returns true when a Yield is found.
fn g_scan_stmt(g: GGen, s: Node, in_lambda: bool) -> bool {
    if s.kind == 52 {
        if in_lambda {
            fail_at(s.line, s.col, "yield cannot appear inside a nested function or closure in v1");
        }
        g_scan_expr(g, s.kids[0], in_lambda);
        return true;
    }
    if s.kind == 23 {
        // Recorded, not raised here (see g_find_defer_stmts):
        // the pre-scan runs on EVERY fn (to find yields), but a
        // defer is only an error inside a GENERATOR fn; a
        // non-generator fn with a defer is fine (the corpus
        // defer files v23/v24/v27/v89 tripped this). A defer
        // inside a lambda is the lambda's own business.
        g_scan_expr(g, s.kids[0], in_lambda);
        return false;
    }
    if s.kind == 20 {
        let mut i: int = 1;
        while i < len(s.kids) {
            if g_has_yield(s.kids[i]) {
                fail_at(s.line, s.col, "yield cannot appear inside a match arm in v1 (use if/else)");
            }
            i = i + 1;
        }
        let mut found: bool = false;
        let mut j: int = 1;
        while j < len(s.kids) {
            if g_scan_arm_stmts(g, s.kids[j]) {
                found = true;
            }
            j = j + 1;
        }
        if g_scan_expr(g, s.kids[0], in_lambda) {
            found = true;
        }
        return found;
    }
    if s.kind == 49 {
        let mut i: int = 1;
        while i < len(s.kids) {
            if g_has_yield(s.kids[i]) {
                fail_at(s.line, s.col, "yield cannot appear inside a comptime if branch in v1");
            }
            i = i + 1;
        }
        let mut found: bool = false;
        let mut j: int = 1;
        while j < len(s.kids) {
            if g_scan_stmts(g, s.kids[j].kids, in_lambda) {
                found = true;
            }
            j = j + 1;
        }
        return found;
    }
    if s.kind == 22 {
        if g_has_yield(s.kids[0]) {
            fail_at(s.line, s.col, "yield cannot appear inside a scope block in v1");
        }
        return g_scan_stmts(g, s.kids[0].kids, in_lambda);
    }
    if s.kind == 9 {
        return g_scan_stmts(g, s.kids, in_lambda);
    }
    if s.kind == 14 {
        let mut found: bool = g_scan_expr(g, s.kids[0], in_lambda);
        let mut i: int = 1;
        while i < len(s.kids) {
            if g_scan_stmts(g, s.kids[i].kids, in_lambda) {
                found = true;
            }
            i = i + 1;
        }
        return found;
    }
    if s.kind == 15 {
        let mut found: bool = g_scan_expr(g, s.kids[0], in_lambda);
        if g_scan_stmts(g, s.kids[1].kids, in_lambda) {
            found = true;
        }
        return found;
    }
    if s.kind == 16 {
        let mut found: bool = g_scan_expr(g, s.kids[0], in_lambda);
        if g_scan_stmts(g, s.kids[1].kids, in_lambda) {
            found = true;
        }
        return found;
    }
    if s.kind == 10 || s.kind == 11 {
        return g_scan_expr(g, s.kids[0], in_lambda);
    }
    if s.kind == 12 || s.kind == 13 {
        let mut found: bool = g_scan_expr(g, s.kids[0], in_lambda);
        if g_scan_expr(g, s.kids[1], in_lambda) {
            found = true;
        }
        return found;
    }
    if s.kind == 24 || s.kind == 21 {
        return g_scan_expr(g, s.kids[0], in_lambda);
    }
    if s.kind == 17 {
        if len(s.kids) > 0 {
            return g_scan_expr(g, s.kids[0], in_lambda);
        }
        return false;
    }
    return false;
}

// Scan a match arm's body statements (the arm's bindings are
// opaque; a yield inside one is already rejected above).
fn g_scan_arm_stmts(g: GGen, arm: Node) -> bool {
    return g_scan_stmts(g, arm.kids[0].kids, false);
}

fn g_scan_stmts(g: GGen, stmts: [Node], in_lambda: bool) -> bool {
    // Accumulate and keep scanning: a yield must not hide a
    // later error (the Python scan behaves the same way).
    let mut found: bool = false;
    let mut i: int = 0;
    while i < len(stmts) {
        if g_scan_stmt(g, stmts[i], in_lambda) {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

// Scan a whole function body. Returns true when it contains a
// Yield (outside any lambda). Raises the v1 errors above.
fn g_scan_body(g: GGen, body: Node) -> bool {
    return g_scan_stmts(g, body.kids, false);
}

// Look up a name in the scope stack (innermost first).
fn g_lookup(g: GGen, name: str) -> GBinding {
    let mut fi: int = len(g.scopes) - 1;
    while fi >= 0 {
        let fr: GScope = g.scopes[fi];
        let mut i: int = len(fr.names) - 1;
        while i >= 0 {
            if fr.names[i] == name {
                return GBinding { found: true, kind: fr.kinds[i], arr: fr.arrs[i], idx: fr.idxs[i], typ: fr.typs[i] };
            }
            i = i - 1;
        }
        fi = fi - 1;
    }
    return GBinding { found: false, kind: "", arr: "", idx: 0, typ: "" };
}

fn g_scope_push(g0: GGen) -> GGen {
    let mut g: GGen = g0;
    let mut sc: [GScope] = g.scopes;
    push(sc, GScope { names: [], kinds: [], arrs: [], idxs: [], typs: [] });
    g.scopes = sc;
    return g;
}

fn g_scope_pop(g0: GGen) -> GGen {
    let mut g: GGen = g0;
    let mut sc: [GScope] = g.scopes;
    let mut out: [GScope] = [];
    let mut i: int = 0;
    while i + 1 < len(sc) {
        push(out, sc[i]);
        i = i + 1;
    }
    g.scopes = out;
    return g;
}

// Allocate one slot of the given type; returns the array
// name and index (the counts are part of g).
fn g_alloc_slot(g0: GGen, typ: str) -> GSlotOut {
    let mut g: GGen = g0;
    if typ == "int" {
        let idx: int = g.int_count;
        g.int_count = g.int_count + 1;
        return GSlotOut { g: g, arr: "slots_i", idx: idx };
    }
    if typ == "str" {
        let idx: int = g.str_count;
        g.str_count = g.str_count + 1;
        return GSlotOut { g: g, arr: "slots_s", idx: idx };
    }
    let idx: int = g.bool_count;
    g.bool_count = g.bool_count + 1;
    return GSlotOut { g: g, arr: "slots_b", idx: idx };
}

// Declare a lifted binding in the innermost frame.
fn g_declare_slot(g0: GGen, name: str, typ: str) -> GGen {
    let mut g: GGen = g0;
    let al: GSlotOut = g_alloc_slot(g, typ);
    g = al.g;
    let mut sc: [GScope] = g.scopes;
    let mut fr: GScope = sc[len(sc) - 1];
    let mut names: [str] = fr.names;
    push(names, name);
    fr.names = names;
    let mut kinds: [str] = fr.kinds;
    push(kinds, "slot");
    fr.kinds = kinds;
    let mut arrs: [str] = fr.arrs;
    push(arrs, al.arr);
    fr.arrs = arrs;
    let mut idxs: [int] = fr.idxs;
    push(idxs, al.idx);
    fr.idxs = idxs;
    let mut typs: [str] = fr.typs;
    push(typs, typ);
    fr.typs = typs;
    sc[len(sc) - 1] = fr;
    g.scopes = sc;
    return g;
}

// Declare an opaque binding in the innermost frame.
fn g_declare_opaque(g0: GGen, name: str, typ: str) -> GGen {
    let mut g: GGen = g0;
    let mut sc: [GScope] = g.scopes;
    let mut fr: GScope = sc[len(sc) - 1];
    let mut names: [str] = fr.names;
    push(names, name);
    fr.names = names;
    let mut kinds: [str] = fr.kinds;
    push(kinds, "opaque");
    fr.kinds = kinds;
    let mut arrs: [str] = fr.arrs;
    push(arrs, "");
    fr.arrs = arrs;
    let mut idxs: [int] = fr.idxs;
    push(idxs, 0);
    fr.idxs = idxs;
    let mut typs: [str] = fr.typs;
    push(typs, typ);
    fr.typs = typs;
    sc[len(sc) - 1] = fr;
    g.scopes = sc;
    return g;
}

// The type prover (best-effort; the checker is the backstop).
// Returns a type string, or "" when it cannot be proved.
fn g_prove_type(g: GGen, e: Node) -> str {
    if e.kind == 25 {
        return "int";
    }
    if e.kind == 26 {
        return "float";
    }
    if e.kind == 27 {
        return "str";
    }
    if e.kind == 28 {
        return "bool";
    }
    if e.kind == 34 {
        let b: GBinding = g_lookup(g, e.name);
        if !b.found {
            return "";
        }
        return b.typ;
    }
    if e.kind == 40 {
        let op: str = e.name;
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
            return "bool";
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "<<" || op == ">>" || op == "&" || op == "|" || op == "^" {
            let lt: str = g_prove_type(g, e.kids[0]);
            let rt: str = g_prove_type(g, e.kids[1]);
            if op == "+" && (lt == "str" || rt == "str") {
                return "str";
            }
            if lt == "float" || rt == "float" {
                return "float";
            }
            if lt == "int" && rt == "int" {
                return "int";
            }
            return "";
        }
        return "";
    }
    if e.kind == 41 {
        if e.name == "!" {
            return "bool";
        }
        return g_prove_type(g, e.kids[0]);
    }
    if e.kind == 35 {
        return g_prove_call(g, e);
    }
    if e.kind == 46 {
        let ct: str = g_prove_type(g, e.kids[0]);
        if ct != "" && is_fn_type(ct) {
            return fn_type_ret(ct);
        }
        return "";
    }
    if e.kind == 36 {
        let bt: str = g_prove_type(g, e.kids[0]);
        if bt == "str" {
            return "str";
        }
        if is_array(bt) {
            return elem_type(bt);
        }
        return "";
    }
    if e.kind == 37 {
        let bt: str = g_prove_type(g, e.kids[0]);
        if bt != "" && is_tuple(bt) {
            let elems: [str] = tuple_elems(bt);
            if e.ival >= 0 && e.ival < len(elems) {
                return elems[e.ival];
            }
        }
        return "";
    }
    if e.kind == 32 {
        let bt: str = g_prove_type(g, e.kids[0]);
        if bt == "" {
            return "";
        }
        let fields: str = g_struct_fields_of(g, bt);
        return g_field_type(fields, e.name);
    }
    if e.kind == 33 {
        let bt: str = g_prove_type(g, e.kids[0]);
        if bt == "range" {
            if e.name == "len" {
                return "int";
            }
            if e.name == "contains" {
                return "bool";
            }
        }
        return "";
    }
    if e.kind == 31 {
        return e.name;
    }
    if e.kind == 29 {
        if len(e.kids) == 0 {
            return "";
        }
        let et: str = g_prove_type(g, e.kids[0]);
        if et == "" {
            return "";
        }
        return "[" + et + "]";
    }
    if e.kind == 30 {
        let mut parts: [str] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let p: str = g_prove_type(g, e.kids[i]);
            if p == "" {
                return "";
            }
            push(parts, p);
            i = i + 1;
        }
        return "(" + join_strs(parts, ", ") + ")";
    }
    if e.kind == 38 {
        return "range";
    }
    if e.kind == 39 {
        return e.sval;
    }
    if e.kind == 42 {
        let t: str = g_prove_type(g, e.kids[0]);
        if t == "" {
            return "";
        }
        let base: str = generic_base(t);
        if base == "Option" || base == "Result" {
            let args: [str] = generic_args(t);
            if len(args) > 0 {
                return args[0];
            }
        }
        return "";
    }
    if e.kind == 47 {
        let mut params: [str] = [];
        let mut i: int = 0;
        while i + 1 < len(e.kids) {
            push(params, e.kids[i].sval);
            i = i + 1;
        }
        return "fn(" + join_strs(params, ", ") + ") -> " + e.sval;
    }
    return "";
}

// Prove a call's return type: builtin table first, then the
// fn table (with generic type-param binding from the args).
fn g_prove_call(g: GGen, e: Node) -> str {
    let bt: str = g_builtin_ret(e.name);
    if bt != "" {
        return bt;
    }
    let fi: int = g_fn_index(g, e.name);
    if fi < 0 {
        return "";
    }
    let tparams: [str] = split(g.fn_type_params[fi], "~");
    let mut tp: [str] = tparams;
    if len(tp) == 1 && tp[0] == "" {
        tp = [];
    }
    if len(tp) == 0 {
        return g.fn_rets[fi];
    }
    return g_prove_generic_call(g, fi, e, tp);
}

// Bind a generic fn's type params from the call args
// (positional, first-use order) and substitute into its
// return type. "" when it cannot be bound.
fn g_prove_generic_call(g: GGen, fi: int, e: Node, tp: [str]) -> str {
    let pts: [str] = split(g.fn_param_typs[fi], "~");
    let mut bnames: [str] = [];
    let mut btypes: [str] = [];
    let mut i: int = 0;
    while i < len(pts) && i < len(e.kids) {
        let pt: str = pts[i];
        let mut is_tp: bool = false;
        let mut j: int = 0;
        while j < len(tp) {
            if tp[j] == pt {
                is_tp = true;
            }
            j = j + 1;
        }
        if is_tp {
            let mut bound: bool = false;
            let mut k: int = 0;
            while k < len(bnames) {
                if bnames[k] == pt {
                    bound = true;
                }
                k = k + 1;
            }
            if !bound {
                let at: str = g_prove_type(g, e.kids[i]);
                if at != "" {
                    push(bnames, pt);
                    push(btypes, at);
                }
            }
        }
        i = i + 1;
    }
    if len(bnames) != len(tp) {
        return "";
    }
    return substitute_type(g.fn_rets[fi], bnames, btypes);
}

// The builtin return-type table (mirrors the Python
// _BUILTIN_RET exactly — the two provers must agree, or the
// yield-type and let-annotation errors would fire in one
// compiler and not the other). "" when the name is not a builtin.
fn g_builtin_ret(name: str) -> str {
    if name == "len" || name == "clock_micros" || name == "panicked_tasks" || name == "last_errno" || name == "parse_int" {
        return "int";
    }
    if name == "parse_float" || name == "sqrt" || name == "exp" || name == "log" || name == "sin" || name == "cos" || name == "tan" || name == "pow" {
        return "float";
    }
    if name == "read_line" || name == "read_file" || name == "substr" || name == "trim" || name == "join" {
        return "str";
    }
    if name == "split" {
        return "[str]";
    }
    if name == "starts_with" || name == "ends_with" || name == "file_exists" {
        return "bool";
    }
    if name == "range" {
        return "range";
    }
    return "";
}

// The step function's parameter variable.
fn g_gvar(g0: GGen, line: int, col: int) -> GNodeOut {
    return g_var(g0, "g", line, col);
}

fn g_slot_read(g0: GGen, b: GBinding, line: int, col: int) -> GNodeOut {
    let gv: GNodeOut = g_gvar(g0, line, col);
    let mut g: GGen = gv.g;
    let fao: GNodeOut = g_node(g, 32, line, col);
    g = fao.g;
    let mut fa: Node = fao.node;
    fa.name = b.arr;
    fa.kids = [gv.node];
    let io: GNodeOut = g_node(g, 36, line, col);
    g = io.g;
    let ii: GNodeOut = g_int(g, b.idx, line, col);
    g = ii.g;
    let mut ix: Node = io.node;
    ix.kids = [fa, ii.node];
    return GNodeOut { g: g, node: ix };
}

fn g_slot_write(g0: GGen, b: GBinding, rhs: Node, line: int, col: int) -> GNodeOut {
    let gv: GNodeOut = g_gvar(g0, line, col);
    let mut g: GGen = gv.g;
    let fao: GNodeOut = g_node(g, 32, line, col);
    g = fao.g;
    let mut fa: Node = fao.node;
    fa.name = b.arr;
    fa.kids = [gv.node];
    let io: GNodeOut = g_node(g, 36, line, col);
    g = io.g;
    let ii: GNodeOut = g_int(g, b.idx, line, col);
    g = ii.g;
    let mut ix: Node = io.node;
    ix.kids = [fa, ii.node];
    let mut n: Node = new_node(12, line, col);
    n.kids = [ix, rhs];
    return GNodeOut { g: g, node: n };
}

fn g_state_write(g0: GGen, target: int, line: int, col: int) -> GNodeOut {
    let gv: GNodeOut = g_gvar(g0, line, col);
    let mut g: GGen = gv.g;
    let fao: GNodeOut = g_node(g, 32, line, col);
    g = fao.g;
    let mut fa: Node = fao.node;
    fa.name = "slots_i";
    fa.kids = [gv.node];
    let io: GNodeOut = g_node(g, 36, line, col);
    g = io.g;
    let iz: GNodeOut = g_int(g, 0, line, col);
    g = iz.g;
    let mut ix: Node = io.node;
    ix.kids = [fa, iz.node];
    let it: GNodeOut = g_int(g, target, line, col);
    g = it.g;
    let mut n: Node = new_node(12, line, col);
    n.kids = [ix, it.node];
    return GNodeOut { g: g, node: n };
}

// The state read: g.slots_i[0].
fn g_state_read(g0: GGen, line: int, col: int) -> GNodeOut {
    let gv: GNodeOut = g_gvar(g0, line, col);
    let mut g: GGen = gv.g;
    let fao: GNodeOut = g_node(g, 32, line, col);
    g = fao.g;
    let mut fa: Node = fao.node;
    fa.name = "slots_i";
    fa.kids = [gv.node];
    let io: GNodeOut = g_node(g, 36, line, col);
    g = io.g;
    let iz: GNodeOut = g_int(g, 0, line, col);
    g = iz.g;
    let mut ix: Node = io.node;
    ix.kids = [fa, iz.node];
    return GNodeOut { g: g, node: ix };
}

fn g_has_inline_loop(loops: GLoops) -> bool {
    let mut i: int = 0;
    while i < len(loops.is_split) {
        if !loops.is_split[i] {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// A break/continue jumping to a SPLIT loop's state `tgt`,
// emitted inside inline (real C) code. It must unwind out of
// every enclosing inline loop before the dispatch loop can see
// the new state: an unlabeled `break` exits the innermost
// inline loop, and the guard after each inline loop cascades
// the unwind outward. A `continue` here would target the
// innermost inline loop and spin forever (the s06b
// labeled-break hang: `break outer` inside an inline while
// became `state = 2; continue;` inside that while). With no
// enclosing inline loop the statement is already at segment
// level, so a plain `continue` targets the dispatch loop.
fn g_unwind_jump(g0: GGen, tgt: int, line: int, col: int, loops: GLoops) -> GNodesOut {
    let sw: GNodeOut = g_state_write(g0, tgt, line, col);
    let mut g: GGen = sw.g;
    let mut nodes: [Node] = [sw.node];
    if g_has_inline_loop(loops) {
        let mut b: Node = new_node(18, line, col);
        b.label = "";
        push(nodes, b);
    } else {
        let mut c: Node = new_node(19, line, col);
        c.label = "";
        push(nodes, c);
    }
    return GNodesOut { g: g, nodes: nodes };
}

// The unwind guard placed after an inline (real C) loop:
// `if (state != cur_state) { break|continue; }`. A jump
// inside the loop sets the state and breaks out; the guard
// sees the changed state and unwinds one more level (`break`
// when the loop is nested inside another inline loop,
// `continue` when it sits directly in a segment, where
// `continue` targets the dispatch loop). With no jump the
// state is unchanged and the guard is a no-op. Emitted
// unconditionally: the scan that would prove a loop jump-free
// is more bug surface than the one-line guard.
fn g_inline_guard(g0: GGen, line: int, col: int, cur_state: int, enclosing: GLoops) -> GNodeOut {
    let sr: GNodeOut = g_state_read(g0, line, col);
    let mut g: GGen = sr.g;
    let ci: GNodeOut = g_int(g, cur_state, line, col);
    g = ci.g;
    let neo: GNodeOut = g_node(g, 40, line, col);
    g = neo.g;
    let mut ne: Node = neo.node;
    ne.name = "!=";
    ne.kids = [sr.node, ci.node];
    let mut unwind: Node = new_node(19, line, col);
    unwind.label = "";
    if g_has_inline_loop(enclosing) {
        unwind = new_node(18, line, col);
        unwind.label = "";
    }
    let n: Node = g_if_node(ne, [unwind], [], false, line, col);
    return GNodeOut { g: g, node: n };
}

// The none literal: Option { present: false, value: zero }.
fn g_none_lit(g0: GGen, line: int, col: int) -> GNodeOut {
    let mut g: GGen = g0;
    let pvo: GNodeOut = g_node(g, 28, line, col);
    g = pvo.g;
    let mut pv: Node = pvo.node;
    pv.bval = false;
    let mut pf: Node = new_node(44, line, col);
    pf.name = "present";
    pf.kids = [pv];
    let mut vf: Node = new_node(44, line, col);
    vf.name = "value";
    let zo: GNodeOut = g_zero(g, g.elem, line, col);
    g = zo.g;
    vf.kids = [zo.node];
    let no: GNodeOut = g_node(g, 31, line, col);
    g = no.g;
    let mut n: Node = no.node;
    n.name = "Option";
    n.kids = [pf, vf];
    return GNodeOut { g: g, node: n };
}

fn g_opt_some(g0: GGen, expr: Node, line: int, col: int) -> GNodeOut {
    let o: GNodeOut = g_node(g0, 35, line, col);
    let mut n: Node = o.node;
    n.name = "opt_some";
    n.kids = [expr];
    return GNodeOut { g: o.g, node: n };
}

// Append an empty state; returns its id.
fn g_new_state(g0: GGen) -> GIntOut {
    let mut g: GGen = g0;
    let mut sts: [GState] = g.states;
    push(sts, GState { stmts: [] });
    g.states = sts;
    return GIntOut { g: g, num: len(sts) - 1 };
}

fn g_emit(g0: GGen, stmt: Node) -> GGen {
    let mut g: GGen = g0;
    let mut sts: [GState] = g.states;
    let mut st: GState = sts[g.cur_state];
    let mut ss: [Node] = st.stmts;
    push(ss, stmt);
    st.stmts = ss;
    sts[g.cur_state] = st;
    g.states = sts;
    return g;
}

// Seal the current state with `state = target; continue;`.
fn g_jump(g0: GGen, target: int) -> GGen {
    let mut g: GGen = g0;
    let line: int = g.fn_line;
    let col: int = g.fn_col;
    let sw: GNodeOut = g_state_write(g, target, line, col);
    g = sw.g;
    g = g_emit(g, sw.node);
    let mut c: Node = new_node(19, line, col);
    c.label = "";
    g = g_emit(g, c);
    g.cur_state = target;
    return g;
}

// Seal the current state with a bare `continue;` (the state
// was already set inside the enclosing if).
fn g_continue_to(g0: GGen, target: int) -> GGen {
    let mut g: GGen = g0;
    let line: int = g.fn_line;
    let col: int = g.fn_col;
    let mut c: Node = new_node(19, line, col);
    c.label = "";
    g = g_emit(g, c);
    g.cur_state = target;
    return g;
}

// Seal the current state with end-of-iteration: any
// side-effect statements, then `state = -1; return none;`.
fn g_seal_return(g0: GGen, extra: [Node]) -> GGen {
    let mut g: GGen = g0;
    let line: int = g.fn_line;
    let col: int = g.fn_col;
    let mut i: int = 0;
    while i < len(extra) {
        g = g_emit(g, extra[i]);
        i = i + 1;
    }
    let sw: GNodeOut = g_state_write(g, -1, line, col);
    g = sw.g;
    g = g_emit(g, sw.node);
    let mut r: Node = new_node(17, line, col);
    let nl: GNodeOut = g_none_lit(g, line, col);
    g = nl.g;
    r.kids = [nl.node];
    g = g_emit(g, r);
    let ns: GIntOut = g_new_state(g);
    g = ns.g;
    g.cur_state = ns.num;
    return g;
}

fn g_split_block(g0: GGen, stmts: [Node], cont: int) -> GIntOut {
    let mut g: GGen = g0;
    let first: int = g.cur_state;
    g = g_scope_push(g);
    g = g_process_stmts(g, stmts);
    g = g_scope_pop(g);
    g = g_jump(g, cont);
    return GIntOut { g: g, num: first };
}

fn g_split_block_fresh(g0: GGen, stmts: [Node], cont: int) -> GIntOut {
    let mut g: GGen = g0;
    let ns: GIntOut = g_new_state(g);
    g = ns.g;
    g.cur_state = ns.num;
    return g_split_block(g, stmts, cont);
}

fn g_process_stmts(g0: GGen, stmts: [Node]) -> GGen {
    let mut g: GGen = g0;
    let mut i: int = 0;
    while i < len(stmts) {
        g = g_split_stmt(g, stmts[i]);
        i = i + 1;
    }
    return g;
}

// Push a loop onto the loop stack.
fn g_loop_push(g0: GGen, label: str, is_split: bool, brk: int, cont: int) -> GGen {
    let mut g: GGen = g0;
    let mut ls: [str] = g.loop_labels;
    push(ls, label);
    g.loop_labels = ls;
    let mut sp: [bool] = g.loop_is_split;
    push(sp, is_split);
    g.loop_is_split = sp;
    let mut bk: [int] = g.loop_brk;
    push(bk, brk);
    g.loop_brk = bk;
    let mut ct: [int] = g.loop_cont;
    push(ct, cont);
    g.loop_cont = ct;
    return g;
}

fn g_loop_pop(g0: GGen) -> GGen {
    let mut g: GGen = g0;
    let mut ls: [str] = [];
    let mut i: int = 0;
    while i + 1 < len(g.loop_labels) {
        push(ls, g.loop_labels[i]);
        i = i + 1;
    }
    g.loop_labels = ls;
    let mut sp: [bool] = [];
    i = 0;
    while i + 1 < len(g.loop_is_split) {
        push(sp, g.loop_is_split[i]);
        i = i + 1;
    }
    g.loop_is_split = sp;
    let mut bk: [int] = [];
    i = 0;
    while i + 1 < len(g.loop_brk) {
        push(bk, g.loop_brk[i]);
        i = i + 1;
    }
    g.loop_brk = bk;
    let mut ct: [int] = [];
    i = 0;
    while i + 1 < len(g.loop_cont) {
        push(ct, g.loop_cont[i]);
        i = i + 1;
    }
    g.loop_cont = ct;
    return g;
}

// Declare an already-allocated binding in the innermost frame.
fn g_declare_binding(g0: GGen, name: str, b: GBinding) -> GGen {
    let mut g: GGen = g0;
    let mut sc: [GScope] = g.scopes;
    let mut fr: GScope = sc[len(sc) - 1];
    let mut names: [str] = fr.names;
    push(names, name);
    fr.names = names;
    let mut kinds: [str] = fr.kinds;
    push(kinds, b.kind);
    fr.kinds = kinds;
    let mut arrs: [str] = fr.arrs;
    push(arrs, b.arr);
    fr.arrs = arrs;
    let mut idxs: [int] = fr.idxs;
    push(idxs, b.idx);
    fr.idxs = idxs;
    let mut typs: [str] = fr.typs;
    push(typs, b.typ);
    fr.typs = typs;
    sc[len(sc) - 1] = fr;
    g.scopes = sc;
    return g;
}

// The state a break/continue jumps to, or -1 when it targets
// an inline loop (emit as-is) or no loop at all.
fn g_loop_target(g: GGen, s: Node) -> int {
    let is_break: bool = s.kind == 18;
    if s.label != "" {
        let mut i: int = len(g.loop_labels) - 1;
        while i >= 0 {
            if g.loop_labels[i] == s.label {
                if !g.loop_is_split[i] {
                    return -1;
                }
                if is_break {
                    return g.loop_brk[i];
                }
                return g.loop_cont[i];
            }
            i = i - 1;
        }
        return -1;
    }
    let mut i: int = len(g.loop_labels) - 1;
    while i >= 0 {
        if !g.loop_is_split[i] {
            return -1;
        }
        if is_break {
            return g.loop_brk[i];
        }
        return g.loop_cont[i];
    }
    return -1;
}

// Build an If node with the given condition and branch blocks.
fn g_if_node(cond: Node, then_stmts: [Node], els_stmts: [Node], has_els: bool, line: int, col: int) -> Node {
    let mut th: Node = new_node(9, line, col);
    th.kids = then_stmts;
    let mut kids: [Node] = [cond, th];
    if has_els {
        let mut el: Node = new_node(9, line, col);
        el.kids = els_stmts;
        push(kids, el);
    }
    let mut n: Node = new_node(14, line, col);
    n.kids = kids;
    return n;
}

fn g_split_let(g0: GGen, s: Node) -> GGen {
    let mut g: GGen = g0;
    let mut typ: str = s.sval;
    if typ == "" {
        typ = g_prove_type(g, s.kids[0]);
    }
    if typ == "" {
        fail_at(s.line, s.col, "generator local '" + s.name + "' needs a type annotation in v1 (the desugar cannot infer its type from the right-hand side)");
    }
    if !g_is_gen_elem(typ) {
        fail_at(s.line, s.col, "generator local '" + s.name + "' has type " + typ + "; only int, str, and bool locals are supported in v1");
    }
    let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
    g = rw.g;
    g = g_declare_slot(g, s.name, typ);
    let b: GBinding = g_lookup(g, s.name);
    let sw: GNodeOut = g_slot_write(g, b, rw.node, s.line, s.col);
    g = sw.g;
    g = g_emit(g, sw.node);
    return g;
}

fn g_for_source_kind(g: GGen, expr: Node) -> str {
    if expr.kind == 38 {
        return "range";
    }
    if g_prove_type(g, expr) == "range" {
        return "range_expr";
    }
    return "array";
}

fn g_split_for(g0: GGen, s: Node) -> GGen {
    let mut g: GGen = g0;
    let kind: str = g_for_source_kind(g, s.kids[0]);
    if kind != "range" {
        if g_has_yield(s.kids[1]) {
            if kind == "range_expr" {
                fail_at(s.line, s.col, "for over a range expression is not supported in v1 (use a literal lo..hi range or a while loop)");
            }
            fail_at(s.line, s.col, "for over an array cannot contain yield in v1 (use while, or a for loop over a range)");
        }
        // No yield: an ordinary for, inlined.
        let enclosing: GLoops = g_loops_of(g);
        let here: int = g.cur_state;
        g = g_loop_push(g, s.label, false, 0, 0);
        g = g_scope_push(g);
        let vt: str = g_prove_type(g, s.kids[0]);
        if vt == "range" {
            g = g_declare_opaque(g, s.name, "int");
        } else if is_array(vt) {
            g = g_declare_opaque(g, s.name, elem_type(vt));
        } else {
            g = g_declare_opaque(g, s.name, "");
        }
        let body: GNodesOut = g_inline_stmts(g, s.kids[1].kids);
        g = body.g;
        g = g_scope_pop(g);
        g = g_loop_pop(g);
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(16, s.line, s.col);
        n.name = s.name;
        n.label = s.label;
        n.kids = [rw.node, bd];
        g = g_emit(g, n);
        let ig: GNodeOut = g_inline_guard(g, s.line, s.col, here, enclosing);
        g = ig.g;
        g = g_emit(g, ig.node);
        return g;
    }
    // Range form: the source must be a literal RangeLit.
    let lo_rw: GNodeOut = g_rewrite_expr(g, s.kids[0].kids[0]);
    g = lo_rw.g;
    let hi_rw: GNodeOut = g_rewrite_expr(g, s.kids[0].kids[1]);
    g = hi_rw.g;
    // Allocate the loop-var slot directly (no frame entry here):
    // the binding lives only in the body frame, so the name does
    // not leak past the loop.
    let lv_al: GSlotOut = g_alloc_slot(g, "int");
    g = lv_al.g;
    let lv_binding: GBinding = GBinding { found: true, kind: "slot", arr: "slots_i", idx: lv_al.idx, typ: "int" };
    let hi_al: GSlotOut = g_alloc_slot(g, "int");
    g = hi_al.g;
    let hi_idx: int = hi_al.idx;
    let ex_ns: GIntOut = g_new_state(g);
    g = ex_ns.g;
    let exit_state: int = ex_ns.num;
    let hd_ns: GIntOut = g_new_state(g);
    g = hd_ns.g;
    let head: int = hd_ns.num;
    let inc_ns: GIntOut = g_new_state(g);
    g = inc_ns.g;
    let inc: int = inc_ns.num;
    let here: int = g.cur_state;
    g = g_loop_push(g, s.label, true, exit_state, inc);
    g = g_scope_push(g);
    g = g_declare_binding(g, s.name, lv_binding);
    let bf: GIntOut = g_split_block_fresh(g, s.kids[1].kids, inc);
    g = bf.g;
    let body_first: int = bf.num;
    g = g_scope_pop(g);
    g = g_loop_pop(g);
    // Increment state: lv += 1; jump to the header.
    g.cur_state = inc;
    let sr: GNodeOut = g_slot_read(g, lv_binding, s.line, s.col);
    g = sr.g;
    let one: GNodeOut = g_int(g, 1, s.line, s.col);
    g = one.g;
    let po: GNodeOut = g_node(g, 40, s.line, s.col);
    g = po.g;
    let mut plus: Node = po.node;
    plus.name = "+";
    plus.kids = [sr.node, one.node];
    let sw: GNodeOut = g_slot_write(g, lv_binding, plus, s.line, s.col);
    g = sw.g;
    g = g_emit(g, sw.node);
    g = g_jump(g, head);
    // Header state: if (lv < hi) body else exit; continue.
    g.cur_state = head;
    let gv: GNodeOut = g_gvar(g, s.line, s.col);
    g = gv.g;
    let fao: GNodeOut = g_node(g, 32, s.line, s.col);
    g = fao.g;
    let mut hi_fa: Node = fao.node;
    hi_fa.name = "slots_i";
    hi_fa.kids = [gv.node];
    let ixo: GNodeOut = g_node(g, 36, s.line, s.col);
    g = ixo.g;
    let hii: GNodeOut = g_int(g, hi_idx, s.line, s.col);
    g = hii.g;
    let mut hi_ix: Node = ixo.node;
    hi_ix.kids = [hi_fa, hii.node];
    let sro: GNodeOut = g_slot_read(g, lv_binding, s.line, s.col);
    g = sro.g;
    let lto: GNodeOut = g_node(g, 40, s.line, s.col);
    g = lto.g;
    let mut lt: Node = lto.node;
    lt.name = "<";
    lt.kids = [sro.node, hi_ix];
    let sw1: GNodeOut = g_state_write(g, body_first, s.line, s.col);
    g = sw1.g;
    let sw2: GNodeOut = g_state_write(g, exit_state, s.line, s.col);
    g = sw2.g;
    let ifn: Node = g_if_node(lt, [sw1.node], [sw2.node], true, s.line, s.col);
    g = g_emit(g, ifn);
    g = g_continue_to(g, exit_state);
    // Entry, in the enclosing segment: lv = lo; hi = hi_expr;
    // jump to the header.
    g.cur_state = here;
    let sw3: GNodeOut = g_slot_write(g, lv_binding, lo_rw.node, s.line, s.col);
    g = sw3.g;
    g = g_emit(g, sw3.node);
    let gv2: GNodeOut = g_gvar(g, s.line, s.col);
    g = gv2.g;
    let fao2: GNodeOut = g_node(g, 32, s.line, s.col);
    g = fao2.g;
    let mut hi_fa2: Node = fao2.node;
    hi_fa2.name = "slots_i";
    hi_fa2.kids = [gv2.node];
    let ixo2: GNodeOut = g_node(g, 36, s.line, s.col);
    g = ixo2.g;
    let hii2: GNodeOut = g_int(g, hi_idx, s.line, s.col);
    g = hii2.g;
    let mut hi_ix2: Node = ixo2.node;
    hi_ix2.kids = [hi_fa2, hii2.node];
    let mut hi_wr: Node = new_node(12, s.line, s.col);
    hi_wr.kids = [hi_ix2, hi_rw.node];
    g = g_emit(g, hi_wr);
    g = g_jump(g, head);
    g.cur_state = exit_state;
    return g;
}

// Split-mode statement processing (appends to cur_state).
fn g_split_stmt(g0: GGen, s: Node) -> GGen {
    let mut g: GGen = g0;
    if s.kind == 52 {
        let t: str = g_prove_type(g, s.kids[0]);
        if t != "" && t != g.elem {
            fail_at(s.line, s.col, "yield value of type " + t + " does not match generator element type " + g.elem);
        }
        let nx_ns: GIntOut = g_new_state(g);
        g = nx_ns.g;
        let nxt: int = nx_ns.num;
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let sw: GNodeOut = g_state_write(g, nxt, s.line, s.col);
        g = sw.g;
        g = g_emit(g, sw.node);
        let mut r: Node = new_node(17, s.line, s.col);
        let os: GNodeOut = g_opt_some(g, rw.node, s.line, s.col);
        g = os.g;
        r.kids = [os.node];
        g = g_emit(g, r);
        g.cur_state = nxt;
        return g;
    }
    if s.kind == 17 {
        let mut extra: [Node] = [];
        if len(s.kids) > 0 {
            let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
            g = rw.g;
            let mut es: Node = new_node(24, s.line, s.col);
            es.kids = [rw.node];
            push(extra, es);
        }
        g = g_seal_return(g, extra);
        return g;
    }
    if s.kind == 18 || s.kind == 19 {
        let tgt: int = g_loop_target(g, s);
        if tgt < 0 {
            g = g_emit(g, s);
        } else {
            g = g_jump(g, tgt);
        }
        return g;
    }
    if s.kind == 10 {
        return g_split_let(g, s);
    }
    if s.kind == 11 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let b: GBinding = g_lookup(g, s.name);
        if b.found && b.kind == "slot" {
            let sw: GNodeOut = g_slot_write(g, b, rw.node, s.line, s.col);
            g = sw.g;
            g = g_emit(g, sw.node);
        } else {
            let mut n: Node = new_node(11, s.line, s.col);
            n.name = s.name;
            n.kids = [rw.node];
            g = g_emit(g, n);
        }
        return g;
    }
    if s.kind == 12 {
        let b_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = b_rw.g;
        let v_rw: GNodeOut = g_rewrite_expr(g, s.kids[1]);
        g = v_rw.g;
        let mut n: Node = new_node(12, s.line, s.col);
        n.kids = [b_rw.node, v_rw.node];
        g = g_emit(g, n);
        return g;
    }
    if s.kind == 13 {
        let t_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = t_rw.g;
        let v_rw: GNodeOut = g_rewrite_expr(g, s.kids[1]);
        g = v_rw.g;
        let mut n: Node = new_node(13, s.line, s.col);
        n.kids = [t_rw.node, v_rw.node];
        g = g_emit(g, n);
        return g;
    }
    if s.kind == 24 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut n: Node = new_node(24, s.line, s.col);
        n.kids = [rw.node];
        g = g_emit(g, n);
        return g;
    }
    if s.kind == 9 {
        g = g_scope_push(g);
        g = g_process_stmts(g, s.kids);
        g = g_scope_pop(g);
        return g;
    }
    if s.kind == 14 {
        let cond_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = cond_rw.g;
        if g_has_yield(s.kids[1]) || (len(s.kids) > 2 && g_has_yield(s.kids[2])) {
            let jn_ns: GIntOut = g_new_state(g);
            g = jn_ns.g;
            let join: int = jn_ns.num;
            let here: int = g.cur_state;
            let th: GIntOut = g_split_block_fresh(g, s.kids[1].kids, join);
            g = th.g;
            let then_first: int = th.num;
            let mut else_first: int = join;
            if len(s.kids) > 2 {
                let el: GIntOut = g_split_block_fresh(g, s.kids[2].kids, join);
                g = el.g;
                else_first = el.num;
            }
            g.cur_state = here;
            let sw1: GNodeOut = g_state_write(g, then_first, s.line, s.col);
            g = sw1.g;
            let sw2: GNodeOut = g_state_write(g, else_first, s.line, s.col);
            g = sw2.g;
            let ifn: Node = g_if_node(cond_rw.node, [sw1.node], [sw2.node], true, s.line, s.col);
            g = g_emit(g, ifn);
            g = g_continue_to(g, join);
        } else {
            g = g_scope_push(g);
            let th: GNodesOut = g_inline_stmts(g, s.kids[1].kids);
            g = th.g;
            g = g_scope_pop(g);
            let mut els_stmts: [Node] = [];
            let mut has_els: bool = false;
            if len(s.kids) > 2 {
                g = g_scope_push(g);
                let el: GNodesOut = g_inline_stmts(g, s.kids[2].kids);
                g = el.g;
                g = g_scope_pop(g);
                els_stmts = el.nodes;
                has_els = true;
            }
            let ifn: Node = g_if_node(cond_rw.node, th.nodes, els_stmts, has_els, s.line, s.col);
            g = g_emit(g, ifn);
        }
        return g;
    }
    if s.kind == 15 {
        let cond_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = cond_rw.g;
        if g_has_yield(s.kids[1]) {
            let ex_ns: GIntOut = g_new_state(g);
            g = ex_ns.g;
            let exit_state: int = ex_ns.num;
            let hd_ns: GIntOut = g_new_state(g);
            g = hd_ns.g;
            let head: int = hd_ns.num;
            let here: int = g.cur_state;
            g = g_loop_push(g, s.label, true, exit_state, head);
            let bf: GIntOut = g_split_block_fresh(g, s.kids[1].kids, head);
            g = bf.g;
            let body_first: int = bf.num;
            g = g_loop_pop(g);
            g.cur_state = head;
            let sw1: GNodeOut = g_state_write(g, body_first, s.line, s.col);
            g = sw1.g;
            let sw2: GNodeOut = g_state_write(g, exit_state, s.line, s.col);
            g = sw2.g;
            let ifn: Node = g_if_node(cond_rw.node, [sw1.node], [sw2.node], true, s.line, s.col);
            g = g_emit(g, ifn);
            g = g_continue_to(g, exit_state);
            g.cur_state = here;
            g = g_jump(g, head);
            g.cur_state = exit_state;
        } else {
            let enclosing: GLoops = g_loops_of(g);
            let here: int = g.cur_state;
            g = g_loop_push(g, s.label, false, 0, 0);
            g = g_scope_push(g);
            let body: GNodesOut = g_inline_stmts(g, s.kids[1].kids);
            g = body.g;
            g = g_scope_pop(g);
            g = g_loop_pop(g);
            let mut bd: Node = new_node(9, s.line, s.col);
            bd.kids = body.nodes;
            let mut n: Node = new_node(15, s.line, s.col);
            n.label = s.label;
            n.kids = [cond_rw.node, bd];
            g = g_emit(g, n);
            let ig: GNodeOut = g_inline_guard(g, s.line, s.col, here, enclosing);
            g = ig.g;
            g = g_emit(g, ig.node);
        }
        return g;
    }
    if s.kind == 16 {
        return g_split_for(g, s);
    }
    if s.kind == 20 {
        if g_has_yield(s) {
            fail_at(s.line, s.col, "yield cannot appear inside a match arm in v1 (use if/else)");
        }
        let m: GNodeOut = g_opaque_match(g, s, false, g_loops_of(g));
        g = m.g;
        g = g_emit(g, m.node);
        return g;
    }
    if s.kind == 49 {
        if g_has_yield(s) {
            fail_at(s.line, s.col, "yield cannot appear inside a comptime if branch in v1");
        }
        let m: GNodeOut = g_opaque_comptime(g, s, false, g_loops_of(g));
        g = m.g;
        g = g_emit(g, m.node);
        return g;
    }
    if s.kind == 22 {
        if g_has_yield(s.kids[0]) {
            fail_at(s.line, s.col, "yield cannot appear inside a scope block in v1");
        }
        g = g_scope_push(g);
        let body: GNodesOut = g_inline_stmts(g, s.kids[0].kids);
        g = body.g;
        g = g_scope_pop(g);
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(22, s.line, s.col);
        n.kids = [bd];
        g = g_emit(g, n);
        return g;
    }
    if s.kind == 21 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut n: Node = new_node(21, s.line, s.col);
        n.kids = [rw.node];
        g = g_emit(g, n);
        return g;
    }
    // Unknown statement shape: rewrite its expressions
    // generically and emit as-is (the checker decides).
    let gn: GNodeOut = g_rewrite_stmt_generic(g, s);
    g = gn.g;
    g = g_emit(g, gn.node);
    return g;
}

// The generator's loop stack as a GLoops value.
fn g_loops_of(g: GGen) -> GLoops {
    return GLoops { labels: g.loop_labels, is_split: g.loop_is_split, brk: g.loop_brk, cont: g.loop_cont };
}

// Inline-mode processing (constructs without yields): returns
// a new statement list. Lets become slot writes; break/continue
// targeting a split loop become [state-write, continue];
// returns become end-of-iteration sequences.
fn g_inline_stmts(g0: GGen, stmts: [Node]) -> GNodesOut {
    let mut g: GGen = g0;
    let mut out: [Node] = [];
    let mut i: int = 0;
    while i < len(stmts) {
        let r: GNodesOut = g_inline_stmt(g, stmts[i]);
        g = r.g;
        let mut j: int = 0;
        while j < len(r.nodes) {
            push(out, r.nodes[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return GNodesOut { g: g, nodes: out };
}

fn g_inline_stmt(g0: GGen, s: Node) -> GNodesOut {
    let mut g: GGen = g0;
    if s.kind == 52 {
        fail_at(s.line, s.col, "internal error: unresolved yield");
    }
    if s.kind == 17 {
        let mut extra: [Node] = [];
        if len(s.kids) > 0 {
            let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
            g = rw.g;
            let mut es: Node = new_node(24, s.line, s.col);
            es.kids = [rw.node];
            push(extra, es);
        }
        let line: int = s.line;
        let col: int = s.col;
        let sw: GNodeOut = g_state_write(g, -1, line, col);
        g = sw.g;
        push(extra, sw.node);
        let mut r: Node = new_node(17, line, col);
        let nl: GNodeOut = g_none_lit(g, line, col);
        g = nl.g;
        r.kids = [nl.node];
        push(extra, r);
        return GNodesOut { g: g, nodes: extra };
    }
    if s.kind == 18 || s.kind == 19 {
        let tgt: int = g_loop_target(g, s);
        if tgt < 0 {
            return GNodesOut { g: g, nodes: [s] };
        }
        let uj: GNodesOut = g_unwind_jump(g, tgt, s.line, s.col, g_loops_of(g));
        return GNodesOut { g: uj.g, nodes: uj.nodes };
    }
    if s.kind == 10 {
        let mut typ: str = s.sval;
        if typ == "" {
            typ = g_prove_type(g, s.kids[0]);
        }
        if typ == "" {
            fail_at(s.line, s.col, "generator local '" + s.name + "' needs a type annotation in v1 (the desugar cannot infer its type from the right-hand side)");
        }
        if !g_is_gen_elem(typ) {
            fail_at(s.line, s.col, "generator local '" + s.name + "' has type " + typ + "; only int, str, and bool locals are supported in v1");
        }
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        g = g_declare_slot(g, s.name, typ);
        let b: GBinding = g_lookup(g, s.name);
        let sw: GNodeOut = g_slot_write(g, b, rw.node, s.line, s.col);
        return GNodesOut { g: sw.g, nodes: [sw.node] };
    }
    if s.kind == 11 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let b: GBinding = g_lookup(g, s.name);
        if b.found && b.kind == "slot" {
            let sw: GNodeOut = g_slot_write(g, b, rw.node, s.line, s.col);
            return GNodesOut { g: sw.g, nodes: [sw.node] };
        }
        let mut n: Node = new_node(11, s.line, s.col);
        n.name = s.name;
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 12 {
        let b_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = b_rw.g;
        let v_rw: GNodeOut = g_rewrite_expr(g, s.kids[1]);
        g = v_rw.g;
        let mut n: Node = new_node(12, s.line, s.col);
        n.kids = [b_rw.node, v_rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 13 {
        let t_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = t_rw.g;
        let v_rw: GNodeOut = g_rewrite_expr(g, s.kids[1]);
        g = v_rw.g;
        let mut n: Node = new_node(13, s.line, s.col);
        n.kids = [t_rw.node, v_rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 24 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut n: Node = new_node(24, s.line, s.col);
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 9 {
        g = g_scope_push(g);
        let r: GNodesOut = g_inline_stmts(g, s.kids);
        g = r.g;
        g = g_scope_pop(g);
        let mut n: Node = new_node(9, s.line, s.col);
        n.kids = r.nodes;
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 14 {
        let cond_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = cond_rw.g;
        g = g_scope_push(g);
        let th: GNodesOut = g_inline_stmts(g, s.kids[1].kids);
        g = th.g;
        g = g_scope_pop(g);
        let mut els_stmts: [Node] = [];
        let mut has_els: bool = false;
        if len(s.kids) > 2 {
            g = g_scope_push(g);
            let el: GNodesOut = g_inline_stmts(g, s.kids[2].kids);
            g = el.g;
            g = g_scope_pop(g);
            els_stmts = el.nodes;
            has_els = true;
        }
        let ifn: Node = g_if_node(cond_rw.node, th.nodes, els_stmts, has_els, s.line, s.col);
        return GNodesOut { g: g, nodes: [ifn] };
    }
    if s.kind == 15 {
        let cond_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = cond_rw.g;
        let enclosing: GLoops = g_loops_of(g);
        let here: int = g.cur_state;
        g = g_loop_push(g, s.label, false, 0, 0);
        g = g_scope_push(g);
        let body: GNodesOut = g_inline_stmts(g, s.kids[1].kids);
        g = body.g;
        g = g_scope_pop(g);
        g = g_loop_pop(g);
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(15, s.line, s.col);
        n.label = s.label;
        n.kids = [cond_rw.node, bd];
        let ig: GNodeOut = g_inline_guard(g, s.line, s.col, here, enclosing);
        return GNodesOut { g: ig.g, nodes: [n, ig.node] };
    }
    if s.kind == 16 {
        if g_has_yield(s.kids[1]) {
            fail_at(s.line, s.col, "internal error: unresolved yield");
        }
        let enclosing: GLoops = g_loops_of(g);
        let here: int = g.cur_state;
        g = g_loop_push(g, s.label, false, 0, 0);
        g = g_scope_push(g);
        let vt: str = g_prove_type(g, s.kids[0]);
        if vt == "range" {
            g = g_declare_opaque(g, s.name, "int");
        } else if is_array(vt) {
            g = g_declare_opaque(g, s.name, elem_type(vt));
        } else {
            g = g_declare_opaque(g, s.name, "");
        }
        let body: GNodesOut = g_inline_stmts(g, s.kids[1].kids);
        g = body.g;
        g = g_scope_pop(g);
        g = g_loop_pop(g);
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(16, s.line, s.col);
        n.name = s.name;
        n.label = s.label;
        n.kids = [rw.node, bd];
        let ig: GNodeOut = g_inline_guard(g, s.line, s.col, here, enclosing);
        return GNodesOut { g: ig.g, nodes: [n, ig.node] };
    }
    if s.kind == 20 {
        if g_has_yield(s) {
            fail_at(s.line, s.col, "yield cannot appear inside a match arm in v1 (use if/else)");
        }
        let m: GNodeOut = g_opaque_match(g, s, false, g_loops_of(g));
        g = m.g;
        return GNodesOut { g: g, nodes: [m.node] };
    }
    if s.kind == 49 {
        if g_has_yield(s) {
            fail_at(s.line, s.col, "yield cannot appear inside a comptime if branch in v1");
        }
        let m: GNodeOut = g_opaque_comptime(g, s, false, g_loops_of(g));
        g = m.g;
        return GNodesOut { g: g, nodes: [m.node] };
    }
    if s.kind == 22 {
        if g_has_yield(s.kids[0]) {
            fail_at(s.line, s.col, "yield cannot appear inside a scope block in v1");
        }
        g = g_scope_push(g);
        let body: GNodesOut = g_inline_stmts(g, s.kids[0].kids);
        g = body.g;
        g = g_scope_pop(g);
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(22, s.line, s.col);
        n.kids = [bd];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 21 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut n: Node = new_node(21, s.line, s.col);
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    let gn: GNodeOut = g_rewrite_stmt_generic(g, s);
    g = gn.g;
    return GNodesOut { g: g, nodes: [gn.node] };
}

// The loop target inside an opaque loop stack (a GLoops
// value, not the generator's stack): -1 when the target is
// an inline loop or no loop at all.
fn g_loop_target_in(loops: GLoops, s: Node) -> int {
    let is_break: bool = s.kind == 18;
    if s.label != "" {
        let mut i: int = len(loops.labels) - 1;
        while i >= 0 {
            if loops.labels[i] == s.label {
                if !loops.is_split[i] {
                    return -1;
                }
                if is_break {
                    return loops.brk[i];
                }
                return loops.cont[i];
            }
            i = i - 1;
        }
        return -1;
    }
    let mut i: int = len(loops.labels) - 1;
    while i >= 0 {
        if !loops.is_split[i] {
            return -1;
        }
        if is_break {
            return loops.brk[i];
        }
        return loops.cont[i];
    }
    return -1;
}

// Push one loop onto an opaque loop stack value.
fn g_loops_push(loops0: GLoops, label: str, is_split: bool, brk: int, cont: int) -> GLoops {
    let mut loops: GLoops = loops0;
    let mut ls: [str] = loops.labels;
    push(ls, label);
    loops.labels = ls;
    let mut sp: [bool] = loops.is_split;
    push(sp, is_split);
    loops.is_split = sp;
    let mut bk: [int] = loops.brk;
    push(bk, brk);
    loops.brk = bk;
    let mut ct: [int] = loops.cont;
    push(ct, cont);
    loops.cont = ct;
    return loops;
}

// Opaque-mode processing (lambda bodies, match arms, comptime
// branches): lets stay lets; only expressions are rewritten.
// `in_lambda` selects the lambda rules (its own return, its
// own loop stack); otherwise returns end the iteration and
// breaks use the generator's loop stack.
fn g_opaque_stmts(g0: GGen, stmts: [Node], extra_names: [str], extra_typs: [str], in_lambda: bool, loops: GLoops) -> GNodesOut {
    let mut g: GGen = g0;
    g = g_scope_push(g);
    let mut i: int = 0;
    while i < len(extra_names) {
        g = g_declare_opaque(g, extra_names[i], extra_typs[i]);
        i = i + 1;
    }
    let mut out: [Node] = [];
    i = 0;
    while i < len(stmts) {
        let r: GNodesOut = g_opaque_stmt(g, stmts[i], in_lambda, loops);
        g = r.g;
        let mut j: int = 0;
        while j < len(r.nodes) {
            push(out, r.nodes[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    g = g_scope_pop(g);
    return GNodesOut { g: g, nodes: out };
}

fn g_opaque_stmt(g0: GGen, s: Node, in_lambda: bool, loops: GLoops) -> GNodesOut {
    let mut g: GGen = g0;
    if s.kind == 52 {
        if in_lambda {
            fail_at(s.line, s.col, "yield cannot appear inside a nested function or closure in v1");
        }
        fail_at(s.line, s.col, "internal error: unresolved yield");
    }
    if s.kind == 17 {
        if in_lambda {
            let mut expr: Node = new_node(0, s.line, s.col);
            let mut has_expr: bool = false;
            if len(s.kids) > 0 {
                let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
                g = rw.g;
                expr = rw.node;
                has_expr = true;
            }
            let mut n: Node = new_node(17, s.line, s.col);
            if has_expr {
                n.kids = [expr];
            } else {
                let mut ek: [Node] = [];
                n.kids = ek;
            }
            return GNodesOut { g: g, nodes: [n] };
        }
        let mut extra: [Node] = [];
        if len(s.kids) > 0 {
            let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
            g = rw.g;
            let mut es: Node = new_node(24, s.line, s.col);
            es.kids = [rw.node];
            push(extra, es);
        }
        let line: int = s.line;
        let col: int = s.col;
        let sw: GNodeOut = g_state_write(g, -1, line, col);
        g = sw.g;
        push(extra, sw.node);
        let mut r: Node = new_node(17, line, col);
        let nl: GNodeOut = g_none_lit(g, line, col);
        g = nl.g;
        r.kids = [nl.node];
        push(extra, r);
        return GNodesOut { g: g, nodes: extra };
    }
    if s.kind == 18 || s.kind == 19 {
        let tgt: int = g_loop_target_in(loops, s);
        if tgt < 0 {
            return GNodesOut { g: g, nodes: [s] };
        }
        let uj: GNodesOut = g_unwind_jump(g, tgt, s.line, s.col, loops);
        return GNodesOut { g: uj.g, nodes: uj.nodes };
    }
    if s.kind == 10 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        g = g_declare_opaque(g, s.name, s.sval);
        let mut n: Node = new_node(10, s.line, s.col);
        n.name = s.name;
        n.bval = s.bval;
        n.sval = s.sval;
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 11 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let b: GBinding = g_lookup(g, s.name);
        if b.found && b.kind == "slot" {
            let sw: GNodeOut = g_slot_write(g, b, rw.node, s.line, s.col);
            return GNodesOut { g: sw.g, nodes: [sw.node] };
        }
        let mut n: Node = new_node(11, s.line, s.col);
        n.name = s.name;
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 12 {
        let b_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = b_rw.g;
        let v_rw: GNodeOut = g_rewrite_expr(g, s.kids[1]);
        g = v_rw.g;
        let mut n: Node = new_node(12, s.line, s.col);
        n.kids = [b_rw.node, v_rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 13 {
        let t_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = t_rw.g;
        let v_rw: GNodeOut = g_rewrite_expr(g, s.kids[1]);
        g = v_rw.g;
        let mut n: Node = new_node(13, s.line, s.col);
        n.kids = [t_rw.node, v_rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 24 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut n: Node = new_node(24, s.line, s.col);
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 9 {
        let r: GNodesOut = g_opaque_stmts(g, s.kids, [], [], in_lambda, loops);
        g = r.g;
        let mut n: Node = new_node(9, s.line, s.col);
        n.kids = r.nodes;
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 14 {
        let cond_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = cond_rw.g;
        let th: GNodesOut = g_opaque_stmts(g, s.kids[1].kids, [], [], in_lambda, loops);
        g = th.g;
        let mut els_stmts: [Node] = [];
        let mut has_els: bool = false;
        if len(s.kids) > 2 {
            let el: GNodesOut = g_opaque_stmts(g, s.kids[2].kids, [], [], in_lambda, loops);
            g = el.g;
            els_stmts = el.nodes;
            has_els = true;
        }
        let ifn: Node = g_if_node(cond_rw.node, th.nodes, els_stmts, has_els, s.line, s.col);
        return GNodesOut { g: g, nodes: [ifn] };
    }
    if s.kind == 15 {
        let cond_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = cond_rw.g;
        let loops2: GLoops = g_loops_push(loops, s.label, false, 0, 0);
        let body: GNodesOut = g_opaque_stmts(g, s.kids[1].kids, [], [], in_lambda, loops2);
        g = body.g;
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(15, s.line, s.col);
        n.label = s.label;
        n.kids = [cond_rw.node, bd];
        // No guard inside a lambda: `g` is out of scope there
        // (and a lambda's jumps can never target a split loop,
        // its loop stack is fresh). In a match/comptime arm the
        // guard unwinds exactly like the inline-mode one.
        if in_lambda {
            return GNodesOut { g: g, nodes: [n] };
        }
        let ig: GNodeOut = g_inline_guard(g, s.line, s.col, g.cur_state, loops);
        return GNodesOut { g: ig.g, nodes: [n, ig.node] };
    }
    if s.kind == 16 {
        let loops2: GLoops = g_loops_push(loops, s.label, false, 0, 0);
        let vt: str = g_prove_type(g, s.kids[0]);
        let mut extra_names: [str] = [s.name];
        let mut extra_typs: [str] = [""];
        if vt == "range" {
            extra_typs = ["int"];
        } else if is_array(vt) {
            extra_typs = [elem_type(vt)];
        }
        let body: GNodesOut = g_opaque_stmts(g, s.kids[1].kids, extra_names, extra_typs, in_lambda, loops2);
        g = body.g;
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(16, s.line, s.col);
        n.name = s.name;
        n.label = s.label;
        n.kids = [rw.node, bd];
        if in_lambda {
            return GNodesOut { g: g, nodes: [n] };
        }
        let ig: GNodeOut = g_inline_guard(g, s.line, s.col, g.cur_state, loops);
        return GNodesOut { g: ig.g, nodes: [n, ig.node] };
    }
    if s.kind == 20 {
        if g_has_yield(s) {
            fail_at(s.line, s.col, "yield cannot appear inside a match arm in v1 (use if/else)");
        }
        let m: GNodeOut = g_opaque_match_in(g, s, in_lambda, loops);
        g = m.g;
        return GNodesOut { g: g, nodes: [m.node] };
    }
    if s.kind == 49 {
        if g_has_yield(s) {
            fail_at(s.line, s.col, "yield cannot appear inside a comptime if branch in v1");
        }
        let m: GNodeOut = g_opaque_comptime_in(g, s, in_lambda, loops);
        g = m.g;
        return GNodesOut { g: g, nodes: [m.node] };
    }
    if s.kind == 22 {
        if g_has_yield(s.kids[0]) {
            fail_at(s.line, s.col, "yield cannot appear inside a scope block in v1");
        }
        let body: GNodesOut = g_opaque_stmts(g, s.kids[0].kids, [], [], in_lambda, loops);
        g = body.g;
        let mut bd: Node = new_node(9, s.line, s.col);
        bd.kids = body.nodes;
        let mut n: Node = new_node(22, s.line, s.col);
        n.kids = [bd];
        return GNodesOut { g: g, nodes: [n] };
    }
    if s.kind == 21 {
        let rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
        g = rw.g;
        let mut n: Node = new_node(21, s.line, s.col);
        n.kids = [rw.node];
        return GNodesOut { g: g, nodes: [n] };
    }
    let gn: GNodeOut = g_rewrite_stmt_generic(g, s);
    g = gn.g;
    return GNodesOut { g: g, nodes: [gn.node] };
}

// The bindings one match arm introduces (the variant binding
// plus struct-pattern field bindings), as names (types "").
fn g_match_bindings(arm: Node) -> [str] {
    let mut out: [str] = [];
    if arm.sval != "" {
        push(out, arm.sval);
    }
    if arm.label == "struct" {
        let mut i: int = 0;
        while i < len(arm.kids) {
            let fp: Node = arm.kids[i];
            if fp.label == "binding" {
                push(out, fp.sval);
            }
            i = i + 1;
        }
    }
    return out;
}

fn g_opaque_match(g0: GGen, s: Node, in_lambda: bool, loops: GLoops) -> GNodeOut {
    return g_opaque_match_in(g0, s, in_lambda, loops);
}

fn g_opaque_match_in(g0: GGen, s: Node, in_lambda: bool, loops: GLoops) -> GNodeOut {
    let mut g: GGen = g0;
    let scr_rw: GNodeOut = g_rewrite_expr(g, s.kids[0]);
    g = scr_rw.g;
    let mut kids: [Node] = [scr_rw.node];
    let mut i: int = 1;
    while i < len(s.kids) {
        let arm: Node = s.kids[i];
        let bindings: [str] = g_match_bindings(arm);
        let mut btyps: [str] = [];
        let mut j: int = 0;
        while j < len(bindings) {
            push(btyps, "");
            j = j + 1;
        }
        let body: GNodesOut = g_opaque_stmts(g, arm.kids[0].kids, bindings, btyps, in_lambda, loops);
        g = body.g;
        let mut bd: Node = new_node(9, arm.line, arm.col);
        bd.kids = body.nodes;
        let mut na: Node = arm;
        let mut akids: [Node] = [bd];
        let mut k: int = 1;
        while k < len(arm.kids) {
            push(akids, arm.kids[k]);
            k = k + 1;
        }
        na.kids = akids;
        push(kids, na);
        i = i + 1;
    }
    let mut n: Node = new_node(20, s.line, s.col);
    n.kids = kids;
    return GNodeOut { g: g, node: n };
}

fn g_opaque_comptime(g0: GGen, s: Node, in_lambda: bool, loops: GLoops) -> GNodeOut {
    return g_opaque_comptime_in(g0, s, in_lambda, loops);
}

fn g_opaque_comptime_in(g0: GGen, s: Node, in_lambda: bool, loops: GLoops) -> GNodeOut {
    let mut g: GGen = g0;
    let th: GNodesOut = g_opaque_stmts(g, s.kids[1].kids, [], [], in_lambda, loops);
    g = th.g;
    let mut thb: Node = new_node(9, s.line, s.col);
    thb.kids = th.nodes;
    let mut kids: [Node] = [s.kids[0], thb];
    if len(s.kids) > 2 {
        let el: GNodesOut = g_opaque_stmts(g, s.kids[2].kids, [], [], in_lambda, loops);
        g = el.g;
        let mut elb: Node = new_node(9, s.line, s.col);
        elb.kids = el.nodes;
        push(kids, elb);
    }
    let mut n: Node = new_node(49, s.line, s.col);
    n.kids = kids;
    return GNodeOut { g: g, node: n };
}

// Expression rewriter: lifted names become slot reads.
fn g_rewrite_expr(g0: GGen, e: Node) -> GNodeOut {
    let mut g: GGen = g0;
    if e.kind == 34 {
        let b: GBinding = g_lookup(g, e.name);
        if b.found && b.kind == "slot" {
            let sr: GNodeOut = g_slot_read(g, b, e.line, e.col);
            return GNodeOut { g: sr.g, node: sr.node };
        }
        return GNodeOut { g: g, node: e };
    }
    if e.kind == 47 {
        g = g_scope_push(g);
        let mut i: int = 0;
        while i + 1 < len(e.kids) {
            g = g_declare_opaque(g, e.kids[i].name, e.kids[i].sval);
            i = i + 1;
        }
        let body: GNodesOut = g_opaque_stmts(g, e.kids[len(e.kids) - 1].kids, [], [], true, GLoops { labels: [], is_split: [], brk: [], cont: [] });
        g = body.g;
        g = g_scope_pop(g);
        let mut kids: [Node] = [];
        i = 0;
        while i + 1 < len(e.kids) {
            push(kids, e.kids[i]);
            i = i + 1;
        }
        let mut bd: Node = new_node(9, e.line, e.col);
        bd.kids = body.nodes;
        push(kids, bd);
        let mut n: Node = new_node(47, e.line, e.col);
        n.sval = e.sval;
        n.kids = kids;
        return GNodeOut { g: g, node: n };
    }
    if e.kind == 40 || e.kind == 36 || e.kind == 38 {
        let mut kids: [Node] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let rw: GNodeOut = g_rewrite_expr(g, e.kids[i]);
            g = rw.g;
            push(kids, rw.node);
            i = i + 1;
        }
        let mut n: Node = e;
        n.kids = kids;
        return GNodeOut { g: g, node: n };
    }
    if e.kind == 41 || e.kind == 37 || e.kind == 32 || e.kind == 39 || e.kind == 42 {
        let rw: GNodeOut = g_rewrite_expr(g, e.kids[0]);
        g = rw.g;
        let mut n: Node = e;
        n.kids = [rw.node];
        return GNodeOut { g: g, node: n };
    }
    if e.kind == 35 || e.kind == 46 || e.kind == 33 {
        let mut kids: [Node] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let rw: GNodeOut = g_rewrite_expr(g, e.kids[i]);
            g = rw.g;
            push(kids, rw.node);
            i = i + 1;
        }
        let mut n: Node = e;
        n.kids = kids;
        return GNodeOut { g: g, node: n };
    }
    if e.kind == 31 {
        let mut fields: [Node] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let f: Node = e.kids[i];
            let rw: GNodeOut = g_rewrite_expr(g, f.kids[0]);
            g = rw.g;
            let mut nf: Node = f;
            nf.kids = [rw.node];
            push(fields, nf);
            i = i + 1;
        }
        let mut n: Node = e;
        n.kids = fields;
        return GNodeOut { g: g, node: n };
    }
    if e.kind == 29 || e.kind == 30 {
        let mut kids: [Node] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let rw: GNodeOut = g_rewrite_expr(g, e.kids[i]);
            g = rw.g;
            push(kids, rw.node);
            i = i + 1;
        }
        let mut n: Node = e;
        n.kids = kids;
        return GNodeOut { g: g, node: n };
    }
    if e.kind == 51 {
        fail_at(e.line, e.col, "walrus ':=' is not supported inside a generator function in v1 (write the assignment before the if/while instead)");
    }
    return GNodeOut { g: g, node: e };
}

// Best-effort expression rewrite for statement shapes the
// splitter does not know: rebuild the node with its expression
// kids rewritten (the checker decides on the rest).
fn g_rewrite_stmt_generic(g0: GGen, s: Node) -> GNodeOut {
    let mut g: GGen = g0;
    let mut kids: [Node] = [];
    let mut i: int = 0;
    while i < len(s.kids) {
        let k: Node = s.kids[i];
        if k.kind == 9 || k.kind == 10 || k.kind == 11 || k.kind == 12 || k.kind == 13 || k.kind == 14 || k.kind == 15 || k.kind == 16 || k.kind == 17 || k.kind == 18 || k.kind == 19 || k.kind == 20 || k.kind == 21 || k.kind == 22 || k.kind == 23 || k.kind == 24 || k.kind == 49 || k.kind == 52 {
            push(kids, k);
        } else {
            let rw: GNodeOut = g_rewrite_expr(g, k);
            g = rw.g;
            push(kids, rw.node);
        }
        i = i + 1;
    }
    let mut n: Node = s;
    n.kids = kids;
    return GNodeOut { g: g, node: n };
}

// The Generator struct must be the stdlib one (import
// "generators.fg"); anything else is a named error.
fn g_check_gen_struct(g: GGen, fn_node: Node) -> bool {
    let si: int = g_struct_index(g, "Generator");
    if si < 0 {
        fail_at(fn_node.line, fn_node.col, "generator functions need import \"generators.fg\" (type '" + fn_node.sval + "' is not defined)");
    }
    if g.struct_type_params[si] != "T" {
        fail_at(fn_node.line, fn_node.col, "Generator<T> must come from import \"generators.fg\" (expected fields kind, cur, slots_i, slots_s, slots_b)");
    }
    let names: [str] = split(g.struct_field_names[si], "~");
    let typs: [str] = split(g.struct_field_typs[si], "~");
    if len(names) != 5 {
        fail_at(fn_node.line, fn_node.col, "Generator<T> must come from import \"generators.fg\" (expected fields kind, cur, slots_i, slots_s, slots_b)");
    }
    let exp_names: [str] = ["kind", "cur", "slots_i", "slots_s", "slots_b"];
    let exp_typs: [str] = ["int", "T", "[int]", "[str]", "[bool]"];
    let mut i: int = 0;
    while i < 5 {
        // (field lookup by name, order-insensitive)
        let mut found: str = "";
        let mut j: int = 0;
        while j < len(names) {
            if names[j] == exp_names[i] {
                found = typs[j];
            }
            j = j + 1;
        }
        if found != exp_typs[i] {
            fail_at(fn_node.line, fn_node.col, "Generator<T> must come from import \"generators.fg\" (expected fields kind, cur, slots_i, slots_s, slots_b)");
        }
        i = i + 1;
    }
    return true;
}

// Native only in v1 — big32 / wasm / freestanding are
// check-time named errors, never backend-internal ones.
fn g_check_target(g: GGen, fn_node: Node) -> bool {
    if g.freestanding {
        fail_at(fn_node.line, fn_node.col, "generators are not supported in freestanding mode in v1 (generators need arrays)");
    }
    if g.target == "big32" {
        fail_at(fn_node.line, fn_node.col, "generators are not supported on big32 in v1 (the Generator struct needs array fields, which big32 structs do not support in v1)");
    }
    if g.target == "wasm" {
        fail_at(fn_node.line, fn_node.col, "generators are not supported on wasm in v1 (wasm v2 does not support struct returns)");
    }
    return true;
}

fn g_transform(g0: GGen, fn_node: Node, elem: str) -> GTransformOut {
    let mut g: GGen = g0;
    g.kind_counter = g.kind_counter + 1;
    g.fn_name = g_name_base(fn_node.name);
    g.fn_line = fn_node.line;
    g.fn_col = fn_node.col;
    g.elem = elem;
    g.kind = g.kind_counter;
    g.scopes = [GScope { names: [], kinds: [], arrs: [], idxs: [], typs: [] }];
    g.int_count = 1;
    g.str_count = 0;
    g.bool_count = 0;
    g.states = [GState { stmts: [] }];
    g.cur_state = 0;
    g.end_state = 0;
    let mut elbl: [str] = [];
    g.loop_labels = elbl;
    let mut elsp: [bool] = [];
    g.loop_is_split = elsp;
    let mut elbk: [int] = [];
    g.loop_brk = elbk;
    let mut elct: [int] = [];
    g.loop_cont = elct;
    let step_name: str = g.fn_name + "_next";
    if g_fn_index(g, step_name) >= 0 {
        fail_at(fn_node.line, fn_node.col, "generator '" + g.fn_name + "' needs a step function named '" + step_name + "' but one already exists; rename it");
    }
    // Seed the scope with the params (slots 1.. for ints).
    let mut pi: int = 0;
    while pi + 1 < len(fn_node.kids) {
        let p: Node = fn_node.kids[pi];
        if !g_is_gen_elem(p.sval) {
            fail_at(fn_node.line, fn_node.col, "generator parameter '" + p.name + "' has type " + p.sval + "; only int, str, and bool parameters are supported in v1");
        }
        g = g_declare_slot(g, p.name, p.sval);
        pi = pi + 1;
    }
    // Split the body: state 0 is the first segment; the end
    // state returns none.
    let es_ns: GIntOut = g_new_state(g);
    g = es_ns.g;
    g.end_state = es_ns.num;
    let body: Node = fn_node.kids[len(fn_node.kids) - 1];
    let sb: GIntOut = g_split_block(g, body.kids, g.end_state);
    g = sb.g;
    let mut sts: [GState] = g.states;
    let mut end_st: GState = sts[g.end_state];
    let mut er: Node = new_node(17, fn_node.line, fn_node.col);
    let ernl: GNodeOut = g_none_lit(g, fn_node.line, fn_node.col);
    g = ernl.g;
    er.kids = [ernl.node];
    end_st.stmts = [er];
    sts[g.end_state] = end_st;
    g.states = sts;
    // The constructor: slot arrays in annotated lets, then the
    // struct literal. Param slots hold the params; local slots
    // hold zero.
    let z0: GNodeOut = g_int(g, 0, fn_node.line, fn_node.col);
    g = z0.g;
    let mut si_elems: [Node] = [z0.node];
    let mut i: int = 1;
    while i < g.int_count {
        let zi: GNodeOut = g_int(g, 0, fn_node.line, fn_node.col);
        g = zi.g;
        push(si_elems, zi.node);
        i = i + 1;
    }
    let mut ss_elems: [Node] = [];
    i = 0;
    while i < g.str_count {
        let zs: GNodeOut = g_str(g, "", fn_node.line, fn_node.col);
        g = zs.g;
        push(ss_elems, zs.node);
        i = i + 1;
    }
    let mut sb_elems: [Node] = [];
    i = 0;
    while i < g.bool_count {
        let zb: GNodeOut = g_bool(g, false, fn_node.line, fn_node.col);
        g = zb.g;
        push(sb_elems, zb.node);
        i = i + 1;
    }
    pi = 0;
    while pi + 1 < len(fn_node.kids) {
        let p: Node = fn_node.kids[pi];
        let b: GBinding = g_lookup(g, p.name);
        let vo: GNodeOut = g_var(g, p.name, fn_node.line, fn_node.col);
        g = vo.g;
        let v: Node = vo.node;
        if b.arr == "slots_i" {
            si_elems[b.idx] = v;
        } else if b.arr == "slots_s" {
            ss_elems[b.idx] = v;
        } else {
            sb_elems[b.idx] = v;
        }
        pi = pi + 1;
    }
    let sia: GNodeOut = g_node(g, 29, fn_node.line, fn_node.col);
    g = sia.g;
    let mut si_arr: Node = sia.node;
    si_arr.kids = si_elems;
    let mut si_let: Node = new_node(10, fn_node.line, fn_node.col);
    si_let.name = "si";
    si_let.bval = false;
    si_let.sval = "[int]";
    si_let.kids = [si_arr];
    let ssa: GNodeOut = g_node(g, 29, fn_node.line, fn_node.col);
    g = ssa.g;
    let mut ss_arr: Node = ssa.node;
    ss_arr.kids = ss_elems;
    let mut ss_let: Node = new_node(10, fn_node.line, fn_node.col);
    ss_let.name = "ss";
    ss_let.bval = false;
    ss_let.sval = "[str]";
    ss_let.kids = [ss_arr];
    let sba: GNodeOut = g_node(g, 29, fn_node.line, fn_node.col);
    g = sba.g;
    let mut sb_arr: Node = sba.node;
    sb_arr.kids = sb_elems;
    let mut sb_let: Node = new_node(10, fn_node.line, fn_node.col);
    sb_let.name = "sb";
    sb_let.bval = false;
    sb_let.sval = "[bool]";
    sb_let.kids = [sb_arr];
    let mut fk: Node = new_node(44, fn_node.line, fn_node.col);
    fk.name = "kind";
    let fki: GNodeOut = g_int(g, g.kind, fn_node.line, fn_node.col);
    g = fki.g;
    fk.kids = [fki.node];
    let mut fc: Node = new_node(44, fn_node.line, fn_node.col);
    fc.name = "cur";
    let fcz: GNodeOut = g_zero(g, elem, fn_node.line, fn_node.col);
    g = fcz.g;
    fc.kids = [fcz.node];
    let mut fi: Node = new_node(44, fn_node.line, fn_node.col);
    fi.name = "slots_i";
    let fiv: GNodeOut = g_var(g, "si", fn_node.line, fn_node.col);
    g = fiv.g;
    fi.kids = [fiv.node];
    let mut fs: Node = new_node(44, fn_node.line, fn_node.col);
    fs.name = "slots_s";
    let fsv: GNodeOut = g_var(g, "ss", fn_node.line, fn_node.col);
    g = fsv.g;
    fs.kids = [fsv.node];
    let mut fb: Node = new_node(44, fn_node.line, fn_node.col);
    fb.name = "slots_b";
    let fbv: GNodeOut = g_var(g, "sb", fn_node.line, fn_node.col);
    g = fbv.g;
    fb.kids = [fbv.node];
    let lito: GNodeOut = g_node(g, 31, fn_node.line, fn_node.col);
    g = lito.g;
    let mut lit: Node = lito.node;
    lit.name = "Generator";
    lit.kids = [fk, fc, fi, fs, fb];
    let mut cret: Node = new_node(17, fn_node.line, fn_node.col);
    cret.kids = [lit];
    let mut cbody: Node = new_node(9, fn_node.line, fn_node.col);
    cbody.kids = [si_let, ss_let, sb_let, cret];
    let mut ckids: [Node] = [];
    pi = 0;
    while pi + 1 < len(fn_node.kids) {
        push(ckids, fn_node.kids[pi]);
        pi = pi + 1;
    }
    push(ckids, cbody);
    let mut ctor: Node = new_node(2, fn_node.line, fn_node.col);
    ctor.name = g.fn_name;
    ctor.sval = fn_node.sval;
    ctor.kids = ckids;
    // The step function: while (true) dispatch over the states,
    // then a trailing return (definite-return analysis, p13).
    let mut dispatch: [Node] = [];
    let mut sid: int = 0;
    while sid < len(g.states) {
        let gv: GNodeOut = g_gvar(g, fn_node.line, fn_node.col);
        g = gv.g;
        let fao: GNodeOut = g_node(g, 32, fn_node.line, fn_node.col);
        g = fao.g;
        let mut fa: Node = fao.node;
        fa.name = "slots_i";
        fa.kids = [gv.node];
        let ixo: GNodeOut = g_node(g, 36, fn_node.line, fn_node.col);
        g = ixo.g;
        let iz: GNodeOut = g_int(g, 0, fn_node.line, fn_node.col);
        g = iz.g;
        let mut ix: Node = ixo.node;
        ix.kids = [fa, iz.node];
        let co: GNodeOut = g_node(g, 40, fn_node.line, fn_node.col);
        g = co.g;
        let sidn: GNodeOut = g_int(g, sid, fn_node.line, fn_node.col);
        g = sidn.g;
        let mut cond: Node = co.node;
        cond.name = "==";
        cond.kids = [ix, sidn.node];
        let mut th: Node = new_node(9, fn_node.line, fn_node.col);
        th.kids = g.states[sid].stmts;
        let mut ifn: Node = new_node(14, fn_node.line, fn_node.col);
        ifn.kids = [cond, th];
        push(dispatch, ifn);
        sid = sid + 1;
    }
    let mut dret: Node = new_node(17, fn_node.line, fn_node.col);
    let drnl: GNodeOut = g_none_lit(g, fn_node.line, fn_node.col);
    g = drnl.g;
    dret.kids = [drnl.node];
    push(dispatch, dret);
    let mut dblock: Node = new_node(9, fn_node.line, fn_node.col);
    dblock.kids = dispatch;
    let wco: GNodeOut = g_node(g, 28, fn_node.line, fn_node.col);
    g = wco.g;
    let mut wcond: Node = wco.node;
    wcond.bval = true;
    let mut wh: Node = new_node(15, fn_node.line, fn_node.col);
    wh.label = "";
    wh.kids = [wcond, dblock];
    let mut tret: Node = new_node(17, fn_node.line, fn_node.col);
    let trnl: GNodeOut = g_none_lit(g, fn_node.line, fn_node.col);
    g = trnl.g;
    tret.kids = [trnl.node];
    let mut sbody: Node = new_node(9, fn_node.line, fn_node.col);
    sbody.kids = [wh, tret];
    let mut sparam: Node = new_node(43, fn_node.line, fn_node.col);
    sparam.name = "g";
    sparam.sval = fn_node.sval;
    let mut step: Node = new_node(2, fn_node.line, fn_node.col);
    step.name = step_name;
    step.sval = "Option<" + elem + ">";
    step.kids = [sparam, sbody];
    // Register the step fn in the fn table (the Python mirror
    // does the same): a later generator body that calls this
    // step fn must be able to prove its return type, and the
    // idempotency skip in resolve_generators_prog reads this
    // table.
    let mut rnames: [str] = g.fn_names;
    push(rnames, step_name);
    g.fn_names = rnames;
    let mut rrets: [str] = g.fn_rets;
    push(rrets, "Option<" + elem + ">");
    g.fn_rets = rrets;
    let mut rpts: [str] = g.fn_param_typs;
    push(rpts, fn_node.sval);
    g.fn_param_typs = rpts;
    let mut rtp: [str] = g.fn_type_params;
    push(rtp, "");
    g.fn_type_params = rtp;
    return GTransformOut { g: g, ctor: ctor, step: step };
}

// Program-level generator transform (see the section header).
// Returns the (possibly rewritten) program; raises (via
// fail_at) on any v1 violation. A no-op when the program
// defines no generator.
fn resolve_generators_prog(c: HChecker, prog: Node) -> Node {
    let mut g: GGen = g_new();
    g.target = c.target;
    g.freestanding = c.freestanding;
    g = g_build_tables(g, prog);
    let mut out_funcs: [Node] = [];
    let mut step_fns: [Node] = [];
    let mut changed: bool = false;
    let mut i: int = 0;
    while i < len(prog.kids) {
        let fn_node: Node = prog.kids[i];
        if fn_node.kind != 2 || len(fn_node.kids) == 0 {
            push(out_funcs, fn_node);
            i = i + 1;
            continue;
        }
        let body: Node = fn_node.kids[len(fn_node.kids) - 1];
        if body.kind != 9 {
            push(out_funcs, fn_node);
            i = i + 1;
            continue;
        }
        let has_yield: bool = g_scan_body(g, body);
        let elem: str = g_gen_ret(fn_node.sval);
        let is_gen: bool = elem != "";
        // Defer in a generator body is a v1 error — but only
        // when the fn IS a generator. The pre-scan runs on
        // every fn, so the check is gated here, not in the
        // scan (a non-generator fn with a defer is fine).
        if has_yield || is_gen {
            let d: Node = g_find_defer_stmts(body.kids);
            if d.kind == 23 {
                fail_at(d.line, d.col, "defer is not supported inside a generator function in v1 (it would run when the step function returns, not when the generator closes)");
            }
        }
        if has_yield {
            if !is_gen {
                fail_at(fn_node.line, fn_node.col, "yield is only allowed in a function returning Generator<T> in v1");
            }
            if !g_is_gen_elem(elem) {
                fail_at(fn_node.line, fn_node.col, "generator element type must be int, str, or bool in v1, got " + elem);
            }
            if len(g_name_type_params(fn_node.name)) > 0 {
                fail_at(fn_node.line, fn_node.col, "generic generator functions are not supported in v1");
            }
            g_check_gen_struct(g, fn_node);
            g_check_target(g, fn_node);
            let tr: GTransformOut = g_transform(g, fn_node, elem);
            g = tr.g;
            push(out_funcs, tr.ctor);
            push(step_fns, tr.step);
            changed = true;
        } else if is_gen {
            if !g_is_gen_elem(elem) {
                fail_at(fn_node.line, fn_node.col, "generator element type must be int, str, or bool in v1, got " + elem);
            }
            if len(g_name_type_params(fn_node.name)) > 0 {
                fail_at(fn_node.line, fn_node.col, "generic generator functions are not supported in v1");
            }
            if g_struct_index(g, "Generator") < 0 {
                push(out_funcs, fn_node);
                i = i + 1;
                continue;
            }
            // Idempotency: this pass runs twice (check_program,
            // then compile_to_c on the merged program). A
            // constructor from the first pass still returns
            // Generator<T> with no yield, so without this skip the
            // second pass would re-transform it and trip its own
            // step fn as a name collision. A fn whose <name>_next
            // already exists is already a constructor — leave it
            // alone. (A yield-ful fn whose step fn exists is a REAL
            // collision and still errors in g_transform; a no-yield
            // fn whose step fn is user-defined is the same shape
            // and is likewise left alone — the <name>_next name is
            // reserved.)
            if g_fn_index(g, fn_node.name + "_next") >= 0 {
                push(out_funcs, fn_node);
                i = i + 1;
                continue;
            }
            g_check_gen_struct(g, fn_node);
            g_check_target(g, fn_node);
            let tr: GTransformOut = g_transform(g, fn_node, elem);
            g = tr.g;
            push(out_funcs, tr.ctor);
            push(step_fns, tr.step);
            changed = true;
        } else {
            push(out_funcs, fn_node);
        }
        i = i + 1;
    }
    if !changed {
        return prog;
    }
    let mut all: [Node] = out_funcs;
    let mut j: int = 0;
    while j < len(step_fns) {
        push(all, step_fns[j]);
        j = j + 1;
    }
    return ct_with_kids(prog, all);
}

// ---------- Top-500 #72: walrus (`name := expr`) ----------
// The parser builds NamedExpr nodes (kind 51); this resolve
// pass (the #70 pattern: a deterministic tree-rebuilding pass,
// run once at check_program entry and once in compile_to_c on
// the merged program) desugars every legal one before check,
// infer, or codegen ever see it. A walrus in an if/while
// condition becomes a binding statement spliced before the
// statement (Let for a fresh name, Assign for an existing one),
// the condition is rewritten with Var(name), and a while gets
// its re-read appended to the body end. The pass is
// scope-aware: it tracks the visible variable names (flat
// [str], passed by value — Qasida arrays are copied on
// assignment, so each nested block gets its own copy and
// declarations never leak out of their block, exactly like
// lexical scoping), plus the enclosing loop stack (labels +
// walrus flags) for the v1 `continue` ban. With no NamedExpr
// in the tree the original node is returned untouched, so the
// bootstrap emit stays byte-identical. No new struct fields
// anywhere in this slice, so the ASan compiler-side numbers
// cannot grow through the field-encoding mechanism (#70 §6.4).

// True when the tree contains a NamedExpr (kind 51) anywhere.
fn w_has_walrus(n: Node) -> bool {
    if n.kind == 51 {
        return true;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if w_has_walrus(n.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// True when `e` contains a NamedExpr outside any nested lambda
// body. A walrus inside a lambda in the RHS belongs to the
// lambda, not to this walrus.
fn w_has_walrus_shallow(e: Node) -> bool {
    if e.kind == 51 {
        return true;
    }
    if e.kind == 47 {
        return false;
    }
    let mut i: int = 0;
    while i < len(e.kids) {
        if w_has_walrus_shallow(e.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Is `name` bound in any enclosing scope (innermost wins, but
// the rewrite only needs existence)?
fn w_bound(names: [str], name: str) -> bool {
    let mut i: int = len(names) - 1;
    while i >= 0 {
        if names[i] == name {
            return true;
        }
        i = i - 1;
    }
    return false;
}

// Walrus nodes in expression `e`, in left-to-right order;
// raises on illegal positions. ctx is "ok" (every ancestor is
// the condition root, `!`, a comparison, or the LEFT of `&&` /
// `||`), "andright", "other", or "nested".
fn w_collect(e: Node, ctx: str) -> [Node] {
    if e.kind == 51 {
        if ctx == "nested" {
            fail_at(e.line, e.col, "walrus cannot appear inside another walrus in v1");
        }
        if ctx == "andright" {
            fail_at(e.line, e.col, "walrus cannot appear on the right of '&&' or '||' in v1 (hoisting it would change when the assignment runs; write the assignment before the if instead)");
        }
        if ctx != "ok" {
            fail_at(e.line, e.col, "walrus ':=' is only allowed in if/while conditions in v1");
        }
        // Legal here — but a walrus inside the RHS is nested.
        if w_has_walrus_shallow(e.kids[0]) {
            fail_at(e.line, e.col, "walrus cannot appear inside another walrus in v1");
        }
        return [e];
    }
    if e.kind == 40 {
        // BinOp: name is the operator.
        if e.name == "&&" || e.name == "||" {
            let mut out: [Node] = w_collect(e.kids[0], ctx);
            let mut right_ctx: str = "andright";
            if ctx != "ok" {
                right_ctx = ctx;
            }
            let r: [Node] = w_collect(e.kids[1], right_ctx);
            let mut i: int = 0;
            while i < len(r) {
                push(out, r[i]);
                i = i + 1;
            }
            return out;
        }
        if e.name == "==" || e.name == "!=" || e.name == "<" || e.name == "<=" || e.name == ">" || e.name == ">=" {
            let mut out: [Node] = w_collect(e.kids[0], ctx);
            let r: [Node] = w_collect(e.kids[1], ctx);
            let mut i: int = 0;
            while i < len(r) {
                push(out, r[i]);
                i = i + 1;
            }
            return out;
        }
        let mut nxt: str = "other";
        if ctx != "ok" {
            nxt = ctx;
        }
        let mut out: [Node] = w_collect(e.kids[0], nxt);
        let r: [Node] = w_collect(e.kids[1], nxt);
        let mut i: int = 0;
        while i < len(r) {
            push(out, r[i]);
            i = i + 1;
        }
        return out;
    }
    if e.kind == 41 {
        // UnaryOp: name is the operator; kids[0] is the operand.
        if e.name == "!" {
            return w_collect(e.kids[0], ctx);
        }
        let mut nxt: str = "other";
        if ctx != "ok" {
            nxt = ctx;
        }
        return w_collect(e.kids[0], nxt);
    }
    if e.kind == 47 {
        // Lambda: a walrus inside the body binds in the
        // lambda's own scope; the lambda's statement lists
        // desugar it. Do not descend.
        return [];
    }
    // Any other node: children are "other" (or keep ctx).
    let mut nxt: str = "other";
    if ctx != "ok" {
        nxt = ctx;
    }
    let mut out: [Node] = [];
    let mut i: int = 0;
    while i < len(e.kids) {
        let sub: [Node] = w_collect(e.kids[i], nxt);
        let mut j: int = 0;
        while j < len(sub) {
            push(out, sub[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

// Replace every NamedExpr in `e` with Var(name); rebuilds the
// tree (the alias pattern). Lambda bodies are not descended
// into (their walruses belong to the lambda).
fn w_subst_vars(e: Node) -> Node {
    if e.kind == 51 {
        let mut v: Node = new_node(34, e.line, e.col);
        v.name = e.name;
        return v;
    }
    if e.kind == 47 {
        return e;
    }
    let mut kids: [Node] = [];
    let mut i: int = 0;
    while i < len(e.kids) {
        push(kids, w_subst_vars(e.kids[i]));
        i = i + 1;
    }
    return ct_with_kids(e, kids);
}

// A deep copy of an expression tree (a new node object at every
// level). The re-read in a walrus-while needs its own copy of
// the RHS: the Python desugar uses copy.deepcopy, and the Fix 1
// loop-proof marks BinOp nodes PLAIN by node identity — if the
// re-read shared the pre-loop binding's node, the plain marking
// would leak into the re-read and the two compilers would emit
// different C (plain `-` vs checked `forge_sub`). The initial
// binding keeps the original node (Python does the same); only
// the re-read is deep-copied.
//
// The copy also NEUTRALIZES the source position (line/col 0,0):
// the hosted tagger (`fix1_tag_node`) keys its plain/covered
// lookups by bare (line, col), NOT by node identity (Python's
// `_fix1_plain` is a set of node ids), so a copy that kept the
// original (line, col) would be re-tagged plain at its new
// position. Line/col 0,0 never occurs in real source (lines
// are 1-based), so the lookup can never collide. The backtrace
// still names the walrus's line: it reads the Assign
// statement's line, which is set to the walrus's position, not
// the copied expression's. `has_nul` is cleared ONLY on BinOp
// (40) and UnaryOp (41), where it means the loop-proof plain
// tag; on StrLit it is the NUL sentinel and must be preserved.
fn w_deepcopy(e: Node) -> Node {
    let mut kids: [Node] = [];
    let mut i: int = 0;
    while i < len(e.kids) {
        push(kids, w_deepcopy(e.kids[i]));
        i = i + 1;
    }
    let mut c: Node = ct_with_kids(e, kids);
    c.line = 0;
    c.col = 0;
    if e.kind == 40 || e.kind == 41 {
        c.has_nul = false;
    }
    return c;
}

// Resolve one node: rebuild it with every walrus desugared.
// Statement lists are only ever inside Block nodes (kind 9),
// so If/While always go through w_rewrite_stmts; the generic
// case below only rebuilds kids (a walrus surviving there is
// caught by the checker's guard, loudly, never silently).
fn w_resolve_node(n: Node, names: [str], loop_labels: [str], loop_walrus: [bool]) -> Node {
    if n.kind == 9 {
        // Block: the only place statement lists live.
        return ct_with_kids(n, w_rewrite_stmts(n.kids, names, loop_labels, loop_walrus));
    }
    if n.kind == 2 || n.kind == 47 {
        // FuncDef/Lambda: params are in scope for the body;
        // the loop stack resets (a function/lambda is a loop
        // boundary). The body is the Block kid (an extern fn
        // has no body).
        let mut names2: [str] = names;
        let mut kids2: [Node] = [];
        let mut i: int = 0;
        while i < len(n.kids) {
            let k: Node = n.kids[i];
            if k.kind == 43 {
                push(names2, k.name);
                push(kids2, k);
            } else if k.kind == 9 {
                let empty_ll: [str] = [];
                let empty_lw: [bool] = [];
                push(kids2, w_resolve_node(k, names2, empty_ll, empty_lw));
            } else {
                push(kids2, k);
            }
            i = i + 1;
        }
        return ct_with_kids(n, kids2);
    }
    if n.kind == 20 {
        // Match: the scrutinee is an expression; each arm's
        // bindings (arm.sval, plus struct-pattern field
        // bindings) are in scope for that arm's body only.
        let scr: Node = w_resolve_node(n.kids[0], names, loop_labels, loop_walrus);
        let mut kids2: [Node] = [scr];
        let mut a: int = 1;
        while a < len(n.kids) {
            let arm: Node = n.kids[a];
            let mut names2: [str] = names;
            if arm.sval != "" {
                push(names2, arm.sval);
            }
            let mut fi: int = 1;
            while fi < len(arm.kids) {
                let fp: Node = arm.kids[fi];
                if fp.label == "binding" {
                    push(names2, fp.sval);
                }
                fi = fi + 1;
            }
            let body2: Node = w_resolve_node(arm.kids[0], names2, loop_labels, loop_walrus);
            let mut akids: [Node] = [body2];
            let mut f: int = 1;
            while f < len(arm.kids) {
                push(akids, arm.kids[f]);
                f = f + 1;
            }
            push(kids2, ct_with_kids(arm, akids));
            a = a + 1;
        }
        return ct_with_kids(n, kids2);
    }
    if n.kind == 16 {
        // For: the loop variable is in scope for the body
        // only; the loop pushes itself (never a walrus loop).
        let expr2: Node = w_resolve_node(n.kids[0], names, loop_labels, loop_walrus);
        let mut names2: [str] = names;
        push(names2, n.name);
        let mut ll2: [str] = loop_labels;
        let mut lw2: [bool] = loop_walrus;
        push(ll2, n.label);
        push(lw2, false);
        let body2: Node = w_resolve_node(n.kids[1], names2, ll2, lw2);
        return ct_with_kids(n, [expr2, body2]);
    }
    // Generic: rebuild every kid in place.
    let mut kids2: [Node] = [];
    let mut i: int = 0;
    while i < len(n.kids) {
        push(kids2, w_resolve_node(n.kids[i], names, loop_labels, loop_walrus));
        i = i + 1;
    }
    return ct_with_kids(n, kids2);
}

// Rewrite one statement list with the walrus desugar. `names`
// is the flat list of variable names visible at the head of
// this list (accumulates Lets and walrus bindings in order;
// the caller's copy is untouched — pass-by-copy — so
// declarations in this list never leak out of it).
// `loop_labels`/`loop_walrus` are the enclosing loop stack
// (parallel arrays; the innermost loop is last).
fn w_rewrite_stmts(stmts: [Node], names: [str], loop_labels: [str], loop_walrus: [bool]) -> [Node] {
    let mut out: [Node] = [];
    let mut i: int = 0;
    while i < len(stmts) {
        let n: Node = stmts[i];
        if n.kind == 14 || n.kind == 15 {
            // If/While: desugar walruses in the condition.
            let is_while: bool = n.kind == 15;
            let walruses: [Node] = w_collect(n.kids[0], "ok");
            // Bindings, in left-to-right order.
            let mut j: int = 0;
            while j < len(walruses) {
                let w: Node = walruses[j];
                if w_bound(names, w.name) {
                    // Existing name: Assign (the checker
                    // validates mutability and type when it
                    // checks it).
                    let mut a: Node = new_node(11, w.line, w.col);
                    a.name = w.name;
                    a.kids = [w.kids[0]];
                    push(out, a);
                } else {
                    // Fresh name: `let mut` with no
                    // annotation; the type is inferred by the
                    // normal Let path. Visible to later
                    // statements in this list and to the
                    // branches below.
                    let mut l: Node = new_node(10, w.line, w.col);
                    l.name = w.name;
                    l.bval = true;
                    l.sval = "";
                    l.kids = [w.kids[0]];
                    push(out, l);
                    push(names, w.name);
                }
                j = j + 1;
            }
            // The rewritten condition (NamedExpr -> Var).
            let cond2: Node = w_subst_vars(n.kids[0]);
            // The loop stack for the sub-blocks: a While
            // pushes itself (walrus-ness = this statement
            // binds one); an If does not push.
            let mut ll2: [str] = loop_labels;
            let mut lw2: [bool] = loop_walrus;
            if is_while {
                push(ll2, n.label);
                push(lw2, len(walruses) > 0);
            }
            if n.kind == 14 {
                let then2: Node = w_resolve_node(n.kids[1], names, ll2, lw2);
                let mut kids2: [Node] = [cond2, then2];
                if len(n.kids) > 2 {
                    push(kids2, w_resolve_node(n.kids[2], names, ll2, lw2));
                }
                push(out, ct_with_kids(n, kids2));
            } else {
                let body2: Node = w_resolve_node(n.kids[1], names, ll2, lw2);
                // Append the re-read(s) to the body end. Each
                // re-read gets a DEEP COPY of the RHS (Python
                // uses copy.deepcopy): sharing the pre-loop
                // binding's node would leak the Fix 1 plain
                // marking into the re-read by node identity.
                let mut bkids: [Node] = body2.kids;
                let mut k: int = 0;
                while k < len(walruses) {
                    let w: Node = walruses[k];
                    let mut a: Node = new_node(11, w.line, w.col);
                    a.name = w.name;
                    a.kids = [w_deepcopy(w.kids[0])];
                    push(bkids, a);
                    k = k + 1;
                }
                push(out, ct_with_kids(n, [cond2, ct_with_kids(body2, bkids)]));
            }
        } else if n.kind == 19 {
            // Continue: the v1 ban on targeting a
            // walrus-while. The checker validates labels and
            // loop membership itself; the rewrite only bans
            // the walrus case.
            if n.label != "" {
                // Innermost loop with this label wins (#62).
                let mut idx: int = len(loop_labels) - 1;
                while idx >= 0 {
                    if loop_labels[idx] == n.label {
                        if loop_walrus[idx] {
                            fail_at(n.line, n.col, "continue cannot target a while loop whose condition binds a walrus in v1 (it would skip the re-read of the bound value; restructure the loop or use break)");
                        }
                        break;
                    }
                    idx = idx - 1;
                }
            } else {
                if len(loop_walrus) > 0 && loop_walrus[len(loop_walrus) - 1] {
                    fail_at(n.line, n.col, "continue cannot target a while loop whose condition binds a walrus in v1 (it would skip the re-read of the bound value; restructure the loop or use break)");
                }
            }
            push(out, n);
        } else if n.kind == 10 {
            // Let: declare the name for later statements in
            // this list (the RHS may contain a lambda whose
            // body holds walruses — resolved by the recursion).
            push(out, w_resolve_node(n, names, loop_labels, loop_walrus));
            push(names, n.name);
        } else {
            push(out, w_resolve_node(n, names, loop_labels, loop_walrus));
        }
        i = i + 1;
    }
    return out;
}

// The entry point: the program with every walrus desugared, or
// the original node untouched when there is nothing to do.
fn resolve_walrus_prog(prog: Node) -> Node {
    if !w_has_walrus(prog) {
        return prog;
    }
    let names: [str] = [];
    let ll: [str] = [];
    let lw: [bool] = [];
    return w_resolve_node(prog, names, ll, lw);
}

// Set a checker's Target fields from the CLI facts, validating
// the target name (mirrors forge_lang/checker.py make_target).
fn ct_set_target(c0: HChecker, target: str, mode: str, debug: bool) -> HChecker {
    let mut c: HChecker = c0;
    c.target = target;
    if target == "native" {
        c.arch = "x86_64";
        c.os = "linux";
    } else if target == "big32" {
        c.arch = "riscv32";
        c.os = "none";
    } else if target == "wasm" {
        c.arch = "wasm32";
        c.os = "wasm";
    } else {
        fail_at(1, 1, "unknown target '" + target + "'; allowed: native, big32, wasm");
    }
    c.mode = mode;
    c.debug = debug;
    return c;
}

fn check_program(prog: Node, freestanding: bool, fn_files: [str], dump_error_sets: bool, target: str, mode: str, debug: bool) -> bool {
    let mut p: Node = expand_aliases_prog(prog);
    let mut c: HChecker = new_checker();
    c.freestanding = freestanding;
    // Top-500 #70: the build target this check resolves
    // `comptime if` against (the hosted driver evaluates native
    // only; non-native targets are Python-only).
    c = ct_set_target(c, target, mode, debug);
    // Top-500 #74: desugar generators (`yield`) before checking,
    // so the checker/infer/codegen see only the constructor and
    // step function (DESIGN.md §3.8: generators -> walrus ->
    // comptime, in both check_program and compile_to_c, so a
    // walrus or a yield inside a comptime branch is a named
    // error here, not silently desugared away).
    p = resolve_generators_prog(c, p);
    // Top-500 #72: desugar walrus (`name := expr`) before
    // checking, so the checker/infer/codegen see only ordinary
    // Let/Assign/Var nodes. (compile_to_c resolves it on the
    // merged program too, so run_infer/codegen see it as well.)
    p = resolve_walrus_prog(p);
    // Top-500 #70: resolve `comptime if` before checking, so the
    // checker sees resolved code (the same resolved program is
    // what compile_to_c hands to run_infer/codegen_program).
    p = resolve_comptime_prog(c, p);
    // Top-500 #48: (name, file) pairs for try_call's module
    // boundary (load_merged records them; test harnesses pass []).
    c.fn_files = fn_files;
    c = collect_defs(c, p);
    let mut i: int = 0;
    while i < len(p.kids) {
        let n: Node = p.kids[i];
        if n.kind == 2 {
            // Skip extern declarations (no body to check).
            if len(n.kids) == 0 {
                i = i + 1;
                continue;
            }
            c = check_func(c, n, hc_func_file(c, n.name));
        }
        if n.kind == 6 {
            // ImplDef: check each method body like a function.
            let mut j: int = 0;
            while j < len(n.kids) {
                c = check_func(c, n.kids[j], hc_func_file(c, n.name + "__" + n.kids[j].name));
                j = j + 1;
            }
        }
        i = i + 1;
    }
    // Top-500 #50: second pass — inferred error sets
    // (ES-C1–ES-C9). Runs inside check_program so the
    // checker (with its def tables) is still live; the
    // verdicts fire here, after the fixpoint, and the dump
    // prints before codegen.
    c = es_infer(c, p, dump_error_sets);
    return true;
}
