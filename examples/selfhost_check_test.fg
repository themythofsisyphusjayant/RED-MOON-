// Driver for the hosted checker (examples/selfhost_check.fg).
// Reads a .fg file path from argv, lexes + parses it with the
// hosted lexer/parser, then runs the hosted checker on it.
// Prints "CHECK PASS" and exits 0 if the program checks clean.
// On a type error the checker calls fail(), which prints the
// error to stderr and exits 1 — the verifier reads that.
// Usage: qasida run examples/selfhost_check_test.fg -- <path>

import "selfhost_check.fg";

fn main() -> int {
    let argv: [str] = args();
    if len(argv) < 1 {
        println("usage: selfhost_check_test.fg -- <path>");
        return 1;
    }
    let src: str = read_file(argv[0]);
    let lx: LexOut = lex(src);
    let hp: HParser = HParser { kinds: lx.kinds, texts: lx.texts, lines: lx.lines, cols: lx.cols, pos: 0, has_nul: lx.has_nul };
    let prog: POut = parse_program(hp);
    let ok: bool = check_program(prog.n, false);
    if ok {
        println("CHECK PASS");
        return 0;
    }
    println("CHECK FAIL");
    return 1;
}
