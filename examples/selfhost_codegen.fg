    }
    if e.name == "weak_upgrade" {
        g.assign_counter = g.assign_counter + 1;
        let n: int = g.assign_counter;
        g.assign_counter = g.assign_counter + 1;
        let m: int = g.assign_counter;
        let iout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = iout.g;
        return CGExpr { g: g, code: "({long long __forge_arg" + itoa(n) + " = " + iout.code + "; ForgeTuple_bool_Arr_int __forge_arg" + itoa(m) + "; __forge_arg" + itoa(m) + "._0 = forge_weak_get(__forge_arg" + itoa(n) + ", &__forge_arg" + itoa(m) + "._1); if (!__forge_arg" + itoa(m) + "._0) { __forge_arg" + itoa(m) + "._1 = (ForgeIntArray){NULL, 0, 0, forge_arr_ref_new()}; } __forge_arg" + itoa(m) + ";})" };
    }
    if e.name == "parallel_dot" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_parallel_dot(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "parallel_matmul" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        let cout: CGExpr = cg_gen_expr(g, e.kids[2]);
        g = cout.g;
        return CGExpr { g: g, code: "forge_parallel_matmul(" + aout.code + ", " + bout.code + ", " + cout.code + ")" };
    }
    // Enum variant construction: Some(42), None(), Circle(3.0).
    let v: [str] = cg_variant_lookup(g, e.name);
    if v[0] == "1" {
        let ename: str = v[1];
        let tag: str = v[2];
        let payload: str = v[3];
        if payload == "" && !cg_enum_has_payload(g, ename) {
            return CGExpr { g: g, code: e.name };
        }
