        return CGExpr { g: g, code: "forge_mmap_grow(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "mmap_get32" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
