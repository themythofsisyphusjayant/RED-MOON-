    }
    if e.name == "args" {
        return CGExpr { g: g, code: "forge_args_global" };
    }
    if e.name == "parse_float" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_parse_float(" + aout.code + ")" };
    }
    if e.name == "parse_int" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_parse_int(" + aout.code + ")" };
    }
    if e.name == "run_command" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_run_command(" + aout.code + ")" };
    }
    if e.name == "split" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_split(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "join" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_join(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "substr" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        let cout: CGExpr = cg_gen_expr(g, e.kids[2]);
        g = cout.g;
