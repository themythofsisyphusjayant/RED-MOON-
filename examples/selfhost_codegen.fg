            }
            return cg_gen_expr(g, arg);
        }
        let mut cond: bool = false;
        if g.move_cond >= 0 {
            cond = g.move_cond == 1;
        } else {
            cond = g.branch_depth > 0 || g.loop_depth > 0;
        }
        if cond {
            let flag: str = cg_moved_flag(arg.name);
            let aout: CGExpr = cg_gen_expr(g, arg);
            g = aout.g;
            return CGExpr { g: g, code: "({ if (" + flag + ") forge_fail(\"use of moved value '" + arg.name + "'\"); " + flag + " = 1; " + aout.code + "; })" };
        }
        g = cg_owned_forget(g, arg.name);
        return cg_gen_expr(g, arg);
    }
    if e.name == "mmap_open" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_mmap_open(" + aout.code + ")" };
    }
    if e.name == "mmap_get" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
