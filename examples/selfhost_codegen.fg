        let dout: CGExpr = cg_gen_expr(g, data);
        g = dout.g;
        let mut data_code: str = dout.code;
        if !cg_is_fresh_array(g, data) {
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            data_code = "({" + cg_c_type(g, cg_expr_type(g, data)) + " __forge_arg" + itoa(n) + " = " + data_code + "; forge_arr_inc(__forge_arg" + itoa(n) + ".ref); __forge_arg" + itoa(n) + ";})";
        }
