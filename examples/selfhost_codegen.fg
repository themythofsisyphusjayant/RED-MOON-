// Hosted native-C codegen (slice 4, stages 4a + 4b).
// Mirrors forge_lang/codegen.py generate() for the non-freestanding
// native path, mode="safe". The hosted infer pass (selfhost_infer.fg)
// supplies the type table; the hosted checker is untouched.
// Stage 4a scope: c_type, HEADER, generate() emission order,
// signatures, main, literals, let, arithmetic, println/print,
// return, calls to user functions. Checked arithmetic was ALWAYS
// emitted in 4a (no elimination); stage 4f implements Python's
// _binop_safe / _check_cache / _facts, so the 4a corpus rule
// (avoid operands Python proves safe) is lifted.
// Stage 4b scope: statements — Block, If/else-if, While, For
// (range + array), Assign, IndexAssign, FieldAssign, Break,
// Continue, Scope, Defer (LIFO, _emit_defers machinery), plus the
// owned/defer frame stacks they need; gen_expr gains RangeLit,
// FieldAccess and Index; the `range` builtin call. Match is 4c/4d,
// Spawn is a later stage, push is 4e. FieldAssign is implemented
// but has no corpus test until 4d (it needs a struct value).
// Stage 4c scope: expressions — ArrayLit, TupleLit (+TupleIndex),
// StructLit, Cast (int/float, checked), Try/?, MethodCall (range,
// struct impl, opaque/trait), full Call builtins + arg conversion,
// enum variant construction, _str_index_cmp, fixed-checked binop
// + fixed unary minus, struct-array FieldAccess fast path, struct
// Index, nested Index. Plus the generate() support they need:
// struct/tuple/union/payload-enum/opaque typedefs + bodies in
// dependency order, per-struct array helpers, opaque copy/free
// helpers, impl-method emission, drop hooks, struct/tuple/union/
// opaque Let/Assign/Return/FieldAssign, struct IndexAssign.
// Stage 4f scope: ownership audit (owned_add/_emit_free_one/
// is_fresh_* — already matching, proven by the v79-v91 corpus) +
// checked-arithmetic elimination, mirroring codegen.py exactly:
// _facts intervals (_int_interval/_narrow/_cond_fact/_hull_facts/
// _facts_update_from_rhs), _binop_safe, the per-statement
// _check_cache dedup (BinOp + Index + struct-array FieldAccess,
// cleared per statement and per Call), and unary-minus elision.
// Fixed-width binops keep their always-checked form (Python does
// not eliminate there); the corpus rule forbidding duplicate
// identical checked binops in one statement is lifted.
// Counters (assign/arr/loop/try/scope) are PROGRAM-global in
// Python (init only, never reset per function): 4a/4b wrongly
// reset them per function — fixed in 4c (v32/v34 numbering
// exposes it). Checked arithmetic was ALWAYS emitted in 4a-4e (no
// _binop_safe / _check_cache / _facts); stage 4f implements the
// elimination, so the corpus rule is lifted (see the 4f note above).
// State lives in the HCodegen struct, passed by value and returned
// updated (struct assignment is a deep copy).

import "selfhost_infer.fg";
import "selfhost_codegen_header.fg";

struct HCodegen {
    lines: [str];
    indent: int;
    current_fn: str;
    current_ret: str;
    // Freestanding mode (slice 4g): freestanding header,
    // qasida_main + _start, no argv copy, no joins/frees.
    freestanding: bool;
    func_names: [str];
    func_rets: [str];
    func_params: [str];
    func_extern: [bool];
    struct_names: [str];
    struct_fields: [str];
    struct_tparams: [str];
    newtype_names: [str];
    newtype_targets: [str];
    enum_names: [str];
    enum_variants: [str];
    enum_payloads: [str];
    enum_tparams: [str];
    // 4c: concrete generic enum types used, e.g. "OptionE<int>"
    // (base names alone do not name the C struct).
    enum_concrete: [str];
    // 4c: trait methods ("name:params->ret" per method, names
    // repeated) and impl blocks (struct/trait pairs, in order).
    trait_names: [str];
    trait_sigs: [str];
    impl_structs: [str];
    impl_traits: [str];
    // 4c: type collections for generate(): tuple spellings,
    // union spellings, nested array spellings, weak use, spawn
    // call names (deduped, program order).
    tuple_types: [str];
    union_types: [str];
    nested_arrays: [str];
    weak_found: bool;
    spawn_names: [str];
    // 4c: argument counts parallel to spawn_names (a spawned
    // call with args gets a malloc'd long long argument).
    spawn_argc: [int];
    // 4c: move() bookkeeping (move v2): dotted field paths moved
    // away, and the drop method's own receiver name (no hook).
    moved_fields: [str];
    drop_receiver: str;
    branch_depth: int;
    loop_depth: int;
    // 4c: was each deferred call registered inside a branch or
    // loop (parallel to defer_calls)? move_cond overrides the
    // depth derivation while a deferred call is emitted:
    // -1 derive from branch/loop depth, 0 straight-line,
    // 1 conditional.
    defer_conds: [bool];
    move_cond: int;
    type_keys: [str];
    type_vals: [str];
    owned_names: [str];
    owned_types: [str];
    owned_marks: [int];
    // 4f: check-elimination state (codegen.py:1163-1171): proven
    // int intervals (fact_names -> (fact_los, fact_his)), the
    // per-statement duplicate-check cache (check_keys), and the
    // branch-local let bindings (let_names flat, let_starts
    // marking each open branch frame's start).
    fact_names: [str];
    fact_los: [int];
    fact_his: [int];
    check_keys: [str];
    let_names: [str];
    let_starts: [int];
    // 4b frame stacks. owned_names / owned_types stay flat in
    // declaration order; owned_frame_starts records each frame's
    // start index (frame 0 = function frame). defer_calls is the
    // flat list of deferred Call nodes with defer_frame_starts
    // marking frame boundaries. loop_frames holds owned-frame
    // indices of enclosing loop bodies; defer_loop_stack holds
    // defer-frame counts at each loop entry; scope_vars /
    // scope_depths hold (start_var, loop depth) per open scope.
    owned_frame_starts: [int];
    defer_calls: [Node];
    defer_frame_starts: [int];
    loop_frames: [int];
    defer_loop_stack: [int];
    scope_vars: [str];
    scope_depths: [int];
    scope_counter: int;
    local_names: [str];
    local_types: [str];
    assign_counter: int;
    arr_counter: int;
    loop_counter: int;
    try_counter: int;
    // 4d: current generic-instantiation bindings (empty outside an
    // instantiation body); the instantiation registry (discovery
    // order); the spawn temp counter (Python's spawn_counter).
    subst_names: [str];
    subst_types: [str];
    inst_tmpl: [str];
    inst_mangled: [str];
    inst_bnames: [str];
    inst_btypes: [str];
    inst_busy: [str];
    spawn_counter: int;
    template_keys: [str];
}

struct CGExpr {
    g: HCodegen;
    code: str;
}

fn cg_new(inf: HInfer) -> HCodegen {
    return HCodegen { lines: [], indent: 0, current_fn: "", current_ret: "void", func_names: [], func_rets: [], func_params: [], func_extern: [], struct_names: [], struct_fields: [], struct_tparams: [], newtype_names: [], newtype_targets: [], enum_names: [], enum_variants: [], enum_payloads: [], enum_tparams: [], enum_concrete: [], trait_names: [], trait_sigs: [], impl_structs: [], impl_traits: [], tuple_types: [], union_types: [], nested_arrays: [], weak_found: false, spawn_names: [], spawn_argc: [], moved_fields: [], drop_receiver: "", branch_depth: 0, loop_depth: 0, defer_conds: [], move_cond: -1, type_keys: inf.type_keys, type_vals: inf.type_vals, template_keys: inf.template_keys, owned_names: [], owned_types: [], owned_marks: [], fact_names: [], fact_los: [], fact_his: [], check_keys: [], let_names: [], let_starts: [], owned_frame_starts: [0], defer_calls: [], defer_frame_starts: [0], loop_frames: [], defer_loop_stack: [], scope_vars: [], scope_depths: [], scope_counter: 0, local_names: [], local_types: [], assign_counter: 0, arr_counter: 0, loop_counter: 0, try_counter: 0, subst_names: [], subst_types: [], inst_tmpl: [], inst_mangled: [], inst_bnames: [], inst_btypes: [], inst_busy: [], spawn_counter: 0, freestanding: false };
}

fn cg_trunc_node(a0: [Node], n: int) -> [Node] {
    let mut out: [Node] = [];
    let mut i: int = 0;
    while i < n && i < len(a0) {
        push(out, a0[i]);
        i = i + 1;
    }
    return out;
}

fn cg_trunc_str(a0: [str], n: int) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < n && i < len(a0) {
        push(out, a0[i]);
        i = i + 1;
    }
    return out;
}

fn cg_trunc_int(a0: [int], n: int) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < n && i < len(a0) {
        push(out, a0[i]);
        i = i + 1;
    }
    return out;
}

fn cg_trunc_bool(a0: [bool], n: int) -> [bool] {
    let mut out: [bool] = [];
    let mut i: int = 0;
    while i < n && i < len(a0) {
        push(out, a0[i]);
        i = i + 1;
    }
    return out;
}

fn cg_trunc_snap(a0: [FactSnap], n: int) -> [FactSnap] {
    let mut out: [FactSnap] = [];
    let mut i: int = 0;
    while i < n && i < len(a0) {
        push(out, a0[i]);
        i = i + 1;
    }
    return out;
}

// The inferred type of a node; missing key -> "int".
// 4c: several node kinds need a COMPUTED type, because the infer
// pass records only a base name for them: generic StructLit
// (infer records "Option", the concrete type is "Option<int>"),
// FieldAccess through a generic struct (infer cannot find the
// mangled field map), MethodCall (infer does not know impl
// methods), and variant-construction Calls of generic enums.
// Substitute the current instantiation bindings into a type spelling
// (no-op outside an instantiation body).
fn cg_subst(g: HCodegen, t: str) -> str {
    if len(g.subst_names) == 0 {
        return t;
    }
    return substitute_type(t, g.subst_names, g.subst_types);
}

// The inferred type of a node, with the current instantiation
// bindings substituted (4d). The raw walk is cg_expr_type_raw;
// substitution at inner levels is idempotent (bindings are concrete).
fn cg_expr_type(g: HCodegen, n: Node) -> str {
    return cg_subst(g, cg_expr_type_raw(g, n));
}

fn cg_expr_type_raw(g: HCodegen, n: Node) -> str {
    // Inside an instantiation body (subst non-empty), template
    // entries (prefixed "T:") win over concrete entries sharing
    // the line:col key (4d v32 fix).
    if len(g.subst_names) > 0 {
        let t: str = infer_table_get(g.type_keys, g.type_vals, "T:" + infer_key(n, ""), "");
        if t != "" {
            return t;
        }
    }
    let base: str = infer_table_get(g.type_keys, g.type_vals, infer_key(n, g.current_fn), "int");
    // ArrayLit (29): the infer table records the base name for
    // generic element types, so rebuild from the children's
    // computed types — except a sized annotation, which the
    // table already holds exactly.
    if n.kind == 29 {
        if len(n.kids) == 0 || is_sized_array(base) {
            return base;
        }
        return "[" + cg_expr_type(g, n.kids[0]) + "]";
    }
    // TupleLit (30): rebuild from the children's computed types
    // so generic elements (e.g. Option<int>) come out concrete.
    if n.kind == 30 {
        let mut out: str = "(";
        let mut i: int = 0;
        while i < len(n.kids) {
            if i > 0 {
                out = out + ", ";
            }
            out = out + cg_expr_type(g, n.kids[i]);
            i = i + 1;
        }
        return out + ")";
    }
    if n.kind == 31 {
        return cg_structlit_concrete(g, n);
    }
    if n.kind == 32 {
        let bt: str = cg_expr_type(g, n.kids[0]);
        let enc: str = cg_struct_fields_concrete(g, bt);
        let ft: str = infer_field_type(enc, n.name);
        if ft != "" {
            return ft;
        }
        return base;
    }
    if n.kind == 33 {
        let rt: str = cg_expr_type(g, n.kids[0]);
        if rt == "range" {
            if n.name == "contains" {
                return "bool";
            }
            return "int";
        }
        if cg_is_opaque_type(rt) {
            let sig: [str] = cg_trait_sig(g, cg_opaque_trait(rt), n.name);
            if sig[0] == "1" {
                return sig[1];
            }
            return base;
        }
        if cg_is_struct_type(g, rt) {
            let found: [str] = cg_fn_lookup(g, cg_struct_type_name(g, rt) + "__" + n.name);
            if found[0] == "1" {
                return found[1];
            }
        }
        return base;
    }
    if n.kind == 35 {
        let v: [str] = cg_variant_lookup(g, n.name);
        if v[0] == "1" {
            return cg_enum_concrete_call(g, n);
        }
        return base;
    }
    return base;
}

// Field encoding ("f:t~...") for a struct's base name, or "".
fn cg_struct_fields_template(g: HCodegen, base: str) -> str {
    let mut i: int = 0;
    while i < len(g.struct_names) {
        if g.struct_names[i] == base {
            return g.struct_fields[i];
        }
        i = i + 1;
    }
    return "";
}

// Type params ("T~U") of a struct template, or "".
fn cg_struct_tparams(g: HCodegen, base: str) -> str {
    let mut i: int = 0;
    while i < len(g.struct_names) {
        if g.struct_names[i] == base {
            return g.struct_tparams[i];
        }
        i = i + 1;
    }
    return "";
}

// Type params ("T~U") of an enum template, or "".
fn cg_enum_tparams(g: HCodegen, ename: str) -> str {
    let mut i: int = 0;
    while i < len(g.enum_names) {
        if g.enum_names[i] == ename {
            return g.enum_tparams[i];
        }
        i = i + 1;
    }
    return "";
}

// Field encoding for a struct type spelling, with generic args
// substituted: "Option<int>" -> "present:bool~value:int".
// A concrete mangled name ("Option_int") looks its own entry up.
fn cg_struct_fields_concrete(g: HCodegen, t: str) -> str {
    let r: str = cg_resolve_newtype(g, t);
    if infer_is_generic(r) {
        let base: str = generic_base(r);
        let args: [str] = generic_args(r);
        let tps: str = cg_struct_tparams(g, base);
        if tps == "" {
            return "";
        }
        let names: [str] = split(tps, "~");
        let enc: str = cg_struct_fields_template(g, base);
        if enc == "" {
            return "";
        }
        let parts: [str] = infer_parse_fields(enc);
        let mut out: str = "";
        let mut i: int = 0;
        while i < len(parts) {
            let kv: [str] = split(parts[i], ":");
            let one: str = kv[0] + ":" + substitute_type(kv[1], names, args);
            if out == "" {
                out = one;
            } else {
                out = out + "~" + one;
            }
            i = i + 1;
        }
        return out;
    }
    return cg_struct_fields_template(g, r);
}

// Concrete type of a StructLit: the base name for plain structs,
// "Base<a, b>" for generic templates, unified from the field
// values (mirrors the checker's StructLit handling). Falls back
// to the base name when a param cannot be bound.
fn cg_structlit_concrete(g: HCodegen, e: Node) -> str {
    let tps: str = cg_struct_tparams(g, e.name);
    if tps == "" {
        return e.name;
    }
    let mut names: [str] = split(tps, "~");
    let mut types: [str] = [];
    let mut q: int = 0;
    while q < len(names) {
        push(types, "?");
        q = q + 1;
    }
    let enc: str = cg_struct_fields_template(g, e.name);
    let mut i: int = 0;
    while i < len(e.kids) {
        let f: Node = e.kids[i];
        let ft: str = infer_field_type(enc, f.name);
        if ft != "" {
            let at: str = cg_expr_type(g, f.kids[0]);
            let u: UOut = unify(ft, at, names, types);
            if u.ok {
                names = u.names;
                types = u.types;
            }
        }
        i = i + 1;
    }
    let mut out: str = e.name + "<";
    let mut j: int = 0;
    while j < len(names) {
        if types[j] == "?" {
            return e.name;
        }
        if j > 0 {
            out = out + ", ";
        }
        out = out + types[j];
        j = j + 1;
    }
    return out + ">";
}

// Concrete enum type of a variant-construction Call: the base
// name for plain enums, "Base<a, b>" for generic enums, unified
// from the payload argument (mirrors enum_concrete_info).
fn cg_enum_concrete_call(g: HCodegen, e: Node) -> str {
    // The infer pass fills a variant's concrete type from its
    // constraining use (annotated let, call arg, return); when it
    // did, that type wins — payload unification alone cannot see
    // it (a bare variant has no payload; a multi-param enum may
    // leave params unconstrained). Only a concrete (no "?")
    // generic type in a concrete function (no template
    // substitution) qualifies; anything else falls through to
    // payload unification below. During the collect pass
    // current_fn is unset, so the lookup misses and the fallback
    // runs — harmless, the type is registered from the infer
    // table's values instead.
    if len(g.subst_names) == 0 {
        let it: str = infer_table_get(g.type_keys, g.type_vals, infer_key(e, g.current_fn), "");
        if it != "" && find_lt(it) >= 0 && len(split(it, "?")) == 1 {
            return it;
        }
    }
    let v: [str] = cg_variant_lookup(g, e.name);
    let ename: str = v[1];
    let tps: str = cg_enum_tparams(g, ename);
    if tps == "" || len(e.kids) == 0 {
        return ename;
    }
    let mut names: [str] = split(tps, "~");
    let mut types: [str] = [];
    let mut q: int = 0;
    while q < len(names) {
        push(types, "?");
        q = q + 1;
    }
    let pt: str = v[3];
    if pt != "" {
        let at: str = cg_expr_type(g, e.kids[0]);
        let u: UOut = unify(pt, at, names, types);
        if u.ok {
            names = u.names;
            types = u.types;
        }
    }
    let mut out: str = ename + "<";
    let mut j: int = 0;
    while j < len(names) {
        if types[j] == "?" {
            return ename;
        }
        if j > 0 {
            out = out + ", ";
        }
        out = out + types[j];
        j = j + 1;
    }
    return out + ">";
}

// Variant info for a concrete enum type (enum_concrete_info,
// codegen.py:1891): "~"-joined "Variant:payload" entries in
// declaration order, payload "" when the variant has none,
// with generic args substituted. "" when the spelling is not
// a concrete enum type.
fn cg_enum_concrete_variants(g: HCodegen, t: str) -> str {
    let mut base: str = t;
    let mut args: [str] = [];
    if infer_is_generic(t) {
        base = generic_base(t);
        args = generic_args(t);
    }
    let mut ei: int = -1;
    let mut i: int = 0;
    while i < len(g.enum_names) {
        if g.enum_names[i] == base {
            ei = i;
        }
        i = i + 1;
    }
    if ei < 0 {
        return "";
    }
    let tps: str = g.enum_tparams[ei];
    if tps != "" {
        let names: [str] = split(tps, "~");
        if len(args) != len(names) {
            return "";
        }
        let mut q: int = 0;
        while q < len(args) {
            if args[q] == "?" {
                return "";
            }
            q = q + 1;
        }
    }
    let variants: [str] = split(g.enum_variants[ei], "~");
    let payloads: [str] = split(g.enum_payloads[ei], "~");
    let mut out: str = "";
    let mut j: int = 0;
    while j < len(variants) {
        let mut pt: str = "";
        let mut k: int = 0;
        while k < len(payloads) {
            let kv: [str] = split(payloads[k], ":");
            if len(kv) >= 2 && kv[0] == variants[j] {
                pt = kv[1];
            }
            k = k + 1;
        }
        if tps != "" && pt != "" {
            pt = substitute_type(pt, split(tps, "~"), args);
        }
        let one: str = variants[j] + ":" + pt;
        if out == "" {
            out = one;
        } else {
            out = out + "~" + one;
        }
        j = j + 1;
    }
    return out;
}

// Trait method lookup: ["1", ret, params_enc] or ["0", "", ""].
// params_enc is "~"-joined param TYPES (the trait declaration
// lists only the call's own params, no receiver).
fn cg_trait_sig(g: HCodegen, tname: str, method: str) -> [str] {
    let mut i: int = 0;
    while i < len(g.trait_names) {
        if g.trait_names[i] == tname {
            let sig: str = g.trait_sigs[i];
            let parts: [str] = split(sig, ":");
            if len(parts) >= 2 && parts[0] == method {
                let rest: str = parts[1];
                let ai: int = infer_find_str(rest, "->");
                if ai >= 0 {
                    let params: str = substr(rest, 0, ai);
                    let ret: str = substr(rest, ai + 2, len(rest) - ai - 2);
                    return ["1", ret, params];
                }
            }
        }
        i = i + 1;
    }
    return ["0", "", ""];
}

fn cg_indent_str(n: int) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < n {
        out = out + "    ";
        i = i + 1;
    }
    return out;
}

// emit(): one indented C line, or "" for an empty line.
fn cg_emit(g0: HCodegen, text: str) -> HCodegen {
    let mut g: HCodegen = g0;
    if text == "" {
        push(g.lines, "");
    } else {
        push(g.lines, cg_indent_str(g.indent) + text);
    }
    return g;
}

fn cg_build_tables(g0: HCodegen, prog: Node) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 {
            let mut enc: str = "";
            let mut j: int = 0;
            while j < len(n.kids) {
                let k: Node = n.kids[j];
                if k.kind == 43 {
                    let one: str = k.name + ":" + k.sval;
                    if enc == "" {
                        enc = one;
                    } else {
                        enc = enc + "," + one;
                    }
                }
                j = j + 1;
            }
            push(g.func_names, n.name);
            push(g.func_rets, n.sval);
            push(g.func_params, enc);
            push(g.func_extern, n.bval);
        }
        if n.kind == 3 {
            let sp: [str] = split_tparams(n.name);
            let mut enc: str = "";
            let mut j: int = 0;
            while j < len(n.kids) {
                let f: Node = n.kids[j];
                let one: str = f.name + ":" + f.sval;
                if enc == "" {
                    enc = one;
                } else {
                    enc = enc + "~" + one;
                }
                j = j + 1;
            }
            push(g.struct_names, sp[0]);
            push(g.struct_fields, enc);
            push(g.struct_tparams, sp[1]);
        }
        if n.kind == 4 {
            let sp: [str] = split_tparams(n.name);
            let mut venc: str = "";
            let mut penc: str = "";
            let mut j: int = 0;
            while j < len(n.kids) {
                let v: Node = n.kids[j];
                if venc == "" {
                    venc = v.name;
                } else {
                    venc = venc + "~" + v.name;
                }
                let one: str = v.name + ":" + v.sval;
                if penc == "" {
                    penc = one;
                } else {
                    penc = penc + "~" + one;
                }
                j = j + 1;
            }
            push(g.enum_names, sp[0]);
            push(g.enum_variants, venc);
            push(g.enum_payloads, penc);
            push(g.enum_tparams, sp[1]);
        }
        if n.kind == 5 {
            // TraitDef: kids are FuncDef-like method nodes (kind
            // 2, Param kids + an empty body Block). One
            // "method:params->ret" entry per method (params are
            // types only, "~"-joined; the receiver is not listed).
            let tname: str = n.name;
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                let mut enc: str = m.name + ":";
                let mut first: bool = true;
                let mut pi: int = 0;
                while pi < len(m.kids) - 1 {
                    let pk: Node = m.kids[pi];
                    if pk.kind == 43 {
                        if !first {
                            enc = enc + "~";
                        }
                        enc = enc + pk.sval;
                        first = false;
                    }
                    pi = pi + 1;
                }
                enc = enc + "->" + m.sval;
                push(g.trait_names, tname);
                push(g.trait_sigs, enc);
                j = j + 1;
            }
        }
        if n.kind == 6 {
            // ImplDef: name = struct, sval = trait ("" if plain),
            // kids are FuncDef method nodes. Plain and trait impls
            // both register their methods under mangled names
            // (Struct__method, as in Python: the checker appends
            // mangled impl methods to the function list), and trait
            // impls record their (struct, trait) pair for opaque
            // dispatch (impl-block order matters for tags).
            let sname: str = n.name;
            if n.sval != "" {
                push(g.impl_structs, sname);
                push(g.impl_traits, n.sval);
            }
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                let mut enc: str = "";
                let mut k: int = 0;
                while k < len(m.kids) {
                    let pk: Node = m.kids[k];
                    if pk.kind == 43 {
                        let one: str = pk.name + ":" + pk.sval;
                        if enc == "" {
                            enc = one;
                        } else {
                            enc = enc + "," + one;
                        }
                    }
                    k = k + 1;
                }
                push(g.func_names, sname + "__" + m.name);
                push(g.func_rets, m.sval);
                push(g.func_params, enc);
                push(g.func_extern, false);
                j = j + 1;
            }
        }
        if n.kind == 8 {
            push(g.newtype_names, n.name);
            push(g.newtype_targets, n.sval);
        }
        i = i + 1;
    }
    return g;
}

// ---- type predicates and spelling ----

fn cg_newtype_target(g: HCodegen, name: str) -> str {
    let mut i: int = 0;
    while i < len(g.newtype_names) {
        if g.newtype_names[i] == name {
            return g.newtype_targets[i];
        }
        i = i + 1;
    }
    return "";
}

// _resolve_newtype (codegen.py:1104): recursive.
fn cg_resolve_newtype(g: HCodegen, t: str) -> str {
    let tgt: str = cg_newtype_target(g, t);
    if tgt != "" {
        return cg_resolve_newtype(g, tgt);
    }
    if is_readonly(t) {
        return "readonly " + cg_resolve_newtype(g, cg_readonly_inner(t));
    }
    if is_array(t) {
        if is_sized_array(t) {
            return "[" + cg_resolve_newtype(g, elem_type(t)) + "; " + itoa(cg_sized_len(t)) + "]";
        }
        return "[" + cg_resolve_newtype(g, substr(t, 1, len(t) - 2)) + "]";
    }
    if infer_is_generic(t) {
        let base: str = generic_base(t);
        let args: [str] = generic_args(t);
        let mut out: str = base + "<";
        let mut i: int = 0;
        while i < len(args) {
            if i > 0 {
                out = out + ", ";
            }
            out = out + cg_resolve_newtype(g, args[i]);
            i = i + 1;
        }
        return out + ">";
    }
    return t;
}

// Length N of a "[T; N]" spelling.
fn cg_sized_len(t: str) -> int {
    let inner: str = substr(t, 1, len(t) - 2);
    let semi: int = find_top(inner, ";");
    return parse_int(trim_spaces(substr(inner, semi + 1, len(inner) - semi - 1)));
}

fn cg_readonly_inner(t: str) -> str {
    return substr(t, 9, len(t) - 9);
}

fn cg_is_fixed_int(t: str) -> bool {
    return infer_is_fixed_int(t);
}

fn cg_is_opaque_type(t: str) -> bool {
    return infer_is_opaque_type(t);
}

fn cg_opaque_trait(t: str) -> str {
    return infer_opaque_trait(t);
}

fn cg_union_c_name(t: str) -> str {
    return "ForgeUnion_" + join(union_members(t), "_");
}

// Structure-preserving C-name fragment for one tuple element.
fn cg_elem_c_name(t: str) -> str {
    if infer_is_tuple_type(t) {
        return cg_tuple_c_name(t);
    }
    if is_array(t) {
        if is_sized_array(t) {
            return "Arr_" + cg_elem_c_name("[" + elem_type(t) + "]");
        }
        return "Arr_" + cg_elem_c_name(substr(t, 1, len(t) - 2));
    }
    if is_readonly(t) {
        return "RO_" + cg_elem_c_name(cg_readonly_inner(t));
    }
    if starts_with(t, "opaque ") {
        return "Opaque_" + substr(t, 7, len(t) - 7);
    }
    if infer_find_str(t, " | ") >= 0 {
        let members: [str] = union_members(t);
        let mut parts: [str] = [];
        let mut i: int = 0;
        while i < len(members) {
            push(parts, cg_elem_c_name(members[i]));
            i = i + 1;
        }
        return "Union_" + join(parts, "_");
    }
    if infer_is_generic(t) {
        let base: str = generic_base(t);
        let args: [str] = generic_args(t);
        let mut parts: [str] = [];
        let mut i: int = 0;
        while i < len(args) {
            push(parts, cg_elem_c_name(args[i]));
            i = i + 1;
        }
        return base + "_" + join(parts, "_");
    }
    return t;
}

fn cg_tuple_c_name(t: str) -> str {
    let elems: [str] = tuple_elems(t);
    let mut parts: [str] = [];
    let mut i: int = 0;
    while i < len(elems) {
        push(parts, cg_elem_c_name(elems[i]));
        i = i + 1;
    }
    return "ForgeTuple_" + join(parts, "_");
}

fn cg_struct_type_name(g: HCodegen, t: str) -> str {
    if infer_find_str(t, "<") >= 0 {
        return infer_mangle_type(t);
    }
    return t;
}

fn cg_is_struct_type(g: HCodegen, t: str) -> bool {
    let r: str = cg_resolve_newtype(g, t);
    if r == "" || r == "int" || r == "float" || r == "bool" || r == "str" || r == "void" {
        return false;
    }
    if cg_is_array_type(g, r) {
        return false;
    }
    let name: str = cg_struct_type_name(g, r);
    let mut i: int = 0;
    while i < len(g.struct_names) {
        if g.struct_names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cg_is_array_type(g: HCodegen, t: str) -> bool {
    let r: str = cg_resolve_newtype(g, t);
    if is_readonly(r) {
        return cg_is_array_type(g, cg_readonly_inner(r));
    }
    if is_sized_array(r) {
        return cg_is_array_type(g, "[" + elem_type(r) + "]");
    }
    if !is_array(r) {
        return false;
    }
    let inner: str = substr(r, 1, len(r) - 2);
    if inner == "int" || inner == "float" || inner == "bool" || inner == "str" {
        return true;
    }
    if cg_is_struct_type(g, inner) {
        return true;
    }
    return cg_is_array_type(g, inner);
}

// c_type (codegen.py:1040), rows in Python order.
fn cg_c_type(g: HCodegen, t: str) -> str {
    let r: str = cg_resolve_newtype(g, t);
    if is_union_type(r) {
        return cg_union_c_name(r);
    }
    if cg_is_opaque_type(r) {
        return "Opaque_" + cg_opaque_trait(r);
    }
    if r == "int" {
        return "long long";
    }
    if r == "float" {
        return "double";
    }
    if r == "bool" {
        return "bool";
    }
    if r == "str" {
        return "char *";
    }
    if r == "void" {
        return "void";
    }
    if r == "never" {
        return "char";
    }
    if r == "range" {
        return "ForgeRange";
    }
    if r == "i8" {
        return "int8_t";
    }
    if r == "i16" {
        return "int16_t";
    }
    if r == "i32" {
        return "int32_t";
    }
    if r == "u8" {
        return "uint8_t";
    }
    if r == "u16" {
        return "uint16_t";
    }
    if r == "u32" {
        return "uint32_t";
    }
    if r == "u64" {
        return "uint64_t";
    }
    if is_readonly(r) {
        return cg_c_type(g, cg_readonly_inner(r));
    }
    if infer_is_tuple_type(r) {
        return cg_tuple_c_name(r);
    }
    if is_array(r) {
        if is_sized_array(r) {
            return cg_c_type(g, "[" + elem_type(r) + "]");
        }
        let inner: str = substr(r, 1, len(r) - 2);
        if inner == "int" {
            return "ForgeIntArray";
        }
        if inner == "float" {
            return "ForgeFloatArray";
        }
        if inner == "bool" {
            return "ForgeBoolArray";
        }
        if inner == "str" {
            return "ForgeStrArray";
        }
        if inner == "?" {
            return r;
        }
        if cg_is_fixed_int(inner) {
            fail("arrays of " + inner + " are not supported in v1");
        }
        if starts_with(inner, "[") {
            return "ForgeArray_" + cg_c_type(g, inner);
        }
        if infer_find_str(inner, "<") >= 0 {
            return "ForgeArray_" + infer_mangle_type(inner);
        }
        return "ForgeArray_" + inner;
    }
    if infer_find_str(r, "<") >= 0 {
        return infer_mangle_type(r);
    }
    return r;
}

// c_str_literal (codegen.py:2348): escapes exactly \n \t \r \\ \" \0.
// has_nul: true iff v holds the lexer's NUL sentinel (0x01) for
// \0 escapes. Only then is the sentinel mapped back to \0; a
// genuine raw 0x01 byte (has_nul false) emits verbatim, exactly
// like Python's c_str_literal. The sentinel literal below is a
// single raw 0x01 byte.
fn cg_c_str_literal(v: str, has_nul: bool) -> str {
    let mut out: str = "\"";
    let mut i: int = 0;
    while i < len(v) {
        let ch: str = substr(v, i, 1);
        if ch == "\n" {
            out = out + "\\n";
        } else if ch == "\t" {
            out = out + "\\t";
        } else if ch == "\r" {
            out = out + "\\r";
        } else if ch == "\\" {
            out = out + "\\\\";
        } else if ch == "\"" {
            out = out + "\\\"";
        } else if has_nul && ch == "" {
            out = out + "\\0";
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out + "\"";
}

// ---- signatures ----

// Function lookup: ["1", ret, params_enc] or ["0", "", ""].
fn cg_fn_lookup(g: HCodegen, name: str) -> [str] {
    let mut i: int = 0;
    while i < len(g.func_names) {
        if g.func_names[i] == name {
            return ["1", g.func_rets[i], g.func_params[i]];
        }
        i = i + 1;
    }
    return ["0", "", ""];
}

fn cg_fn_is_extern(g: HCodegen, name: str) -> bool {
    let mut i: int = 0;
    while i < len(g.func_names) {
        if g.func_names[i] == name {
            return g.func_extern[i];
        }
        i = i + 1;
    }
    return false;
}

// Param nodes of a FuncDef as "name:type" entries.
fn cg_param_entries(fn_node: Node) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(fn_node.kids) {
        let k: Node = fn_node.kids[i];
        if k.kind == 43 {
            push(out, k.name + ":" + k.sval);
        }
        i = i + 1;
    }
    return out;
}

// c_sig (codegen.py:2340).
fn cg_c_sig(g: HCodegen, fn_node: Node) -> str {
    return cg_c_sig_named(g, fn_node, fn_node.name);
}

// c_sig (codegen.py:2355) with an overridden function name:
// impl methods are emitted under their mangled Struct__method
// name, but their node still carries the plain method name.
fn cg_c_sig_named(g: HCodegen, fn_node: Node, fname: str) -> str {
    let params: [str] = cg_param_entries(fn_node);
    let mut plist: str = "";
    let mut i: int = 0;
    while i < len(params) {
        let kv: [str] = split(params[i], ":");
        let one: str = cg_c_type(g, cg_subst(g, kv[1])) + " " + kv[0];
        if plist == "" {
            plist = one;
        } else {
            plist = plist + ", " + one;
        }
        i = i + 1;
    }
    let mut ret: str = "void";
    if fn_node.sval != "never" {
        ret = cg_c_type(g, cg_subst(g, fn_node.sval));
    }
    if plist == "" {
        plist = "void";
    }
    return ret + " " + fname + "(" + plist + ")";
}

// c_sig_extern (codegen.py:2324): C-ABI override int -> int,
// str -> const char *.
fn cg_c_sig_extern(g: HCodegen, fn_node: Node) -> str {
    let params: [str] = cg_param_entries(fn_node);
    let mut plist: str = "";
    let mut i: int = 0;
    while i < len(params) {
        let kv: [str] = split(params[i], ":");
        let mut cct: str = "";
        if kv[1] == "int" {
            cct = "int";
        } else if kv[1] == "str" {
            cct = "const char *";
        } else {
            cct = cg_c_type(g, kv[1]);
        }
        let one: str = cct + " " + kv[0];
        if plist == "" {
            plist = one;
        } else {
            plist = plist + ", " + one;
        }
        i = i + 1;
    }
    let mut ret: str = "";
    if fn_node.sval == "int" {
        ret = "int";
    } else if fn_node.sval == "str" {
        ret = "const char *";
    } else {
        ret = cg_c_type(g, cg_subst(g, fn_node.sval));
    }
    if plist == "" {
        plist = "void";
    }
    return ret + " " + fn_node.name + "(" + plist + ")";
}

// ---- freshness (is_fresh_*, codegen.py:1764-1857) ----

fn cg_is_fresh_str(g: HCodegen, e: Node) -> bool {
    if e.kind == 35 {
        if e.name == "read_file" || e.name == "read_line" || e.name == "join" || e.name == "substr" || e.name == "trim" || e.name == "http_get" || e.name == "http_read_request" || e.name == "move" {
            return true;
        }
        let found: [str] = cg_fn_lookup(g, e.name);
        if found[0] == "1" && found[1] == "str" && !cg_fn_is_extern(g, e.name) {
            return true;
        }
        return false;
    }
    if e.kind == 40 && e.name == "+" && cg_expr_type(g, e.kids[0]) == "str" {
        return true;
    }
    if e.kind == 36 && cg_expr_type(g, e.kids[0]) == "str" {
        return true;
    }
    return false;
}

fn cg_is_fresh_array(g: HCodegen, e: Node) -> bool {
    if e.kind == 29 {
        return true;
    }
    if e.kind == 35 {
        if e.name == "range" || e.name == "split" || e.name == "parallel_matmul" || e.name == "args" || e.name == "move" || e.name == "read_bytes" {
            return true;
        }
        let found: [str] = cg_fn_lookup(g, e.name);
        if found[0] == "1" && cg_is_array_type(g, found[1]) {
            return true;
        }
        return false;
    }
    return false;
}

fn cg_is_fresh_struct(g: HCodegen, e: Node) -> bool {
    if e.kind == 31 {
        return true;
    }
    if e.kind == 33 {
        let rt: str = cg_expr_type(g, e.kids[0]);
        let mangled: str = infer_mangle_method(rt, e.name);
        let found: [str] = cg_fn_lookup(g, mangled);
        if found[0] == "1" && cg_is_struct_type(g, found[1]) {
            return true;
        }
        return false;
    }
    if e.kind == 35 {
        if e.name == "move" || e.name == "try_alloc" {
            return true;
        }
        let found: [str] = cg_fn_lookup(g, e.name);
        if found[0] == "1" && cg_is_struct_type(g, found[1]) {
            return true;
        }
        return false;
    }
    if e.kind == 36 && cg_is_struct_type(g, cg_expr_type(g, e)) {
        return true;
    }
    return false;
}

fn cg_is_fresh_tuple(g: HCodegen, e: Node) -> bool {
    if e.kind == 30 || e.kind == 35 || e.kind == 33 {
        return true;
    }
    return false;
}

fn cg_is_fresh_union(g: HCodegen, e: Node) -> bool {
    if e.kind == 35 || e.kind == 33 {
        return true;
    }
    return false;
}

// ---- 4f: check elimination (codegen.py:1163-1171, 2440-2659) ----
// _facts: proven int intervals, parallel arrays (name -> (lo, hi)).
// _check_cache: dedup keys for checked ops already emitted in the
// current statement. _let_stack: branch-local let bindings, as a
// flat name list plus a start index per open branch frame (a frame's
// set is let_names[start..]; popping a frame drops only its marker,
// so names bound in nested arms stay visible to outer frames, the
// way Python's `for s in self._let_stack: s.add(name)` does).
// Every facts mutation rebuilds the arrays (never push/index-assign
// on them), so a snapshot taken with cg_facts_snap stays intact.

struct FactSnap {
    names: [str];
    los: [int];
    his: [int];
}

fn cg_int_min() -> int {
    return 0 - 9223372036854775807 - 1;
}

fn cg_int_max() -> int {
    return 9223372036854775807;
}

// facts_find (_facts.get): [found, lo, hi].
fn cg_facts_find(g: HCodegen, name: str) -> [int] {
    let mut i: int = len(g.fact_names) - 1;
    while i >= 0 {
        if g.fact_names[i] == name {
            return [1, g.fact_los[i], g.fact_his[i]];
        }
        i = i - 1;
    }
    return [0, 0, 0];
}

fn cg_facts_set(g0: HCodegen, name: str, lo: int, hi: int) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut nn: [str] = [];
    let mut nl: [int] = [];
    let mut nh: [int] = [];
    let mut i: int = 0;
    while i < len(g.fact_names) {
        if g.fact_names[i] != name {
            push(nn, g.fact_names[i]);
            push(nl, g.fact_los[i]);
            push(nh, g.fact_his[i]);
        }
        i = i + 1;
    }
    push(nn, name);
    push(nl, lo);
    push(nh, hi);
    g.fact_names = nn;
    g.fact_los = nl;
    g.fact_his = nh;
    return g;
}

fn cg_facts_pop(g0: HCodegen, name: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut nn: [str] = [];
    let mut nl: [int] = [];
    let mut nh: [int] = [];
    let mut i: int = 0;
    while i < len(g.fact_names) {
        if g.fact_names[i] != name {
            push(nn, g.fact_names[i]);
            push(nl, g.fact_los[i]);
            push(nh, g.fact_his[i]);
        }
        i = i + 1;
    }
    g.fact_names = nn;
    g.fact_los = nl;
    g.fact_his = nh;
    return g;
}

fn cg_facts_clear(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    g.fact_names = cg_trunc_str(g.fact_names, 0);
    g.fact_los = cg_trunc_int(g.fact_los, 0);
    g.fact_his = cg_trunc_int(g.fact_his, 0);
    return g;
}

// _narrow (codegen.py:2477): intersect facts[var] with (lo, hi),
// clamped to int64; drop the var if empty.
fn cg_facts_narrow(g0: HCodegen, name: str, lo: int, hi: int) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut l: int = lo;
    let mut h: int = hi;
    if l < cg_int_min() {
        l = cg_int_min();
    }
    if h > cg_int_max() {
        h = cg_int_max();
    }
    if l > h {
        return cg_facts_pop(g, name);
    }
    let old: [int] = cg_facts_find(g, name);
    if old[0] == 0 {
        return cg_facts_set(g, name, l, h);
    }
    let mut nl: int = old[1];
    if l > nl {
        nl = l;
    }
    let mut nh: int = old[2];
    if h < nh {
        nh = h;
    }
    if nl > nh {
        return cg_facts_pop(g, name);
    }
    return cg_facts_set(g, name, nl, nh);
}

// _int_interval (codegen.py:2464): [found, lo, hi]. A Var is always
// found (default the full int64 range); anything but an IntLit or a
// Var is unknown.
fn cg_int_interval(g: HCodegen, node: Node) -> [int] {
    if node.kind == 25 {
        let mut v: int = node.ival;
        if v < cg_int_min() {
            v = cg_int_min();
        }
        if v > cg_int_max() {
            v = cg_int_max();
        }
        return [1, v, v];
    }
    if node.kind == 34 {
        let f: [int] = cg_facts_find(g, node.name);
        if f[0] == 1 {
            return f;
        }
        return [1, cg_int_min(), cg_int_max()];
    }
    return [0, 0, 0];
}

// _apply_cond_facts (codegen.py:2498-2532): narrow the var proven
// by a var-vs-int-literal comparison; truth=False flips the op
// (== proves nothing when false).
fn cg_apply_cond_facts(g0: HCodegen, cond: Node, truth: bool) -> HCodegen {
    let mut g: HCodegen = g0;
    if cond.kind != 40 {
        return g;
    }
    let mut op: str = cond.name;
    if op != "<" && op != "<=" && op != ">" && op != ">=" && op != "==" {
        return g;
    }
    let mut left: Node = cond.kids[0];
    let mut right: Node = cond.kids[1];
    if left.kind == 25 && right.kind == 34 {
        let tmp: Node = left;
        left = right;
        right = tmp;
        if op == "<" {
            op = ">";
        } else if op == "<=" {
            op = ">=";
        } else if op == ">" {
            op = "<";
        } else if op == ">=" {
            op = "<=";
        }
    }
    if left.kind != 34 || right.kind != 25 {
        return g;
    }
    if cg_expr_type(g, left) != "int" {
        return g;
    }
    let lit: int = right.ival;
    if !truth {
        if op == "==" {
            return g;
        }
        if op == "<" {
            op = ">=";
        } else if op == "<=" {
            op = ">";
        } else if op == ">" {
            op = "<=";
        } else if op == ">=" {
            op = "<";
        }
    }
    // lit +/- 1 would leave int64 at the extremes (and the checker
    // accepts out-of-range literals, so lit itself may already be
    // outside int64): settle those cases by the same empty/no-op
    // outcome Python's clamped _narrow reaches, without computing
    // the overflowing bound.
    if op == "<" {
        if lit <= cg_int_min() {
            return cg_facts_pop(g, left.name);
        }
        if lit > cg_int_max() {
            return g;
        }
        return cg_facts_narrow(g, left.name, cg_int_min(), lit - 1);
    }
    if op == "<=" {
        if lit < cg_int_min() {
            return cg_facts_pop(g, left.name);
        }
        if lit >= cg_int_max() {
            return g;
        }
        return cg_facts_narrow(g, left.name, cg_int_min(), lit);
    }
    if op == ">" {
        if lit >= cg_int_max() {
            return cg_facts_pop(g, left.name);
        }
        if lit < cg_int_min() {
            return g;
        }
        return cg_facts_narrow(g, left.name, lit + 1, cg_int_max());
    }
    if op == ">=" {
        if lit > cg_int_max() {
            return cg_facts_pop(g, left.name);
        }
        if lit <= cg_int_min() {
            return g;
        }
        return cg_facts_narrow(g, left.name, lit, cg_int_max());
    }
    if lit > cg_int_max() || lit < cg_int_min() {
        return cg_facts_pop(g, left.name);
    }
    return cg_facts_narrow(g, left.name, lit, lit);
}

// Overflow-free range predicates for _binop_safe: Python's
// interval arithmetic is unbounded, but Qasida ints are int64, so
// a bound sum or product that leaves int64 would abort the hosted
// run — the in-range test is done with comparisons only.
fn cg_add_in_range(lo1: int, hi1: int, lo2: int, hi2: int) -> bool {
    // hi1+hi2 <= INT_MAX: true unless both his are positive and
    // their sum exceeds MAX; lo1+lo2 >= INT_MIN likewise.
    if hi1 > 0 && hi2 > 0 && hi1 > cg_int_max() - hi2 {
        return false;
    }
    if lo1 < 0 && lo2 < 0 && lo1 < cg_int_min() - lo2 {
        return false;
    }
    return true;
}

fn cg_sub_in_range(lo1: int, hi1: int, lo2: int, hi2: int) -> bool {
    // Result interval is [lo1-hi2, hi1-lo2].
    if lo2 < 0 && hi1 > cg_int_max() + lo2 {
        return false;
    }
    if hi2 > 0 && lo1 < cg_int_min() + hi2 {
        return false;
    }
    return true;
}

// One corner product of an interval multiplication, in int64 range?
fn cg_prod_in_range(a: int, b: int) -> bool {
    if a == 0 || b == 0 {
        return true;
    }
    if a > 0 && b > 0 {
        return a <= cg_int_max() / b;
    }
    if a < 0 && b < 0 {
        if a == cg_int_min() || b == cg_int_min() {
            return false;
        }
        return (0 - a) <= cg_int_max() / (0 - b);
    }
    // Mixed signs: the product is negative, so only the INT_MIN
    // bound can fail, i.e. |a*b| <= 2^63. |.| == 1 always fits;
    // the 2^63 limit is floor((INT_MAX+1)/k) = q, or q+1 when
    // INT_MAX % k == k-1 (then INT_MAX+1 is exactly divisible).
    if a > 0 {
        if b == cg_int_min() {
            return a == 1;
        }
        let k: int = 0 - b;
        if k == 1 {
            return true;
        }
        let q: int = cg_int_max() / k;
        let r: int = cg_int_max() % k;
        let mut limit: int = q;
        if r == k - 1 {
            limit = q + 1;
        }
        return a <= limit;
    }
    if a == cg_int_min() {
        return b == 1;
    }
    let k2: int = 0 - a;
    if k2 == 1 {
        return true;
    }
    let q2: int = cg_int_max() / k2;
    let r2: int = cg_int_max() % k2;
    let mut limit2: int = q2;
    if r2 == k2 - 1 {
        limit2 = q2 + 1;
    }
    return b <= limit2;
}

// _binop_safe (codegen.py:2546): THE GATE. Intervals from
// _int_interval; +,-,* via the overflow-free range predicates;
// /,% require a provably-nonzero divisor interval AND exclude the
// INT_MIN/-1 pair; anything else -> false.
fn cg_binop_safe(g: HCodegen, op: str, lnode: Node, rnode: Node) -> bool {
    let li: [int] = cg_int_interval(g, lnode);
    let ri: [int] = cg_int_interval(g, rnode);
    if li[0] == 0 || ri[0] == 0 {
        return false;
    }
    if op == "/" || op == "%" {
        if ri[2] < 0 || ri[1] > 0 {
        } else {
            return false;
        }
        if li[1] == cg_int_min() && ri[1] <= -1 && -1 <= ri[2] {
            return false;
        }
        return true;
    }
    if op == "+" {
        return cg_add_in_range(li[1], li[2], ri[1], ri[2]);
    }
    if op == "-" {
        return cg_sub_in_range(li[1], li[2], ri[1], ri[2]);
    }
    if op == "*" {
        return cg_prod_in_range(li[1], ri[1]) && cg_prod_in_range(li[1], ri[2]) && cg_prod_in_range(li[2], ri[1]) && cg_prod_in_range(li[2], ri[2]);
    }
    return false;
}

// _subtree_has_call (codegen.py:2440): a call anywhere below.
fn cg_subtree_has_call(node: Node) -> bool {
    if node.kind == 35 || node.kind == 33 {
        return true;
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        if cg_subtree_has_call(node.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// _check_cache (codegen.py:2702, 4073): per-statement dedup keys,
// length-prefixed so distinct (tag, parts) can never collide.
fn cg_cache_key(parts: [str]) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(parts) {
        out = out + itoa(len(parts[i])) + ":" + parts[i] + "|";
        i = i + 1;
    }
    return out;
}

fn cg_cache_clear(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    g.check_keys = cg_trunc_str(g.check_keys, 0);
    return g;
}

fn cg_cache_has(g: HCodegen, key: str) -> bool {
    let mut i: int = 0;
    while i < len(g.check_keys) {
        if g.check_keys[i] == key {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cg_cache_add(g0: HCodegen, key: str) -> HCodegen {
    let mut g: HCodegen = g0;
    push(g.check_keys, key);
    return g;
}

// FactSnap: a copy of _facts (codegen.py: dict(self._facts)).
fn cg_facts_snap(g: HCodegen) -> FactSnap {
    return FactSnap { names: cg_trunc_str(g.fact_names, len(g.fact_names)), los: cg_trunc_int(g.fact_los, len(g.fact_los)), his: cg_trunc_int(g.fact_his, len(g.fact_his)) };
}

fn cg_facts_restore(g0: HCodegen, snap: FactSnap) -> HCodegen {
    let mut g: HCodegen = g0;
    g.fact_names = snap.names;
    g.fact_los = snap.los;
    g.fact_his = snap.his;
    return g;
}

fn cg_snap_find(snap: FactSnap, name: str) -> [int] {
    let mut i: int = len(snap.names) - 1;
    while i >= 0 {
        if snap.names[i] == name {
            return [1, snap.los[i], snap.his[i]];
        }
        i = i - 1;
    }
    return [0, 0, 0];
}

// _hull_facts (codegen.py:2534): join across two paths — a var
// keeps the hull of both intervals, and only if both paths know it.
fn cg_facts_hull(a: FactSnap, b: FactSnap) -> FactSnap {
    let mut nn: [str] = [];
    let mut nl: [int] = [];
    let mut nh: [int] = [];
    let mut i: int = 0;
    while i < len(a.names) {
        let f: [int] = cg_snap_find(b, a.names[i]);
        if f[0] == 1 {
            push(nn, a.names[i]);
            let mut lo: int = a.los[i];
            if f[1] < lo {
                lo = f[1];
            }
            push(nl, lo);
            let mut hi: int = a.his[i];
            if f[2] > hi {
                hi = f[2];
            }
            push(nh, hi);
        }
        i = i + 1;
    }
    return FactSnap { names: nn, los: nl, his: nh };
}

// Filter a snapshot to drop every name bound in names[start..]
// (branch-local lets never leak into join facts).
fn cg_facts_filter_lets(snap: FactSnap, names: [str], start: int) -> FactSnap {
    let mut nn: [str] = [];
    let mut nl: [int] = [];
    let mut nh: [int] = [];
    let mut i: int = 0;
    while i < len(snap.names) {
        let mut skip: bool = false;
        let mut j: int = start;
        while j < len(names) {
            if names[j] == snap.names[i] {
                skip = true;
            }
            j = j + 1;
        }
        if !skip {
            push(nn, snap.names[i]);
            push(nl, snap.los[i]);
            push(nh, snap.his[i]);
        }
        i = i + 1;
    }
    return FactSnap { names: nn, los: nl, his: nh };
}

// Scope facts revert (codegen.py:3360): lets bound inside the scope
// revert to their pre-scope facts (or drop); assignments to outer
// variables keep their updated facts.
fn cg_facts_revert_scope(g0: HCodegen, pre: FactSnap, names: [str], start: int) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut j: int = start;
    while j < len(names) {
        let name: str = names[j];
        let f: [int] = cg_snap_find(pre, name);
        if f[0] == 1 {
            g = cg_facts_set(g, name, f[1], f[2]);
        } else {
            g = cg_facts_pop(g, name);
        }
        j = j + 1;
    }
    return g;
}

// _facts_update_from_rhs (codegen.py:2645): after `let name = rhs` /
// `name = rhs`, refresh name's facts. A let also records the name in
// the flat let_names list, visible to every open branch frame.
fn cg_facts_update_from_rhs(g0: HCodegen, name: str, rhs: Node, is_let: bool) -> HCodegen {
    let mut g: HCodegen = g0;
    if rhs.kind == 25 {
        let mut v: int = rhs.ival;
        if v < cg_int_min() {
            v = cg_int_min();
        }
        if v > cg_int_max() {
            v = cg_int_max();
        }
        g = cg_facts_set(g, name, v, v);
    } else if rhs.kind == 34 {
        let f: [int] = cg_facts_find(g, rhs.name);
        if f[0] == 1 {
            g = cg_facts_set(g, name, f[1], f[2]);
        } else {
            g = cg_facts_pop(g, name);
        }
    } else {
        g = cg_facts_pop(g, name);
    }
    if is_let {
        push(g.let_names, name);
    }
    return g;
}

// _branch_exits (codegen.py:2583): a block's last statement always
// leaves it (Return/Break/Continue, or a fail()/fail_compile() call).
fn cg_branch_exits(blk: Node) -> bool {
    if len(blk.kids) == 0 {
        return false;
    }
    let last: Node = blk.kids[len(blk.kids) - 1];
    if last.kind == 17 || last.kind == 18 || last.kind == 19 {
        return true;
    }
    if last.kind == 24 && len(last.kids) > 0 && last.kids[0].kind == 35 && (last.kids[0].name == "fail" || last.kids[0].name == "fail_compile") {
        return true;
    }
    return false;
}

// ---- 4c helpers: unions, opaques, ownership, casts, sorting ----

fn cg_str_in(s: str, arr: [str]) -> bool {
    let mut i: int = 0;
    while i < len(arr) {
        if arr[i] == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cg_push_unique_str(a0: [str], s: str) -> [str] {
    let mut i: int = 0;
    while i < len(a0) {
        if a0[i] == s {
            return a0;
        }
        i = i + 1;
    }
    let mut out: [str] = [];
    let mut j: int = 0;
    while j < len(a0) {
        push(out, a0[j]);
        j = j + 1;
    }
    push(out, s);
    return out;
}

// Index of the str member of a union, or -1.
fn cg_union_str_index(t: str) -> int {
    let members: [str] = union_members(t);
    let mut i: int = 0;
    while i < len(members) {
        if members[i] == "str" {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// union_wrap (codegen.py:1240).
fn cg_union_wrap(code: str, vt: str, ut: str, copy_str: bool, g: HCodegen) -> str {
    let members: [str] = union_members(ut);
    let mut idx: int = 0;
    let mut i: int = 0;
    while i < len(members) {
        if members[i] == vt {
            idx = i;
        }
        i = i + 1;
    }
    let cname: str = cg_union_c_name(ut);
    let mut vc: str = code;
    if copy_str {
        vc = "forge_copy_str(" + code + ")";
    }
    return "((" + cname + "){.tag = " + itoa(idx) + ", .payload = {._" + itoa(idx) + " = (" + vc + ")}})";
}

// union_copy_stmt (codegen.py:1254); "" when no str member.
fn cg_union_copy_stmt(temp: str, ut: str) -> str {
    let s: int = cg_union_str_index(ut);
    if s < 0 {
        return "";
    }
    return "if (" + temp + ".tag == " + itoa(s) + ") " + temp + ".payload._" + itoa(s) + " = forge_copy_str(" + temp + ".payload._" + itoa(s) + ");";
}

// union_free_code (codegen.py:1265); "" when no str member.
fn cg_union_free_code(var_code: str, ut: str) -> str {
    let s: int = cg_union_str_index(ut);
    if s < 0 {
        return "";
    }
    return "if (" + var_code + ".tag == " + itoa(s) + ") forge_free_str(" + var_code + ".payload._" + itoa(s) + ");";
}

fn cg_opaque_c_name(t: str) -> str {
    return "Opaque_" + cg_opaque_trait(t);
}

// Implementing struct names for a trait, in impl-block order.
fn cg_impls_for_trait(g: HCodegen, trait_name: str) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(g.impl_structs) {
        if g.impl_traits[i] == trait_name {
            out = cg_push_unique_str(out, g.impl_structs[i]);
        }
        i = i + 1;
    }
    return out;
}

// opaque_wrap (codegen.py:1416).
fn cg_opaque_wrap(g: HCodegen, value_code: str, struct_t: str, opaque_t: str) -> str {
    let impls: [str] = cg_impls_for_trait(g, cg_opaque_trait(opaque_t));
    let mut idx: int = 0;
    let mut i: int = 0;
    while i < len(impls) {
        if impls[i] == struct_t {
            idx = i;
        }
        i = i + 1;
    }
    let cname: str = cg_opaque_c_name(opaque_t);
    return "((" + cname + "){.tag = " + itoa(idx) + ", .payload = {._" + itoa(idx) + " = (" + value_code + ")}})";
}

// opaque_convert (codegen.py:1425).
fn cg_opaque_convert(g0: HCodegen, code: str, vt: str, opaque_t: str, e: Node) -> CGExpr {
    let mut g: HCodegen = g0;
    let impls: [str] = cg_impls_for_trait(g, cg_opaque_trait(opaque_t));
    if cg_str_in(vt, impls) {
        if !cg_is_fresh_struct(g, e) {
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            let own: str = cg_struct_own_code(g, "__forge_op" + itoa(n), vt);
            let wrapped: str = cg_opaque_wrap(g, "__forge_op" + itoa(n), vt, opaque_t);
            return CGExpr { g: g, code: "({" + cg_c_type(g, vt) + " __forge_op" + itoa(n) + " = " + code + "; " + own + " " + wrapped + ";})" };
        }
        return CGExpr { g: g, code: cg_opaque_wrap(g, code, vt, opaque_t) };
    }
    if vt == opaque_t && !cg_is_fresh_union(g, e) {
        return CGExpr { g: g, code: "forge_copy_" + cg_opaque_c_name(opaque_t) + "(" + code + ")" };
    }
    return CGExpr { g: g, code: code };
}

// struct_own_code (codegen.py:1687): deep-copy str fields, gain
// array refs, recurse into nested structs. Join keeps empty
// pieces (a scalar-only nested struct contributes ""), exactly
// as Python's " ".join does.
fn cg_struct_own_code(g: HCodegen, var_code: str, t: str) -> str {
    let enc: str = cg_struct_fields_concrete(g, t);
    let parts: [str] = infer_parse_fields(enc);
    let mut pieces: [str] = [];
    let mut i: int = 0;
    while i < len(parts) {
        let kv: [str] = split(parts[i], ":");
        if len(kv) >= 2 {
            let fname: str = kv[0];
            let ftype: str = kv[1];
            let code: str = var_code + "." + fname;
            if ftype == "str" {
                push(pieces, code + " = forge_copy_str(" + code + ");");
            } else if cg_is_array_type(g, ftype) {
                push(pieces, "forge_arr_inc(" + code + ".ref);");
            } else if cg_is_struct_type(g, ftype) {
                push(pieces, cg_struct_own_code(g, code, ftype));
            }
        }
        i = i + 1;
    }
    return join(pieces, " ");
}

// tuple_own_code (codegen.py:1707).
fn cg_tuple_own_code(g: HCodegen, var_code: str, t: str) -> str {
    let elems: [str] = tuple_elems(t);
    let mut pieces: [str] = [];
    let mut i: int = 0;
    while i < len(elems) {
        let et: str = elems[i];
        let code: str = var_code + "._" + itoa(i);
        if et == "str" {
            push(pieces, code + " = forge_copy_str(" + code + ");");
        } else if is_union_type(et) {
            let ucopy: str = cg_union_copy_stmt(code, et);
            if ucopy != "" {
                push(pieces, ucopy);
            }
        } else if cg_is_opaque_type(et) {
            push(pieces, code + " = forge_copy_" + cg_opaque_c_name(et) + "(" + code + ");");
        } else if cg_is_array_type(g, et) {
            push(pieces, "forge_arr_inc(" + code + ".ref);");
        } else if cg_is_struct_type(g, et) {
            push(pieces, cg_struct_own_code(g, code, et));
        } else if infer_is_tuple_type(et) {
            push(pieces, cg_tuple_own_code(g, code, et));
        }
        i = i + 1;
    }
    return join(pieces, " ");
}

// struct_free_code (codegen.py:1764): free a struct value's owned
// fields; `path` is the variable's dotted path ("" when unknown),
// and fields recorded in moved_fields are skipped.
fn cg_struct_free_code(g0: HCodegen, var_code: str, t: str, path: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let enc: str = cg_struct_fields_concrete(g, t);
    let parts: [str] = infer_parse_fields(enc);
    let mut pieces: [str] = [];
    let mut i: int = 0;
    while i < len(parts) {
        let kv: [str] = split(parts[i], ":");
        if len(kv) >= 2 {
            let fname: str = kv[0];
            let ftype: str = kv[1];
            let mut skip: bool = false;
            if path != "" && cg_moved_contains(g, path + "." + fname) {
                skip = true;
            }
            if !skip {
                let code: str = var_code + "." + fname;
                if ftype == "str" {
                    push(pieces, "forge_free_str(" + code + ");");
                } else if is_union_type(ftype) {
                    let ufree: str = cg_union_free_code(code, ftype);
                    if ufree != "" {
                        push(pieces, ufree);
                    }
                } else if cg_is_opaque_type(ftype) {
                    push(pieces, "forge_free_" + cg_opaque_c_name(ftype) + "(" + code + ");");
                } else if cg_is_array_type(g, ftype) {
                    let fc: CGExpr = cg_array_free_code(g, code, ftype);
                    g = fc.g;
                    push(pieces, fc.code);
                } else if cg_is_struct_type(g, ftype) {
                    let mut subpath: str = "";
                    if path != "" {
                        subpath = path + "." + fname;
                    }
                    let fc: CGExpr = cg_struct_free_code(g, code, ftype, subpath);
                    g = fc.g;
                    push(pieces, fc.code);
                }
            }
        }
        i = i + 1;
    }
    return CGExpr { g: g, code: join(pieces, " ") };
}

// tuple_free_code (codegen.py:1730).
fn cg_tuple_free_code(g0: HCodegen, var_code: str, t: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let elems: [str] = tuple_elems(t);
    let mut pieces: [str] = [];
    let mut i: int = 0;
    while i < len(elems) {
        let et: str = elems[i];
        let code: str = var_code + "._" + itoa(i);
        if et == "str" {
            push(pieces, "forge_free_str(" + code + ");");
        } else if is_union_type(et) {
            let ufree: str = cg_union_free_code(code, et);
            if ufree != "" {
                push(pieces, ufree);
            }
        } else if cg_is_opaque_type(et) {
            push(pieces, "forge_free_" + cg_opaque_c_name(et) + "(" + code + ");");
        } else if cg_is_array_type(g, et) {
            let fc: CGExpr = cg_array_free_code(g, code, et);
            g = fc.g;
            push(pieces, fc.code);
        } else if cg_is_struct_type(g, et) {
            let fc: CGExpr = cg_struct_free_code(g, code, et, "");
            g = fc.g;
            push(pieces, fc.code);
        } else if infer_is_tuple_type(et) {
            let fc: CGExpr = cg_tuple_free_code(g, code, et);
            g = fc.g;
            push(pieces, fc.code);
        }
        i = i + 1;
    }
    return CGExpr { g: g, code: join(pieces, " ") };
}

fn cg_emit_struct_own(g0: HCodegen, var_code: str, t: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let code: str = cg_struct_own_code(g, var_code, t);
    if code != "" {
        g = cg_emit(g, code);
    }
    return g;
}

fn cg_emit_tuple_own(g0: HCodegen, var_code: str, t: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let code: str = cg_tuple_own_code(g, var_code, t);
    if code != "" {
        g = cg_emit(g, code);
    }
    return g;
}

fn cg_emit_struct_free(g0: HCodegen, var_code: str, t: str, path: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let fc: CGExpr = cg_struct_free_code(g, var_code, t, path);
    g = fc.g;
    if fc.code != "" {
        g = cg_emit(g, fc.code);
    }
    return g;
}

fn cg_emit_tuple_free(g0: HCodegen, var_code: str, t: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let fc: CGExpr = cg_tuple_free_code(g, var_code, t);
    g = fc.g;
    if fc.code != "" {
        g = cg_emit(g, fc.code);
    }
    return g;
}

// ---- move() bookkeeping (move v2) ----

fn cg_moved_contains(g: HCodegen, path: str) -> bool {
    let mut i: int = 0;
    while i < len(g.moved_fields) {
        if g.moved_fields[i] == path {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cg_moved_add(g0: HCodegen, path: str) -> HCodegen {
    let mut g: HCodegen = g0;
    if !cg_moved_contains(g, path) {
        push(g.moved_fields, path);
    }
    return g;
}

fn cg_moved_discard(g0: HCodegen, path: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(g.moved_fields) {
        if g.moved_fields[i] != path {
            push(out, g.moved_fields[i]);
        }
        i = i + 1;
    }
    g.moved_fields = out;
    return g;
}

fn cg_moved_discard_prefix(g0: HCodegen, prefix: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(g.moved_fields) {
        if !starts_with(g.moved_fields[i], prefix) {
            push(out, g.moved_fields[i]);
        }
        i = i + 1;
    }
    g.moved_fields = out;
    return g;
}

fn cg_moved_has_prefix(g: HCodegen, prefix: str) -> bool {
    let mut i: int = 0;
    while i < len(g.moved_fields) {
        if starts_with(g.moved_fields[i], prefix) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// owned_forget (codegen.py:1210): drop a variable from ownership
// tracking (straight-line move); frame-start indices past the
// removed entry shift down by one to stay valid.
fn cg_owned_forget(g0: HCodegen, name: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut idx: int = -1;
    let mut i: int = len(g.owned_names) - 1;
    while i >= 0 {
        if idx < 0 && g.owned_names[i] == name {
            idx = i;
        }
        i = i - 1;
    }
    if idx < 0 {
        return g;
    }
    let mut nn: [str] = [];
    let mut nt: [str] = [];
    let mut j: int = 0;
    while j < len(g.owned_names) {
        if j != idx {
            push(nn, g.owned_names[j]);
            push(nt, g.owned_types[j]);
        }
        j = j + 1;
    }
    g.owned_names = nn;
    g.owned_types = nt;
    let mut nf: [int] = [];
    let mut k: int = 0;
    while k < len(g.owned_frame_starts) {
        let s: int = g.owned_frame_starts[k];
        if s > idx {
            push(nf, s - 1);
        } else {
            push(nf, s);
        }
        k = k + 1;
    }
    g.owned_frame_starts = nf;
    return g;
}

// Is any field of `t` ownable by struct_own_code (scalars, str,
// arrays, structs, tuples — no union/opaque anywhere)?
// Used by the drop-hook gate (codegen.py:1457).
fn cg_ownable(g: HCodegen, t: str, seen0: [str]) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "str" {
        return true;
    }
    if is_union_type(t) || cg_is_opaque_type(t) {
        return false;
    }
    if infer_is_tuple_type(t) {
        let elems: [str] = tuple_elems(t);
        let mut i: int = 0;
        while i < len(elems) {
            if !cg_ownable(g, elems[i], seen0) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if cg_is_array_type(g, t) {
        return cg_ownable(g, infer_array_elem(t), seen0);
    }
    if cg_is_struct_type(g, t) {
        let name: str = cg_struct_type_name(g, t);
        if cg_str_in(name, seen0) {
            return true;
        }
        let mut seen: [str] = seen0;
        push(seen, name);
        let enc: str = cg_struct_fields_concrete(g, t);
        let parts: [str] = infer_parse_fields(enc);
        let mut j: int = 0;
        while j < len(parts) {
            let kv: [str] = split(parts[j], ":");
            if len(kv) >= 2 && !cg_ownable(g, kv[1], seen) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }
    return false;
}

// drop_hook_name (codegen.py:1457): mangled drop-hook name for a
// struct type, or "" when there is none / it is not ownable.
fn cg_drop_hook_name(g: HCodegen, typ: str) -> str {
    let resolved: str = cg_resolve_newtype(g, typ);
    if infer_find_str(resolved, "<") >= 0 {
        return "";
    }
    let fname: str = resolved + "__drop";
    let found: [str] = cg_fn_lookup(g, fname);
    if found[0] != "1" {
        return "";
    }
    if found[1] != "void" {
        return "";
    }
    let params: [str] = infer_parse_params(found[2]);
    if len(params) != 1 {
        return "";
    }
    let kv: [str] = infer_split_param(params[0]);
    if len(kv) < 2 || kv[1] != resolved {
        return "";
    }
    let seen: [str] = [];
    if !cg_ownable(g, resolved, seen) {
        return "";
    }
    return fname;
}

// emit_drop_hook (codegen.py:1505).
fn cg_emit_drop_hook(g0: HCodegen, name: str, typ: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let fname: str = cg_drop_hook_name(g, typ);
    if fname == "" {
        return g;
    }
    let resolved: str = cg_resolve_newtype(g, typ);
    g.assign_counter = g.assign_counter + 1;
    let n: int = g.assign_counter;
    let tmp: str = "__forge_drop" + itoa(n);
    let own: str = cg_struct_own_code(g, tmp, resolved);
    g = cg_emit(g, "{ " + cg_c_type(g, resolved) + " " + tmp + " = " + name + "; " + own + " " + fname + "(" + tmp + "); }");
    return g;
}

// ---- fixed-width ints and casts ----

// [lo, hi] as decimal strings ("int" is the full int64 range;
// u64's hi is 2^64-1, which no Qasida int literal can spell).
fn cg_fixed_range_str(t: str) -> [str] {
    if t == "int" {
        return ["-9223372036854775808", "9223372036854775807"];
    }
    if t == "i8" {
        return ["-128", "127"];
    }
    if t == "i16" {
        return ["-32768", "32767"];
    }
    if t == "i32" {
        return ["-2147483648", "2147483647"];
    }
    if t == "u8" {
        return ["0", "255"];
    }
    if t == "u16" {
        return ["0", "65535"];
    }
    if t == "u32" {
        return ["0", "4294967295"];
    }
    return ["0", "18446744073709551615"];
}

fn cg_fixed_width(t: str) -> int {
    if t == "i8" || t == "u8" {
        return 8;
    }
    if t == "i16" || t == "u16" {
        return 16;
    }
    if t == "i32" || t == "u32" {
        return 32;
    }
    return 64;
}

// [lo, hi] for float_to_int_cast as Python repr(float(...))
// spellings: the upper bound is exclusive (max+1, exactly
// representable as a double).
fn cg_float_bound_str(t: str) -> [str] {
    if t == "int" {
        return ["-9.223372036854776e+18", "9.223372036854776e+18"];
    }
    if t == "i8" {
        return ["-128.0", "128.0"];
    }
    if t == "i16" {
        return ["-32768.0", "32768.0"];
    }
    if t == "i32" {
        return ["-2147483648.0", "2147483648.0"];
    }
    if t == "u8" {
        return ["0.0", "256.0"];
    }
    if t == "u16" {
        return ["0.0", "65536.0"];
    }
    if t == "u32" {
        return ["0.0", "4294967296.0"];
    }
    return ["0.0", "1.8446744073709552e+19"];
}

fn cg_is_int_type(t: str) -> bool {
    return t == "int" || cg_is_fixed_int(t);
}

// Widening cast (from-range inside to-range), by the eight int
// types' ranges — no big-int comparison needed.
fn cg_is_widening(from_t: str, to_t: str) -> bool {
    if from_t == to_t {
        return true;
    }
    if from_t == "int" {
        return false;
    }
    if from_t == "i8" {
        return to_t == "i16" || to_t == "i32" || to_t == "int";
    }
    if from_t == "i16" {
        return to_t == "i32" || to_t == "int";
    }
    if from_t == "i32" {
        return to_t == "int";
    }
    if from_t == "u8" {
        return to_t == "u16" || to_t == "u32" || to_t == "u64" || to_t == "int";
    }
    if from_t == "u16" {
        return to_t == "u32" || to_t == "u64" || to_t == "int";
    }
    if from_t == "u32" {
        return to_t == "u64" || to_t == "int";
    }
    return false;
}

// _fx_temp (codegen.py:1283): increment-then-read.
fn cg_fx_temp(g0: HCodegen) -> CGExpr {
    let mut g: HCodegen = g0;
    g.assign_counter = g.assign_counter + 1;
    return CGExpr { g: g, code: "__forge_fx" + itoa(g.assign_counter) };
}

// int_cast_code (codegen.py:1346).
fn cg_int_cast_code(g0: HCodegen, code: str, from_t: str, to_t: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let ct: str = cg_c_type(g, to_t);
    if cg_is_widening(from_t, to_t) {
        return CGExpr { g: g, code: "(" + ct + ")(" + code + ")" };
    }
    let tr: [str] = cg_fixed_range_str(to_t);
    let tlo: str = tr[0];
    let thi: str = tr[1];
    let mut w: str = "long long";
    if from_t == "u64" {
        w = "unsigned long long";
    }
    let tmp: CGExpr = cg_fx_temp(g);
    g = tmp.g;
    let tn: str = tmp.code;
    let mut cond: str = tn + " < " + tlo + " || " + tn + " > " + thi;
    if w == "unsigned long long" && (starts_with(tlo, "-") || tlo == "0") {
        cond = tn + " > " + thi;
    }
    return CGExpr { g: g, code: "({" + w + " " + tn + " = (" + w + ")(" + code + "); if (" + cond + ") forge_fail(\"integer overflow\"); (" + ct + ")(" + tn + ");})" };
}

// float_to_int_cast (codegen.py:1374), safe mode only.
fn cg_float_to_int_cast(g0: HCodegen, code: str, to_t: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let ct: str = cg_c_type(g, to_t);
    let b: [str] = cg_float_bound_str(to_t);
    let tmp: CGExpr = cg_fx_temp(g);
    g = tmp.g;
    let tn: str = tmp.code;
    return CGExpr { g: g, code: "({ double " + tn + " = (" + code + "); if (!(" + tn + " >= " + b[0] + " && " + tn + " < " + b[1] + ")) forge_fail(\"float to int cast out of range\"); (" + ct + ")(" + tn + ");})" };
}

// Shared TupleLit / StructLit / Call-arg conversion (codegen.py
// TupleLit L3598, StructLit L3643, Call L4299): by the DECLARED
// element/field/param type — never_wrap, str copy, union wrap /
// shared-union copy, opaque convert, array inc, struct own,
// tuple own. Temp form uses __forge_arg{n} (increment-then-read).
// Convert a value to an owned value of the expected type at a
// receiving site. str_copy_always: Python copies str elements
// of TupleLit/StructLit UNCONDITIONALLY (codegen.py:3642, 3687),
// but a user-call str argument only when it is NOT fresh
// (codegen.py:4378); the hosted version used to copy always at
// every site, which made fresh substr/concat results gain a
// spurious forge_copy_str (lex bootstrap diffs).
fn cg_convert_owned(g0: HCodegen, code0: str, child_t: str, et: str, child: Node, str_copy_always: bool) -> CGExpr {
    let mut g: HCodegen = g0;
    let mut code: str = code0;
    if child_t == "never" && et != "" {
        code = cg_never_wrap(code, et, g);
    }
    if et == "str" {
        if str_copy_always || !cg_is_fresh_str(g, child) {
            code = "forge_copy_str(" + code + ")";
        }
    } else if is_union_type(et) {
        if cg_str_in(child_t, union_members(et)) {
            let cs: bool = child_t == "str" && !cg_is_fresh_str(g, child);
            code = cg_union_wrap(code, child_t, et, cs, g);
        } else if child_t == et && !cg_is_fresh_union(g, child) {
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            let copy: str = cg_union_copy_stmt("__forge_arg" + itoa(n), et);
            code = "({" + cg_c_type(g, et) + " __forge_arg" + itoa(n) + " = " + code + "; " + copy + " __forge_arg" + itoa(n) + ";})";
        }
    } else if cg_is_opaque_type(et) {
        let oc: CGExpr = cg_opaque_convert(g, code, child_t, et, child);
        g = oc.g;
        code = oc.code;
    } else if cg_is_array_type(g, et) && !cg_is_fresh_array(g, child) {
        g.assign_counter = g.assign_counter + 1;
        let n: int = g.assign_counter;
        code = "({" + cg_c_type(g, et) + " __forge_arg" + itoa(n) + " = " + code + "; forge_arr_inc(__forge_arg" + itoa(n) + ".ref); __forge_arg" + itoa(n) + ";})";
    } else if cg_is_struct_type(g, et) && !cg_is_fresh_struct(g, child) {
        g.assign_counter = g.assign_counter + 1;
        let n: int = g.assign_counter;
        let own: str = cg_struct_own_code(g, "__forge_arg" + itoa(n), et);
        code = "({" + cg_c_type(g, et) + " __forge_arg" + itoa(n) + " = " + code + "; " + own + " __forge_arg" + itoa(n) + ";})";
    } else if infer_is_tuple_type(et) && !cg_is_fresh_tuple(g, child) {
        g.assign_counter = g.assign_counter + 1;
        let n: int = g.assign_counter;
        let own: str = cg_tuple_own_code(g, "__forge_arg" + itoa(n), et);
        code = "({" + cg_c_type(g, et) + " __forge_arg" + itoa(n) + " = " + code + "; " + own + " __forge_arg" + itoa(n) + ";})";
    }
    return CGExpr { g: g, code: code };
}

// ---- string ordering / sorting (for generate()'s sorted lists) ----

// Rank of one ASCII char in ASCII order (-1 when absent).
fn cg_char_rank(ch: str) -> int {
    return infer_find_str(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", ch);
}

// Lexicographic comparison of two strings: -1, 0, 1.
fn cg_str_cmp(a: str, b: str) -> int {
    let mut i: int = 0;
    while i < len(a) && i < len(b) {
        let ra: int = cg_char_rank(substr(a, i, 1));
        let rb: int = cg_char_rank(substr(b, i, 1));
        if ra != rb {
            return ra - rb;
        }
        i = i + 1;
    }
    if len(a) < len(b) {
        return -1;
    }
    if len(a) > len(b) {
        return 1;
    }
    return 0;
}

fn cg_count_char(t: str, ch: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(t) {
        if substr(t, i, 1) == ch {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// Comparator for the sorted lists: 0 = lexicographic (unions,
// concrete enums), 1 = (length, spelling) (tuples), 2 = number
// of "[" (nested arrays, stable).
fn cg_cmp_mode(a: str, b: str, mode: int) -> int {
    if mode == 1 {
        if len(a) < len(b) {
            return -1;
        }
        if len(a) > len(b) {
            return 1;
        }
        return cg_str_cmp(a, b);
    }
    if mode == 2 {
        let ca: int = cg_count_char(a, "[");
        let cb: int = cg_count_char(b, "[");
        if ca < cb {
            return -1;
        }
        if ca > cb {
            return 1;
        }
        return 0;
    }
    return cg_str_cmp(a, b);
}

// Stable insertion sort under cg_cmp_mode.
fn cg_sorted_mode(a0: [str], mode: int) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(a0) {
        let s: str = a0[i];
        let mut pos: int = len(out);
        let mut j: int = 0;
        while j < len(out) {
            if cg_cmp_mode(s, out[j], mode) < 0 && pos == len(out) {
                pos = j;
            }
            j = j + 1;
        }
        let mut nxt: [str] = [];
        let mut k: int = 0;
        while k < len(out) {
            if k == pos {
                push(nxt, s);
            }
            push(nxt, out[k]);
            k = k + 1;
        }
        if pos == len(out) {
            push(nxt, s);
        }
        out = nxt;
        i = i + 1;
    }
    return out;
}

// ---- concrete generic types: registration + collection ----

fn cg_is_enum_name(g: HCodegen, base: str) -> bool {
    let mut i: int = 0;
    while i < len(g.enum_names) {
        if g.enum_names[i] == base {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// True when a type spelling mentions one of the given type-param
// names as a bare type (directly, or inside <...>, [...], (...)).
fn cg_has_bare_tparam(t: str, names: [str]) -> bool {
    let mut i: int = 0;
    while i < len(names) {
        if t == names[i] {
            return true;
        }
        i = i + 1;
    }
    if infer_is_generic(t) {
        let args: [str] = generic_args(t);
        let mut j: int = 0;
        while j < len(args) {
            if cg_has_bare_tparam(args[j], names) {
                return true;
            }
            j = j + 1;
        }
        return false;
    }
    if is_array(t) {
        return cg_has_bare_tparam(infer_array_elem(t), names);
    }
    if infer_is_tuple_type(t) {
        let elems: [str] = tuple_elems(t);
        let mut j: int = 0;
        while j < len(elems) {
            if cg_has_bare_tparam(elems[j], names) {
                return true;
            }
            j = j + 1;
        }
        return false;
    }
    return false;
}

// Register one concrete generic struct ("Option<int>" -> a
// "Option_int" entry with substituted fields), unless it is
// already present or its args still mention type params.
fn cg_register_concrete_struct(g0: HCodegen, t: str) -> HCodegen {
    let mut g: HCodegen = g0;
    if !infer_is_generic(t) {
        return g;
    }
    let base: str = generic_base(t);
    let tps: str = cg_struct_tparams(g, base);
    if tps == "" {
        return g;
    }
    let names: [str] = split(tps, "~");
    if cg_has_bare_tparam(t, names) {
        return g;
    }
    let mangled: str = infer_mangle_type(t);
    let mut i: int = 0;
    while i < len(g.struct_names) {
        if g.struct_names[i] == mangled {
            return g;
        }
        i = i + 1;
    }
    let enc: str = cg_struct_fields_concrete(g, t);
    push(g.struct_names, mangled);
    push(g.struct_fields, enc);
    push(g.struct_tparams, "");
    return g;
}

// Strip sized-array sizes to the dynamic form ("[int; 3]" ->
// "[int]", recursively), as collect_nested_array_types does.
fn cg_normalize_sized(t: str) -> str {
    if is_sized_array(t) {
        return "[" + cg_normalize_sized(elem_type(t)) + "]";
    }
    if starts_with(t, "[") && substr(t, len(t) - 1, 1) == "]" {
        return "[" + cg_normalize_sized(infer_array_elem(t)) + "]";
    }
    return t;
}

// Collect the composite types one type spelling uses, into the
// generate() collections (concrete structs/enums, tuples,
// unions, nested arrays).
fn cg_collect_type(g0: HCodegen, t: str) -> HCodegen {
    let mut g: HCodegen = g0;
    if t == "" {
        return g;
    }
    if starts_with(t, "readonly ") {
        return cg_collect_type(g, cg_readonly_inner(t));
    }
    if infer_is_generic(t) {
        let base: str = generic_base(t);
        let args: [str] = generic_args(t);
        if cg_struct_tparams(g, base) != "" {
            g = cg_register_concrete_struct(g, t);
        } else if cg_is_enum_name(g, base) {
            let names: [str] = split(cg_enum_tparams(g, base), "~");
            if !cg_has_bare_tparam(t, names) {
                g.enum_concrete = cg_push_unique_str(g.enum_concrete, t);
            }
        }
        let mut i: int = 0;
        while i < len(args) {
            g = cg_collect_type(g, args[i]);
            i = i + 1;
        }
        return g;
    }
    if is_union_type(t) {
        g.union_types = cg_push_unique_str(g.union_types, t);
        return g;
    }
    if infer_is_tuple_type(t) {
        g.tuple_types = cg_push_unique_str(g.tuple_types, t);
        let elems: [str] = tuple_elems(t);
        let mut i: int = 0;
        while i < len(elems) {
            g = cg_collect_type(g, elems[i]);
            i = i + 1;
        }
        return g;
    }
    if is_array(t) {
        // Nested-array typedefs use the dynamic form: sized
        // sizes are stripped first (collect_nested_array_types).
        let norm: str = cg_normalize_sized(t);
        let mut cur: str = norm;
        while starts_with(cur, "[") && substr(cur, len(cur) - 1, 1) == "]" {
            let inner: str = infer_array_elem(cur);
            if starts_with(inner, "[") {
                g.nested_arrays = cg_push_unique_str(g.nested_arrays, cur);
            }
            cur = inner;
        }
        return cg_collect_type(g, infer_array_elem(norm));
    }
    if cg_is_enum_name(g, t) {
        g.enum_concrete = cg_push_unique_str(g.enum_concrete, t);
        return g;
    }
    return g;
}

// Recursive body walk for the collect pass: concrete types from
// StructLit / variant-Call nodes, Cast targets, Let annotations,
// weak use, spawn call names. Generic function templates are
// NOT walked (their bodies mention type params; Python only
// instantiates types actually used).
fn cg_collect_walk(g0: HCodegen, node: Node) -> HCodegen {
    let mut g: HCodegen = g0;
    // BinOp spine: walk iteratively, innermost-first (a chain
    // of N terms recursed N deep at ~34KB/frame, overflowing
    // the 8MB C stack at ~200 terms). The visit order is exactly
    // the recursion's: leftmost operand, then each right operand
    // innermost-first. BinOp nodes carry no per-node work (the
    // kind branches below are 2/31/35/39/10/21), so only the
    // operands are walked; a right operand that is itself a
    // chain re-enters this branch and flattens too.
    if node.kind == 40 {
        let mut spine: [Node] = [];
        let mut cur: Node = node;
        while cur.kind == 40 {
            push(spine, cur);
            cur = cur.kids[0];
        }
        g = cg_collect_walk(g, cur);
        let mut i: int = len(spine) - 1;
        while i >= 0 {
            g = cg_collect_walk(g, spine[i].kids[1]);
            i = i - 1;
        }
        return g;
    }
    if node.kind == 2 {
        let sp: [str] = split_tparams(node.name);
        if sp[1] != "" {
            return g;
        }
        // Type lookups below are keyed "fn:line:col" (bootstrap
        // fix), so the walk must know whose body it is in.
        g.current_fn = node.name;
    }
    if node.kind == 31 {
        let conc: str = cg_structlit_concrete(g, node);
        if conc != node.name {
            g = cg_register_concrete_struct(g, conc);
            g = cg_collect_type(g, conc);
        }
    }
    if node.kind == 35 {
        let v: [str] = cg_variant_lookup(g, node.name);
        if v[0] == "1" {
            let conc: str = cg_enum_concrete_call(g, node);
            if conc != v[1] {
                g.enum_concrete = cg_push_unique_str(g.enum_concrete, conc);
                g = cg_collect_type(g, conc);
            }
        }
        if node.name == "weak_new" || node.name == "weak_upgrade" {
            g.weak_found = true;
        }
    }
    if node.kind == 39 {
        g = cg_collect_type(g, cg_subst(g, node.sval));
    }
    if node.kind == 10 {
        g = cg_collect_type(g, cg_subst(g, node.sval));
    }
    if node.kind == 21 {
        if len(node.kids) > 0 && node.kids[0].kind == 35 {
            let mut nm: str = node.kids[0].name;
            let tf: [str] = cg_template_lookup(g, nm);
            if tf[0] == "1" {
                let b: CGBind = cg_generic_bindings(g, tf, nm, node.kids[0]);
                if b.ok {
                    nm = b.mangled;
                }
            }
            if !cg_str_in(nm, g.spawn_names) {
                push(g.spawn_names, nm);
                push(g.spawn_argc, len(node.kids[0].kids));
            }
        }
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        if node.kind == 6 {
            // Impl method: walk its kids with the mangled
            // Struct__method name pinned (the kind-2 branch
            // would otherwise reset it to the plain method
            // name). Methods cannot be generic (parser
            // rejects them), so skipping the kind-2 header
            // loses nothing.
            let m: Node = node.kids[i];
            g.current_fn = node.name + "__" + m.name;
            let mut k: int = 0;
            while k < len(m.kids) {
                g = cg_collect_walk(g, m.kids[k]);
                k = k + 1;
            }
        } else {
            g = cg_collect_walk(g, node.kids[i]);
        }
        i = i + 1;
    }
    return g;
}

// Collect pass (runs after cg_build_tables, before cg_generate):
// every composite type the program uses, from the infer table,
// signatures, struct/enum/trait declarations, and a body walk.
fn cg_collect(g0: HCodegen, prog: Node) -> HCodegen {
    let mut g: HCodegen = g0;
    // Signature types first: the Python checker instantiates
    // generic structs from function signatures (in program
    // order) before it checks bodies, so concrete structs are
    // registered in signature order, then body order.
    let mut i: int = 0;
    while i < len(g.func_rets) {
        g = cg_collect_type(g, g.func_rets[i]);
        i = i + 1;
    }
    i = 0;
    while i < len(g.func_params) {
        let entries: [str] = infer_parse_params(g.func_params[i]);
        let mut j: int = 0;
        while j < len(entries) {
            let kv: [str] = infer_split_param(entries[j]);
            if len(kv) >= 2 {
                g = cg_collect_type(g, kv[1]);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(g.type_vals) {
        // Template-body entries (4d) are not uses: Python only
        // instantiates types actually used by a concrete body.
        if !cg_str_in(g.type_keys[i], g.template_keys) {
            g = cg_collect_type(g, g.type_vals[i]);
        }
        i = i + 1;
    }
    i = 0;
    while i < len(g.struct_fields) {
        let parts: [str] = infer_parse_fields(g.struct_fields[i]);
        let mut j: int = 0;
        while j < len(parts) {
            let kv: [str] = split(parts[j], ":");
            if len(kv) >= 2 {
                g = cg_collect_type(g, kv[1]);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(g.enum_payloads) {
        let parts: [str] = split(g.enum_payloads[i], "~");
        let mut j: int = 0;
        while j < len(parts) {
            let kv: [str] = split(parts[j], ":");
            if len(kv) >= 2 {
                g = cg_collect_type(g, kv[1]);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(g.trait_sigs) {
        let sig: str = g.trait_sigs[i];
        let colon: int = infer_find_str(sig, ":");
        let rest: str = substr(sig, colon + 1, len(sig) - colon - 1);
        let ai: int = infer_find_str(rest, "->");
        if ai >= 0 {
            let params: str = substr(rest, 0, ai);
            let ret: str = substr(rest, ai + 2, len(rest) - ai - 2);
            g = cg_collect_type(g, ret);
            if params != "" {
                let ps: [str] = split(params, "~");
                let mut j: int = 0;
                while j < len(ps) {
                    g = cg_collect_type(g, ps[j]);
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    g = cg_collect_walk(g, prog);
    // Generic instantiations (4d): collect concrete types from each
    // instantiated template body under its bindings (signature types
    // first, mirroring the concrete-function order above).
    let mut xi: int = 0;
    while xi < len(g.inst_mangled) {
        let tmpl: Node = cg_find_fn_node(prog, g.inst_tmpl[xi]);
        if tmpl.kind == 2 {
            let saved_names: [str] = g.subst_names;
            let saved_types: [str] = g.subst_types;
            g.subst_names = split(g.inst_bnames[xi], "~");
            g.subst_types = split(g.inst_btypes[xi], "~");
            g = cg_collect_type(g, cg_subst(g, tmpl.sval));
            let entries: [str] = cg_param_entries(tmpl);
            let mut pj: int = 0;
            while pj < len(entries) {
                let kv: [str] = split(entries[pj], ":");
                if len(kv) >= 2 {
                    g = cg_collect_type(g, cg_subst(g, kv[1]));
                }
                pj = pj + 1;
            }
            g = cg_collect_walk(g, tmpl.kids[len(tmpl.kids) - 1]);
            g.subst_names = saved_names;
            g.subst_types = saved_types;
        }
        xi = xi + 1;
    }
    return g;
}

// ---- ownership frees (4a: str + scalar arrays only) ----

// Array free code for a scalar-element array value.
fn cg_array_free_code(g0: HCodegen, var_code: str, typ: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let r0: str = cg_resolve_newtype(g, typ);
    if is_readonly(r0) {
        return cg_array_free_code(g, var_code, cg_readonly_inner(r0));
    }
    let r: str = r0;
    let inner: str = elem_type(r);
    if inner == "int" {
        return CGExpr { g: g, code: "forge_int_array_free(" + var_code + ");" };
    }
    if inner == "float" {
        return CGExpr { g: g, code: "forge_float_array_free(" + var_code + ");" };
    }
    if inner == "bool" {
        return CGExpr { g: g, code: "forge_bool_array_free(" + var_code + ");" };
    }
    if inner == "str" {
        return CGExpr { g: g, code: "forge_str_array_free(" + var_code + ");" };
    }
    if cg_is_struct_type(g, inner) {
        return CGExpr { g: g, code: "forge_" + cg_struct_type_name(g, inner) + "_array_free(" + var_code + ");" };
    }
    // Nested array: refcount the outer, free each element array,
    // then the outer buffer. Counter is read-then-incremented,
    // exactly as in Python (array_free_code).
    let n: int = g.assign_counter;
    g.assign_counter = g.assign_counter + 1;
    let tmp: str = "__forge_fi" + itoa(n);
    let inner_out: CGExpr = cg_array_free_code(g, var_code + ".data[" + tmp + "]", inner);
    g = inner_out.g;
    let code: str = "if (" + var_code + ".ref && --(*" + var_code + ".ref) == 0) { for (long long " + tmp + " = 0; " + tmp + " < " + var_code + ".len; " + tmp + "++) { " + inner_out.code + " } if (" + var_code + ".data) memset(" + var_code + ".data, 0, (size_t)" + var_code + ".cap * sizeof(*" + var_code + ".data)); free(" + var_code + ".data); if (" + var_code + ".ref) memset(" + var_code + ".ref, 0, sizeof(long long)); free(" + var_code + ".ref); forge_arr_frees++; }";
    return CGExpr { g: g, code: code };
}

fn cg_moved_flag(name: str) -> str {
    return "__forge_moved_" + name;
}

// _emit_free_one (codegen.py:1536): guarded free of one owned var.
fn cg_emit_free_one(g0: HCodegen, name: str, typ: str) -> HCodegen {
    let mut g: HCodegen = g0;
    g = cg_emit(g, "if (!" + cg_moved_flag(name) + ") {");
    g.indent = g.indent + 1;
    if typ == "str" {
        g = cg_emit(g, "forge_free_str(" + name + ");");
    } else if is_union_type(typ) {
        let members: [str] = union_members(typ);
        let mut idx: int = -1;
        let mut i: int = 0;
        while i < len(members) {
            if members[i] == "str" {
                idx = i;
            }
            i = i + 1;
        }
        if idx >= 0 {
            g = cg_emit(g, "if (" + name + ".tag == " + itoa(idx) + ") forge_free_str(" + name + ".payload._" + itoa(idx) + ");");
        }
    } else if cg_is_opaque_type(typ) {
        g = cg_emit(g, "forge_free_Opaque_" + cg_opaque_trait(typ) + "(" + name + ");");
    } else if cg_is_array_type(g, typ) {
        let out: CGExpr = cg_array_free_code(g, name, typ);
        g = out.g;
        g = cg_emit(g, out.code);
    } else if cg_is_struct_type(g, typ) {
        if cg_moved_has_prefix(g, name + ".") {
            // A field of this struct moved away: the drop hook
            // must not read it, and the free must skip it (the
            // new owner frees it) — move v2.
            g = cg_emit_struct_free(g, name, typ, name);
        } else {
            // Destructor hook first: fields must still be alive
            // when drop reads them (Top-500 #33). Never for the
            // drop method's own receiver parameter — that would
            // recurse forever (see gen_func's drop_receiver).
            if g.drop_receiver != name {
                g = cg_emit_drop_hook(g, name, typ);
            }
            g = cg_emit_struct_free(g, name, typ, "");
        }
    } else if infer_is_tuple_type(typ) {
        let fc: CGExpr = cg_tuple_free_code(g, name, typ);
        g = fc.g;
        g = cg_emit(g, fc.code);
    }
    g.indent = g.indent - 1;
    g = cg_emit(g, "}");
    return g;
}

fn cg_owned_add(g0: HCodegen, name: str, typ: str) -> HCodegen {
    let mut g: HCodegen = g0;
    // Python's owned_stack[-1] is a dict: re-adding a name to the
    // CURRENT frame overwrites its type instead of duplicating it
    // (Assign re-adds its target). Only the current frame is
    // searched — an outer frame's entry stays put.
    let start: int = g.owned_frame_starts[len(g.owned_frame_starts) - 1];
    let mut i: int = start;
    while i < len(g.owned_names) {
        if g.owned_names[i] == name {
            let mut nt: [str] = [];
            let mut j: int = 0;
            while j < len(g.owned_types) {
                if j == i {
                    push(nt, typ);
                } else {
                    push(nt, g.owned_types[j]);
                }
                j = j + 1;
            }
            g.owned_types = nt;
            return g;
        }
        i = i + 1;
    }
    push(g.owned_names, name);
    push(g.owned_types, typ);
    return g;
}

fn cg_owned_contains(g: HCodegen, name: str) -> bool {
    let mut i: int = 0;
    while i < len(g.owned_names) {
        if g.owned_names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// owned_type (codegen.py:1226): declared type of an owned variable,
// innermost frame wins; "" when untracked.
fn cg_owned_type(g: HCodegen, name: str) -> str {
    let mut i: int = len(g.owned_names) - 1;
    while i >= 0 {
        if g.owned_names[i] == name {
            return g.owned_types[i];
        }
        i = i - 1;
    }
    return "";
}

// emit_guarded (codegen.py:1202): emit a free only when the moved
// flag is clear.
fn cg_emit_guarded(g0: HCodegen, name: str, code: str) -> HCodegen {
    let mut g: HCodegen = g0;
    if code != "" {
        g = cg_emit(g, "if (!" + cg_moved_flag(name) + ") { " + code + " }");
    }
    return g;
}

// _field_path (codegen.py:1189): dotted path for a field access
// rooted at a variable, or "" for any other base.
fn cg_field_path(e: Node) -> str {
    let mut parts: [str] = [];
    let mut node: Node = e;
    while node.kind == 32 {
        push(parts, node.name);
        node = node.kids[0];
    }
    if node.kind != 34 {
        return "";
    }
    push(parts, node.name);
    let mut out: str = "";
    let mut i: int = len(parts) - 1;
    while i >= 0 {
        if out == "" {
            out = parts[i];
        } else {
            out = out + "." + parts[i];
        }
        i = i - 1;
    }
    return out;
}

// Latest local type for a name (mirrors Python's dict overwrite).
fn cg_local_type(g: HCodegen, name: str) -> str {
    let mut i: int = len(g.local_names) - 1;
    while i >= 0 {
        if g.local_names[i] == name {
            return g.local_types[i];
        }
        i = i - 1;
    }
    return "";
}

// ---- owned / defer frames (codegen.py:1135, 1571-1611, 2668-2681) ----

fn cg_push_owned_frame(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    push(g.owned_frame_starts, len(g.owned_names));
    return g;
}

fn cg_pop_owned_frame(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    let start: int = g.owned_frame_starts[len(g.owned_frame_starts) - 1];
    g.owned_names = cg_trunc_str(g.owned_names, start);
    g.owned_types = cg_trunc_str(g.owned_types, start);
    g.owned_frame_starts = cg_trunc_int(g.owned_frame_starts, len(g.owned_frame_starts) - 1);
    return g;
}

fn cg_push_defer_frame(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    push(g.defer_frame_starts, len(g.defer_calls));
    return g;
}

fn cg_pop_defer_frame(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    let start: int = g.defer_frame_starts[len(g.defer_frame_starts) - 1];
    g.defer_calls = cg_trunc_node(g.defer_calls, start);
    g.defer_conds = cg_trunc_bool(g.defer_conds, start);
    g.defer_frame_starts = cg_trunc_int(g.defer_frame_starts, len(g.defer_frame_starts) - 1);
    return g;
}

// emit_free_frame (codegen.py:1571): free only the innermost
// frame's vars, skipping names also held by an outer frame (the
// outer frame frees them) and skipping duplicates in this frame.
fn cg_emit_free_frame(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    let start: int = g.owned_frame_starts[len(g.owned_frame_starts) - 1];
    let mut seen: [str] = [];
    let mut i: int = start;
    while i < len(g.owned_names) {
        let name: str = g.owned_names[i];
        let typ: str = g.owned_types[i];
        let mut skip: bool = false;
        let mut j: int = 0;
        while j < len(seen) {
            if seen[j] == name {
                skip = true;
            }
            j = j + 1;
        }
        j = 0;
        while j < start {
            if g.owned_names[j] == name {
                skip = true;
            }
            j = j + 1;
        }
        if !skip {
            push(seen, name);
            g = cg_emit_free_one(g, name, typ);
        }
        i = i + 1;
    }
    return g;
}

// emit_free_frames_downto (codegen.py:1595): free frames from the
// innermost down to frame idx inclusive, without popping; a name
// is freed by exactly one frame (a frame below it wins).
fn cg_emit_free_frames_downto(g0: HCodegen, idx: int) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut f: int = len(g.owned_frame_starts) - 1;
    while f >= idx {
        let start: int = g.owned_frame_starts[f];
        let mut end: int = len(g.owned_names);
        if f + 1 < len(g.owned_frame_starts) {
            end = g.owned_frame_starts[f + 1];
        }
        let mut seen: [str] = [];
        let mut i: int = start;
        while i < end {
            let name: str = g.owned_names[i];
            let typ: str = g.owned_types[i];
            let mut skip: bool = false;
            let mut j: int = 0;
            while j < len(seen) {
                if seen[j] == name {
                    skip = true;
                }
                j = j + 1;
            }
            j = 0;
            while j < start {
                if g.owned_names[j] == name {
                    skip = true;
                }
                j = j + 1;
            }
            if !skip {
                push(seen, name);
                g = cg_emit_free_one(g, name, typ);
            }
            i = i + 1;
        }
        f = f - 1;
    }
    return g;
}

// emit_free_owned (codegen.py:1562 + owned_all, 1446): all frames,
// innermost first, each name freed once.
fn cg_emit_free_owned(g0: HCodegen) -> HCodegen {
    let mut g: HCodegen = g0;
    if g.freestanding {
        // No owned values can exist: strings/arrays have no
        // values in freestanding v1, so there is nothing to free
        // (unused str/array parameters are dead declarations).
        return g;
    }
    let mut seen: [str] = [];
    let mut f: int = len(g.owned_frame_starts) - 1;
    while f >= 0 {
        let start: int = g.owned_frame_starts[f];
        let mut end: int = len(g.owned_names);
        if f + 1 < len(g.owned_frame_starts) {
            end = g.owned_frame_starts[f + 1];
        }
        let mut i: int = start;
        while i < end {
            let name: str = g.owned_names[i];
            let typ: str = g.owned_types[i];
            let mut skip: bool = false;
            let mut j: int = 0;
            while j < len(seen) {
                if seen[j] == name {
                    skip = true;
                }
                j = j + 1;
            }
            if !skip {
                push(seen, name);
                g = cg_emit_free_one(g, name, typ);
            }
            i = i + 1;
        }
        f = f - 1;
    }
    return g;
}

// _emit_defer_frame (codegen.py:2668): one frame's deferred calls,
// LIFO, each re-emitted as an ExprStmt through gen_stmt.
fn cg_emit_defer_frame(g0: HCodegen, frame_idx: int, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let start: int = g.defer_frame_starts[frame_idx];
    let mut end: int = len(g.defer_calls);
    if frame_idx + 1 < len(g.defer_frame_starts) {
        end = g.defer_frame_starts[frame_idx + 1];
    }
    let mut i: int = end - 1;
    while i >= start {
        let call: Node = g.defer_calls[i];
        let mut st: Node = new_node(24, call.line, call.col);
        st.kids = [call];
        if g.defer_conds[i] {
            g.move_cond = 1;
        } else {
            g.move_cond = 0;
        }
        g = cg_gen_stmt(g, st, ret_type);
        g.move_cond = -1;
        i = i - 1;
    }
    return g;
}

// _emit_defers_downto (codegen.py:2675): frames from depth upward,
// innermost first, each LIFO. Emits only — frames stay on the stack.
fn cg_emit_defers_downto(g0: HCodegen, depth: int, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut f: int = len(g.defer_frame_starts) - 1;
    while f >= depth {
        g = cg_emit_defer_frame(g, f, ret_type);
        f = f - 1;
    }
    return g;
}

// _emit_all_defers (codegen.py:2681).
fn cg_emit_all_defers(g0: HCodegen, ret_type: str) -> HCodegen {
    return cg_emit_defers_downto(g0, 0, ret_type);
}

// never_wrap (codegen.py:1397): a never value satisfies C's type
// checker with a dummy of the expected type.
fn cg_never_wrap(code: str, expected: str, g: HCodegen) -> str {
    return "({ " + code + "; (" + cg_c_type(g, expected) + ")0; })";
}

// Dummy value for a Try early-return of a scalar type, or ""
// when the type has no scalar dummy (Try, codegen.py:3821).
fn cg_try_dummy(y: str) -> str {
    if y == "int" {
        return "0";
    }
    if y == "float" {
        return "0.0";
    }
    if y == "bool" {
        return "false";
    }
    if y == "str" {
        return "forge_copy_str(\"\")";
    }
    return "";
}

// Last index of a one-char string, or -1.
fn cg_find_last(s: str, ch: str) -> int {
    let mut out: int = -1;
    let mut i: int = 0;
    while i < len(s) {
        if substr(s, i, 1) == ch {
            out = i;
        }
        i = i + 1;
    }
    return out;
}

// ---- gen_expr ----

// Enum variant lookup: ["1", enum_name, tag, payload] or ["0"...].
// Payload "" means the variant takes no payload.
fn cg_variant_lookup(g: HCodegen, name: str) -> [str] {
    let mut i: int = 0;
    while i < len(g.enum_names) {
        let vs: [str] = split(g.enum_variants[i], "~");
        let mut j: int = 0;
        while j < len(vs) {
            if vs[j] == name {
                let parts: [str] = split(g.enum_payloads[i], "~");
                let mut pt: str = "";
                let mut k: int = 0;
                while k < len(parts) {
                    let kv: [str] = split(parts[k], ":");
                    if len(kv) >= 2 && kv[0] == name {
                        pt = kv[1];
                    }
                    k = k + 1;
                }
                return ["1", g.enum_names[i], itoa(j), pt];
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return ["0", "", "", ""];
}

// Does any variant of this enum carry a payload?
fn cg_enum_has_payload(g: HCodegen, ename: str) -> bool {
    let mut i: int = 0;
    while i < len(g.enum_names) {
        if g.enum_names[i] == ename {
            let parts: [str] = split(g.enum_payloads[i], "~");
            let mut k: int = 0;
            while k < len(parts) {
                let kv: [str] = split(parts[k], ":");
                if len(kv) >= 2 && kv[1] != "" {
                    return true;
                }
                k = k + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

fn cg_gen_expr(g0: HCodegen, e: Node) -> CGExpr {
    let mut g: HCodegen = g0;
    if g.freestanding {
        // Freestanding v1 has no allocator: strings and arrays
        // have no values, so any program that builds one fails
        // here with a clear error, never with a C or link error.
        if e.kind == 27 || e.kind == 29 {
            fail("freestanding v1 does not support strings/arrays yet");
        }
        let gt: str = cg_expr_type(g, e);
        if gt == "str" || cg_is_array_type(g, gt) {
            fail("freestanding v1 does not support strings/arrays yet");
        }
        if cg_is_struct_type(g, gt) {
            // A struct value carrying str/array fields would need
            // the hosted copy/free helpers on use; reject it here
            // rather than at link time. Concrete structs only
            // (Python's self.structs is rebuilt concrete-only
            // in generate()).
            let sname: str = cg_struct_type_name(g, gt);
            let mut si: int = 0;
            while si < len(g.struct_names) {
                if g.struct_names[si] == sname && g.struct_tparams[si] == "" {
                    let parts: [str] = infer_parse_fields(g.struct_fields[si]);
                    let mut fj: int = 0;
                    while fj < len(parts) {
                        let kv: [str] = split(parts[fj], ":");
                        if len(kv) >= 2 && (kv[1] == "str" || cg_is_array_type(g, kv[1])) {
                            fail("freestanding v1 does not support strings/arrays yet");
                        }
                        fj = fj + 1;
                    }
                }
                si = si + 1;
            }
        }
    }
    if e.kind == 25 {
        // Int literal: Python emits the decimal value + "LL".
        // A base-10 literal above i64 max saturates its ival, so
        // emit the true decimal text for those (the C literal
        // then has the same value Python emits); anything else
        // emits the ival (exact, and octal-safe: a source "010"
        // means decimal 10, while C "010" would mean octal 8).
        let digs: str = int_lit_digits(e);
        if digs != "" && !dec_le(digs, "9223372036854775807") {
            return CGExpr { g: g, code: digs + "LL" };
        }
        return CGExpr { g: g, code: itoa(e.ival) + "LL" };
    }
    if e.kind == 26 {
        // Float literal: emit the source spelling. Stage 4a only
        // covers canonical repr spellings (1.5, 2.0, 0.1, ...);
        // a general float repr formatter is a named later task.
        return CGExpr { g: g, code: e.sval };
    }
    if e.kind == 27 {
        return CGExpr { g: g, code: cg_c_str_literal(e.sval, e.has_nul) };
    }
    if e.kind == 28 {
        if e.bval {
            return CGExpr { g: g, code: "true" };
        }
        return CGExpr { g: g, code: "false" };
    }
    if e.kind == 34 {
        // Bare enum variant: payload-less enum -> bare name;
        // payload enum, payload-less variant -> tagged struct;
        // payload variant as a value -> error (write V(v)).
        let v: [str] = cg_variant_lookup(g, e.name);
        if v[0] == "1" {
            if cg_enum_has_payload(g, v[1]) {
                if v[3] != "" {
                    fail("variant '" + e.name + "' has a payload; write " + e.name + "(value)");
                }
                let et: str = cg_expr_type(g, e);
                return CGExpr { g: g, code: "(" + cg_c_type(g, et) + "){ .tag = " + v[2] + " }" };
            }
        }
        return CGExpr { g: g, code: e.name };
    }
    if e.kind == 41 {
        // UnaryOp: name = op, kids = [operand].
        if e.name == "-" && cg_expr_type(g, e.kids[0]) == "int" {
            let inner: CGExpr = cg_gen_expr(g, e.kids[0]);
            g = inner.g;
            // 4f: interval-proven safe (codegen.py:3866): plain
            // when the operand's interval lo is above INT_MIN
            // (a literal above INT_MIN, or a narrowed variable);
            // otherwise the checked form.
            let iv: [int] = cg_int_interval(g, e.kids[0]);
            if iv[0] == 1 && iv[1] > cg_int_min() {
                return CGExpr { g: g, code: "(-" + inner.code + ")" };
            }
            return CGExpr { g: g, code: "forge_neg(" + inner.code + ")" };
        }
        if e.name == "-" && cg_is_fixed_int(cg_expr_type(g, e.kids[0])) {
            // Unary minus on a fixed-width int (codegen.py:3913,
            // safe mode): signed widens, negates, range-checks
            // and narrows; unsigned fails at runtime unless the
            // value is zero.
            let t: str = cg_expr_type(g, e.kids[0]);
            let inner: CGExpr = cg_gen_expr(g, e.kids[0]);
            g = inner.g;
            let tmp: CGExpr = cg_fx_temp(g);
            g = tmp.g;
            let tn: str = tmp.code;
            if starts_with(t, "i") {
                let tr: [str] = cg_fixed_range_str(t);
                return CGExpr { g: g, code: "({long long " + tn + " = -(long long)(" + inner.code + "); if (" + tn + " < " + tr[0] + " || " + tn + " > " + tr[1] + ") forge_fail(\"integer overflow\"); (" + cg_c_type(g, t) + ")(" + tn + ");})" };
            }
            return CGExpr { g: g, code: "({unsigned long long " + tn + " = (unsigned long long)(" + inner.code + "); if (" + tn + " != 0) forge_fail(\"integer overflow\"); (" + cg_c_type(g, t) + ")(0);})" };
        }
        let inner: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = inner.g;
        return CGExpr { g: g, code: "(" + e.name + inner.code + ")" };
    }
    if e.kind == 40 {
        return cg_gen_binop(g, e);
    }
    if e.kind == 38 {
        // RangeLit (codegen.py:3593): kids = [start, end].
        let sout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = sout.g;
        let eout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = eout.g;
        return CGExpr { g: g, code: "(ForgeRange){ .start = " + sout.code + ", .end = " + eout.code + " }" };
    }
    if e.kind == 32 {
        // FieldAccess (codegen.py:3693): name = field, kids = [base].
        // Struct-array fast path: base is an Index over an array of
        // structs -> direct (arr).data[idx].field. A pure repeat in
        // this statement takes the fast form (codegen.py:3712).
        if e.kids[0].kind == 36 {
            let idxnode: Node = e.kids[0];
            let arr_t: str = cg_expr_type(g, idxnode.kids[0]);
            let elem_t: str = cg_expr_type(g, idxnode);
            if cg_is_array_type(g, arr_t) && cg_is_struct_type(g, elem_t) {
                let aout: CGExpr = cg_gen_expr(g, idxnode.kids[0]);
                g = aout.g;
                let iout: CGExpr = cg_gen_expr(g, idxnode.kids[1]);
                g = iout.g;
                let fa_pure: bool = !cg_subtree_has_call(idxnode.kids[0]) && !cg_subtree_has_call(idxnode.kids[1]);
                let fa_key: str = cg_cache_key(["fa", aout.code, iout.code, e.name]);
                if fa_pure && cg_cache_has(g, fa_key) {
                    return CGExpr { g: g, code: "(" + aout.code + ").data[" + iout.code + "]." + e.name };
                }
                if fa_pure {
                    g = cg_cache_add(g, fa_key);
                }
                let n: int = g.arr_counter;
                g.arr_counter = g.arr_counter + 1;
                let ta: str = "__forge_fa" + itoa(n);
                let ti: str = "__forge_fi" + itoa(n);
                let at: str = cg_c_type(g, arr_t);
                let code: str = "({ " + at + " " + ta + " = " + aout.code + "; long long " + ti + " = " + iout.code + "; if (" + ti + " < 0 || " + ti + " >= " + ta + ".len) forge_fail(\"array index out of bounds\"); " + ta + ".data[" + ti + "]." + e.name + "; })";
                return CGExpr { g: g, code: code };
            }
        }
        let bout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = bout.g;
        return CGExpr { g: g, code: "(" + bout.code + ")." + e.name };
    }
    if e.kind == 36 {
        // Index (codegen.py:3752). A pure repeat of an identical
        // index read in one statement takes the fast/direct form
        // (codegen.py:3766-3808); the first one takes the checked
        // form and records the key.
        let base_t: str = cg_expr_type(g, e.kids[0]);
        let et: str = cg_expr_type(g, e);
        let bout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = bout.g;
        let iout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = iout.g;
        if base_t == "str" {
            let idx_pure: bool = !cg_subtree_has_call(e.kids[0]) && !cg_subtree_has_call(e.kids[1]);
            let key: str = cg_cache_key(["str", bout.code, iout.code]);
            if idx_pure && cg_cache_has(g, key) {
                return CGExpr { g: g, code: "forge_str_at_fast(" + bout.code + ", " + iout.code + ")" };
            }
            if idx_pure {
                g = cg_cache_add(g, key);
            }
            return CGExpr { g: g, code: "forge_str_at(" + bout.code + ", " + iout.code + ")" };
        }
        if cg_is_struct_type(g, et) {
            // Struct array element read: forge_<Struct>_get, or
            // the _get_fast form on a pure repeat in this statement.
            let sname: str = cg_struct_type_name(g, et);
            let idx_pure: bool = !cg_subtree_has_call(e.kids[0]) && !cg_subtree_has_call(e.kids[1]);
            let key: str = cg_cache_key(["arr", bout.code, iout.code]);
            if idx_pure && cg_cache_has(g, key) {
                return CGExpr { g: g, code: "forge_" + sname + "_get_fast(" + bout.code + ", " + iout.code + ")" };
            }
            if idx_pure {
                g = cg_cache_add(g, key);
            }
            return CGExpr { g: g, code: "forge_" + sname + "_get(" + bout.code + ", " + iout.code + ")" };
        }
        if cg_is_array_type(g, et) {
            let idx_pure: bool = !cg_subtree_has_call(e.kids[0]) && !cg_subtree_has_call(e.kids[1]);
            let key: str = cg_cache_key(["arr", bout.code, iout.code]);
            if idx_pure && cg_cache_has(g, key) {
                return CGExpr { g: g, code: "(" + bout.code + ").data[" + iout.code + "]" };
            }
            let arr_t: str = cg_c_type(g, base_t);
            let n: int = g.arr_counter;
            g.arr_counter = g.arr_counter + 1;
            let ta: str = "__forge_ia" + itoa(n);
            let ti: str = "__forge_ii" + itoa(n);
            if idx_pure {
                g = cg_cache_add(g, key);
            }
            let code: str = "({ " + arr_t + " " + ta + " = " + bout.code + "; long long " + ti + " = " + iout.code + "; if (" + ti + " < 0 || " + ti + " >= " + ta + ".len) forge_fail(\"array index out of bounds\"); " + ta + ".data[" + ti + "]; })";
            return CGExpr { g: g, code: code };
        }
        // Scalar element (codegen.py:3800): a pure repeat in this
        // statement reads the slot directly, no bounds check.
        let idx_pure2: bool = !cg_subtree_has_call(e.kids[0]) && !cg_subtree_has_call(e.kids[1]);
        let key2: str = cg_cache_key(["arr", bout.code, iout.code]);
        if idx_pure2 && cg_cache_has(g, key2) {
            return CGExpr { g: g, code: "(" + bout.code + ").data[" + iout.code + "]" };
        }
        if idx_pure2 {
            g = cg_cache_add(g, key2);
        }
        if et == "int" {
            return CGExpr { g: g, code: "forge_int_get(" + bout.code + ", " + iout.code + ")" };
        }
        if et == "float" {
            return CGExpr { g: g, code: "forge_float_get(" + bout.code + ", " + iout.code + ")" };
        }
        if et == "bool" {
            return CGExpr { g: g, code: "forge_bool_get(" + bout.code + ", " + iout.code + ")" };
        }
        if et == "str" {
            return CGExpr { g: g, code: "forge_str_get(" + bout.code + ", " + iout.code + ")" };
        }
        fail("unsupported index element type " + et);
        return CGExpr { g: g, code: "" };
    }
    if e.kind == 29 {
        // ArrayLit (codegen.py:3730): GNU statement expression
        // holding a malloc'd array struct.
        let t: str = cg_expr_type(g, e);
        if t == "[?]" || t == "int" {
            fail("array literal needs a known element type (annotate the variable or use non-empty literal)");
        }
        let et: str = infer_array_elem(t);
        let ct: str = cg_c_type(g, t);
        let dt: str = cg_c_type(g, et);
        let n: int = g.arr_counter;
        g.arr_counter = g.arr_counter + 1;
        let ta: str = "__forge_arr" + itoa(n);
        let num: int = len(e.kids);
        let mut body: str = ta + ".len = " + itoa(num) + "; " + ta + ".cap = " + itoa(num) + "; " + ta + ".ref = forge_arr_ref_new(); ";
        if num == 0 {
            body = body + ta + ".data = NULL; ";
        } else {
            body = body + ta + ".data = ( " + dt + " *)malloc(sizeof(" + dt + ") * " + itoa(num) + "); ";
        }
        let mut i: int = 0;
        while i < num {
            let child: Node = e.kids[i];
            let cout: CGExpr = cg_gen_expr(g, child);
            g = cout.g;
            let mut code: str = cout.code;
            if et == "str" {
                code = "forge_copy_str(" + code + ")";
            }
            body = body + ta + ".data[" + itoa(i) + "] = " + code + "; ";
            if cg_is_struct_type(g, et) && !cg_is_fresh_struct(g, child) {
                let own: str = cg_struct_own_code(g, ta + ".data[" + itoa(i) + "]", et);
                if own != "" {
                    body = body + own + " ";
                }
            } else if cg_is_array_type(g, et) && !cg_is_fresh_array(g, child) {
                body = body + "forge_arr_inc(" + ta + ".data[" + itoa(i) + "].ref); ";
            }
            i = i + 1;
        }
        body = body + ta;
        return CGExpr { g: g, code: "({" + ct + " " + ta + "; " + body + "; })" };
    }
    if e.kind == 30 {
        // TupleLit (codegen.py:3604): (CType){ parts }, each part
        // converted by its DECLARED element type.
        let t: str = cg_expr_type(g, e);
        let elems: [str] = tuple_elems(t);
        let mut parts: [str] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let child: Node = e.kids[i];
            let cout: CGExpr = cg_gen_expr(g, child);
            g = cout.g;
            let conv: CGExpr = cg_convert_owned(g, cout.code, cg_expr_type(g, child), elems[i], child, true);
            g = conv.g;
            push(parts, conv.code);
            i = i + 1;
        }
        return CGExpr { g: g, code: "(" + cg_c_type(g, t) + "){ " + join(parts, ", ") + " }" };
    }
    if e.kind == 31 {
        // StructLit (codegen.py:3652): (CType){ .f = code, ... }
        // in SOURCE order, each field converted by its DECLARED
        // field type (concrete for generic instantiations).
        let conc: str = cg_structlit_concrete(g, e);
        let enc: str = cg_struct_fields_concrete(g, conc);
        let mut parts: [str] = [];
        let mut i: int = 0;
        while i < len(e.kids) {
            let field: Node = e.kids[i];
            let fexpr: Node = field.kids[0];
            let cout: CGExpr = cg_gen_expr(g, fexpr);
            g = cout.g;
            let ft: str = infer_field_type(enc, field.name);
            let conv: CGExpr = cg_convert_owned(g, cout.code, cg_expr_type(g, fexpr), ft, fexpr, true);
            g = conv.g;
            push(parts, "." + field.name + " = " + conv.code);
            i = i + 1;
        }
        return CGExpr { g: g, code: "(" + cg_c_type(g, conc) + "){ " + join(parts, ", ") + " }" };
    }
    if e.kind == 37 {
        // TupleIndex (codegen.py:3691): kids = [base].
        let bout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = bout.g;
        return CGExpr { g: g, code: "(" + bout.code + ")._" + itoa(e.ival) };
    }
    if e.kind == 39 {
        // Cast (codegen.py:3794): target type in sval.
        let cout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = cout.g;
        let code: str = cout.code;
        let target: str = cg_subst(g, e.sval);
        let it: str = cg_expr_type(g, e.kids[0]);
        if is_union_type(target) {
            let cs: bool = it == "str" && !cg_is_fresh_str(g, e.kids[0]);
            return CGExpr { g: g, code: cg_union_wrap(code, it, target, cs, g) };
        }
        if target == "float" {
            return CGExpr { g: g, code: "(double)(" + code + ")" };
        }
        if cg_is_int_type(it) && cg_is_int_type(target) && it != target {
            return cg_int_cast_code(g, code, it, target);
        }
        if it == "float" && cg_is_int_type(target) {
            return cg_float_to_int_cast(g, code, target);
        }
        return CGExpr { g: g, code: "(long long)(" + code + ")" };
    }
    if e.kind == 42 {
        // Try (codegen.py:3821): kind from the infer table
        // (operand type Option[...] vs Result[...,...]),
        // ret_type from this function's declared return.
        let n: int = g.try_counter;
        g.try_counter = g.try_counter + 1;
        let inner: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = inner.g;
        let inner_t: str = cg_expr_type(g, e.kids[0]);
        let ret_t: str = g.current_ret;
        let c_inner: str = cg_c_type(g, inner_t);
        let c_ret: str = cg_c_type(g, ret_t);
        let temp: str = "__forge_try" + itoa(n);
        let mut early: str = "";
        if starts_with(inner_t, "Option<") {
            if ret_t == inner_t {
                early = "return " + temp + ";";
            } else {
                let mut y: str = "int";
                if infer_find_str(ret_t, "<") >= 0 {
                    let lt: int = infer_find_str(ret_t, "<");
                    let rt: int = cg_find_last(ret_t, ">");
                    y = substr(ret_t, lt + 1, rt - lt - 1);
                }
                let dummy: str = cg_try_dummy(y);
                if dummy == "" {
                    fail("? for Option with a non-scalar return value type is not supported yet");
                }
                early = "return (" + c_ret + "){ .present = false, .value = " + dummy + " };";
            }
            return CGExpr { g: g, code: "({ " + c_inner + " " + temp + " = " + inner.code + "; if (!" + temp + ".present) { " + early + " } " + temp + ".value; })" };
        }
        if starts_with(inner_t, "Result<") {
            if ret_t == inner_t {
                early = "return " + temp + ";";
            } else {
                let args: [str] = generic_args(ret_t);
                let mut y: str = "int";
                if len(args) > 0 {
                    y = args[0];
                }
                let mut et2: str = "str";
                if len(args) > 1 {
                    et2 = args[1];
                }
                let dummy: str = cg_try_dummy(y);
                if dummy == "" {
                    fail("? for Result with a non-scalar return value type is not supported yet");
                }
                let mut err_code: str = temp + ".error";
                if et2 == "str" {
                    err_code = "forge_copy_str(" + temp + ".error)";
                }
                early = "return (" + c_ret + "){ .ok = false, .value = " + dummy + ", .error = " + err_code + " };";
            }
            return CGExpr { g: g, code: "({ " + c_inner + " " + temp + " = " + inner.code + "; if (!" + temp + ".ok) { " + early + " } " + temp + ".value; })" };
        }
        fail("? expression was not checked as Option/Result");
        return CGExpr { g: g, code: "" };
    }
    if e.kind == 33 {
        return cg_gen_method_call(g, e);
    }
    if e.kind == 35 {
        return cg_gen_call(g, e);
    }
    fail("unsupported expression in 4a");
    return CGExpr { g: g, code: "" };
}

// Unsigned C type of the same width as a fixed int type
// (the << branch casts the left operand to it).
fn cg_fixed_unsigned_c_type(t: str) -> str {
    if t == "i8" || t == "u8" {
        return "uint8_t";
    }
    if t == "i16" || t == "u16" {
        return "uint16_t";
    }
    if t == "i32" || t == "u32" {
        return "uint32_t";
    }
    return "uint64_t";
}

// fixed_checked_binop (codegen.py:1287): safe-mode checked
// BinOp on a fixed-width integer type.
fn cg_fixed_checked_binop(g0: HCodegen, op: str, left_code: str, right_code: str, t: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let ct: str = cg_c_type(g, t);
    let is_signed: bool = t == "i8" || t == "i16" || t == "i32";
    if op == "+" || op == "-" || op == "*" {
        if t == "u64" {
            let mut builtin: str = "__builtin_add_overflow";
            if op == "-" {
                builtin = "__builtin_sub_overflow";
            }
            if op == "*" {
                builtin = "__builtin_mul_overflow";
            }
            let tmp: CGExpr = cg_fx_temp(g);
            g = tmp.g;
            let tn: str = tmp.code;
            return CGExpr { g: g, code: "({unsigned long long " + tn + "; if (" + builtin + "((unsigned long long)(" + left_code + "), (unsigned long long)(" + right_code + "), &" + tn + ")) forge_fail(\"integer overflow\"); " + tn + ";})" };
        }
        let mut w: str = "unsigned long long";
        if is_signed {
            w = "long long";
        }
        let tmp: CGExpr = cg_fx_temp(g);
        g = tmp.g;
        let tn: str = tmp.code;
        let tr: [str] = cg_fixed_range_str(t);
        return CGExpr { g: g, code: "({" + w + " " + tn + " = (" + w + ")(" + left_code + ") " + op + " (" + w + ")(" + right_code + "); if (" + tn + " < " + tr[0] + " || " + tn + " > " + tr[1] + ") forge_fail(\"integer overflow\"); (" + ct + ")(" + tn + ");})" };
    }
    if op == "/" {
        if is_signed {
            let dt: CGExpr = cg_fx_temp(g);
            g = dt.g;
            let nt: CGExpr = cg_fx_temp(g);
            g = nt.g;
            let tr: [str] = cg_fixed_range_str(t);
            return CGExpr { g: g, code: "({long long " + dt.code + " = (long long)(" + right_code + "); if (" + dt.code + " == 0) forge_fail(\"division by zero\"); long long " + nt.code + " = (long long)(" + left_code + "); if (" + nt.code + " == " + tr[0] + " && " + dt.code + " == -1) forge_fail(\"integer overflow\"); (" + ct + ")(" + nt.code + " / " + dt.code + ");})" };
        }
        let dt: CGExpr = cg_fx_temp(g);
        g = dt.g;
        return CGExpr { g: g, code: "({unsigned long long " + dt.code + " = (unsigned long long)(" + right_code + "); if (" + dt.code + " == 0) forge_fail(\"division by zero\"); (" + ct + ")((unsigned long long)(" + left_code + ") / " + dt.code + ");})" };
    }
    if op == "%" {
        let mut w: str = "unsigned long long";
        if is_signed {
            w = "long long";
        }
        let dt: CGExpr = cg_fx_temp(g);
        g = dt.g;
        return CGExpr { g: g, code: "({" + w + " " + dt.code + " = (" + w + ")(" + right_code + "); if (" + dt.code + " == 0) forge_fail(\"division by zero\"); (" + left_code + " % " + right_code + ");})" };
    }
    if op == "<<" || op == ">>" {
        let width: int = cg_fixed_width(t);
        let at: CGExpr = cg_fx_temp(g);
        g = at.g;
        let an: str = at.code;
        if op == "<<" {
            let uct: str = cg_fixed_unsigned_c_type(t);
            return CGExpr { g: g, code: "({long long " + an + " = (long long)(" + right_code + "); if (" + an + " < 0 || " + an + " >= " + itoa(width) + ") forge_fail(\"shift count out of range\"); (" + ct + ")((" + uct + ")(" + left_code + ") << " + an + ");})" };
        }
        return CGExpr { g: g, code: "({long long " + an + " = (long long)(" + right_code + "); if (" + an + " < 0 || " + an + " >= " + itoa(width) + ") forge_fail(\"shift count out of range\"); ((" + left_code + ") >> " + an + ");})" };
    }
    fail("no checked form for '" + op + "' on " + t);
    return CGExpr { g: g, code: "" };
}

// _str_index_cmp (codegen.py:2584): s[i] == "a" / s[i] == s[j]
// byte comparison with the safe-mode bounds check but no
// allocation. Returns code "" when the shape does not apply
// (the caller falls through to the generic strcmp path).
// The literal must be exactly 1 byte: Qasida len() counts
// characters, so a 1-char non-ASCII literal is misdetected
// (known 4c limitation; the corpus uses ASCII only).
fn cg_str_index_cmp(g0: HCodegen, e: Node) -> CGExpr {
    let mut g: HCodegen = g0;
    let left: Node = e.kids[0];
    let right: Node = e.kids[1];
    let mut op: str = "==";
    if e.name == "!=" {
        op = "!=";
    }
    let left_is_idx: bool = left.kind == 36 && cg_expr_type(g, left.kids[0]) == "str";
    let right_is_idx: bool = right.kind == 36 && cg_expr_type(g, right.kids[0]) == "str";
    let left_is_lit: bool = left.kind == 27 && len(left.sval) == 1;
    let right_is_lit: bool = right.kind == 27 && len(right.sval) == 1;
    let mut kind0: int = 0;
    let mut kind1: int = 0;
    let mut node0: Node = left;
    let mut node1: Node = right;
    if left_is_idx && right_is_lit {
        kind0 = 1;
        kind1 = 2;
        node0 = left;
        node1 = right;
    } else if left_is_lit && right_is_idx {
        kind0 = 2;
        kind1 = 1;
        node0 = left;
        node1 = right;
    } else if left_is_idx && right_is_idx {
        kind0 = 1;
        kind1 = 1;
        node0 = left;
        node1 = right;
    } else {
        return CGExpr { g: g, code: "" };
    }
    let n: int = g.arr_counter;
    g.arr_counter = g.arr_counter + 1;
    let mut decls: str = "";
    let mut cmp0: str = "";
    let mut cmp1: str = "";
    if kind0 == 2 {
        cmp0 = cg_c_str_literal(node0.sval, node0.has_nul) + "[0]";
    } else {
        let bout: CGExpr = cg_gen_expr(g, node0.kids[0]);
        g = bout.g;
        let iout: CGExpr = cg_gen_expr(g, node0.kids[1]);
        g = iout.g;
        let ts: str = "__forge_sc" + itoa(n) + "s0";
        let ti: str = "__forge_sc" + itoa(n) + "i0";
        let tn: str = "__forge_sc" + itoa(n) + "n0";
        decls = decls + "const char *" + ts + " = " + bout.code + "; long long " + ti + " = " + iout.code + "; ";
        decls = decls + "long long " + tn + " = (long long)strlen(" + ts + "); if (" + ti + " < 0 || " + ti + " >= " + tn + ") forge_fail(\"string index out of bounds\"); ";
        cmp0 = ts + "[" + ti + "]";
    }
    if kind1 == 2 {
        cmp1 = cg_c_str_literal(node1.sval, node1.has_nul) + "[0]";
    } else {
        let bout: CGExpr = cg_gen_expr(g, node1.kids[0]);
        g = bout.g;
        let iout: CGExpr = cg_gen_expr(g, node1.kids[1]);
        g = iout.g;
        let ts: str = "__forge_sc" + itoa(n) + "s1";
        let ti: str = "__forge_sc" + itoa(n) + "i1";
        let tn: str = "__forge_sc" + itoa(n) + "n1";
        decls = decls + "const char *" + ts + " = " + bout.code + "; long long " + ti + " = " + iout.code + "; ";
        decls = decls + "long long " + tn + " = (long long)strlen(" + ts + "); if (" + ti + " < 0 || " + ti + " >= " + tn + ") forge_fail(\"string index out of bounds\"); ";
        cmp1 = ts + "[" + ti + "]";
    }
    return CGExpr { g: g, code: "({ " + decls + "(" + cmp0 + " " + op + " " + cmp1 + "); })" };
}

// MethodCall (codegen.py:3970): range methods, opaque dispatch,
// struct static dispatch (via the ordinary Call path).
fn cg_gen_method_call(g0: HCodegen, e: Node) -> CGExpr {
    let mut g: HCodegen = g0;
    let struct_t: str = cg_expr_type(g, e.kids[0]);
    if struct_t == "range" {
        g.loop_counter = g.loop_counter + 1;
        let n: int = g.loop_counter;
        let recv: str = "__forge_rng" + itoa(n);
        let rout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = rout.g;
        if e.name == "start" {
            return CGExpr { g: g, code: "({ ForgeRange " + recv + " = " + rout.code + "; " + recv + ".start; })" };
        }
        if e.name == "end" {
            return CGExpr { g: g, code: "({ ForgeRange " + recv + " = " + rout.code + "; " + recv + ".end; })" };
        }
        if e.name == "contains" {
            let aout: CGExpr = cg_gen_expr(g, e.kids[1]);
            g = aout.g;
            return CGExpr { g: g, code: "({ ForgeRange " + recv + " = " + rout.code + "; long long __forge_x" + itoa(n) + " = " + aout.code + "; (" + recv + ".start <= __forge_x" + itoa(n) + " && __forge_x" + itoa(n) + " < " + recv + ".end); })" };
        }
        if e.name == "len" {
            return CGExpr { g: g, code: "({ ForgeRange " + recv + " = " + rout.code + "; long long __forge_l" + itoa(n) + " = 0; if (" + recv + ".end > " + recv + ".start) { unsigned long long __forge_d" + itoa(n) + " = (unsigned long long)" + recv + ".end - (unsigned long long)" + recv + ".start; if (__forge_d" + itoa(n) + " > 9223372036854775807ULL) forge_fail(\"integer overflow\"); __forge_l" + itoa(n) + " = (long long)__forge_d" + itoa(n) + "; } __forge_l" + itoa(n) + "; })" };
        }
        if e.name == "sum" {
            return CGExpr { g: g, code: "({ ForgeRange " + recv + " = " + rout.code + "; __int128 __forge_s" + itoa(n) + " = 0; if (" + recv + ".end > " + recv + ".start) { __int128 __forge_n" + itoa(n) + " = (__int128)((unsigned long long)" + recv + ".end - (unsigned long long)" + recv + ".start); __forge_s" + itoa(n) + " = __forge_n" + itoa(n) + " * ((__int128)" + recv + ".start + (__int128)" + recv + ".end - 1) / 2; if (__forge_s" + itoa(n) + " > 9223372036854775807 || __forge_s" + itoa(n) + " < (-9223372036854775807 - 1)) forge_fail(\"integer overflow\"); } (long long)__forge_s" + itoa(n) + "; })" };
        }
        fail("range has no method '" + e.name + "'");
        return CGExpr { g: g, code: "" };
    }
    if cg_is_opaque_type(struct_t) {
        let trait_name: str = cg_opaque_trait(struct_t);
        let sig: [str] = cg_trait_sig(g, trait_name, e.name);
        if sig[0] != "1" {
            fail("trait '" + trait_name + "' has no method '" + e.name + "'");
        }
        let ret: str = sig[1];
        let params: [str] = split(sig[2], "~");
        let mut arg_codes: [str] = [];
        let mut i: int = 0;
        while i < len(e.kids) - 1 {
            let a: Node = e.kids[i + 1];
            let aout: CGExpr = cg_gen_expr(g, a);
            g = aout.g;
            let mut code: str = aout.code;
            let mut pt: str = "";
            if i < len(params) {
                pt = params[i];
            }
            if pt == "str" && !cg_is_fresh_str(g, a) {
                code = "forge_copy_str(" + code + ")";
            } else if cg_is_array_type(g, pt) && !cg_is_fresh_array(g, a) {
                g.assign_counter = g.assign_counter + 1;
                let an: int = g.assign_counter;
                code = "({" + cg_c_type(g, pt) + " __forge_arg" + itoa(an) + " = " + code + "; forge_arr_inc(__forge_arg" + itoa(an) + ".ref); __forge_arg" + itoa(an) + ";})";
            } else if cg_is_struct_type(g, pt) && !cg_is_fresh_struct(g, a) {
                g.assign_counter = g.assign_counter + 1;
                let an: int = g.assign_counter;
                let own: str = cg_struct_own_code(g, "__forge_arg" + itoa(an), pt);
                code = "({" + cg_c_type(g, pt) + " __forge_arg" + itoa(an) + " = " + code + "; " + own + " __forge_arg" + itoa(an) + ";})";
            }
            push(arg_codes, code);
            i = i + 1;
        }
        g.loop_counter = g.loop_counter + 1;
        let n: int = g.loop_counter;
        let recv: str = "__forge_recv" + itoa(n);
        let cname: str = cg_opaque_c_name(struct_t);
        let bout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = bout.g;
        let impls: [str] = cg_impls_for_trait(g, trait_name);
        let mut parts: [str] = [];
        push(parts, "({" + cname + " " + recv + " = " + bout.code + ";");
        if ret != "void" {
            push(parts, cg_c_type(g, ret) + " __forge_mret" + itoa(n) + ";");
        }
        push(parts, "switch (" + recv + ".tag) {");
        let mut j: int = 0;
        while j < len(impls) {
            let st: str = impls[j];
            let mangled: str = infer_mangle_method(st, e.name);
            let own: str = cg_struct_own_code(g, "__forge_mrecv" + itoa(n) + "_" + itoa(j), st);
            let mut recv_code: str = recv + ".payload._" + itoa(j);
            if own != "" {
                recv_code = "({" + cg_c_type(g, st) + " __forge_mrecv" + itoa(n) + "_" + itoa(j) + " = " + recv + ".payload._" + itoa(j) + "; " + own + " __forge_mrecv" + itoa(n) + "_" + itoa(j) + ";})";
            }
            let mut call: str = mangled + "(" + recv_code;
            if len(arg_codes) > 0 {
                call = call + ", " + join(arg_codes, ", ");
            }
            call = call + ")";
            push(parts, "case " + itoa(j) + ": {");
            if ret != "void" {
                push(parts, "__forge_mret" + itoa(n) + " = " + call + ";");
            } else {
                push(parts, call + ";");
            }
            push(parts, "break; }");
            j = j + 1;
        }
        push(parts, "}");
        if ret != "void" {
            push(parts, "__forge_mret" + itoa(n) + ";");
        }
        push(parts, "})");
        return CGExpr { g: g, code: join(parts, " ") };
    }
    if !cg_is_struct_type(g, struct_t) {
        fail("trait method call needs a struct receiver, got " + struct_t);
    }
    let mangled: str = infer_mangle_method(struct_t, e.name);
    let found: [str] = cg_fn_lookup(g, mangled);
    if found[0] != "1" {
        fail("struct '" + struct_t + "' has no method '" + e.name + "'");
    }
    let mut call: Node = new_node(35, e.line, e.col);
    call.name = mangled;
    let mut kids: [Node] = [];
    push(kids, e.kids[0]);
    let mut j: int = 0;
    while j < len(e.kids) - 1 {
        push(kids, e.kids[j + 1]);
        j = j + 1;
    }
    call.kids = kids;
    return cg_gen_call(g, call);
}

// cg_binop_combine: the per-node combination step of
// cg_gen_binop, factored out so a flattened left spine can apply
// it once per spine node with already-generated operand code.
// Byte-identical to the old inline code: same lt/rt derivation
// from e.kids, same cg_binop_safe call on the actual kid NODES,
// same _check_cache keys (built from op + left/right code
// strings), same fixed-checked binop (fx temps allocated in the
// same innermost-first order). The str-index special case is NOT
// here: it generates the kids itself, so the spine driver in
// cg_gen_binop handles it for the innermost node only.
fn cg_binop_combine(g0: HCodegen, e: Node, left: str, right: str) -> CGExpr {
    let mut g: HCodegen = g0;
    let lt: str = cg_expr_type(g, e.kids[0]);
    let rt: str = cg_expr_type(g, e.kids[1]);
    if e.name == "+" && lt == "str" {
        return CGExpr { g: g, code: "forge_concat(" + left + ", " + right + ")" };
    }
    if e.name == "==" && lt == "str" {
        return CGExpr { g: g, code: "(strcmp(" + left + ", " + right + ") == 0)" };
    }
    if e.name == "!=" && lt == "str" {
        return CGExpr { g: g, code: "(strcmp(" + left + ", " + right + ") != 0)" };
    }
    if lt == "int" && rt == "int" {
        if e.name == "+" || e.name == "-" || e.name == "*" || e.name == "/" || e.name == "%" {
            // Check elimination (codegen.py:3900): provably safe ->
            // plain; a pure repeat of an identical checked op in
            // this statement -> plain (dedup via _check_cache).
            if cg_binop_safe(g, e.name, e.kids[0], e.kids[1]) {
                return CGExpr { g: g, code: "(" + left + " " + e.name + " " + right + ")" };
            }
            let pure: bool = !cg_subtree_has_call(e.kids[0]) && !cg_subtree_has_call(e.kids[1]);
            let key: str = cg_cache_key(["bin", e.name, left, right]);
            if pure && cg_cache_has(g, key) {
                return CGExpr { g: g, code: "(" + left + " " + e.name + " " + right + ")" };
            }
            if pure {
                g = cg_cache_add(g, key);
            }
            if e.name == "+" {
                return CGExpr { g: g, code: "forge_add(" + left + ", " + right + ")" };
            }
            if e.name == "-" {
                return CGExpr { g: g, code: "forge_sub(" + left + ", " + right + ")" };
            }
            if e.name == "*" {
                return CGExpr { g: g, code: "forge_mul(" + left + ", " + right + ")" };
            }
            if e.name == "/" {
                return CGExpr { g: g, code: "forge_div(" + left + ", " + right + ")" };
            }
            return CGExpr { g: g, code: "forge_mod(" + left + ", " + right + ")" };
        }
        if e.name == "<<" {
            return CGExpr { g: g, code: "((int64_t)((uint64_t)(" + left + ") << ((uint64_t)(" + right + ") & 63)))" };
        }
        if e.name == ">>" {
            return CGExpr { g: g, code: "((" + left + ") >> ((" + right + ") & 63))" };
        }
    }
    let mut ft: str = "";
    if cg_is_fixed_int(lt) {
        ft = lt;
    } else if cg_is_fixed_int(rt) {
        ft = rt;
    }
    if ft != "" {
        if e.name == "+" || e.name == "-" || e.name == "*" || e.name == "/" || e.name == "%" || e.name == "<<" || e.name == ">>" {
            return cg_fixed_checked_binop(g, e.name, left, right, ft);
        }
    }
    return CGExpr { g: g, code: "(" + left + " " + e.name + " " + right + ")" };
}

// BinOp (codegen.py:3879): str +/==/!=, int checked arithmetic
// (4f: eliminated when _binop_safe proves it, else the checked
// helper, with the per-statement _check_cache dedup), shifts,
// then the plain fall-through. The str-index comparison
// (_str_index_cmp, s[i] == "x") is deferred: no Index in 4a.
//
// BOOTSTRAP FIX (11 Nov 2026): a left-deep spine of the same
// operator (e.g. a 27-term || chain) used to recurse cg_gen_binop
// <-> cg_gen_expr ~2 frames per level with multi-KB HCodegen /
// CGExpr structs by value, exhausting the 8MB C stack at ~24
// levels (ASan: stack-overflow in cg_gen_binop). The spine is now
// walked iteratively and folded innermost-first; recursion depth
// is bounded by operand depth, not chain length. Spine length 1
// takes the exact old path below.
fn cg_gen_binop(g0: HCodegen, e: Node) -> CGExpr {
    let mut g: HCodegen = g0;
    let mut spine: [Node] = [];
    let mut cur: Node = e;
    while cur.kind == 40 && cur.name == e.name {
        push(spine, cur);
        cur = cur.kids[0];
    }
    if len(spine) == 1 {
        // No chain: the exact old path, unchanged.
        // _str_index_cmp is tried BEFORE the sides are generated
        // (it generates them itself, once each, into temps).
        if (e.name == "==" || e.name == "!=") && cg_expr_type(g, e.kids[0]) == "str" {
            let spec: CGExpr = cg_str_index_cmp(g, e);
            g = spec.g;
            if spec.code != "" {
                return spec;
            }
        }
        let lout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = lout.g;
        let rout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = rout.g;
        return cg_binop_combine(g, e, lout.code, rout.code);
    }
    // Chain: innermost spine node first. Only it can take the
    // str-index path (every higher spine node's left kid is a
    // BinOp, never an Index or a literal, so _str_index_cmp
    // returns "" there — exactly as the recursion would find).
    let inner: Node = spine[len(spine) - 1];
    let mut acc: str = "";
    if (inner.name == "==" || inner.name == "!=") && cg_expr_type(g, inner.kids[0]) == "str" {
        let spec: CGExpr = cg_str_index_cmp(g, inner);
        g = spec.g;
        if spec.code != "" {
            acc = spec.code;
        }
    }
    if acc == "" {
        let lout: CGExpr = cg_gen_expr(g, inner.kids[0]);
        g = lout.g;
        let rout: CGExpr = cg_gen_expr(g, inner.kids[1]);
        g = rout.g;
        let comb: CGExpr = cg_binop_combine(g, inner, lout.code, rout.code);
        g = comb.g;
        acc = comb.code;
    }
    // Fold the remaining spine nodes innermost-first:
    // spine[len-2] is the next node out, spine[0] the top.
    // Each step generates only the right operand (shallow) and
    // combines it with the accumulated left code, so the fold
    // reproduces Python's nested parens "((a op b) op c)"
    // byte-identically, with the same per-node check-elimination
    // and _check_cache order as the recursion.
    let mut i: int = len(spine) - 2;
    while i >= 0 {
        let node: Node = spine[i];
        let rout: CGExpr = cg_gen_expr(g, node.kids[1]);
        g = rout.g;
        let comb: CGExpr = cg_binop_combine(g, node, acc, rout.code);
        g = comb.g;
        acc = comb.code;
        i = i - 1;
    }
    return CGExpr { g: g, code: acc };
}

// Call (codegen.py:4063): builtins in Python order, then enum
// variant construction, then user-function calls with per-arg
// conversion by DECLARED param type. print/println reaching
// gen_expr fall through to the plain name(args) form, exactly
// as in Python (gen_print is only called from gen_stmt).
fn cg_gen_call(g0: HCodegen, e: Node) -> CGExpr {
    let mut g: HCodegen = g0;
    // A call may mutate shared state, so it ends any
    // duplicate-check run inside this expression (codegen.py:4073).
    g = cg_cache_clear(g);
    if e.name == "len" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        if cg_expr_type(g, e.kids[0]) == "str" {
            return CGExpr { g: g, code: "strlen(" + aout.code + ")" };
        }
        return CGExpr { g: g, code: "(" + aout.code + ").len" };
    }
    if e.name == "range" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_range(" + aout.code + ")" };
    }
    if e.name == "clock_micros" {
        return CGExpr { g: g, code: "forge_clock_micros()" };
    }
    if e.name == "sqrt" || e.name == "exp" || e.name == "log" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: e.name + "(" + aout.code + ")" };
    }
    if e.name == "pow" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "pow(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "abs" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "llabs(" + aout.code + ")" };
    }
    if e.name == "wrapping_add" || e.name == "wrapping_sub" || e.name == "wrapping_mul" {
        let mut op: str = "+";
        if e.name == "wrapping_sub" {
            op = "-";
        }
        if e.name == "wrapping_mul" {
            op = "*";
        }
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "((long long)((unsigned long long)(" + aout.code + ") " + op + " (unsigned long long)(" + bout.code + ")))" };
    }
    if e.name == "wrapping_neg" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "((long long)(0ULL - (unsigned long long)(" + aout.code + ")))" };
    }
    if e.name == "file_exists" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_file_exists(" + aout.code + ")" };
    }
    if e.name == "read_file" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_read_file(" + aout.code + ")" };
    }
    if e.name == "read_line" {
        return CGExpr { g: g, code: "forge_read_line()" };
    }
    if e.name == "peek32" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_peek32(" + aout.code + ")" };
    }
    if e.name == "poke32" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_poke32(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "csr_read" || e.name == "csr_write" || e.name == "csr_set" || e.name == "csr_clear" || e.name == "ecall" || e.name == "ecall3" {
        fail(e.name + "() needs RISC-V CSRs/ecall (big32 target only)");
