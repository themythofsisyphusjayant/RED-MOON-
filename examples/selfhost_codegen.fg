    }
    if e.name == "trim" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_trim(" + aout.code + ")" };
    }
    if e.name == "starts_with" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_starts_with(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "ends_with" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_ends_with(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "http_get" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_http_get(" + aout.code + ")" };
    }
    if e.name == "http_listen" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_http_listen(" + aout.code + ")" };
    }
    if e.name == "http_accept" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_http_accept(" + aout.code + ")" };
    }
    if e.name == "http_read_request" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "forge_http_read_request(" + aout.code + ")" };
    }
    if e.name == "http_respond" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        return CGExpr { g: g, code: "forge_http_respond(" + aout.code + ", " + bout.code + ")" };
    }
    if e.name == "http_respond_status" {
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        let bout: CGExpr = cg_gen_expr(g, e.kids[1]);
        g = bout.g;
        let cout: CGExpr = cg_gen_expr(g, e.kids[2]);
        g = cout.g;
        return CGExpr { g: g, code: "forge_http_respond_status(" + aout.code + ", " + bout.code + ", " + cout.code + ")" };
    }
