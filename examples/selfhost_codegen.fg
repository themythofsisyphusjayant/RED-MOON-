    }
    if e.name == "alloc_count" {
        return CGExpr { g: g, code: "forge_str_allocs" };
    }
    if e.name == "free_count" {
        return CGExpr { g: g, code: "forge_str_frees" };
    }
    if e.name == "arr_alloc_count" {
        return CGExpr { g: g, code: "forge_arr_allocs" };
    }
    if e.name == "arr_free_count" {
        return CGExpr { g: g, code: "forge_arr_frees" };
    }
    if e.name == "refcount" {
        g.assign_counter = g.assign_counter + 1;
        let n: int = g.assign_counter;
        let at: str = cg_expr_type(g, e.kids[0]);
        let aout: CGExpr = cg_gen_expr(g, e.kids[0]);
        g = aout.g;
        return CGExpr { g: g, code: "({" + cg_c_type(g, at) + " __forge_arg" + itoa(n) + " = " + aout.code + "; __forge_arg" + itoa(n) + ".ref ? *__forge_arg" + itoa(n) + ".ref : 0;})" };
    }
    if e.name == "move" {
        let arg: Node = e.kids[0];
        if arg.kind == 32 {
            let path: str = cg_field_path(arg);
            if path != "" {
