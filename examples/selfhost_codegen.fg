    // User-function call: per-arg conversion by DECLARED param type.
    // A generic template call resolves to its mangled instantiation
    // (4d; discovered by the collect pre-pass) with substituted
    // param types for conversion.
    let mut call_name: str = e.name;
    let found: [str] = cg_fn_lookup(g, e.name);
    let mut params: [str] = infer_parse_params(found[2]);
    let tf: [str] = cg_template_lookup(g, e.name);
    if tf[0] == "1" {
        let b: CGBind = cg_generic_bindings(g, tf, e.name, e);
        if !b.ok {
            fail("could not infer type parameter(s) for '" + e.name + "'");
        }
        let reg: [str] = cg_inst_lookup(g, b.mangled);
        if reg[0] == "0" {
            fail("generic instantiation '" + b.mangled + "' was not discovered in the collect pass");
        }
        call_name = b.mangled;
        let raw_params: [str] = infer_parse_params(tf[2]);
        let mut sub_params: [str] = [];
        let mut pi: int = 0;
        while pi < len(raw_params) {
            let kv: [str] = infer_split_param(raw_params[pi]);
            if len(kv) >= 2 {
                push(sub_params, kv[0] + ":" + substitute_type(kv[1], b.names, b.types));
            } else {
                push(sub_params, raw_params[pi]);
            }
            pi = pi + 1;
        }
        params = sub_params;
    }
    let mut arg_codes: [str] = [];
    let mut i: int = 0;
    while i < len(e.kids) {
        let a: Node = e.kids[i];
        let aout: CGExpr = cg_gen_expr(g, a);
        g = aout.g;
        let mut code: str = aout.code;
        if i < len(params) {
            let kv: [str] = infer_split_param(params[i]);
            if len(kv) >= 2 {
                let pt: str = kv[1];
                let conv: CGExpr = cg_convert_owned(g, code, cg_expr_type(g, a), pt, a, false);
                g = conv.g;
                code = conv.code;
            }
        }
        push(arg_codes, code);
        i = i + 1;
    }
    return CGExpr { g: g, code: call_name + "(" + join(arg_codes, ", ") + ")" };
}

// gen_print (codegen.py:3530): one printf per arg, a printf(" ")
// between args, printf("\n") at the end iff println.
fn cg_gen_print(g0: HCodegen, call: Node) -> HCodegen {
    let mut g: HCodegen = g0;
    let newline: bool = call.name == "println";
    let mut idx: int = 0;
    while idx < len(call.kids) {
        let arg: Node = call.kids[idx];
        let t: str = cg_expr_type(g, arg);
        let aout: CGExpr = cg_gen_expr(g, arg);
        g = aout.g;
        let code: str = aout.code;
        if t == "int" {
            g = cg_emit(g, "printf(\"%lld\", " + code + ");");
        } else if t == "i8" || t == "i16" || t == "i32" {
            g = cg_emit(g, "printf(\"%lld\", (long long)(" + code + "));");
        } else if t == "u8" || t == "u16" || t == "u32" || t == "u64" {
            g = cg_emit(g, "printf(\"%llu\", (unsigned long long)(" + code + "));");
        } else if t == "float" {
            g = cg_emit(g, "printf(\"%.6g\", " + code + ");");
        } else if t == "bool" {
            g = cg_emit(g, "printf(\"%s\", " + code + " ? \"true\" : \"false\");");
        } else if t == "str" {
            g = cg_emit(g, "printf(\"%s\", " + code + ");");
        } else {
            fail("cannot print a value of type " + t);
        }
        if idx < len(call.kids) - 1 {
            g = cg_emit(g, "printf(\" \");");
        }
        idx = idx + 1;
    }
    if newline {
        g = cg_emit(g, "printf(\"\\n\");");
    }
    return g;
}

// ---- gen_stmt ----

// Let type rule (codegen.py:2712): the annotation wins only when
// it is opaque/union, the init is never, or the init is an empty
// array literal; otherwise the init's inferred type.
fn cg_let_type(g: HCodegen, st: Node) -> str {
    let init: Node = st.kids[0];
    if st.sval != "" && (cg_is_opaque_type(st.sval) || is_union_type(st.sval) || cg_expr_type(g, init) == "never" || (init.kind == 29 && len(init.kids) == 0)) {
        return cg_subst(g, st.sval);
    }
    return cg_expr_type(g, init);
}

// gen_arm_block (codegen.py:2684): a match arm's block gets its own
// defer frame (run at arm exit); arms have no owned frame of their own.
fn cg_gen_arm_block(g0: HCodegen, body: Node, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    g = cg_push_defer_frame(g);
    g.branch_depth = g.branch_depth + 1;
    g = cg_gen_block(g, body, ret_type);
    g = cg_emit_defer_frame(g, len(g.defer_frame_starts) - 1, ret_type);
    g = cg_pop_defer_frame(g);
    g.branch_depth = g.branch_depth - 1;
    return g;
}

// Match (codegen.py:3027): three shapes — union, non-payload enum,
// payload enum. Exhaustiveness is the checker's job.
fn cg_gen_match(g0: HCodegen, st: Node, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let et: str = cg_expr_type(g, st.kids[0]);
    if is_union_type(et) {
        let members: [str] = union_members(et);
        let n: int = g.loop_counter;
        g.loop_counter = g.loop_counter + 1;
        let temp: str = "__forge_match" + itoa(n);
        let sout: CGExpr = cg_gen_expr(g, st.kids[0]);
        g = sout.g;
        g = cg_emit(g, "{");
        g.indent = g.indent + 1;
        g = cg_emit(g, cg_c_type(g, et) + " " + temp + " = " + sout.code + ";");
        let match_pre: FactSnap = cg_facts_snap(g);
        let mut a: int = 1;
        while a < len(st.kids) {
            let arm: Node = st.kids[a];
            g = cg_facts_restore(g, match_pre);
            if arm.name == "_" {
                if a == 1 {
                    g = cg_emit(g, "{");
                } else {
                    g = cg_emit(g, "} else {");
                }
                g.indent = g.indent + 1;
                g = cg_gen_arm_block(g, arm.kids[0], ret_type);
                g.indent = g.indent - 1;
                g = cg_emit(g, "}");
            } else {
                let mut midx: int = -1;
                let mut mi: int = 0;
                while mi < len(members) {
                    if members[mi] == arm.name {
                        midx = mi;
                    }
                    mi = mi + 1;
                }
                let mut kw: str = "if";
                if a != 1 {
                    kw = "} else if";
                }
                g = cg_emit(g, kw + " (" + temp + ".tag == " + itoa(midx) + ") {");
                g.indent = g.indent + 1;
                let mut payload_code: str = temp + ".payload._" + itoa(midx);
                if arm.name == "str" {
                    payload_code = "forge_copy_str(" + payload_code + ")";
                }
                g = cg_emit(g, cg_c_type(g, arm.name) + " " + arm.sval + " = " + payload_code + ";");
                if arm.name == "str" || cg_is_array_type(g, arm.name) || cg_is_struct_type(g, arm.name) || infer_is_tuple_type(arm.name) || is_union_type(arm.name) || cg_is_opaque_type(arm.name) {
                    g = cg_emit(g, "int " + cg_moved_flag(arm.sval) + " = 0;");
                }
                g = cg_facts_pop(g, arm.sval);
                g = cg_gen_arm_block(g, arm.kids[0], ret_type);
                g.indent = g.indent - 1;
                if a == len(st.kids) - 1 {
                    g = cg_emit(g, "}");
                }
            }
            a = a + 1;
        }
        g.indent = g.indent - 1;
        g = cg_emit(g, "}");
        g = cg_facts_clear(g);
        return g;
    }
    // Enum: payload or not, from the concrete variant info.
    let variants: str = cg_enum_concrete_variants(g, et);
    let parts: [str] = split(variants, "~");
    let mut is_payload: bool = false;
    let mut j: int = 0;
    while j < len(parts) {
        let kv: [str] = split(parts[j], ":");
        if len(kv) >= 2 && kv[1] != "" {
            is_payload = true;
        }
        j = j + 1;
    }
    if !is_payload {
        let tout: CGExpr = cg_gen_expr(g, st.kids[0]);
        g = tout.g;
        let target: str = tout.code;
        let match_pre: FactSnap = cg_facts_snap(g);
        let mut a: int = 1;
        while a < len(st.kids) {
            let arm: Node = st.kids[a];
            g = cg_facts_restore(g, match_pre);
            if arm.name == "_" {
                if a == 1 {
                    g = cg_emit(g, "{");
                } else {
                    g = cg_emit(g, "} else {");
                }
                g.indent = g.indent + 1;
                g = cg_gen_arm_block(g, arm.kids[0], ret_type);
                g.indent = g.indent - 1;
                g = cg_emit(g, "}");
            } else {
                let mut kw: str = "if";
                if a != 1 {
                    kw = "} else if";
                }
                g = cg_emit(g, kw + " (" + target + " == " + arm.name + ") {");
                g.indent = g.indent + 1;
                g = cg_gen_arm_block(g, arm.kids[0], ret_type);
                g.indent = g.indent - 1;
                if a == len(st.kids) - 1 {
                    g = cg_emit(g, "}");
                }
            }
            a = a + 1;
        }
        g = cg_facts_clear(g);
        return g;
    }
    // Payload enum: evaluate once into a temp, match on .tag, bind
    // the payload into a local for arms that bind it.
    let n: int = g.loop_counter;
    g.loop_counter = g.loop_counter + 1;
    let temp: str = "__forge_match" + itoa(n);
    let sout: CGExpr = cg_gen_expr(g, st.kids[0]);
    g = sout.g;
    g = cg_emit(g, "{");
    g.indent = g.indent + 1;
    g = cg_emit(g, cg_c_type(g, et) + " " + temp + " = " + sout.code + ";");
    let match_pre: FactSnap = cg_facts_snap(g);
    let mut a: int = 1;
    while a < len(st.kids) {
        let arm: Node = st.kids[a];
        g = cg_facts_restore(g, match_pre);
        if arm.name == "_" {
            if a == 1 {
                g = cg_emit(g, "{");
            } else {
                g = cg_emit(g, "} else {");
            }
            g.indent = g.indent + 1;
            g = cg_gen_arm_block(g, arm.kids[0], ret_type);
            g.indent = g.indent - 1;
            g = cg_emit(g, "}");
        } else {
            let mut tag: int = -1;
            let mut pt: str = "";
            let mut k: int = 0;
            while k < len(parts) {
                let kv: [str] = split(parts[k], ":");
                if len(kv) >= 2 && kv[0] == arm.name {
                    tag = k;
                    pt = kv[1];
                }
                k = k + 1;
            }
            let mut kw: str = "if";
            if a != 1 {
                kw = "} else if";
            }
            g = cg_emit(g, kw + " (" + temp + ".tag == " + itoa(tag) + ") {");
            g.indent = g.indent + 1;
            if arm.sval != "" {
                let mut payload_code: str = temp + ".payload.payload_" + arm.name;
                if pt == "str" {
                    payload_code = "forge_copy_str(" + payload_code + ")";
                }
                g = cg_emit(g, cg_c_type(g, pt) + " " + arm.sval + " = " + payload_code + ";");
                if pt == "str" || cg_is_array_type(g, pt) || cg_is_struct_type(g, pt) || infer_is_tuple_type(pt) || is_union_type(pt) || cg_is_opaque_type(pt) {
                    g = cg_emit(g, "int " + cg_moved_flag(arm.sval) + " = 0;");
                }
                g = cg_facts_pop(g, arm.sval);
            }
            g = cg_gen_arm_block(g, arm.kids[0], ret_type);
            g.indent = g.indent - 1;
            if a == len(st.kids) - 1 {
                g = cg_emit(g, "}");
            }
        }
        a = a + 1;
    }
    g.indent = g.indent - 1;
    g = cg_emit(g, "}");
    g = cg_facts_clear(g);
    return g;
}

// Spawn (codegen.py:3155): allocate the single-arg box when the call
// has an argument, create the thread under the pre-emitted wrapper,
// and record it for the join at function return / main exit.
fn cg_gen_spawn(g0: HCodegen, st: Node, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let call: Node = st.kids[0];
    let mut spawn_name: str = call.name;
    let tf: [str] = cg_template_lookup(g, spawn_name);
    if tf[0] == "1" {
        let b: CGBind = cg_generic_bindings(g, tf, spawn_name, call);
        if !b.ok {
            fail("could not infer type parameter(s) for spawned '" + spawn_name + "'");
        }
        let reg: [str] = cg_inst_lookup(g, b.mangled);
        if reg[0] == "0" {
            fail("generic instantiation '" + b.mangled + "' was not discovered in the collect pass");
        }
        spawn_name = b.mangled;
    }
    let n: int = g.spawn_counter;
    g.spawn_counter = g.spawn_counter + 1;
    g = cg_emit(g, "{");
    g.indent = g.indent + 1;
    let mut arg: str = "NULL";
    if len(call.kids) > 0 {
        let aout: CGExpr = cg_gen_expr(g, call.kids[0]);
        g = aout.g;
        g = cg_emit(g, "long long *__forge_spawn_arg" + itoa(n) + " = (long long *)malloc(sizeof(long long));");
        g = cg_emit(g, "*__forge_spawn_arg" + itoa(n) + " = " + aout.code + ";");
        arg = "__forge_spawn_arg" + itoa(n);
    }
    g = cg_emit(g, "pthread_t __forge_t" + itoa(n) + ";");
    g = cg_emit(g, "pthread_create(&__forge_t" + itoa(n) + ", NULL, forge_thread_" + spawn_name + ", " + arg + ");");
    g = cg_emit(g, "forge_threads[forge_thread_count++] = __forge_t" + itoa(n) + ";");
    g.indent = g.indent - 1;
    g = cg_emit(g, "}");
    return g;
}

fn cg_gen_stmt(g0: HCodegen, st: Node, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    // Duplicate checks live within one statement only: every
    // statement starts with an empty cache (codegen.py:2702).
    g = cg_cache_clear(g);
    if st.kind == 9 {
        // Block (codegen.py:2697): braces + its own owned/defer
        // frames; defers run before frees at exit. Facts restore
        // to the pre-block facts before the defers run.
        let saved_facts: FactSnap = cg_facts_snap(g);
        g = cg_emit(g, "{");
        g.indent = g.indent + 1;
        g = cg_push_owned_frame(g);
        g = cg_push_defer_frame(g);
        g = cg_gen_block(g, st, ret_type);
        g = cg_facts_restore(g, saved_facts);
        g = cg_emit_defer_frame(g, len(g.defer_frame_starts) - 1, ret_type);
        g = cg_pop_defer_frame(g);
        g = cg_emit_free_frame(g);
        g = cg_pop_owned_frame(g);
        g.indent = g.indent - 1;
        g = cg_emit(g, "}");
        return g;
    }
    if st.kind == 11 {
        // Assign (codegen.py:2786). Temp-first for owned types;
        // the counter is read-then-incremented (__forge_assign0...).
        let rhs: Node = st.kids[0];
        let eout: CGExpr = cg_gen_expr(g, rhs);
        g = eout.g;
        g = cg_facts_update_from_rhs(g, st.name, rhs, false);
        let mut expr: str = eout.code;
        let et: str = cg_expr_type(g, rhs);
        let vt: str = cg_owned_type(g, st.name);
        if et == "never" {
            let mut expected: str = cg_local_type(g, st.name);
            if expected == "" {
                expected = vt;
            }
            if expected != "" {
                expr = cg_never_wrap(expr, expected, g);
            }
        }
        if vt != "" && cg_is_opaque_type(vt) {
            // Evaluate into a temp first (the new value may
            // reference the old one), then free the old value
            // and take the converted temp.
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            let temp: str = "__forge_assign" + itoa(n);
            let conv: CGExpr = cg_opaque_convert(g, expr, et, vt, rhs);
            g = conv.g;
            g = cg_emit(g, cg_c_type(g, vt) + " " + temp + " = " + conv.code + ";");
            if cg_owned_contains(g, st.name) {
                g = cg_emit_guarded(g, st.name, "forge_free_" + cg_opaque_c_name(vt) + "(" + st.name + ");");
            }
            g = cg_emit(g, st.name + " = " + temp + ";");
            g = cg_owned_add(g, st.name, vt);
            g = cg_emit(g, cg_moved_flag(st.name) + " = 0;");
        } else if vt != "" && is_union_type(vt) {
            // Evaluate into a temp first, copy the temp's str
            // payload before freeing the old value, then take
            // the temp. A member value wraps into the union,
            // copying a shared str payload on the way in.
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            let temp: str = "__forge_assign" + itoa(n);
            let mut e2: str = expr;
            if cg_str_in(et, union_members(vt)) {
                let cs: bool = et == "str" && !cg_is_fresh_str(g, rhs);
                e2 = cg_union_wrap(expr, et, vt, cs, g);
            }
            g = cg_emit(g, cg_c_type(g, vt) + " " + temp + " = " + e2 + ";");
            if et == vt && !cg_is_fresh_union(g, rhs) {
                let copy: str = cg_union_copy_stmt(temp, vt);
                if copy != "" {
                    g = cg_emit(g, copy);
                }
            }
            if cg_owned_contains(g, st.name) {
                g = cg_emit_guarded(g, st.name, cg_union_free_code(st.name, vt));
            }
            g = cg_emit(g, st.name + " = " + temp + ";");
            g = cg_owned_add(g, st.name, vt);
            g = cg_emit(g, cg_moved_flag(st.name) + " = 0;");
        } else if et == "str" {
            if !cg_is_fresh_str(g, rhs) {
                expr = "forge_copy_str(" + expr + ")";
            }
            let n: int = g.assign_counter;
            g.assign_counter = g.assign_counter + 1;
            g = cg_emit(g, "char * __forge_assign" + itoa(n) + " = " + expr + ";");
            if cg_owned_contains(g, st.name) {
                g = cg_emit_guarded(g, st.name, "forge_free_str(" + st.name + ");");
            }
            g = cg_emit(g, st.name + " = __forge_assign" + itoa(n) + ";");
            g = cg_owned_add(g, st.name, "str");
            g = cg_emit(g, cg_moved_flag(st.name) + " = 0;");
        } else if cg_is_array_type(g, et) {
            let n: int = g.assign_counter;
            g.assign_counter = g.assign_counter + 1;
            g = cg_emit(g, cg_c_type(g, et) + " __forge_assign" + itoa(n) + " = " + expr + ";");
            if cg_owned_contains(g, st.name) {
                let fc: CGExpr = cg_array_free_code(g, st.name, et);
                g = fc.g;
                g = cg_emit_guarded(g, st.name, fc.code);
            }
            g = cg_emit(g, st.name + " = __forge_assign" + itoa(n) + ";");
            if !cg_is_fresh_array(g, rhs) {
                g = cg_emit(g, "forge_arr_inc(" + st.name + ".ref);");
            }
            g = cg_owned_add(g, st.name, et);
            g = cg_emit(g, cg_moved_flag(st.name) + " = 0;");
        } else if cg_is_struct_type(g, et) {
            // Evaluate into a temp, make it independently owned
            // (so freeing the old value cannot free the new one),
            // then free the old struct and take the new one.
            let n: int = g.assign_counter;
            g.assign_counter = g.assign_counter + 1;
            g = cg_emit(g, cg_c_type(g, et) + " __forge_assign" + itoa(n) + " = " + expr + ";");
            if !cg_is_fresh_struct(g, rhs) {
                g = cg_emit_struct_own(g, "__forge_assign" + itoa(n), et);
            }
            if cg_owned_contains(g, st.name) {
                let fc: CGExpr = cg_struct_free_code(g, st.name, et, st.name);
                g = fc.g;
                g = cg_emit_guarded(g, st.name, fc.code);
            }
            g = cg_emit(g, st.name + " = __forge_assign" + itoa(n) + ";");
            g = cg_owned_add(g, st.name, et);
            g = cg_emit(g, cg_moved_flag(st.name) + " = 0;");
            g = cg_moved_discard_prefix(g, st.name + ".");
        } else if infer_is_tuple_type(et) {
            // Same temp-first shape as structs, with tuple
            // ownership on the temp and tuple frees on the old.
            let n: int = g.assign_counter;
            g.assign_counter = g.assign_counter + 1;
            g = cg_emit(g, cg_c_type(g, et) + " __forge_assign" + itoa(n) + " = " + expr + ";");
            if !cg_is_fresh_tuple(g, rhs) {
                g = cg_emit_tuple_own(g, "__forge_assign" + itoa(n), et);
            }
            if cg_owned_contains(g, st.name) {
                let fc: CGExpr = cg_tuple_free_code(g, st.name, et);
                g = fc.g;
                g = cg_emit_guarded(g, st.name, fc.code);
            }
            g = cg_emit(g, st.name + " = __forge_assign" + itoa(n) + ";");
            g = cg_owned_add(g, st.name, et);
            g = cg_emit(g, cg_moved_flag(st.name) + " = 0;");
        } else {
            g = cg_emit(g, st.name + " = " + expr + ";");
        }
        return g;
    }
    if st.kind == 13 {
        // FieldAssign (codegen.py:2889). The counter is
        // increment-then-read (__forge_fa1, ...). A field that
        // moved away holds no value to free: assigning it revives
        // it, so its old free is skipped and the path leaves
        // moved_fields below.
        let target: Node = st.kids[0];
        let rhs: Node = st.kids[1];
        let field_path: str = cg_field_path(target);
        let field_moved: bool = field_path != "" && cg_moved_contains(g, field_path);
        let tcode: CGExpr = cg_gen_expr(g, target);
        g = tcode.g;
        let ft: str = cg_expr_type(g, target);
        let vout: CGExpr = cg_gen_expr(g, rhs);
        g = vout.g;
        let mut val: str = vout.code;
        if cg_expr_type(g, rhs) == "never" {
            val = cg_never_wrap(val, ft, g);
        }
        if ft == "str" {
            if !cg_is_fresh_str(g, rhs) {
                val = "forge_copy_str(" + val + ")";
            }
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            g = cg_emit(g, "char * __forge_fa" + itoa(n) + " = " + val + ";");
            if !field_moved {
                g = cg_emit(g, "forge_free_str(" + tcode.code + ");");
            }
            g = cg_emit(g, tcode.code + " = __forge_fa" + itoa(n) + ";");
        } else if is_union_type(ft) {
            let vt: str = cg_expr_type(g, rhs);
            if cg_str_in(vt, union_members(ft)) {
                let cs: bool = vt == "str" && !cg_is_fresh_str(g, rhs);
                val = cg_union_wrap(val, vt, ft, cs, g);
            }
            g.assign_counter = g.assign_counter + 1;
            let n: int = g.assign_counter;
            g = cg_emit(g, cg_c_type(g, ft) + " __forge_fa" + itoa(n) + " = " + val + ";");
            if vt == ft && !cg_is_fresh_union(g, rhs) {
                let copy: str = cg_union_copy_stmt("__forge_fa" + itoa(n), ft);
                if copy != "" {
                    g = cg_emit(g, copy);
                }
            }
