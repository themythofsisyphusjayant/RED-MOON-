        let err_bad: str = "(" + rt + "){ .ok = false, .value = " + empty + ", .error = forge_copy_str(\"bad size\") }";
        let err_oom: str = "(" + rt + "){ .ok = false, .value = " + empty + ", .error = forge_copy_str(\"out of memory\") }";
        let ok_empty: str = "(" + rt + "){ .ok = true, .value = " + empty + ", .error = forge_copy_str(\"\") }";
