        // the runtime-flag form when it is emitted.
        push(g.defer_calls, st.kids[0]);
        push(g.defer_conds, g.branch_depth > 0 || g.loop_depth > 0);
        return g;
    }
    if st.kind == 10 {
        // Let: name, bval = mutable, sval = annotation, kids = [init].
        let init: Node = st.kids[0];
        let t: str = cg_let_type(g, st);
        let eout: CGExpr = cg_gen_expr(g, init);
        g = eout.g;
        let mut expr: str = eout.code;
        if cg_expr_type(g, init) == "never" {
            expr = cg_never_wrap(expr, t, g);
        }
        push(g.local_names, st.name);
        push(g.local_types, t);
        g = cg_facts_update_from_rhs(g, st.name, init, true);
        if t == "str" {
            if !cg_is_fresh_str(g, init) {
                expr = "forge_copy_str(" + expr + ")";
            }
            g = cg_owned_add(g, st.name, "str");
            // NOTE the order: the moved flag is emitted BEFORE
            // the declaration for str (unlike the other branches).
            g = cg_emit(g, "int " + cg_moved_flag(st.name) + " = 0;");
            g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + expr + ";");
            return g;
        }
        if is_union_type(t) {
            let et: str = cg_expr_type(g, init);
            let mut e2: str = expr;
            if cg_str_in(et, union_members(t)) {
                let cs: bool = et == "str" && !cg_is_fresh_str(g, init);
                e2 = cg_union_wrap(expr, et, t, cs, g);
            } else if et == t && !cg_is_fresh_union(g, init) {
                g.assign_counter = g.assign_counter + 1;
                let n: int = g.assign_counter;
                let copy: str = cg_union_copy_stmt("__forge_let" + itoa(n), t);
                e2 = "({" + cg_c_type(g, t) + " __forge_let" + itoa(n) + " = " + expr + "; " + copy + " __forge_let" + itoa(n) + ";})";
            }
            g = cg_owned_add(g, st.name, t);
            g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + e2 + ";");
            g = cg_emit(g, "int " + cg_moved_flag(st.name) + " = 0;");
            return g;
        }
        if cg_is_opaque_type(t) {
            let oc: CGExpr = cg_opaque_convert(g, expr, cg_expr_type(g, init), t, init);
            g = oc.g;
            g = cg_owned_add(g, st.name, t);
            g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + oc.code + ";");
            g = cg_emit(g, "int " + cg_moved_flag(st.name) + " = 0;");
            return g;
        }
        if cg_is_array_type(g, t) {
            g = cg_owned_add(g, st.name, t);
            g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + expr + ";");
            g = cg_emit(g, "int " + cg_moved_flag(st.name) + " = 0;");
            if !cg_is_fresh_array(g, init) {
                g = cg_emit(g, "forge_arr_inc(" + st.name + ".ref);");
            }
            return g;
        }
        if cg_is_struct_type(g, t) {
            g = cg_owned_add(g, st.name, t);
            g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + expr + ";");
            g = cg_emit(g, "int " + cg_moved_flag(st.name) + " = 0;");
            if !cg_is_fresh_struct(g, init) {
                g = cg_emit_struct_own(g, st.name, t);
            }
            return g;
        }
        if infer_is_tuple_type(t) {
            g = cg_owned_add(g, st.name, t);
            g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + expr + ";");
            g = cg_emit(g, "int " + cg_moved_flag(st.name) + " = 0;");
            if !cg_is_fresh_tuple(g, init) {
                g = cg_emit_tuple_own(g, st.name, t);
            }
            return g;
        }
        g = cg_emit(g, cg_c_type(g, t) + " " + st.name + " = " + expr + ";");
        return g;
    }
    if st.kind == 17 {
        // Return (codegen.py:3380): defers run first (all frames),
        // then every open scope is joined innermost-first, then
        // main joins threads, then the value is made independently
        // owned and the owned vars are freed.
        g = cg_emit_all_defers(g, ret_type);
        let mut si: int = len(g.scope_vars) - 1;
        while si >= 0 {
            g = cg_emit(g, "forge_join_scope(" + g.scope_vars[si] + ");");
            si = si - 1;
        }
        if g.current_fn == "main" && !g.freestanding {
            g = cg_emit(g, "forge_join_threads();");
        }
        if len(st.kids) == 0 {
            g = cg_emit_free_owned(g);
            if g.current_fn == "main" {
                g = cg_emit(g, "return 0;");
            } else {
                g = cg_emit(g, "return;");
            }
            return g;
        }
        let e: Node = st.kids[0];
        let eout: CGExpr = cg_gen_expr(g, e);
        g = eout.g;
        let mut ret_code: str = eout.code;
        if cg_expr_type(g, e) == "never" {
            ret_code = cg_never_wrap(ret_code, ret_type, g);
        }
        if ret_type == "str" && !cg_is_fresh_str(g, e) {
            ret_code = "forge_copy_str(" + ret_code + ")";
        }
        if cg_is_opaque_type(ret_type) {
            let oc: CGExpr = cg_opaque_convert(g, ret_code, cg_expr_type(g, e), ret_type, e);
            g = oc.g;
            ret_code = oc.code;
        }
        if is_union_type(ret_type) {
            let rt: str = cg_expr_type(g, e);
            if cg_str_in(rt, union_members(ret_type)) {
                let cs: bool = rt == "str" && !cg_is_fresh_str(g, e);
                ret_code = cg_union_wrap(ret_code, rt, ret_type, cs, g);
            }
        }
        g = cg_emit(g, cg_c_type(g, ret_type) + " __forge_ret = " + ret_code + ";");
        if cg_is_array_type(g, ret_type) && !cg_is_fresh_array(g, e) {
            g = cg_emit(g, "forge_arr_inc(__forge_ret.ref);");
        }
        if cg_is_struct_type(g, ret_type) && !cg_is_fresh_struct(g, e) {
            g = cg_emit_struct_own(g, "__forge_ret", ret_type);
        }
        if infer_is_tuple_type(ret_type) && !cg_is_fresh_tuple(g, e) {
            g = cg_emit_tuple_own(g, "__forge_ret", ret_type);
        }
        if is_union_type(ret_type) && cg_expr_type(g, e) == ret_type && !cg_is_fresh_union(g, e) {
            let copy: str = cg_union_copy_stmt("__forge_ret", ret_type);
            if copy != "" {
                g = cg_emit(g, copy);
            }
        }
        g = cg_emit_free_owned(g);
        g = cg_emit(g, "return __forge_ret;");
        return g;
    }
    if st.kind == 24 {
        // ExprStmt: kids = [expr].
        let call: Node = st.kids[0];
        if call.kind == 35 && call.name == "assert" {
            let cout: CGExpr = cg_gen_expr(g, call.kids[0]);
            g = cout.g;
            let mout: CGExpr = cg_gen_expr(g, call.kids[1]);
            g = mout.g;
            g = cg_emit(g, "if (!(" + cout.code + ")) { fprintf(stderr, \"qasida: assertion failed: %s\\n\", " + mout.code + "); exit(1); }");
            return g;
        }
        if call.kind == 35 && (call.name == "print" || call.name == "println") {
            return cg_gen_print(g, call);
        }
        if call.kind == 35 && call.name == "push" {
            // push (codegen.py:3450): scalar via PUSH_FN, str copied
            // first, struct owned into a temp, nested array grown
            // inline with the batch-18 CoW detach before realloc.
            let vout: CGExpr = cg_gen_expr(g, call.kids[0]);
            g = vout.g;
            let var_code: str = vout.code;
            let et: str = cg_expr_type(g, call.kids[1]);
            let aout: CGExpr = cg_gen_expr(g, call.kids[1]);
            g = aout.g;
            let mut val: str = aout.code;
            if et == "str" {
                val = "forge_copy_str(" + val + ")";
            }
            if cg_is_struct_type(g, et) {
                if !cg_is_fresh_struct(g, call.kids[1]) {
                    g.assign_counter = g.assign_counter + 1;
                    let tmp: str = "__forge_pushv" + itoa(g.assign_counter - 1);
                    g = cg_emit(g, cg_c_type(g, et) + " " + tmp + " = " + val + ";");
                    g = cg_emit_struct_own(g, tmp, et);
                    val = tmp;
                }
                g = cg_emit(g, "forge_" + cg_struct_type_name(g, et) + "_push(&" + var_code + ", " + val + ");");
                return g;
            }
            if cg_is_array_type(g, et) {
                if !cg_is_fresh_array(g, call.kids[1]) {
                    g.assign_counter = g.assign_counter + 1;
                    let tmp: str = "__forge_pusha" + itoa(g.assign_counter - 1);
                    g = cg_emit(g, cg_c_type(g, et) + " " + tmp + " = " + val + ";");
                    g = cg_emit(g, "forge_arr_inc(" + tmp + ".ref);");
                    val = tmp;
                }
                g.assign_counter = g.assign_counter + 1;
                let ptr: str = "__forge_pp" + itoa(g.assign_counter - 1);
                g = cg_emit(g, cg_c_type(g, cg_expr_type(g, call.kids[0])) + " *" + ptr + " = &" + var_code + ";");
                let elem_c: str = cg_c_type(g, et);
                g.assign_counter = g.assign_counter + 1;
                let ocap: str = "__forge_ocap" + itoa(g.assign_counter - 1);
                g.assign_counter = g.assign_counter + 1;
                let nbuf: str = "__forge_nbuf" + itoa(g.assign_counter - 1);
                g.assign_counter = g.assign_counter + 1;
                let li: str = "__forge_li" + itoa(g.assign_counter - 1);
                g = cg_emit(g, "if (" + ptr + "->ref && *" + ptr + "->ref > 1) {");
                g = cg_emit(g, "    long long " + ocap + " = " + ptr + "->cap ? " + ptr + "->cap : 4;");
                g = cg_emit(g, "    " + elem_c + " *" + nbuf + " = (" + elem_c + " *)malloc(sizeof(" + elem_c + ") * (size_t)" + ocap + ");");
                g = cg_emit(g, "    if (!" + nbuf + ") forge_fail(\"out of memory\");");
                g = cg_emit(g, "    for (long long " + li + " = 0; " + li + " < " + ptr + "->len; " + li + "++) { " + nbuf + "[" + li + "] = " + ptr + "->data[" + li + "]; forge_arr_inc(" + nbuf + "[" + li + "].ref); }");
                g = cg_emit(g, "    (*" + ptr + "->ref)--;");
                g = cg_emit(g, "    " + ptr + "->data = " + nbuf + "; " + ptr + "->cap = " + ocap + "; " + ptr + "->ref = forge_arr_ref_new();");
                g = cg_emit(g, "}");
                g.assign_counter = g.assign_counter + 1;
                let ncap: str = "__forge_ncap" + itoa(g.assign_counter - 1);
                g = cg_emit(g, "if (" + ptr + "->len >= " + ptr + "->cap) {");
                g = cg_emit(g, "    long long " + ncap + " = " + ptr + "->cap ? " + ptr + "->cap * 2 : 4;");
                g = cg_emit(g, "    " + elem_c + " *nd = (" + elem_c + " *)realloc(" + ptr + "->data, sizeof(" + elem_c + ") * (size_t)" + ncap + ");");
                g = cg_emit(g, "    if (!nd) forge_fail(\"out of memory\");");
                g = cg_emit(g, "    " + ptr + "->data = nd; " + ptr + "->cap = " + ncap + ";");
                g = cg_emit(g, "}");
                g = cg_emit(g, ptr + "->data[" + ptr + "->len++] = " + val + ";");
                return g;
            }
            let mut push_fn: str = "";
            if et == "int" {
                push_fn = "forge_int_push";
            } else if et == "float" {
                push_fn = "forge_float_push";
            } else if et == "bool" {
                push_fn = "forge_bool_push";
            } else if et == "str" {
                push_fn = "forge_str_push";
            } else {
                fail("cannot push a value of type " + et);
            }
            g = cg_emit(g, push_fn + "(&" + var_code + ", " + val + ");");
            return g;
        }
        if call.kind == 35 && call.name == "fail" {
            let mout: CGExpr = cg_gen_expr(g, call.kids[0]);
            g = mout.g;
            g = cg_emit(g, "fprintf(stderr, \"qasida: %s\\n\", " + mout.code + ");");
            g = cg_emit(g, "exit(1);");
            return g;
        }
        if call.kind == 35 && call.name == "fail_compile" {
            // Slice 5 driver builtin: compile-time error, with
            // the CLI's "qasida: error: " prefix.
            let mout: CGExpr = cg_gen_expr(g, call.kids[0]);
            g = mout.g;
            g = cg_emit(g, "fprintf(stderr, \"qasida: error: %s\\n\", " + mout.code + ");");
            g = cg_emit(g, "exit(1);");
            return g;
        }
        if call.kind == 35 && call.name == "eprintln" {
            // Slice 5 driver builtin: stderr line, no exit.
            let mout: CGExpr = cg_gen_expr(g, call.kids[0]);
            g = mout.g;
            g = cg_emit(g, "fprintf(stderr, \"%s\\n\", " + mout.code + ");");
            return g;
        }
        if call.kind == 35 && call.name == "pin" {
            // Pinning is compile-time only: no code at all.
            return g;
        }
        let eout: CGExpr = cg_gen_expr(g, st.kids[0]);
        g = eout.g;
        g = cg_emit(g, eout.code + ";");
        return g;
    }
    fail("unsupported statement in 4a");
    return g;
}

fn cg_gen_block(g0: HCodegen, blk: Node, ret_type: str) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut i: int = 0;
    while i < len(blk.kids) {
        g = cg_gen_stmt(g, blk.kids[i], ret_type);
        i = i + 1;
    }
    return g;
}

// ---- gen_func ----

fn cg_gen_func(g0: HCodegen, fn_node: Node) -> HCodegen {
    return cg_gen_func_named(g0, fn_node, fn_node.name);
}

// gen_func (codegen.py:2361) with an overridden function name:
// impl methods are emitted under their mangled Struct__method
// name, but their node still carries the plain method name.
// Counters are program-global (Python's __init__ only): they
// are NOT reset per function.
fn cg_gen_func_named(g0: HCodegen, fn_node: Node, fname: str) -> HCodegen {
    let mut g: HCodegen = g0;
    g.current_fn = fname;
    g.current_ret = cg_subst(g, fn_node.sval);
    g.moved_fields = cg_trunc_str(g.moved_fields, 0);
    if ends_with(fname, "__drop") {
        let params0: [str] = cg_param_entries(fn_node);
        if len(params0) > 0 {
            g.drop_receiver = split(params0[0], ":")[0];
        }
    }
    g.defer_conds = cg_trunc_bool(g.defer_conds, 0);
    g.move_cond = -1;
    g.owned_names = cg_trunc_str(g.owned_names, 0);
    g.owned_types = cg_trunc_str(g.owned_types, 0);
    g.owned_marks = cg_trunc_int(g.owned_marks, 0);
    g.owned_frame_starts = cg_trunc_int(g.owned_frame_starts, 0);
    push(g.owned_frame_starts, 0);
    g.defer_calls = cg_trunc_node(g.defer_calls, 0);
    g.defer_frame_starts = cg_trunc_int(g.defer_frame_starts, 0);
    push(g.defer_frame_starts, 0);
    g.loop_frames = cg_trunc_int(g.loop_frames, 0);
    g.defer_loop_stack = cg_trunc_int(g.defer_loop_stack, 0);
    g.scope_vars = cg_trunc_str(g.scope_vars, 0);
    g.scope_depths = cg_trunc_int(g.scope_depths, 0);
    g.scope_counter = 0;
    g.local_names = cg_trunc_str(g.local_names, 0);
    g.local_types = cg_trunc_str(g.local_types, 0);
    // 4f: check-elimination state is per-function (codegen.py:2381).
    g.fact_names = cg_trunc_str(g.fact_names, 0);
    g.fact_los = cg_trunc_int(g.fact_los, 0);
    g.fact_his = cg_trunc_int(g.fact_his, 0);
    g.check_keys = cg_trunc_str(g.check_keys, 0);
    g.let_names = cg_trunc_str(g.let_names, 0);
    g.let_starts = cg_trunc_int(g.let_starts, 0);
    // Owned parameters own their copy after copy-on-call.
    let params: [str] = cg_param_entries(fn_node);
    let mut i: int = 0;
    while i < len(params) {
        let kv: [str] = split(params[i], ":");
        push(g.local_names, kv[0]);
        push(g.local_types, cg_subst(g, kv[1]));
        let pt: str = cg_subst(g, kv[1]);
        if pt == "str" || cg_is_array_type(g, pt) || cg_is_struct_type(g, pt) || is_union_type(pt) || cg_is_opaque_type(pt) {
            g = cg_owned_add(g, kv[0], pt);
        }
        i = i + 1;
    }
    let mut msig: str = "";
    if fname == "main" && g.freestanding {
        msig = "long long qasida_main(void)";
    } else if fname == "main" {
        msig = "int main(int __forge_argc, char **__forge_argv)";
    } else {
        msig = cg_c_sig_named(g, fn_node, fname);
    }
    g = cg_emit(g, msig + " {");
    g.indent = g.indent + 1;
    // Runtime moved flags for owned parameters (tuple included).
    i = 0;
    while i < len(params) {
        let kv: [str] = split(params[i], ":");
        let pt: str = cg_subst(g, kv[1]);
        if pt == "str" || cg_is_array_type(g, pt) || cg_is_struct_type(g, pt) || is_union_type(pt) || cg_is_opaque_type(pt) || infer_is_tuple_type(pt) {
            g = cg_emit(g, "int " + cg_moved_flag(kv[0]) + " = 0;");
        }
        i = i + 1;
    }
    if fname == "main" && !g.freestanding {
        g = cg_emit(g, "forge_args_global.len = __forge_argc > 0 ? __forge_argc - 1 : 0;");
        g = cg_emit(g, "forge_args_global.cap = forge_args_global.len;");
        g = cg_emit(g, "forge_args_global.data = forge_args_global.len ? (char **)malloc(sizeof(char *) * (size_t)forge_args_global.len) : NULL;");
        g = cg_emit(g, "for (long long __forge_arg_i = 0; __forge_arg_i < forge_args_global.len; __forge_arg_i++) forge_args_global.data[__forge_arg_i] = forge_copy_str(__forge_argv[__forge_arg_i + 1]);");
    }
    let body: Node = fn_node.kids[len(fn_node.kids) - 1];
    g = cg_gen_block(g, body, cg_subst(g, fn_node.sval));
    if fname == "main" {
        // Function-frame defers run before the joins and frees.
        g = cg_emit_defer_frame(g, 0, fn_node.sval);
        if !g.freestanding {
            g = cg_emit(g, "forge_join_threads();");
            g = cg_emit_free_owned(g);
        }
        g = cg_emit(g, "return 0;");
    } else if fn_node.sval == "void" {
        g = cg_emit_defer_frame(g, 0, fn_node.sval);
        g = cg_emit_free_owned(g);
    }
    g.indent = g.indent - 1;
    g = cg_emit(g, "}");
    push(g.lines, "");
    g.current_fn = "";
    g.drop_receiver = "";
    return g;
}

// ---- generate() ----

fn cg_generate(g0: HCodegen, prog: Node) -> str {
    let mut g: HCodegen = g0;
    if g.freestanding {
        push(g.lines, cg_freestanding_header());
    } else {
        push(g.lines, cg_header());
    }
    // Enums: non-payload enums as C enums, in program order.
    let mut i: int = 0;
    while i < len(g.enum_names) {
        if !cg_enum_has_payload(g, g.enum_names[i]) {
            g = cg_emit(g, "typedef enum { " + join(split(g.enum_variants[i], "~"), ", ") + " } " + g.enum_names[i] + ";");
        }
        i = i + 1;
    }
    // Concrete enums, sorted: payload enums as tag+union structs,
    // non-payload generic enums as aliases of the base C enum.
    let conc_enums: [str] = cg_sorted_mode(g.enum_concrete, 0);
    let mut ei: int = 0;
    while ei < len(conc_enums) {
        let t: str = conc_enums[ei];
        let variants: str = cg_enum_concrete_variants(g, t);
        if variants != "" {
            let mut base: str = t;
            if infer_is_generic(t) {
                base = generic_base(t);
            }
            if cg_enum_has_payload(g, base) {
                let cname: str = cg_c_type(g, t);
                g = cg_emit(g, "typedef struct " + cname + " " + cname + ";");
                g = cg_emit(g, "struct " + cname + " { int tag;");
                let parts: [str] = split(variants, "~");
                let mut has_union: bool = false;
                let mut j: int = 0;
                while j < len(parts) {
                    let kv: [str] = split(parts[j], ":");
                    if len(kv) >= 2 && kv[1] != "" {
                        has_union = true;
                    }
                    j = j + 1;
                }
                if has_union {
                    g = cg_emit(g, "    union {");
                    j = 0;
                    while j < len(parts) {
                        let kv: [str] = split(parts[j], ":");
                        if len(kv) >= 2 && kv[1] != "" {
                            g = cg_emit(g, "        " + cg_c_type(g, kv[1]) + " payload_" + kv[0] + ";");
                        }
                        j = j + 1;
                    }
                    g = cg_emit(g, "    } payload;");
                }
                g = cg_emit(g, "};");
            } else if infer_find_str(t, "<") >= 0 {
                g = cg_emit(g, "typedef " + base + " " + infer_mangle_type(t) + ";");
            }
        }
        ei = ei + 1;
    }
    if len(g.enum_names) > 0 {
        push(g.lines, "");
    }
    // Struct forward decls (concrete only).
    i = 0;
    while i < len(g.struct_names) {
        if g.struct_tparams[i] == "" {
            g = cg_emit(g, "typedef struct " + g.struct_names[i] + " " + g.struct_names[i] + ";");
        }
        i = i + 1;
    }
    // Union typedefs, sorted.
    let unions: [str] = cg_sorted_mode(g.union_types, 0);
    if g.freestanding {
        let mut ui0: int = 0;
        while ui0 < len(unions) {
            if cg_union_str_index(unions[ui0]) >= 0 {
                fail("unions with str members need the hosted runtime (not in freestanding v1); union '" + unions[ui0] + "' has one");
            }
            ui0 = ui0 + 1;
        }
    }
    let mut ui: int = 0;
    while ui < len(unions) {
        let ut: str = unions[ui];
        let cname: str = cg_union_c_name(ut);
        g = cg_emit(g, "typedef struct " + cname + " " + cname + ";");
        g = cg_emit(g, "struct " + cname + " { long long tag;");
        g = cg_emit(g, "    union {");
        let members: [str] = union_members(ut);
        let mut j: int = 0;
        while j < len(members) {
            g = cg_emit(g, "        " + cg_c_type(g, members[j]) + " _" + itoa(j) + ";");
            j = j + 1;
        }
        g = cg_emit(g, "    } payload;");
        g = cg_emit(g, "};");
        ui = ui + 1;
    }
    if len(unions) > 0 {
        push(g.lines, "");
    }
    // Ranges: emitted unconditionally.
    g = cg_emit(g, "typedef struct { long long start; long long end; } ForgeRange;");
    push(g.lines, "");
    // Tuple + opaque forward typedefs.
    let tuples: [str] = cg_sorted_mode(g.tuple_types, 1);
    if g.freestanding {
        let mut ti0: int = 0;
        while ti0 < len(tuples) {
            let elems: [str] = tuple_elems(tuples[ti0]);
            let mut ej: int = 0;
            while ej < len(elems) {
                if elems[ej] == "str" || cg_is_array_type(g, elems[ej]) {
                    fail("tuples with str/array elements need the hosted runtime (not in freestanding v1); tuple '" + tuples[ti0] + "' has one");
                }
                ej = ej + 1;
            }
            ti0 = ti0 + 1;
        }
    }
    let mut ti: int = 0;
    while ti < len(tuples) {
        let cn: str = cg_tuple_c_name(tuples[ti]);
        g = cg_emit(g, "typedef struct " + cn + " " + cn + ";");
        ti = ti + 1;
    }
    let mut opaque_traits: [str] = [];
    let mut oi: int = 0;
    while oi < len(g.impl_traits) {
        opaque_traits = cg_push_unique_str(opaque_traits, g.impl_traits[oi]);
        oi = oi + 1;
    }
    oi = 0;
    while oi < len(opaque_traits) {
        g = cg_emit(g, "typedef struct Opaque_" + opaque_traits[oi] + " Opaque_" + opaque_traits[oi] + ";");
        oi = oi + 1;
    }
    // Per-struct array typedefs, then nested array typedefs
    // innermost-first.
    let mut has_structs: bool = false;
    i = 0;
    while i < len(g.struct_names) {
        if g.struct_tparams[i] == "" {
            has_structs = true;
            let name: str = g.struct_names[i];
            g = cg_emit(g, "typedef struct { " + name + " *data; long long len; long long cap; long long *ref; } ForgeArray_" + name + ";");
        }
        i = i + 1;
    }
    let nested: [str] = cg_sorted_mode(g.nested_arrays, 2);
    let mut ni: int = 0;
    while ni < len(nested) {
        let t: str = nested[ni];
        g = cg_emit(g, "typedef struct { " + cg_c_type(g, infer_array_elem(t)) + " *data; long long len; long long cap; long long *ref; } " + cg_c_type(g, t) + ";");
        ni = ni + 1;
    }
    if has_structs || len(nested) > 0 {
        push(g.lines, "");
    }
    // Composite bodies (structs, tuples, opaques) in dependency
    // order: a value field needs its type complete.
    let mut node_kind: [str] = [];
    let mut node_name: [str] = [];
    let mut node_ftypes: [str] = [];
    let mut node_fnames: [str] = [];
    i = 0;
    while i < len(g.struct_names) {
        if g.struct_tparams[i] == "" {
            push(node_kind, "struct");
            push(node_name, g.struct_names[i]);
            let parts: [str] = infer_parse_fields(g.struct_fields[i]);
            let mut fts: str = "";
            let mut fns: str = "";
            let mut j: int = 0;
            while j < len(parts) {
                let kv: [str] = split(parts[j], ":");
                if len(kv) >= 2 {
                    if fts == "" {
                        fts = kv[1];
                        fns = kv[0];
                    } else {
                        fts = fts + "~" + kv[1];
                        fns = fns + "~" + kv[0];
                    }
                }
                j = j + 1;
            }
            push(node_ftypes, fts);
            push(node_fnames, fns);
        }
        i = i + 1;
    }
    ti = 0;
    while ti < len(tuples) {
        push(node_kind, "tuple");
        push(node_name, cg_tuple_c_name(tuples[ti]));
        push(node_ftypes, join(tuple_elems(tuples[ti]), "~"));
        push(node_fnames, "");
        ti = ti + 1;
    }
    oi = 0;
    while oi < len(opaque_traits) {
        push(node_kind, "opaque");
        push(node_name, "Opaque_" + opaque_traits[oi]);
        push(node_ftypes, join(cg_impls_for_trait(g, opaque_traits[oi]), "~"));
        push(node_fnames, "");
        oi = oi + 1;
    }
    let mut remaining: [int] = [];
    let mut ri: int = 0;
    while ri < len(node_kind) {
        push(remaining, ri);
        ri = ri + 1;
    }
    let mut emitted_names: [str] = [];
    let mut emitted_any: bool = false;
    while len(remaining) > 0 {
        let mut picked: int = -1;
        let mut picked_pos: int = -1;
        let mut pi: int = 0;
        while pi < len(remaining) {
            let ni2: int = remaining[pi];
            let ftypes: [str] = split(node_ftypes[ni2], "~");
            let mut ok: bool = true;
            let mut di: int = 0;
            while di < len(ftypes) {
                if ftypes[di] != "" {
                    let dep: str = cg_c_type(g, ftypes[di]);
                    if cg_str_in(dep, node_name) && !cg_str_in(dep, emitted_names) {
                        ok = false;
                    }
                }
                di = di + 1;
            }
            if ok && picked < 0 {
                picked = ni2;
                picked_pos = pi;
            }
            pi = pi + 1;
        }
        if picked < 0 {
            let mut cycle: str = "";
            let mut ci: int = 0;
            while ci < len(remaining) {
                if cycle == "" {
                    cycle = node_name[remaining[ci]];
                } else {
                    cycle = cycle + ", " + node_name[remaining[ci]];
                }
                ci = ci + 1;
            }
            fail("cyclic type definition involving " + cycle + "; a type cannot contain itself by value");
        }
        let kind: str = node_kind[picked];
        let cname: str = node_name[picked];
        if kind == "struct" {
            g = cg_emit(g, "struct " + cname + " {");
            let fts: [str] = split(node_ftypes[picked], "~");
            let fns: [str] = split(node_fnames[picked], "~");
            let mut j: int = 0;
            while j < len(fts) {
                if fts[j] != "" {
                    g = cg_emit(g, "    " + cg_c_type(g, fts[j]) + " " + fns[j] + ";");
                }
                j = j + 1;
            }
            g = cg_emit(g, "};");
        } else if kind == "tuple" {
            g = cg_emit(g, "struct " + cname + " {");
            let elems: [str] = split(node_ftypes[picked], "~");
            let mut j: int = 0;
            while j < len(elems) {
                g = cg_emit(g, "    " + cg_c_type(g, elems[j]) + " _" + itoa(j) + ";");
                j = j + 1;
            }
            g = cg_emit(g, "};");
        } else {
            let trait_name: str = substr(cname, 7, len(cname) - 7);
            let impls: [str] = cg_impls_for_trait(g, trait_name);
            g = cg_emit(g, "struct " + cname + " { long long tag;");
            g = cg_emit(g, "    union {");
            let mut j: int = 0;
            while j < len(impls) {
                g = cg_emit(g, "        " + impls[j] + " _" + itoa(j) + ";");
                j = j + 1;
            }
            g = cg_emit(g, "    } payload;");
            g = cg_emit(g, "};");
        }
        emitted_any = true;
        push(emitted_names, cname);
        let mut nxt: [int] = [];
        let mut k: int = 0;
        while k < len(remaining) {
            if k != picked_pos {
                push(nxt, remaining[k]);
            }
            k = k + 1;
        }
        remaining = nxt;
    }
    if emitted_any {
        push(g.lines, "");
    }
    // Per-struct array helpers: free / get / set / get_fast /
    // set_fast / push. Skipped in freestanding mode: arrays
    // cannot exist there, and the helpers use memset/free/
    // size_t, none of which exists under the freestanding
    // header (codegen.py:2188).
    i = 0;
    while i < len(g.struct_names) && !g.freestanding {
        if g.struct_tparams[i] == "" {
            let name: str = g.struct_names[i];
            let arr_t: str = "ForgeArray_" + name;
            g = cg_emit(g, "static void forge_" + name + "_array_free(" + arr_t + " a) {");
            g = cg_emit(g, "    if (a.ref && --(*a.ref) == 0) {");
            g = cg_emit(g, "        for (long long i = 0; i < a.len; i++) {");
            let fc: CGExpr = cg_struct_free_code(g, "a.data[i]", name, "");
            g = fc.g;
            if fc.code != "" {
                g = cg_emit(g, "            " + fc.code);
            }
            g = cg_emit(g, "        }");
            g = cg_emit(g, "        if (a.data) memset(a.data, 0, (size_t)a.cap * sizeof(*a.data)); free(a.data); if (a.ref) memset(a.ref, 0, sizeof(long long)); free(a.ref); forge_arr_frees++;");
            g = cg_emit(g, "    }");
            g = cg_emit(g, "}");
            let mut si: int = 0;
            while si < 2 {
                let mut suffix: str = "";
                let mut check: bool = true;
                if si == 1 {
                    suffix = "_fast";
                    check = false;
                }
                g = cg_emit(g, "static " + name + " forge_" + name + "_get" + suffix + "(" + arr_t + " a, long long i) {");
                if check {
                    g = cg_emit(g, "    if (i < 0 || i >= a.len) forge_fail(\"array index out of bounds\");");
                }
                g = cg_emit(g, "    " + name + " v = a.data[i];");
                let own: str = cg_struct_own_code(g, "v", name);
                if own != "" {
                    g = cg_emit(g, "    " + own);
                }
                g = cg_emit(g, "    return v;");
                g = cg_emit(g, "}");
                g = cg_emit(g, "static void forge_" + name + "_set" + suffix + "(" + arr_t + " *a, long long i, " + name + " v) {");
                if check {
                    g = cg_emit(g, "    if (i < 0 || i >= a->len) forge_fail(\"array index out of bounds\");");
                }
                let ofc: CGExpr = cg_struct_free_code(g, "a->data[i]", name, "");
                g = ofc.g;
                if ofc.code != "" {
                    g = cg_emit(g, "    " + ofc.code);
                }
                g = cg_emit(g, "    a->data[i] = v;");
                g = cg_emit(g, "}");
                si = si + 1;
            }
            g = cg_emit(g, "static void forge_" + name + "_push(" + arr_t + " *a, " + name + " v) {");
            g = cg_emit(g, "    if (a->ref && *a->ref > 1) {");
            g = cg_emit(g, "        /* Copy-on-write (fix track): this array is");
            g = cg_emit(g, "           shared, so growing it in place would");
            g = cg_emit(g, "           realloc the shared buffer and leave the");
            g = cg_emit(g, "           other holders dangling — the two-sided");
            g = cg_emit(g, "           probe double-freed in realloc. Detach");
            g = cg_emit(g, "           first, mirroring FORGE_ARRAY_HELPERS:");
            g = cg_emit(g, "           fresh buffer, copy slots gaining");
            g = cg_emit(g, "           ownership of their fields each (the");
            g = cg_emit(g, "           struct free path frees one hold per");
            g = cg_emit(g, "           slot, so the inc keeps the counts");
            g = cg_emit(g, "           exact), drop this holder's count on");
            g = cg_emit(g, "           the old buffer without freeing it. */");
            g = cg_emit(g, "        long long oc = a->cap ? a->cap : 4;");
            g = cg_emit(g, "        " + name + " *nd = (" + name + " *)malloc(sizeof(" + name + ") * (size_t)oc);");
            g = cg_emit(g, "        if (!nd) forge_fail(\"out of memory\");");
            g = cg_emit(g, "        for (long long i = 0; i < a->len; i++) {");
            let pown: str = cg_struct_own_code(g, "nd[i]", name);
            let mut ndline: str = "            nd[i] = a->data[i];";
            if pown != "" {
                ndline = ndline + " " + pown;
            }
            g = cg_emit(g, ndline);
            g = cg_emit(g, "        }");
            g = cg_emit(g, "        (*a->ref)--;");
            g = cg_emit(g, "        a->data = nd; a->cap = oc; a->ref = forge_arr_ref_new();");
            g = cg_emit(g, "    }");
            g = cg_emit(g, "    if (a->len >= a->cap) {");
            g = cg_emit(g, "        long long nc = a->cap ? a->cap * 2 : 4;");
            g = cg_emit(g, "        " + name + " *nd = (" + name + " *)realloc(a->data, sizeof(" + name + ") * (size_t)nc);");
            g = cg_emit(g, "        if (!nd) forge_fail(\"out of memory\");");
            g = cg_emit(g, "        a->data = nd; a->cap = nc;");
            g = cg_emit(g, "    }");
            g = cg_emit(g, "    a->data[a->len++] = v;");
            g = cg_emit(g, "}");
        }
        i = i + 1;
    }
    if has_structs {
        push(g.lines, "");
    }
    // Function forward decls: top-level functions first (the
    // checker appends impl methods after them), then impl
    // methods under their mangled names.
    i = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 && n.name != "main" {
            let sp: [str] = split_tparams(n.name);
            if sp[1] == "" {
                if n.bval {
                    g = cg_emit(g, cg_c_sig_extern(g, n) + ";");
                } else {
                    g = cg_emit(g, cg_c_sig(g, n) + ";");
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 6 {
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                g = cg_emit(g, cg_c_sig_named(g, m, n.name + "__" + m.name) + ";");
                j = j + 1;
            }
        }
        i = i + 1;
    }
    // Generic instantiations, in discovery order (Python appends
    // them to program.funcs after the originals and impl methods).
    i = 0;
    while i < len(g.inst_mangled) {
        let tmpl: Node = cg_find_fn_node(prog, g.inst_tmpl[i]);
        if tmpl.kind == 2 {
            g.subst_names = split(g.inst_bnames[i], "~");
            g.subst_types = split(g.inst_btypes[i], "~");
            g = cg_emit(g, cg_c_sig_named(g, tmpl, g.inst_mangled[i]) + ";");
            g.subst_names = cg_trunc_str(g.subst_names, 0);
            g.subst_types = cg_trunc_str(g.subst_types, 0);
        }
        i = i + 1;
    }
    push(g.lines, "");
    // Opaque copy/free helpers, one per trait with implementations.
    oi = 0;
    while oi < len(opaque_traits) {
        let trait_name: str = opaque_traits[oi];
        let impls: [str] = cg_impls_for_trait(g, trait_name);
        let cname: str = "Opaque_" + trait_name;
        g = cg_emit(g, "static " + cname + " forge_copy_" + cname + "(" + cname + " v) {");
        g = cg_emit(g, "    switch (v.tag) {");
        let mut j: int = 0;
        while j < len(impls) {
            g = cg_emit(g, "    case " + itoa(j) + ":");
            let own: str = cg_struct_own_code(g, "v.payload._" + itoa(j), impls[j]);
            if own != "" {
                g = cg_emit(g, "        " + own);
            }
            g = cg_emit(g, "        break;");
            j = j + 1;
        }
        g = cg_emit(g, "    }");
        g = cg_emit(g, "    return v;");
        g = cg_emit(g, "}");
        g = cg_emit(g, "static void forge_free_" + cname + "(" + cname + " v) {");
        g = cg_emit(g, "    switch (v.tag) {");
        j = 0;
        while j < len(impls) {
            g = cg_emit(g, "    case " + itoa(j) + ":");
            let fc: CGExpr = cg_struct_free_code(g, "v.payload._" + itoa(j), impls[j], "");
            g = fc.g;
            if fc.code != "" {
                g = cg_emit(g, "        " + fc.code);
            }
            g = cg_emit(g, "        break;");
            j = j + 1;
        }
        g = cg_emit(g, "    }");
        g = cg_emit(g, "}");
        oi = oi + 1;
    }
    if len(opaque_traits) > 0 {
        push(g.lines, "");
    }
    // Thread wrappers for every spawned function.
    let mut wi: int = 0;
    while wi < len(g.spawn_names) {
        let nm: str = g.spawn_names[wi];
        g = cg_emit(g, "static void *forge_thread_" + nm + "(void *arg) {");
        if g.spawn_argc[wi] > 0 {
            g = cg_emit(g, "    long long v = *(long long *)arg; memset(arg, 0, sizeof(long long)); free(arg); " + nm + "(v); return NULL;");
        } else {
            g = cg_emit(g, "    (void)arg; " + nm + "(); return NULL;");
        }
        g = cg_emit(g, "}");
        wi = wi + 1;
    }
    if len(g.spawn_names) > 0 {
        push(g.lines, "");
    }
    // Function bodies: top-level functions first, then impl
    // methods under their mangled names.
    i = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 && !n.bval {
            let sp: [str] = split_tparams(n.name);
            if sp[1] == "" {
                g = cg_gen_func(g, n);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 6 {
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                g = cg_gen_func_named(g, m, n.name + "__" + m.name);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    // Generic instantiation bodies, in discovery order.
    i = 0;
    while i < len(g.inst_mangled) {
        let tmpl: Node = cg_find_fn_node(prog, g.inst_tmpl[i]);
        if tmpl.kind == 2 {
            g.subst_names = split(g.inst_bnames[i], "~");
            g.subst_types = split(g.inst_btypes[i], "~");
            g = cg_gen_func_named(g, tmpl, g.inst_mangled[i]);
            g.subst_names = cg_trunc_str(g.subst_names, 0);
            g.subst_types = cg_trunc_str(g.subst_types, 0);
        }
        i = i + 1;
    }
    // Freestanding entry point (codegen.py:2319): x86_64 Linux
    // _start calls qasida_main() and exits via the raw
    // exit_group syscall (231, code in rdi). No CRT, no libc.
    if g.freestanding {
        let mut has_main: bool = false;
        let mut mi: int = 0;
        while mi < len(prog.kids) {
            let n: Node = prog.kids[mi];
            if n.kind == 2 {
                let sp: [str] = split_tparams(n.name);
                if sp[0] == "main" {
                    has_main = true;
                }
            }
            mi = mi + 1;
        }
        if has_main {
            g = cg_emit(g, "__attribute__((noreturn)) void _start(void) {");
            g = cg_emit(g, "    long long code = qasida_main();");
            g = cg_emit(g, "    __asm__ volatile (\"syscall\" :: \"a\" (231L), \"D\" (code) : \"rcx\", \"r11\", \"memory\");");
            g = cg_emit(g, "    __builtin_unreachable();");
            g = cg_emit(g, "}");
        }
    }
    return join(g.lines, "\n");
}

// ---- generic instantiations (4d) ----

// One generic-call resolution: ok, the mangled name, and the
// bindings (parallel names/types arrays).
struct CGBind {
    ok: bool;
    mangled: str;
    names: [str];
    types: [str];
}

// Template lookup: ["1", ret, params_enc, tparams] for the template
// whose base name matches, else ["0", "", "", ""].
fn cg_template_lookup(g: HCodegen, name: str) -> [str] {
    let mut i: int = 0;
    while i < len(g.func_names) {
        let sp: [str] = split_tparams(g.func_names[i]);
        if sp[0] == name && sp[1] != "" {
            return ["1", g.func_rets[i], g.func_params[i], sp[1]];
        }
        i = i + 1;
    }
    return ["0", "", "", ""];
}

// Bindings for a call to a generic template: unify each template
// param type with the corresponding argument's inferred type.
// Mangling mirrors Python instantiate_func: name + "_" +
// "_".join(mangle_type(binding) for each type param).
fn cg_generic_bindings(g: HCodegen, tmpl: [str], base: str, call: Node) -> CGBind {
    let mut names: [str] = split(tmpl[3], "~");
    let mut types: [str] = [];
    let mut ti: int = 0;
    while ti < len(names) {
        push(types, "?");
        ti = ti + 1;
    }
    let params: [str] = infer_parse_params(tmpl[2]);
    let mut i: int = 0;
    while i < len(call.kids) {
        if i < len(params) {
            let kv: [str] = infer_split_param(params[i]);
            if len(kv) >= 2 {
                let u: UOut = unify(kv[1], cg_expr_type(g, call.kids[i]), names, types);
                if !u.ok {
                    return CGBind { ok: false, mangled: "", names: names, types: types };
                }
                names = u.names;
                types = u.types;
            }
        }
        i = i + 1;
    }
    let mut q: int = 0;
    while q < len(names) {
        if types[q] == "?" {
            return CGBind { ok: false, mangled: "", names: names, types: types };
        }
        q = q + 1;
    }
    let mut mangled: str = base + "_";
    let mut m: int = 0;
    while m < len(types) {
        if m > 0 {
            mangled = mangled + "_";
        }
        mangled = mangled + infer_mangle_type(types[m]);
        m = m + 1;
    }
    return CGBind { ok: true, mangled: mangled, names: names, types: types };
}

// The template FuncDef node for a base name, or kind 0 if absent.
fn cg_find_fn_node(prog: Node, base: str) -> Node {
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 {
            let sp: [str] = split_tparams(n.name);
            if sp[0] == base {
                return n;
            }
        }
        i = i + 1;
    }
    return new_node(0, 0, 0);
}

// Registry lookup: ["1", binds_enc] or ["0", ""].
fn cg_inst_lookup(g: HCodegen, mangled: str) -> [str] {
    let mut i: int = 0;
    while i < len(g.inst_mangled) {
        if g.inst_mangled[i] == mangled {
            return ["1", g.inst_bnames[i] + "=" + g.inst_btypes[i]];
        }
        i = i + 1;
    }
    return ["0", ""];
}

// Register a generic instantiation (dedup by mangled name). On a NEW
// registration, immediately walk the template body under the bindings
// (depth-first, mirroring Python instantiate_func -> check_func(spec)):
// nested generic calls in the body register their own instantiations.
// inst_busy guards directly recursive instantiations (Python returns
// None for those; here the inner call resolves to the same entry).
fn cg_register_inst(g0: HCodegen, prog: Node, base: str, b: CGBind) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut i: int = 0;
    while i < len(g.inst_mangled) {
        if g.inst_mangled[i] == b.mangled {
            return g;
        }
        i = i + 1;
    }
    if cg_str_in(b.mangled, g.inst_busy) {
        return g;
    }
    let mut bnames: str = "";
    let mut btypes: str = "";
    let mut q: int = 0;
    while q < len(b.names) {
        if bnames == "" {
            bnames = b.names[q];
            btypes = b.types[q];
        } else {
            bnames = bnames + "~" + b.names[q];
            btypes = btypes + "~" + b.types[q];
        }
        q = q + 1;
    }
    push(g.inst_tmpl, base);
    push(g.inst_mangled, b.mangled);
    push(g.inst_bnames, bnames);
    push(g.inst_btypes, btypes);
    push(g.inst_busy, b.mangled);
    let tmpl: Node = cg_find_fn_node(prog, base);
    if tmpl.kind == 2 {
        let saved_names: [str] = g.subst_names;
        let saved_types: [str] = g.subst_types;
        g.subst_names = b.names;
        g.subst_types = b.types;
        let body: Node = tmpl.kids[len(tmpl.kids) - 1];
        g = cg_collect_inst_walk(g, prog, body);
        g.subst_names = saved_names;
        g.subst_types = saved_types;
    }
    let mut nb: [str] = [];
    let mut bi: int = 0;
    while bi < len(g.inst_busy) {
        if g.inst_busy[bi] != b.mangled {
            push(nb, g.inst_busy[bi]);
        }
        bi = bi + 1;
    }
    g.inst_busy = nb;
    return g;
}

// Recursive walk finding generic calls: args first, then the call
// itself (postorder, mirroring Python's check_expr, which checks
// arguments before instantiating the callee).
fn cg_collect_inst_walk(g0: HCodegen, prog: Node, node: Node) -> HCodegen {
    let mut g: HCodegen = g0;
    // BinOp spine: walk iteratively, innermost-first (same stack
    // reason as cg_collect_walk: ~18KB/frame over a chain of N
    // terms). Visit order matches the recursion (leftmost
    // operand, then each right operand innermost-first); spine
    // nodes carry no own work (only kind-35 calls register).
    if node.kind == 40 {
        let mut spine: [Node] = [];
        let mut cur: Node = node;
        while cur.kind == 40 {
            push(spine, cur);
            cur = cur.kids[0];
        }
        g = cg_collect_inst_walk(g, prog, cur);
        let mut i: int = len(spine) - 1;
        while i >= 0 {
            g = cg_collect_inst_walk(g, prog, spine[i].kids[1]);
            i = i - 1;
        }
        return g;
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        g = cg_collect_inst_walk(g, prog, node.kids[i]);
        i = i + 1;
    }
    if node.kind == 35 {
        let tf: [str] = cg_template_lookup(g, node.name);
        if tf[0] == "1" {
            let b: CGBind = cg_generic_bindings(g, tf, node.name, node);
            if b.ok {
                g = cg_register_inst(g, prog, node.name, b);
            }
        }
    }
    return g;
}

// Instantiation discovery (4d): walk concrete function bodies in
// program order, then impl-method bodies. Python checks top-level
// functions in program order first (collect_impls appends impl
// methods to program.funcs before the check loop), then impl
// methods — discovery order follows.
fn cg_collect_instantiations(g0: HCodegen, prog: Node) -> HCodegen {
    let mut g: HCodegen = g0;
    let mut i: int = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 2 && !n.bval {
            let sp: [str] = split_tparams(n.name);
            if sp[1] == "" {
                // Generic-arg types are looked up under
                // "fn:line:col" keys (bootstrap fix).
                g.current_fn = n.name;
                g = cg_collect_inst_walk(g, prog, n.kids[len(n.kids) - 1]);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < len(prog.kids) {
        let n: Node = prog.kids[i];
        if n.kind == 6 {
            let mut j: int = 0;
            while j < len(n.kids) {
                let m: Node = n.kids[j];
                let msp: [str] = split_tparams(m.name);
                if msp[1] == "" {
                    g.current_fn = n.name + "__" + m.name;
                    g = cg_collect_inst_walk(g, prog, m.kids[len(m.kids) - 1]);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return g;
}

// Entry point: infer + generate, mode safe.
fn codegen_program(prog: Node, inf: HInfer, freestanding: bool) -> str {
    let mut p: Node = expand_aliases_prog(prog);
    let mut g: HCodegen = cg_new(inf);
    g.freestanding = freestanding;
    g = cg_build_tables(g, p);
    g = cg_collect_instantiations(g, p);
    g = cg_collect(g, p);
    return cg_generate(g, p);
}
