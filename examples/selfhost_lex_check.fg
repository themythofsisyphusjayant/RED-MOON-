// Driver for verifying the hosted lexer (examples/selfhost_lex.fg)
// against the Python lexer. Reads a .fg file path from argv,
// lexes it with the hosted lexer, and prints one token per line:
//   KIND|ESCAPED_TEXT|LINE|COL
// ESCAPED_TEXT escapes backslash, newline, tab, carriage return,
// and the | separator so each token is exactly one line.
// Usage: qasida run examples/selfhost_lex_check.fg -- <path>

import "selfhost_lex.fg";

fn escape_text(s: str) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(s) {
        let c: str = substr(s, i, 1);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\t" {
            out = out + "\\t";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "|" {
            out = out + "\\|";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

fn i2s(n: int) -> str {
    if n == 0 {
        return "0";
    }
    let mut neg: bool = false;
    let mut v: int = n;
    if v < 0 {
        neg = true;
        v = -v;
    }
    let mut out: str = "";
    while v > 0 {
        let d: int = v % 10;
        let mut ch: str = "?";
        if d == 0 {
            ch = "0";
        } else if d == 1 {
            ch = "1";
        } else if d == 2 {
            ch = "2";
        } else if d == 3 {
            ch = "3";
        } else if d == 4 {
            ch = "4";
        } else if d == 5 {
            ch = "5";
        } else if d == 6 {
            ch = "6";
        } else if d == 7 {
            ch = "7";
        } else if d == 8 {
            ch = "8";
        } else {
            ch = "9";
        }
        out = ch + out;
        v = v / 10;
    }
    if neg {
        out = "-" + out;
    }
    return out;
}

fn main() -> int {
    let argv: [str] = args();
    if len(argv) < 1 {
        println("usage: selfhost_lex_check.fg -- <path>");
        return 1;
    }
    let src: str = read_file(argv[0]);
    let lx: LexOut = lex(src);
    let mut i: int = 0;
    while i < len(lx.texts) {
        let line: str = kind_name(lx.kinds[i]) + "|" + escape_text(lx.texts[i]) + "|" + i2s(lx.lines[i]) + "|" + i2s(lx.cols[i]);
        println(line);
        i = i + 1;
    }
    return 0;
}
