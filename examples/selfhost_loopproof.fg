// Fix 1 Phase B1 — bounds-check hoisting proofs (H1, H2, H1-D),
// hosted mirror of forge_lang/loopproof.py over the hosted Node
// tree (kind tags from selfhost_parse.fg).
//
// Pure analysis: fix1_analyze_program(prog) returns a Fix1Res
// (covered Index (line, col) pairs + per-loop guard strings).
// The codegen (selfhost_codegen.fg) tags that result onto the
// program tree itself (fix1_tag_program below) and consults the
// tags only in safe mode with bounds checks on. Covered uses
// reuse the existing fast-mode emission.
//
// The guard text built here is byte-identical to the Python
// mirror's, including the two soundness deviations from the
// DESIGN.md guard text (see loopproof.py header): H1b-var /
// H2-RangeLit-var guards carry the loop-entry condition, and the
// H1-D guard re-evaluates the entry expression E when stable
// (else a singleton interval), with >= len iff an a[k] use is
// covered, else > len.
//
// Interval rule shared with Python: ends are capped at 2^40 and
// a * interval is unknown when any |end| > 10^6 (the hosted
// checked * would trap the compiler itself on huge products).

import "selfhost_parse.fg";

// Node kinds used here (selfhost_parse.fg header):
// 9 Block, 10 Let, 11 Assign, 12 IndexAssign, 13 FieldAssign,
// 15 While, 16 For, 21 Spawn, 23 Defer, 25 IntLit, 26 FloatLit,
// 27 StrLit, 28 BoolLit, 29 ArrayLit, 32 FieldAccess,
// 33 MethodCall, 34 Var, 35 Call, 36 Index, 38 RangeLit,
// 40 BinOp, 41 UnaryOp, 43 Param, 2 FuncDef, 6 ImplDef.

struct Fix1Env {
    names: [str];
    types: [str];
    los: [int];
    his: [int];
    lok: [bool];
    hik: [bool];
    sized_names: [str];
    sized_ns: [int];
    // B2 (§4): relational upper bounds — one entry per (var, bound)
    // pair: `var < bound` is proven (loop-counter bounds, R2 mod
    // results). Needed by R3-P2.
    rel_names: [str];
    rel_bounds: [str];
}

struct Fix1Res {
    cov_lines: [int];
    cov_cols: [int];
    guard_lines: [int];
    guard_cols: [int];
    guards: [str];
    // B2: plain BinOp positions (R2 '%' / R3 '*' and '+') and
    // straight-line R5 guards, one per covered Index node.
    plain_lines: [int];
    plain_cols: [int];
    ig_lines: [int];
    ig_cols: [int];
    ig_guards: [str];
    // Fix 2 (b): first-entry run verdicts per loop position —
    // run_vals[i] is 1 when the loop at (run_lines[i],
    // run_cols[i]) provably runs >= 1 iteration at first entry.
    run_lines: [int];
    run_cols: [int];
    run_vals: [int];
}

struct Fix1Pair {
    env: Fix1Env;
    res: Fix1Res;
}

struct Fix1Uses {
    lines: [int];
    cols: [int];
    // B2: direct-child position of each use within the body
    // (for R1's before-increment / after-reset grouping).
    pos: [int];
}

// B3 (O1-S2b): post-reset union fact — has=1 with the var name
// and the union interval, or has=0 when no reset fact holds.
struct Fix1Reset {
    has: int;
    name: str;
    lo: int;
    hi: int;
}

fn fix1_env_new() -> Fix1Env {
    return Fix1Env { names: [], types: [], los: [], his: [], lok: [], hik: [], sized_names: [], sized_ns: [], rel_names: [], rel_bounds: [] };
}

// B3: TRUE copy of an env. `let mut env = env0` copies only the
// array headers, so index-assignments (`env.los[idx] = ...`) write
// through to the caller's buffer — the then-arm's `col = 1` leaked
// into the else arm's scan and wrongly proved `col + 1` plain
// (unsound: col is unbounded). Python uses dict(env) copies at
// every branch point; the hosted mirror must do the same. Used at
// the If-arm and loop-body branch points only — the statement
// threading uses return values and needs no copy.
fn fix1_env_deep_copy(env0: Fix1Env) -> Fix1Env {
    let mut env: Fix1Env = fix1_env_new();
    let mut i: int = 0;
    while i < len(env0.names) {
        push(env.names, env0.names[i]);
        push(env.types, env0.types[i]);
        push(env.los, env0.los[i]);
        push(env.his, env0.his[i]);
        push(env.lok, env0.lok[i]);
        push(env.hik, env0.hik[i]);
        i = i + 1;
    }
    i = 0;
    while i < len(env0.sized_names) {
        push(env.sized_names, env0.sized_names[i]);
        push(env.sized_ns, env0.sized_ns[i]);
        i = i + 1;
    }
    i = 0;
    while i < len(env0.rel_names) {
        push(env.rel_names, env0.rel_names[i]);
        push(env.rel_bounds, env0.rel_bounds[i]);
        i = i + 1;
    }
    return env;
}

fn fix1_res_new() -> Fix1Res {
    return Fix1Res { cov_lines: [], cov_cols: [], guard_lines: [], guard_cols: [], guards: [], plain_lines: [], plain_cols: [], ig_lines: [], ig_cols: [], ig_guards: [], run_lines: [], run_cols: [], run_vals: [] };
}

fn fix1_is_var(n: Node, name: str) -> bool {
    return n.kind == 34 && n.name == name;
}

fn fix1_is_intlit(n: Node) -> bool {
    return n.kind == 25;
}

fn fix1_is_len_of(e: Node, arr: str) -> bool {
    if e.kind == 35 && e.name == "len" && len(e.kids) == 1 {
        return fix1_is_var(e.kids[0], arr);
    }
    if e.kind == 33 && e.name == "len" && len(e.kids) == 1 {
        return fix1_is_var(e.kids[0], arr);
    }
    return false;
}

fn fix1_is_len_call(e: Node) -> bool {
    if e.kind == 35 && e.name == "len" && len(e.kids) == 1 {
        return true;
    }
    if e.kind == 33 && e.name == "len" && len(e.kids) == 1 {
        return true;
    }
    return false;
}

// C rendering of a pure int expr (literal / var / + - * binop /
// unary minus / len(var)). "" when not renderable.
fn fix1_c_expr(e: Node) -> str {
    if e.kind == 25 {
        return itoa(e.ival);
    }
    if e.kind == 34 {
        return e.name;
    }
    if e.kind == 41 && e.name == "-" {
        let inner: str = fix1_c_expr(e.kids[0]);
        if inner == "" {
            return "";
        }
        return "(-" + inner + ")";
    }
    if e.kind == 40 && (e.name == "+" || e.name == "-" || e.name == "*") {
        let l: str = fix1_c_expr(e.kids[0]);
        let r: str = fix1_c_expr(e.kids[1]);
        if l == "" || r == "" {
            return "";
        }
        return "(" + l + " " + e.name + " " + r + ")";
    }
    if e.kind == 35 && e.name == "len" && len(e.kids) == 1 {
        let inner: str = fix1_c_expr(e.kids[0]);
        if inner == "" {
            return "";
        }
        return "(" + inner + ").len";
    }
    return "";
}

fn fix1_is_array_type(t: str) -> bool {
    if starts_with(t, "[") {
        return true;
    }
    if starts_with(t, "readonly [") {
        return true;
    }
    return false;
}

// Qasida has no ordering comparison on str: digit test is
// explicit equality against each digit.
fn fix1_is_digit(c: str) -> bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

// N for a sized array type spelling "[T; N]", -1 when not sized.
fn fix1_sized_len(t: str) -> int {
    let mut i: int = 0;
    let mut semi: int = -1;
    while i < len(t) {
        if t[i] == ";" {
            semi = i;
        }
        i = i + 1;
    }
    if semi < 0 {
        return -1;
    }
    let mut j: int = semi + 1;
    let mut digits: str = "";
    while j < len(t) {
        let c: str = t[j];
        if fix1_is_digit(c) {
            digits = digits + c;
        } else if digits != "" {
            break;
        }
        j = j + 1;
    }
    if digits == "" {
        return -1;
    }
    return parse_int(digits);
}

// True iff v is within the interval cap (2^40); capped values are
// reported as unknown by the caller via the known flag.
fn fix1_in_cap(v: int) -> bool {
    return v <= 1099511627776 && v >= -1099511627776;
}

// ---------- environment ----------

fn fix1_env_idx(env: Fix1Env, name: str) -> int {
    let mut i: int = 0;
    while i < len(env.names) {
        if env.names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn fix1_env_type(env: Fix1Env, name: str) -> str {
    let idx: int = fix1_env_idx(env, name);
    if idx < 0 {
        return "";
    }
    return env.types[idx];
}

// Interval as [lok, lo, hik, hi] (lok/hik 0/1; lo/hi meaningless
// when the matching flag is 0).
fn fix1_env_interval(env: Fix1Env, name: str) -> [int] {
    let idx: int = fix1_env_idx(env, name);
    if idx < 0 {
        return [0, 0, 0, 0];
    }
    let mut lok: int = 0;
    if env.lok[idx] {
        lok = 1;
    }
    let mut hik: int = 0;
    if env.hik[idx] {
        hik = 1;
    }
    return [lok, env.los[idx], hik, env.his[idx]];
}

fn fix1_env_set_type(env0: Fix1Env, name: str, t: str) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let idx: int = fix1_env_idx(env, name);
    if idx >= 0 {
        env.types[idx] = t;
        return env;
    }
    push(env.names, name);
    push(env.types, t);
    push(env.los, 0);
    push(env.his, 0);
    push(env.lok, false);
    push(env.hik, false);
    return env;
}

fn fix1_env_set_interval(env0: Fix1Env, name: str, iv: [int]) -> Fix1Env {
    let mut env: Fix1Env = env0;
    if iv[0] == 0 && iv[2] == 0 {
        return fix1_env_drop_interval(env, name);
    }
    let idx: int = fix1_env_idx(env, name);
    if idx >= 0 {
        env.los[idx] = iv[1];
        env.his[idx] = iv[3];
        env.lok[idx] = iv[0] == 1;
        env.hik[idx] = iv[2] == 1;
        return env;
    }
    push(env.names, name);
    push(env.types, "");
    push(env.los, iv[1]);
    push(env.his, iv[3]);
    push(env.lok, iv[0] == 1);
    push(env.hik, iv[2] == 1);
    return env;
}

fn fix1_env_drop_interval(env0: Fix1Env, name: str) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let idx: int = fix1_env_idx(env, name);
    if idx >= 0 {
        env.lok[idx] = false;
        env.hik[idx] = false;
    }
    return env;
}

fn fix1_env_sized(env: Fix1Env, name: str) -> int {
    let mut i: int = 0;
    while i < len(env.sized_names) {
        if env.sized_names[i] == name {
            return env.sized_ns[i];
        }
        i = i + 1;
    }
    return -1;
}

fn fix1_env_set_sized(env0: Fix1Env, name: str, n: int) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let mut i: int = 0;
    while i < len(env.sized_names) {
        if env.sized_names[i] == name {
            env.sized_ns[i] = n;
            return env;
        }
        i = i + 1;
    }
    push(env.sized_names, name);
    push(env.sized_ns, n);
    return env;
}

fn fix1_env_drop_sized(env0: Fix1Env, name: str) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let mut out_names: [str] = [];
    let mut out_ns: [int] = [];
    let mut i: int = 0;
    while i < len(env.sized_names) {
        if env.sized_names[i] != name {
            push(out_names, env.sized_names[i]);
            push(out_ns, env.sized_ns[i]);
        }
        i = i + 1;
    }
    env.sized_names = out_names;
    env.sized_ns = out_ns;
    return env;
}

// B2: relational upper bounds (see Fix1Env.rel_names).
fn fix1_env_rel_has(env: Fix1Env, name: str, bound: str) -> bool {
    let mut i: int = 0;
    while i < len(env.rel_names) {
        if env.rel_names[i] == name && env.rel_bounds[i] == bound {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn fix1_env_rel_add(env0: Fix1Env, name: str, bound: str) -> Fix1Env {
    let mut env: Fix1Env = env0;
    if fix1_env_rel_has(env, name, bound) {
        return env;
    }
    push(env.rel_names, name);
    push(env.rel_bounds, bound);
    return env;
}

fn fix1_env_drop_rel(env0: Fix1Env, name: str) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let mut out_names: [str] = [];
    let mut out_bounds: [str] = [];
    let mut i: int = 0;
    while i < len(env.rel_names) {
        if env.rel_names[i] != name {
            push(out_names, env.rel_names[i]);
            push(out_bounds, env.rel_bounds[i]);
        }
        i = i + 1;
    }
    env.rel_names = out_names;
    env.rel_bounds = out_bounds;
    return env;
}

// Drop both the interval and the relational facts for `name`
// (used when a narrowed interval turns out empty: the branch is
// unreachable, so no fact about the var survives it).
fn fix1_env_drop_interval_rel(env0: Fix1Env, name: str) -> Fix1Env {
    let mut env: Fix1Env = env0;
    env = fix1_env_drop_interval(env, name);
    env = fix1_env_drop_rel(env, name);
    return env;
}

fn fix1_int_min() -> int {
    return 0 - 9223372036854775807 - 1;
}

fn fix1_int_max() -> int {
    return 9223372036854775807;
}

// Intersect env's interval for `name` with the concrete range
// [nlo, nhi] (both ends int64). Empty intersection drops the
// interval and the rel facts; an end outside the 2^40 analysis cap
// becomes unknown on that side (mirrors Python _cap).
fn fix1_env_narrow_to(env0: Fix1Env, name: str, nlo: int, nhi: int) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let iv: [int] = fix1_env_interval(env, name);
    let mut lo: int = nlo;
    if iv[0] == 1 && iv[1] > lo {
        lo = iv[1];
    }
    let mut hi: int = nhi;
    if iv[2] == 1 && iv[3] < hi {
        hi = iv[3];
    }
    if lo > hi {
        return fix1_env_drop_interval_rel(env, name);
    }
    let mut lok: int = 1;
    if !fix1_in_cap(lo) {
        lok = 0;
        lo = 0;
    }
    let mut hik: int = 1;
    if !fix1_in_cap(hi) {
        hik = 0;
        hi = 0;
    }
    return fix1_env_set_interval(env, name, [lok, lo, hik, hi]);
}

// ---------- intervals ----------

// [lok, lo, hik, hi] of an int expr. Mirrors Python _interval,
// including the 2^40 cap and the 10^6 * threshold.
fn fix1_interval(e: Node, env: Fix1Env) -> [int] {
    if e.kind == 25 {
        if fix1_in_cap(e.ival) {
            return [1, e.ival, 1, e.ival];
        }
        return [0, 0, 0, 0];
    }
    if e.kind == 34 {
        return fix1_env_interval(env, e.name);
    }
    if e.kind == 41 && e.name == "-" {
        let inner: [int] = fix1_interval(e.kids[0], env);
        let mut lok: int = 0;
        let mut lo: int = 0;
        let mut hik: int = 0;
        let mut hi: int = 0;
        if inner[2] == 1 && fix1_in_cap(-inner[3]) {
            lok = 1;
            lo = -inner[3];
        }
        if inner[0] == 1 && fix1_in_cap(-inner[1]) {
            hik = 1;
            hi = -inner[1];
        }
        return [lok, lo, hik, hi];
    }
    if e.kind == 40 && (e.name == "+" || e.name == "-" || e.name == "*") {
        let l: [int] = fix1_interval(e.kids[0], env);
        let r: [int] = fix1_interval(e.kids[1], env);
        if e.name == "+" {
            let mut lok: int = 0;
            let mut lo: int = 0;
            let mut hik: int = 0;
            let mut hi: int = 0;
            if l[0] == 1 && r[0] == 1 && fix1_in_cap(l[1] + r[1]) {
                lok = 1;
                lo = l[1] + r[1];
            }
            if l[2] == 1 && r[2] == 1 && fix1_in_cap(l[3] + r[3]) {
                hik = 1;
                hi = l[3] + r[3];
            }
            return [lok, lo, hik, hi];
        }
        if e.name == "-" {
            let mut lok: int = 0;
            let mut lo: int = 0;
            let mut hik: int = 0;
            let mut hi: int = 0;
            if l[0] == 1 && r[2] == 1 && fix1_in_cap(l[1] - r[3]) {
                lok = 1;
                lo = l[1] - r[3];
            }
            if l[2] == 1 && r[0] == 1 && fix1_in_cap(l[3] - r[1]) {
                hik = 1;
                hi = l[3] - r[1];
            }
            return [lok, lo, hik, hi];
        }
        if l[0] == 0 || l[2] == 0 || r[0] == 0 || r[2] == 0 {
            return [0, 0, 0, 0];
        }
        let mut big: bool = false;
        if l[1] > 1000000 || l[1] < -1000000 {
            big = true;
        }
        if l[3] > 1000000 || l[3] < -1000000 {
            big = true;
        }
        if r[1] > 1000000 || r[1] < -1000000 {
            big = true;
        }
        if r[3] > 1000000 || r[3] < -1000000 {
            big = true;
        }
        if big {
            return [0, 0, 0, 0];
        }
        let p0: int = l[1] * r[1];
        let p1: int = l[1] * r[3];
        let p2: int = l[3] * r[1];
        let p3: int = l[3] * r[3];
        let mut lo: int = p0;
        if p1 < lo {
            lo = p1;
        }
        if p2 < lo {
            lo = p2;
        }
        if p3 < lo {
            lo = p3;
        }
        let mut hi: int = p0;
        if p1 > hi {
            hi = p1;
        }
        if p2 > hi {
            hi = p2;
        }
        if p3 > hi {
            hi = p3;
        }
        if !fix1_in_cap(lo) || !fix1_in_cap(hi) {
            return [0, 0, 0, 0];
        }
        return [1, lo, 1, hi];
    }
    // B3 (O1-S3/S5): '%' and '/' intervals — magnitude bounds
    // only; the analysis never divides, so the hosted mirror can
    // never trap its own compiler on a zero divisor.
    if e.kind == 40 && e.name == "%" {
        let l: [int] = fix1_interval(e.kids[0], env);
        let r: [int] = fix1_interval(e.kids[1], env);
        if l[0] == 1 && l[1] >= 0 && r[0] == 1 && r[1] >= 1 {
            if r[2] == 1 {
                return [1, 0, 1, r[3] - 1];
            }
            return [1, 0, 0, 0];
        }
        if ((r[0] == 1 && r[1] >= 1) || (r[2] == 1 && r[3] <= -1)) && r[0] == 1 && r[2] == 1 {
            let mut m: int = r[1];
            if m < 0 {
                m = -m;
            }
            let mut ar: int = r[3];
            if ar < 0 {
                ar = -ar;
            }
            if ar > m {
                m = ar;
            }
            return [1, -(m - 1), 1, m - 1];
        }
        return [0, 0, 0, 0];
    }
    if e.kind == 40 && e.name == "/" {
        let l: [int] = fix1_interval(e.kids[0], env);
        let r: [int] = fix1_interval(e.kids[1], env);
        if ((r[0] == 1 && r[1] >= 1) || (r[2] == 1 && r[3] <= -1)) && l[0] == 1 && l[2] == 1 {
            let mut m: int = l[1];
            if m < 0 {
                m = -m;
            }
            let mut ah: int = l[3];
            if ah < 0 {
                ah = -ah;
            }
            if ah > m {
                m = ah;
            }
            if l[1] >= 0 {
                return [1, 0, 1, m];
            }
            if l[3] <= 0 {
                return [1, -m, 1, 0];
            }
            return [1, -m, 1, m];
        }
        return [0, 0, 0, 0];
    }
    if fix1_is_len_call(e) {
        return [1, 0, 0, 0];
    }
    return [0, 0, 0, 0];
}

// B2: condition facts for If-arm narrowing in the analysis.
// Mirrors cg_apply_cond_facts (selfhost_codegen.fg) plus the §4.3
// singleton var-vs-var extension: when the other side of a
// comparison has a singleton interval, it plays the literal's
// role (needed by R4's consumer: `if j2 < nlv` with nlv let-bound
// to 64 narrows j2 to [0, 63]). Edge-safe at the int64 extremes
// exactly like cg_apply_cond_facts (lit +/- 1 would trap the
// hosted compiler itself). Returns env unchanged when the
// condition proves nothing.
fn fix1_apply_cond_fact(env0: Fix1Env, cond: Node, truth: bool) -> Fix1Env {
    let mut env: Fix1Env = fix1_env_deep_copy(env0);
    if cond.kind != 40 {
        return env;
    }
    let mut op: str = cond.name;
    if op != "<" && op != "<=" && op != ">" && op != ">=" && op != "==" {
        return env;
    }
    let mut left: Node = cond.kids[0];
    let mut right: Node = cond.kids[1];
    if left.kind == 25 && right.kind == 34 {
        let tmp: Node = left;
        left = right;
        right = tmp;
        if op == "<" {
            op = ">";
        } else if op == "<=" {
            op = ">=";
        } else if op == ">" {
            op = "<";
        } else if op == ">=" {
            op = "<=";
        }
    }
    let mut lit: int = 0;
    let mut has_lit: bool = false;
    if left.kind == 34 && right.kind == 25 {
        lit = right.ival;
        has_lit = true;
    } else if left.kind == 34 && right.kind == 34 {
        let riv: [int] = fix1_env_interval(env, right.name);
        if riv[0] == 1 && riv[2] == 1 && riv[1] == riv[3] {
            lit = riv[1];
            has_lit = true;
        } else {
            let liv: [int] = fix1_env_interval(env, left.name);
            if liv[0] == 1 && liv[2] == 1 && liv[1] == liv[3] {
                let tmp2: Node = left;
                left = right;
                right = tmp2;
                if op == "<" {
                    op = ">";
                } else if op == "<=" {
                    op = ">=";
                } else if op == ">" {
                    op = "<";
                } else if op == ">=" {
                    op = "<=";
                }
                lit = liv[1];
                has_lit = true;
            }
        }
    }
    if !has_lit || left.kind != 34 {
        return env;
    }
    let t: str = fix1_env_type(env, left.name);
    if t != "" && t != "int" {
        return env;
    }
    if !truth {
        if op == "==" {
            return env;
        }
        if op == "<" {
            op = ">=";
        } else if op == "<=" {
            op = ">";
        } else if op == ">" {
            op = "<=";
        } else if op == ">=" {
            op = "<";
        }
    }
    if op == "<" {
        if lit <= fix1_int_min() {
            return fix1_env_drop_interval_rel(env, left.name);
        }
        if lit > fix1_int_max() {
            return env;
        }
        return fix1_env_narrow_to(env, left.name, fix1_int_min(), lit - 1);
    }
    if op == "<=" {
        if lit < fix1_int_min() {
            return fix1_env_drop_interval_rel(env, left.name);
        }
        if lit >= fix1_int_max() {
            return env;
        }
        return fix1_env_narrow_to(env, left.name, fix1_int_min(), lit);
    }
    if op == ">" {
        if lit >= fix1_int_max() {
            return fix1_env_drop_interval_rel(env, left.name);
        }
        if lit < fix1_int_min() {
            return env;
        }
        return fix1_env_narrow_to(env, left.name, lit + 1, fix1_int_max());
    }
    if op == ">=" {
        if lit > fix1_int_max() {
            return fix1_env_drop_interval_rel(env, left.name);
        }
        if lit <= fix1_int_min() {
            return env;
        }
        return fix1_env_narrow_to(env, left.name, lit, fix1_int_max());
    }
    if lit > fix1_int_max() || lit < fix1_int_min() {
        return fix1_env_drop_interval_rel(env, left.name);
    }
    return fix1_env_narrow_to(env, left.name, lit, lit);
}

// B2 (R3-P2(b)): the bound var name for `x % n` assigned to a
// var, when x >= 0 and n > 0 are proven; "" when not.
fn fix1_mod_rel(expr: Node, env: Fix1Env) -> str {
    if expr.kind != 40 || expr.name != "%" {
        return "";
    }
    if expr.kids[0].kind != 34 || expr.kids[1].kind != 34 {
        return "";
    }
    let xiv: [int] = fix1_env_interval(env, expr.kids[0].name);
    let niv: [int] = fix1_env_interval(env, expr.kids[1].name);
    if xiv[0] == 0 || xiv[1] < 0 {
        return "";
    }
    if niv[0] == 0 || niv[1] <= 0 {
        return "";
    }
    return expr.kids[1].name;
}

// B2 (R3-P2(b)): [has, lo, hi] of the interval of `x % n` ([0,
// n_hi-1] when n's upper end is known); [0, 0, 0] when the mod
// fact does not hold.
fn fix1_mod_iv(expr: Node, env: Fix1Env) -> [int] {
    if fix1_mod_rel(expr, env) == "" {
        return [0, 0, 0];
    }
    let niv: [int] = fix1_env_interval(env, expr.kids[1].name);
    if niv[2] == 0 {
        return [0, 0, 0];
    }
    return [1, 0, niv[3] - 1];
}

// Best-effort array type of an init expr (annotation handled by
// the caller): ArrayLit / Var-copy.
fn fix1_derive_type(e: Node, env: Fix1Env) -> str {
    if e.kind == 29 && len(e.kids) > 0 {
        let first: Node = e.kids[0];
        if first.kind == 25 {
            return "[int]";
        }
        if first.kind == 26 {
            return "[float]";
        }
        if first.kind == 27 {
            return "[str]";
        }
        if first.kind == 28 {
            return "[bool]";
        }
        if first.kind == 29 {
            let inner: str = fix1_derive_type(first, env);
            if inner == "" {
                return "";
            }
            return "[" + inner + "]";
        }
        if first.kind == 34 {
            let et: str = fix1_env_type(env, first.name);
            if et == "" {
                return "";
            }
            if starts_with(et, "[") {
                return et;
            }
            return "[" + et + "]";
        }
        return "";
    }
    if e.kind == 34 {
        return fix1_env_type(env, e.name);
    }
    return "";
}

// ---------- subtree scans ----------

fn fix1_has_push(n: Node) -> bool {
    if n.kind == 35 && n.name == "push" {
        return true;
    }
    if n.kind == 33 && n.name == "push" {
        return true;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if fix1_has_push(n.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn fix1_has_spawn_defer(n: Node) -> bool {
    if n.kind == 21 || n.kind == 23 {
        return true;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if fix1_has_spawn_defer(n.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn fix1_has_move_of(n: Node, name: str) -> bool {
    if n.kind == 35 && n.name == "move" && len(n.kids) >= 1 {
        if fix1_is_var(n.kids[0], name) {
            return true;
        }
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if fix1_has_move_of(n.kids[i], name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn fix1_has_field_assign_to(n: Node, name: str) -> bool {
    if n.kind == 13 && len(n.kids) >= 1 {
        let tgt: Node = n.kids[0];
        if tgt.kind == 32 && len(tgt.kids) >= 1 {
            if fix1_is_var(tgt.kids[0], name) {
                return true;
            }
        }
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        if fix1_has_field_assign_to(n.kids[i], name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Number of Assign/Let/For nodes in the subtree binding `name`.
fn fix1_write_count(n: Node, name: str) -> int {
    let mut c: int = 0;
    if (n.kind == 11 || n.kind == 10) && n.name == name {
        c = c + 1;
    }
    if n.kind == 16 && n.name == name {
        c = c + 1;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        c = c + fix1_write_count(n.kids[i], name);
        i = i + 1;
    }
    return c;
}

// [line, col] of the first Assign/Let/For binding `name` in the
// subtree, [-1, -1] when there is none.
fn fix1_write_site(n: Node, name: str) -> [int] {
    if (n.kind == 11 || n.kind == 10 || n.kind == 16) && n.name == name {
        return [n.line, n.col];
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        let found: [int] = fix1_write_site(n.kids[i], name);
        if found[0] >= 0 {
            return found;
        }
        i = i + 1;
    }
    return [-1, -1];
}

// Distinct names bound by Assign/Let/For anywhere in the subtree.
fn fix1_written_names(n: Node) -> [str] {
    let mut out: [str] = [];
    if (n.kind == 11 || n.kind == 10 || n.kind == 16) && n.name != "" {
        push(out, n.name);
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        let sub: [str] = fix1_written_names(n.kids[i]);
        let mut j: int = 0;
        while j < len(sub) {
            let mut seen: bool = false;
            let mut k: int = 0;
            while k < len(out) {
                if out[k] == sub[j] {
                    seen = true;
                }
                k = k + 1;
            }
            if !seen {
                push(out, sub[j]);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn fix1_vars_in(n: Node) -> [str] {
    let mut out: [str] = [];
    if n.kind == 34 {
        push(out, n.name);
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        let sub: [str] = fix1_vars_in(n.kids[i]);
        let mut j: int = 0;
        while j < len(sub) {
            push(out, sub[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

// Fix 2 (a1)/(a2): true when no var appearing in `bound` is
// written anywhere in `body`.
fn fix1_bound_vars_invariant(bound: Node, body: Node) -> bool {
    let vars: [str] = fix1_vars_in(bound);
    let mut i: int = 0;
    while i < len(vars) {
        if fix1_write_count(body, vars[i]) > 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Does `node`'s index form match the covered shape? mode 0:
// exactly Var(ctr). mode 1: Var(ctr) or (ctr - 1).
fn fix1_index_matches(ix: Node, ctr: str, mode: int) -> bool {
    if fix1_is_var(ix, ctr) {
        return true;
    }
    if mode == 1 && ix.kind == 40 && ix.name == "-" {
        if fix1_is_var(ix.kids[0], ctr) && ix.kids[1].kind == 25 && ix.kids[1].ival == 1 {
            return true;
        }
    }
    return false;
}

fn fix1_collect_rec(n: Node, arr: str, ctr: str, mode: int, pos: int, uses: Fix1Uses) -> Fix1Uses {
    let mut out: Fix1Uses = uses;
    // FieldAccess over an Index: the Index node's own check lives
    // in the FieldAccess emitter, so never cover it — but still
    // walk its index expr and base for nested uses.
    if n.kind == 32 && len(n.kids) >= 1 && n.kids[0].kind == 36 {
        let idxnode: Node = n.kids[0];
        out = fix1_collect_rec(idxnode.kids[1], arr, ctr, mode, pos, out);
        out = fix1_collect_rec(idxnode.kids[0], arr, ctr, mode, pos, out);
        return out;
    }
    if n.kind == 36 && len(n.kids) == 2 {
        if fix1_is_var(n.kids[0], arr) && fix1_index_matches(n.kids[1], ctr, mode) {
            push(out.lines, n.line);
            push(out.cols, n.col);
            push(out.pos, pos);
        }
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        // Only the outermost body Block assigns positions (it is
        // entered with pos == -1); deeper Blocks inherit the
        // position of the top-level statement containing them.
        let mut cpos: int = pos;
        if n.kind == 9 && pos == -1 {
            cpos = i;
        }
        out = fix1_collect_rec(n.kids[i], arr, ctr, mode, cpos, out);
        i = i + 1;
    }
    return out;
}

fn fix1_collect_uses(body: Node, arr: str, ctr: str, mode: int) -> Fix1Uses {
    let uses: Fix1Uses = Fix1Uses { lines: [], cols: [], pos: [] };
    return fix1_collect_rec(body, arr, ctr, mode, -1, uses);
}

// Distinct Var bases of Index nodes in `body` whose index matches
// the shape (mode as in fix1_collect_uses).
fn fix1_candidate_rec(n: Node, ctr: str, mode: int, out: [str]) -> [str] {
    let mut acc: [str] = out;
    if n.kind == 32 && len(n.kids) >= 1 && n.kids[0].kind == 36 {
        let idxnode: Node = n.kids[0];
        acc = fix1_candidate_rec(idxnode.kids[1], ctr, mode, acc);
        acc = fix1_candidate_rec(idxnode.kids[0], ctr, mode, acc);
        return acc;
    }
    if n.kind == 36 && len(n.kids) == 2 {
        if n.kids[0].kind == 34 && fix1_index_matches(n.kids[1], ctr, mode) {
            let nm: str = n.kids[0].name;
            let mut seen: bool = false;
            let mut i: int = 0;
            while i < len(acc) {
                if acc[i] == nm {
                    seen = true;
                }
                i = i + 1;
            }
            if !seen {
                push(acc, nm);
            }
        }
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        acc = fix1_candidate_rec(n.kids[i], ctr, mode, acc);
        i = i + 1;
    }
    return acc;
}

fn fix1_candidate_arrays(body: Node, ctr: str, mode: int) -> [str] {
    let out: [str] = [];
    return fix1_candidate_rec(body, ctr, mode, out);
}

// ---------- result accumulation ----------

fn fix1_res_add_cov(res0: Fix1Res, line: int, col: int) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut i: int = 0;
    while i < len(res.cov_lines) {
        if res.cov_lines[i] == line && res.cov_cols[i] == col {
            return res;
        }
        i = i + 1;
    }
    push(res.cov_lines, line);
    push(res.cov_cols, col);
    return res;
}

// B2: dedupe identical (line, col, guard) triples — the R-scan
// can attach the same guard text to one loop many times.
fn fix1_res_add_guard(res0: Fix1Res, line: int, col: int, guard: str) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut i: int = 0;
    while i < len(res.guard_lines) {
        if res.guard_lines[i] == line && res.guard_cols[i] == col && res.guards[i] == guard {
            return res;
        }
        i = i + 1;
    }
    push(res.guard_lines, line);
    push(res.guard_cols, col);
    push(res.guards, guard);
    return res;
}

// Fix 2 (b): record a loop's first-entry run verdict (val 1 =
// provably runs >= 1 iteration). First entry wins; a loop
// statement is analysed exactly once per function.
fn fix1_res_add_run(res0: Fix1Res, line: int, col: int, val: int) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut i: int = 0;
    while i < len(res.run_lines) {
        if res.run_lines[i] == line && res.run_cols[i] == col {
            return res;
        }
        i = i + 1;
    }
    push(res.run_lines, line);
    push(res.run_cols, col);
    push(res.run_vals, val);
    return res;
}

// Fix 2 (b): the recorded run verdict for the loop at
// (line, col); false when absent (no verdict recorded).
fn fix1_res_runs(res: Fix1Res, line: int, col: int) -> bool {
    let mut i: int = 0;
    while i < len(res.run_lines) {
        if res.run_lines[i] == line && res.run_cols[i] == col {
            return res.run_vals[i] == 1;
        }
        i = i + 1;
    }
    return false;
}

// B2: a plain BinOp position (R2 '%' / R3 '*' and '+').
fn fix1_res_add_plain(res0: Fix1Res, line: int, col: int) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut i: int = 0;
    while i < len(res.plain_lines) {
        if res.plain_lines[i] == line && res.plain_cols[i] == col {
            return res;
        }
        i = i + 1;
    }
    push(res.plain_lines, line);
    push(res.plain_cols, col);
    return res;
}

fn fix1_res_is_plain(res: Fix1Res, line: int, col: int) -> bool {
    let mut i: int = 0;
    while i < len(res.plain_lines) {
        if res.plain_lines[i] == line && res.plain_cols[i] == col {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// B2: a straight-line R5 guard for one Index node (at most one
// per node; the first wins).
fn fix1_res_add_idxguard(res0: Fix1Res, line: int, col: int, guard: str) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut i: int = 0;
    while i < len(res.ig_lines) {
        if res.ig_lines[i] == line && res.ig_cols[i] == col {
            return res;
        }
        i = i + 1;
    }
    push(res.ig_lines, line);
    push(res.ig_cols, col);
    push(res.ig_guards, guard);
    return res;
}

fn fix1_res_idxguard(res: Fix1Res, line: int, col: int) -> str {
    let mut i: int = 0;
    while i < len(res.ig_lines) {
        if res.ig_lines[i] == line && res.ig_cols[i] == col {
            return res.ig_guards[i];
        }
        i = i + 1;
    }
    return "";
}

fn fix1_res_add_uses(res0: Fix1Res, uses: Fix1Uses) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut i: int = 0;
    while i < len(uses.lines) {
        res = fix1_res_add_cov(res, uses.lines[i], uses.cols[i]);
        i = i + 1;
    }
    return res;
}

// ---------- shared preconditions ----------

// ---------- tagging the program (B1-FIX, attempt 2) ----------
//
// The analysis above returns a Fix1Res (positions + guard texts).
// Storing that result on HCodegen grew the giant codegen frames
// ~10% and overflowed the 8 MB stack — even one heap array field
// (attempt 1) left the peak 160 KB over the limit. So the result
// is tagged onto the program tree itself, and HCodegen carries
// NO fix1 field at all (its pre-B1 size is restored exactly).
//
//   * a covered Index node gets has_nul = true. The parser sets
//     has_nul only on StrLit nodes (selfhost_parse.fg, kind 27),
//     so it is free on Index nodes (kind 36); the string emitter
//     reads it only for StrLit nodes.
//   * a loop node (While 15 / For 16) with hoisted guards gets
//     the guard texts joined with "\n" in its sval. While/For
//     nodes never carry an sval from the parser.
//   * B2: a plain BinOp node (R2 '%' / R3 '*' and '+') gets
//     has_nul = true (free on BinOp nodes, same reason), and a
//     covered Index node with a straight-line R5 guard gets that
//     guard text in its sval (free on Index nodes).
// Tags are written through the parent's kids array, which shares
// its buffer with the tree, so they land in the program codegen
// reads. The walk is a dumb applicator — all proof logic stays
// in fix1_analyze_program, which runs first and is unchanged.
// Idempotent: re-tagging skips nodes already tagged (sval != "").

fn fix1_res_covers(res: Fix1Res, line: int, col: int) -> bool {
    let mut i: int = 0;
    while i < len(res.cov_lines) {
        if res.cov_lines[i] == line && res.cov_cols[i] == col {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn fix1_res_guards(res: Fix1Res, line: int, col: int) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(res.guard_lines) {
        if res.guard_lines[i] == line && res.guard_cols[i] == col {
            push(out, res.guards[i]);
        }
        i = i + 1;
    }
    return out;
}

fn fix1_tag_node(n: Node, res: Fix1Res) -> int {
    let mut tagged: int = 0;
    let mut i: int = 0;
    while i < len(n.kids) {
        let mut c: Node = n.kids[i];
        if c.kind == 36 && fix1_res_covers(res, c.line, c.col) {
            c.has_nul = true;
            n.kids[i] = c;
            tagged = tagged + 1;
        }
        // B2: a plain BinOp (R2 '%' / R3 '*' and '+') takes the
        // fast path too; has_nul is free on BinOp nodes (the
        // parser sets it only on StrLit).
        if c.kind == 40 && fix1_res_is_plain(res, c.line, c.col) {
            c.has_nul = true;
            n.kids[i] = c;
            tagged = tagged + 1;
        }
        // B3: a plain UnaryOp (O1 '-') takes the fast path too;
        // has_nul is free on UnaryOp nodes (the parser sets it
        // only on StrLit).
        if c.kind == 41 && fix1_res_is_plain(res, c.line, c.col) {
            c.has_nul = true;
            n.kids[i] = c;
            tagged = tagged + 1;
        }
        // B2: a straight-line R5 guard rides on the covered Index
        // node itself, in its sval (free on Index nodes); loop
        // guards stay on the loop node (below).
        if c.kind == 36 && c.sval == "" {
            let ig: str = fix1_res_idxguard(res, c.line, c.col);
            if ig != "" {
                c.sval = ig;
                n.kids[i] = c;
                tagged = tagged + 1;
            }
        }
        if (c.kind == 15 || c.kind == 16) && c.sval == "" {
            let gs: [str] = fix1_res_guards(res, c.line, c.col);
            if len(gs) > 0 {
                let mut s: str = "";
                let mut j: int = 0;
                while j < len(gs) {
                    if j > 0 {
                        s = s + "\n";
                    }
                    s = s + gs[j];
                    j = j + 1;
                }
                c.sval = s;
                n.kids[i] = c;
                tagged = tagged + 1;
            }
        }
        tagged = tagged + fix1_tag_node(c, res);
        i = i + 1;
    }
    return tagged;
}

// Apply `res` to `prog` in place; returns the number of nodes
// tagged (covered Index nodes + guarded loops).
// WARNING (b1fix2): the pooled Fix1Res keys by bare (line, col),
// which collides across files in a merged program. This function
// is correct only within a single file — lp_test-only. Production
// must use fix1_tag_program_fns (per-function tagging) instead.
fn fix1_tag_program(prog: Node, res: Fix1Res) -> int {
    return fix1_tag_node(prog, res);
}

// H1-P4/P5 / H1D-P5: exactly one write to `name` in the body, and
// it is the last direct child, `name = name <step> 1`.
fn fix1_counter_ok(body: Node, name: str, step: str) -> bool {
    if len(body.kids) == 0 {
        return false;
    }
    if fix1_write_count(body, name) != 1 {
        return false;
    }
    let last: Node = body.kids[len(body.kids) - 1];
    if last.kind != 11 || last.name != name {
        return false;
    }
    let site: [int] = fix1_write_site(body, name);
    if site[0] != last.line || site[1] != last.col {
        return false;
    }
    let e: Node = last.kids[0];
    if e.kind != 40 || e.name != step {
        return false;
    }
    if !fix1_is_var(e.kids[0], name) {
        return false;
    }
    return e.kids[1].kind == 25 && e.kids[1].ival == 1;
}

fn fix1_array_ok(body: Node, arr: str) -> bool {
    if fix1_write_count(body, arr) > 0 {
        return false;
    }
    if fix1_has_move_of(body, arr) {
        return false;
    }
    if fix1_has_field_assign_to(body, arr) {
        return false;
    }
    if fix1_has_push(body) {
        return false;
    }
    if fix1_has_spawn_defer(body) {
        return false;
    }
    return true;
}

// Guard text for a bound, mirroring Python _guard_for_bound.
// bound_kind: 0 = len(a) (no guard), 1 = literal, 2 = var.
// Returns "" (no guard), "FAIL", or "NEVER" (loop never runs —
// record no proof at all), or the guard line.
fn fix1_guard_bound(arr: str, bound_kind: int, bound_val: int, bound_name: str, entry_lit: int, entry_has: bool, env: Fix1Env) -> str {
    if bound_kind == 0 {
        return "";
    }
    let sized: int = fix1_env_sized(env, arr);
    if bound_kind == 1 {
        if sized >= 0 {
            if bound_val <= sized {
                return "";
            }
            return "FAIL";
        }
        if entry_has && entry_lit >= bound_val {
            return "NEVER";
        }
        return "if (" + itoa(bound_val) + " > (" + arr + ").len) forge_fail(\"array index out of bounds\");";
    }
    if sized >= 0 {
        let iv: [int] = fix1_env_interval(env, bound_name);
        if iv[2] == 1 && iv[3] <= sized {
            return "";
        }
        if iv[0] == 1 && iv[1] > sized && entry_has && entry_lit < iv[1] {
            return "FAIL";
        }
    }
    if entry_has {
        return "if (" + itoa(entry_lit) + " < " + bound_name + " && " + bound_name + " > (" + arr + ").len) forge_fail(\"array index out of bounds\");";
    }
    return "if (" + bound_name + " > (" + arr + ").len) forge_fail(\"array index out of bounds\");";
}

// Nearest preceding write of `name` before stmts[pos] in the same
// block (Let/Assign/For binding), or -1.
fn fix1_nearest_entry(stmts: [Node], pos: int, name: str) -> int {
    let mut k: int = pos - 1;
    while k >= 0 {
        let s: Node = stmts[k];
        if (s.kind == 10 || s.kind == 11 || s.kind == 16) && s.name == name {
            return k;
        }
        k = k - 1;
    }
    return -1;
}

// Fix 1 B1-FIX (stale entry): true when `name` is written by any
// statement between the entry write at stmts[k] and the loop at
// stmts[pos]. Writes inside an intervening if/loop/block count:
// the entry value is unknowable there, so the nearest literal is
// stale — a negative runtime entry would turn a "proven" a[i] into
// an unchecked OOB access. Callers treat a stale entry as no entry.
fn fix1_entry_stale(stmts: [Node], k: int, pos: int, name: str) -> bool {
    let mut s: int = k + 1;
    while s < pos {
        if fix1_write_count(stmts[s], name) > 0 {
            return true;
        }
        s = s + 1;
    }
    return false;
}

// ---------- H1: counted while ----------

fn fix1_try_h1(stmt: Node, stmts: [Node], pos: int, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let body: Node = stmt.kids[1];
    let cond: Node = stmt.kids[0];
    if cond.kind != 40 || cond.name != "<" || cond.kids[0].kind != 34 {
        return res;
    }
    let ctr: str = cond.kids[0].name;
    let k: int = fix1_nearest_entry(stmts, pos, ctr);
    if k < 0 {
        return res;
    }
    if fix1_entry_stale(stmts, k, pos, ctr) {
        return res;
    }
    let w: Node = stmts[k];
    if w.kind != 10 && w.kind != 11 {
        return res;
    }
    let entry: Node = w.kids[0];
    if entry.kind != 25 || entry.ival < 0 {
        return res;
    }
    let entry_lit: int = entry.ival;
    if !fix1_counter_ok(body, ctr, "+") {
        return res;
    }
    let bound_expr: Node = cond.kids[1];
    let mut bound_kind: int = -1;
    let mut bound_val: int = 0;
    let mut bound_name: str = "";
    if bound_expr.kind == 35 || bound_expr.kind == 33 {
        bound_kind = 0;
    } else if bound_expr.kind == 25 {
        bound_kind = 1;
        bound_val = bound_expr.ival;
    } else if bound_expr.kind == 34 {
        bound_kind = 2;
        bound_name = bound_expr.name;
        if fix1_write_count(body, bound_name) > 0 {
            return res;
        }
    } else {
        return res;
    }
    let cands: [str] = fix1_candidate_arrays(body, ctr, 0);
    let mut i: int = 0;
    while i < len(cands) {
        let arr: str = cands[i];
        if fix1_is_array_type(fix1_env_type(env, arr)) && fix1_array_ok(body, arr) {
            let mut guard: str = "";
            let mut ok: bool = true;
            if bound_kind == 0 {
                if !fix1_is_len_of(bound_expr, arr) {
                    ok = false;
                }
            } else {
                guard = fix1_guard_bound(arr, bound_kind, bound_val, bound_name, entry_lit, true, env);
                if guard == "FAIL" || guard == "NEVER" {
                    ok = false;
                }
            }
            if ok {
                let uses: Fix1Uses = fix1_collect_uses(body, arr, ctr, 0);
                if len(uses.lines) > 0 {
                    res = fix1_res_add_uses(res, uses);
                    if guard != "" {
                        res = fix1_res_add_guard(res, stmt.line, stmt.col, guard);
                    }
                }
            }
        }
        i = i + 1;
    }
    return res;
}

// ---------- H1-D: descending while ----------

fn fix1_try_h1d(stmt: Node, stmts: [Node], pos: int, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let body: Node = stmt.kids[1];
    let cond: Node = stmt.kids[0];
    if cond.kind != 40 || cond.name != ">" || cond.kids[0].kind != 34 {
        return res;
    }
    let ctr: str = cond.kids[0].name;
    let lexpr: Node = cond.kids[1];
    let mut l_code: str = "";
    let mut l_lo: int = 0;
    let mut l_lok: int = 0;
    if lexpr.kind == 25 {
        if lexpr.ival < 0 {
            return res;
        }
        l_code = itoa(lexpr.ival);
        l_lo = lexpr.ival;
        l_lok = 1;
    } else if lexpr.kind == 34 {
        let iv: [int] = fix1_env_interval(env, lexpr.name);
        if iv[0] == 0 || iv[1] < 0 {
            return res;
        }
        if fix1_write_count(body, lexpr.name) > 0 {
            return res;
        }
        l_code = lexpr.name;
        l_lo = iv[1];
        l_lok = 1;
    } else {
        return res;
    }
    let k: int = fix1_nearest_entry(stmts, pos, ctr);
    if k < 0 {
        return res;
    }
    if fix1_entry_stale(stmts, k, pos, ctr) {
        return res;
    }
    let w: Node = stmts[k];
    if w.kind != 10 && w.kind != 11 {
        return res;
    }
    let entry_expr: Node = w.kids[0];
    let eiv: [int] = fix1_interval(entry_expr, env);
    if eiv[2] == 0 {
        return res;
    }
    if l_lok == 1 && eiv[3] <= l_lo {
        return res;
    }
    if !fix1_counter_ok(body, ctr, "-") {
        return res;
    }
    let e_code: str = fix1_c_expr(entry_expr);
    let mut stable: bool = e_code != "";
    if stable {
        let evs: [str] = fix1_vars_in(entry_expr);
        let mut vi: int = 0;
        while vi < len(evs) {
            let mut s: int = k + 1;
            while s < pos {
                if fix1_write_count(stmts[s], evs[vi]) > 0 {
                    stable = false;
                }
                s = s + 1;
            }
            vi = vi + 1;
        }
    }
    let singleton: bool = eiv[0] == 1 && eiv[1] == eiv[3];
    if !stable && !singleton {
        return res;
    }
    let mut e_val: str = e_code;
    if singleton {
        e_val = itoa(eiv[1]);
    }
    let cands: [str] = fix1_candidate_arrays(body, ctr, 1);
    let mut i: int = 0;
    while i < len(cands) {
        let arr: str = cands[i];
        if fix1_is_array_type(fix1_env_type(env, arr)) && fix1_array_ok(body, arr) {
            let uses_k: Fix1Uses = fix1_collect_uses(body, arr, ctr, 0);
            let uses: Fix1Uses = fix1_collect_uses(body, arr, ctr, 1);
            if len(uses.lines) > 0 {
                let mut cmp: str = ">";
                if len(uses_k.lines) > 0 {
                    cmp = ">=";
                }
                let mut guard: str = "";
                if singleton {
                    guard = "if (" + e_val + " > (" + l_code + ") && " + e_val + " " + cmp + " (" + arr + ").len) forge_fail(\"array index out of bounds\");";
                } else {
                    guard = "if ((" + e_val + ") > (" + l_code + ") && (" + e_val + ") " + cmp + " (" + arr + ").len) forge_fail(\"array index out of bounds\");";
                }
                let mut skip: bool = false;
                if singleton && lexpr.kind == 25 && eiv[1] <= lexpr.ival {
                    skip = true;
                }
                if !skip {
                    res = fix1_res_add_uses(res, uses);
                    res = fix1_res_add_guard(res, stmt.line, stmt.col, guard);
                }
            }
        }
        i = i + 1;
    }
    return res;
}

// ---------- H2: for over range ----------

fn fix1_try_h2(stmt: Node, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let body: Node = stmt.kids[1];
    let ctr: str = stmt.name;
    let it: Node = stmt.kids[0];
    let mut bound_kind: int = -1;
    let mut bound_val: int = 0;
    let mut bound_name: str = "";
    let mut bound_node: Node = it;
    let mut guard_kind: int = -1;
    let mut start_lit: int = 0;
    if it.kind == 35 && it.name == "range" && len(it.kids) == 1 {
        guard_kind = 0;
        let arg: Node = it.kids[0];
        bound_node = arg;
        if arg.kind == 25 {
            bound_kind = 1;
            bound_val = arg.ival;
        } else if arg.kind == 34 {
            bound_kind = 2;
            bound_name = arg.name;
            if fix1_write_count(body, bound_name) > 0 {
                return res;
            }
        } else if arg.kind == 35 || arg.kind == 33 {
            bound_kind = 0;
        } else {
            return res;
        }
    } else if it.kind == 38 {
        guard_kind = 1;
        if it.kids[0].kind != 25 || it.kids[0].ival < 0 {
            return res;
        }
        start_lit = it.kids[0].ival;
        let e: Node = it.kids[1];
        bound_node = e;
        if e.kind == 25 {
            bound_kind = 1;
            bound_val = e.ival;
            if start_lit >= e.ival {
                return res;
            }
        } else if e.kind == 34 {
            bound_kind = 2;
            bound_name = e.name;
            if fix1_write_count(body, bound_name) > 0 {
                return res;
            }
        } else if e.kind == 35 || e.kind == 33 {
            bound_kind = 0;
        } else {
            return res;
        }
    } else {
        return res;
    }
    if fix1_write_count(body, ctr) > 0 {
        return res;
    }
    let cands: [str] = fix1_candidate_arrays(body, ctr, 0);
    let mut i: int = 0;
    while i < len(cands) {
        let arr: str = cands[i];
        if fix1_is_array_type(fix1_env_type(env, arr)) && fix1_array_ok(body, arr) {
            let mut guard: str = "";
            let mut ok: bool = true;
            if bound_kind == 0 {
                if !fix1_is_len_of(bound_node, arr) {
                    ok = false;
                }
            } else if guard_kind == 0 {
                guard = fix1_guard_bound(arr, bound_kind, bound_val, bound_name, 0, false, env);
                if guard == "FAIL" || guard == "NEVER" {
                    ok = false;
                }
                if bound_kind == 1 && bound_val <= 0 {
                    ok = false;
                }
            } else {
                guard = fix1_guard_bound(arr, bound_kind, bound_val, bound_name, start_lit, true, env);
                if guard == "FAIL" || guard == "NEVER" {
                    ok = false;
                }
            }
            if ok {
                let uses: Fix1Uses = fix1_collect_uses(body, arr, ctr, 0);
                if len(uses.lines) > 0 {
                    res = fix1_res_add_uses(res, uses);
                    if guard != "" {
                        res = fix1_res_add_guard(res, stmt.line, stmt.col, guard);
                    }
                }
            }
        }
        i = i + 1;
    }
    return res;
}

// ---------- B2: range analysis (R1–R5) ----------
//
// All R-proofs run through the per-function path only
// (fix1_tag_function -> fix1_analyze_node -> fix1_analyze_block);
// the pooled fix1_analyze_program / fix1_tag_program stay
// lp_test-only (b1fix2 tagging constraint).

// True when any `continue` (kind 19) occurs in `node` without
// descending into nested While/For subtrees (their `continue`
// targets the inner loop, not this one).
fn fix1_has_continue(node: Node) -> bool {
    if node.kind == 19 {
        return true;
    }
    if node.kind == 15 || node.kind == 16 {
        return false;
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        if fix1_has_continue(node.kids[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Loop-body entry env: the outer env with intervals and rel facts
// dropped for every var written in the body subtree, then the
// counted-loop facts applied. The drop is load-bearing: without
// it the scan would "prove" buf[idx] from idx's entry value.
// `stmts`/`pos` locate the loop in its enclosing block (needed
// for the H1/H1-D entry facts).
// B3 (O1-S2): ring-reset facts for the loop-body env. Groups
// the body's `x = x + 1` increments per var (the same grouping
// as fix1_try_r1) and, for each var with exactly one increment
// whose ring candidate holds with a known w_hi, sets
// `idx in [0, w_hi-1]` on env_body, INTERSECTED with any
// interval idx already has there (a counter fact and a ring fact
// cannot co-occur, but neither fact may ever widen the other).
// Preconditions are read on env_outer (the env outside the loop),
// exactly as fix1_try_r1 reads them.
fn fix1_ring_body_facts(stmt: Node, stmts: [Node], pos: int, env_outer: Fix1Env, env_body0: Fix1Env) -> Fix1Env {
    let mut env: Fix1Env = env_body0;
    let body: Node = stmt.kids[1];
    if len(body.kids) == 0 {
        return env;
    }
    let mut inames: [str] = [];
    let mut iposs: [int] = [];
    let mut icnts: [int] = [];
    let mut i: int = 0;
    while i < len(body.kids) {
        let s: Node = body.kids[i];
        if s.kind == 11 && s.kids[0].kind == 40 && s.kids[0].name == "+" && s.kids[0].kids[0].kind == 34 && s.kids[0].kids[0].name == s.name && s.kids[0].kids[1].kind == 25 && s.kids[0].kids[1].ival == 1 {
            let mut j: int = 0;
            let mut found: bool = false;
            while j < len(inames) {
                if inames[j] == s.name {
                    icnts[j] = icnts[j] + 1;
                    found = true;
                }
                j = j + 1;
            }
            if !found {
                push(inames, s.name);
                push(iposs, i);
                push(icnts, 1);
            }
        }
        i = i + 1;
    }
    let mut vi: int = 0;
    while vi < len(inames) {
        if icnts[vi] == 1 {
            let cand: [int] = fix1_ring_candidate(stmt, stmts, pos, env_outer, inames[vi], iposs[vi]);
            if cand[0] == 1 && cand[1] == 1 {
                let cur: [int] = fix1_env_interval(env, inames[vi]);
                let mut nlo: int = 0;
                if cur[0] == 1 && cur[1] > 0 {
                    nlo = cur[1];
                }
                let mut nhi: int = cand[2] - 1;
                if cur[2] == 1 && cur[3] < nhi {
                    nhi = cur[3];
                }
                if nhi >= nlo {
                    env = fix1_env_set_interval(env, inames[vi], [1, nlo, 1, nhi]);
                }
            }
        }
        vi = vi + 1;
    }
    return env;
}

fn fix1_body_env(stmt: Node, stmts: [Node], pos: int, env0: Fix1Env) -> Fix1Env {
    let mut env: Fix1Env = fix1_env_deep_copy(env0);
    let body: Node = stmt.kids[1];
    let written: [str] = fix1_written_names(body);
    let mut i: int = 0;
    while i < len(written) {
        env = fix1_env_drop_interval(env, written[i]);
        env = fix1_env_drop_rel(env, written[i]);
        i = i + 1;
    }
    if stmt.kind == 16 {
        env = fix1_env_drop_interval(env, stmt.name);
        env = fix1_env_drop_rel(env, stmt.name);
    }
    if stmt.kind == 15 {
        let cond: Node = stmt.kids[0];
        // H1: while ctr < B -> ctr in [L, B_hi-1], rel {B} for a
        // var bound; [L, B-1] with no rel for a literal bound
        // (Python _loop_counter_facts: no clamp, no B >= 1 check).
        if cond.kind == 40 && cond.name == "<" && cond.kids[0].kind == 34 && (cond.kids[1].kind == 34 || cond.kids[1].kind == 25) {
            let ctr: str = cond.kids[0].name;
            let k: int = fix1_nearest_entry(stmts, pos, ctr);
            let mut ok: bool = false;
            let mut lo: int = 0;
            if k >= 0 {
                let w: Node = stmts[k];
                if (w.kind == 10 || w.kind == 11) && w.kids[0].kind == 25 && w.kids[0].ival >= 0 && !fix1_entry_stale(stmts, k, pos, ctr) {
                    lo = w.kids[0].ival;
                    ok = true;
                }
            }
            if cond.kids[1].kind == 25 {
                if ok && fix1_counter_ok(body, ctr, "+") {
                    let hi: int = cond.kids[1].ival - 1;
                    env = fix1_env_set_interval(env, ctr, [1, lo, 1, hi]);
                }
            } else {
                let bname: str = cond.kids[1].name;
                let mut hi: int = 0;
                let biv: [int] = fix1_env_interval(env, bname);
                if ok && biv[2] == 1 && fix1_counter_ok(body, ctr, "+") && fix1_write_count(body, bname) == 0 && biv[3] >= 1 {
                    hi = biv[3] - 1;
                    if hi < lo {
                        hi = lo;
                    }
                    env = fix1_env_set_interval(env, ctr, [1, lo, 1, hi]);
                    env = fix1_env_rel_add(env, ctr, bname);
                }
            }
        }
        // Fix 2 (a1): a BinOp bound (e.g. `n * n`) — the counter
        // interval is [lo, hi-1] when the bound's upper end is
        // known and no var in the bound is written in the body.
        // No rel fact for a BinOp bound. Mirrors Python
        // _loop_counter_facts. The hi clamp matches the Var
        // branch above (never-runs loops only; the body never
        // executes then).
        if cond.kind == 40 && cond.name == "<" && cond.kids[0].kind == 34 && cond.kids[1].kind == 40 {
            let ctr: str = cond.kids[0].name;
            let k: int = fix1_nearest_entry(stmts, pos, ctr);
            let mut ok: bool = false;
            let mut lo: int = 0;
            if k >= 0 {
                let w: Node = stmts[k];
                if (w.kind == 10 || w.kind == 11) && w.kids[0].kind == 25 && w.kids[0].ival >= 0 && !fix1_entry_stale(stmts, k, pos, ctr) {
                    lo = w.kids[0].ival;
                    ok = true;
                }
            }
            let biv: [int] = fix1_interval(cond.kids[1], env);
            if ok && biv[2] == 1 && fix1_counter_ok(body, ctr, "+") && fix1_bound_vars_invariant(cond.kids[1], body) {
                let mut hi: int = biv[3] - 1;
                if hi < lo {
                    hi = lo;
                }
                env = fix1_env_set_interval(env, ctr, [1, lo, 1, hi]);
            }
        }
        // H1-D: while ctr > L -> ctr in [L_lo+1, hi_E].
        if cond.kind == 40 && cond.name == ">" && cond.kids[0].kind == 34 && cond.kids[1].kind == 34 {
            let ctr: str = cond.kids[0].name;
            let lname: str = cond.kids[1].name;
            let k: int = fix1_nearest_entry(stmts, pos, ctr);
            let mut ok: bool = false;
            let mut lo: int = 0;
            let mut hi: int = 0;
            if k >= 0 {
                let w: Node = stmts[k];
                if (w.kind == 10 || w.kind == 11) && !fix1_entry_stale(stmts, k, pos, ctr) {
                    let eiv: [int] = fix1_interval(w.kids[0], env);
                    if eiv[0] == 1 && eiv[2] == 1 && eiv[1] >= 0 {
                        lo = eiv[1];
                        hi = eiv[3];
                        ok = true;
                    }
                }
            }
            let liv: [int] = fix1_env_interval(env, lname);
            if ok && liv[0] == 1 && liv[1] >= 0 && liv[3] >= 0 && fix1_counter_ok(body, ctr, "-") && fix1_write_count(body, lname) == 0 {
                lo = liv[1] + 1;
                if lo > hi {
                    lo = hi;
                }
                env = fix1_env_set_interval(env, ctr, [1, lo, 1, hi]);
            }
        }
        // H1-D with a literal L: [L+1, hi_E], no rel; no fact
        // when the entry hi <= L (loop never runs — Python
        // _loop_counter_facts returns None there).
        if cond.kind == 40 && cond.name == ">" && cond.kids[0].kind == 34 && cond.kids[1].kind == 25 && cond.kids[1].ival >= 0 {
            let ctr: str = cond.kids[0].name;
            let l_lo: int = cond.kids[1].ival;
            let k: int = fix1_nearest_entry(stmts, pos, ctr);
            if k >= 0 {
                let w: Node = stmts[k];
                if (w.kind == 10 || w.kind == 11) && !fix1_entry_stale(stmts, k, pos, ctr) {
                    let eiv: [int] = fix1_interval(w.kids[0], env);
                    if eiv[2] == 1 && eiv[3] > l_lo && fix1_counter_ok(body, ctr, "-") {
                        env = fix1_env_set_interval(env, ctr, [1, l_lo + 1, 1, eiv[3]]);
                    }
                }
            }
        }
    }
    if stmt.kind == 16 {
        let rng: Node = stmt.kids[0];
        if rng.kind == 38 {
            let s_iv: [int] = fix1_interval(rng.kids[0], env);
            let e_iv: [int] = fix1_interval(rng.kids[1], env);
            if s_iv[0] == 1 && e_iv[2] == 1 {
                // Unclamped [s, e-1] (Python _loop_counter_facts):
                // an empty range 0..0 gives [0, -1], and the R5
                // guard text must read -1, not the clamped 0.
                let hi: int = e_iv[3] - 1;
                env = fix1_env_set_interval(env, stmt.name, [1, s_iv[1], 1, hi]);
            }
        } else if rng.kind == 25 {
            env = fix1_env_set_interval(env, stmt.name, [1, 0, 1, rng.ival - 1]);
        } else if rng.kind == 34 {
            let b_iv: [int] = fix1_env_interval(env, rng.name);
            if b_iv[2] == 1 && b_iv[3] >= 1 {
                env = fix1_env_set_interval(env, stmt.name, [1, 0, 1, b_iv[3] - 1]);
                env = fix1_env_rel_add(env, stmt.name, rng.name);
            }
        }
    }
    // B3 (O1-S2): ring-reset facts, read on the outer env (env0)
    // and applied to the body env after the counter facts.
    env = fix1_ring_body_facts(stmt, stmts, pos, env0, env);
    return env;
}

// B2 (R3-P2(a)): `var < nnode` proven, where nnode is a Var or
// an IntLit.
fn fix1_lt_n(var: str, nnode: Node, env: Fix1Env) -> bool {
    let iv: [int] = fix1_env_interval(env, var);
    if iv[0] == 0 || iv[1] < 0 {
        return false;
    }
    if nnode.kind == 25 {
        if iv[2] == 1 && iv[3] < nnode.ival {
            return true;
        }
        return false;
    }
    if nnode.kind == 34 {
        if fix1_env_rel_has(env, var, nnode.name) {
            return true;
        }
        let niv: [int] = fix1_env_interval(env, nnode.name);
        if niv[0] == 1 && niv[2] == 1 && niv[1] == niv[3] && iv[2] == 1 && iv[3] < niv[1] {
            return true;
        }
        return false;
    }
    return false;
}

// B2 (R1): one ring var's attempt. `idx` increments once at
// `inc_pos` and resets once after it; every other `x = x + 1`
// in the body (e.g. the loop counter) belongs to a different var
// and must not abort this var's proof — the driver groups
// increments per var (like the Python mirror) and calls this
// once per var with exactly one increment.
// B3 (O1-S2): one ring var's recognition, shared by fix1_try_r1_var
// (R1 coverage) and fix1_ring_body_facts (the O1-S2 loop-top ring
// fact). Returns [has, whi_has, whi, reset_pos]: has=1 when the
// ring-reset preconditions hold (exactly one `idx = idx + 1`
// increment at inc_pos, exactly one reset If after it — == / >= w,
// no else, then-branch exactly one `idx = c` literal assignment —
// w >= 1 and invariant, entry literal, no `continue` between
// increment and reset); whi is w's interval upper end when known
// (literal w: the literal; var w: env hi), whi_has=0 otherwise.
fn fix1_ring_candidate(stmt: Node, stmts: [Node], pos: int, env: Fix1Env, idx: str, inc_pos: int) -> [int] {
    let mut no: [int] = [0, 0, 0, -1];
    let body: Node = stmt.kids[1];
    if len(body.kids) == 0 {
        return no;
    }
    // reset: if idx == w { idx = c; } / if idx >= w { idx = c; }
    // (no else, then-branch exactly one literal assignment),
    // exactly one, after the increment.
    let mut reset_pos: int = -1;
    let mut w: Node = new_node(0, 0, 0);
    let mut cval: int = 0;
    let mut i: int = inc_pos + 1;
    while i < len(body.kids) {
        let s: Node = body.kids[i];
        if s.kind == 14 && len(s.kids) == 2 {
            let cond: Node = s.kids[0];
            if cond.kind == 40 && (cond.name == "==" || cond.name == ">=") && cond.kids[0].kind == 34 && cond.kids[0].name == idx && (cond.kids[1].kind == 34 || cond.kids[1].kind == 25) {
                let thenb: Node = s.kids[1];
                if len(thenb.kids) == 1 && thenb.kids[0].kind == 11 && thenb.kids[0].name == idx && thenb.kids[0].kids[0].kind == 25 {
                    if reset_pos >= 0 {
                        return no;
                    }
                    reset_pos = i;
                    w = cond.kids[1];
                    cval = thenb.kids[0].kids[0].ival;
                }
            }
        }
        i = i + 1;
    }
    if reset_pos < 0 {
        return no;
    }
    // No `continue` in the direct-child statements strictly
    // between increment and reset — it would skip the reset and
    // the next iteration could start with idx == w (a
    // design-note soundness gap, fixed here). The increment and
    // reset need not be adjacent: uses between them simply keep
    // their checks.
    let mut cj: int = inc_pos + 1;
    while cj < reset_pos {
        if fix1_has_continue(body.kids[cj]) {
            return no;
        }
        cj = cj + 1;
    }
    if fix1_write_count(body, idx) != 2 {
        return no;
    }
    let mut whi_has: int = 0;
    let mut whi: int = 0;
    let mut wv: int = 0;
    if w.kind == 25 {
        wv = w.ival;
        if wv < 1 {
            return no;
        }
        whi_has = 1;
        whi = wv;
    } else if w.kind == 34 {
        let wiv: [int] = fix1_env_interval(env, w.name);
        if wiv[0] == 0 || wiv[1] < 1 {
            return no;
        }
        if fix1_write_count(body, w.name) > 0 {
            return no;
        }
        whi_has = wiv[2];
        whi = wiv[3];
    } else {
        return no;
    }
    // entry rule: literal w needs L < w and c in [0, w);
    // var w needs L == 0 and c == 0.
    let k: int = fix1_nearest_entry(stmts, pos, idx);
    let mut entry_ok: bool = false;
    if k >= 0 {
        let es: Node = stmts[k];
        if (es.kind == 10 || es.kind == 11) && es.kids[0].kind == 25 && !fix1_entry_stale(stmts, k, pos, idx) {
            let lval: int = es.kids[0].ival;
            if w.kind == 25 {
                if lval >= 0 && lval < wv && cval >= 0 && cval < wv {
                    entry_ok = true;
                }
            } else {
                if lval == 0 && cval == 0 {
                    entry_ok = true;
                }
            }
        }
    }
    if !entry_ok {
        return no;
    }
    return [1, whi_has, whi, reset_pos];
}

// B2 (R1): one ring var's attempt. `idx` increments once at
// `inc_pos` and resets once after it; every other `x = x + 1`
// in the body (e.g. the loop counter) belongs to a different var
// and must not abort this var's proof — the driver groups
// increments per var (like the Python mirror) and calls this
// once per var with exactly one increment. Recognition lives in
// fix1_ring_candidate (B3); this keeps only the array/coverage
// work.
fn fix1_try_r1_var(stmt: Node, stmts: [Node], pos: int, env: Fix1Env, res0: Fix1Res, idx: str, inc_pos: int) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let body: Node = stmt.kids[1];
    if len(body.kids) == 0 {
        return res;
    }
    let cand: [int] = fix1_ring_candidate(stmt, stmts, pos, env, idx, inc_pos);
    if cand[0] == 0 {
        return res;
    }
    let reset_pos: int = cand[3];
    let w: Node = body.kids[reset_pos].kids[0].kids[1];
    let wcode: str = fix1_c_expr(w);
    let arrs: [str] = fix1_candidate_arrays(body, idx, 0);
    let mut ai: int = 0;
    while ai < len(arrs) {
        let arr: str = arrs[ai];
        if !fix1_is_array_type(fix1_env_type(env, arr)) {
            ai = ai + 1;
            continue;
        }
        let uses: Fix1Uses = fix1_collect_uses(body, arr, idx, 0);
        let mut cover_lines: [int] = [];
        let mut cover_cols: [int] = [];
        let mut ui: int = 0;
        while ui < len(uses.lines) {
            let sp: int = uses.pos[ui];
            if sp < inc_pos || sp > reset_pos {
                push(cover_lines, uses.lines[ui]);
                push(cover_cols, uses.cols[ui]);
            }
            ui = ui + 1;
        }
        if len(cover_lines) > 0 {
            let guard: str = "if (" + wcode + " > (" + arr + ").len) forge_fail(\"array index out of bounds\");";
            res = fix1_res_add_guard(res, stmt.line, stmt.col, guard);
            let mut ci: int = 0;
            while ci < len(cover_lines) {
                res = fix1_res_add_cov(res, cover_lines[ci], cover_cols[ci]);
                ci = ci + 1;
            }
        }
        ai = ai + 1;
    }
    return res;
}

// B2 (R1) driver: group the body's `x = x + 1` increments per
// var and attempt one ring proof per var with exactly one
// increment (a var with two increments, or a var with one
// increment but no reset, contributes nothing). The guard
// `w <= len(buf)` attaches to the loop; uses before the
// increment or after the reset are covered, uses between them
// keep their checks.
fn fix1_try_r1(stmt: Node, stmts: [Node], pos: int, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let body: Node = stmt.kids[1];
    if len(body.kids) == 0 {
        return res;
    }
    let mut inames: [str] = [];
    let mut iposs: [int] = [];
    let mut icnts: [int] = [];
    let mut i: int = 0;
    while i < len(body.kids) {
        let s: Node = body.kids[i];
        // increment: idx = idx + 1
        if s.kind == 11 && s.kids[0].kind == 40 && s.kids[0].name == "+" && s.kids[0].kids[0].kind == 34 && s.kids[0].kids[0].name == s.name && s.kids[0].kids[1].kind == 25 && s.kids[0].kids[1].ival == 1 {
            let mut j: int = 0;
            let mut found: bool = false;
            while j < len(inames) {
                if inames[j] == s.name {
                    icnts[j] = icnts[j] + 1;
                    found = true;
                }
                j = j + 1;
            }
            if !found {
                push(inames, s.name);
                push(iposs, i);
                push(icnts, 1);
            }
        }
        i = i + 1;
    }
    let mut vi: int = 0;
    while vi < len(inames) {
        if icnts[vi] == 1 {
            res = fix1_try_r1_var(stmt, stmts, pos, env, res, inames[vi], iposs[vi]);
        }
        vi = vi + 1;
    }
    return res;
}

// Fix 2 (b): true when the loop provably runs >= 1 iteration at
// first entry, judged with the env at the loop statement. While
// `<`: counter's max entry value < bound's min; `>`: counter's
// min > bound's max. For range(arg): arg >= 1. For RangeLit s..e:
// s_hi < e_lo. For an IntLit iterable: value >= 1. For a Var
// iterable: a sized array runs iff its length > 0, an int count
// iff its interval lo >= 1. Anything else: false. Uses the env at
// the loop statement (the first-entry env), NOT the body env —
// the body env already assumes the loop runs, which would be
// circular. Mirrors Python _loop_runs_entry.
fn fix1_loop_runs(stmt: Node, env: Fix1Env) -> bool {
    if stmt.kind == 15 {
        let cond: Node = stmt.kids[0];
        if cond.kind != 40 || cond.kids[0].kind != 34 {
            return false;
        }
        let civ: [int] = fix1_env_interval(env, cond.kids[0].name);
        let biv: [int] = fix1_interval(cond.kids[1], env);
        if cond.name == "<" {
            return civ[2] == 1 && biv[0] == 1 && civ[3] < biv[1];
        }
        if cond.name == ">" {
            return civ[0] == 1 && biv[2] == 1 && civ[1] > biv[3];
        }
        return false;
    }
    if stmt.kind == 16 {
        let it: Node = stmt.kids[0];
        if it.kind == 35 && it.name == "range" && len(it.kids) == 1 {
            let aiv: [int] = fix1_interval(it.kids[0], env);
            return aiv[0] == 1 && aiv[1] >= 1;
        }
        if it.kind == 38 {
            let siv: [int] = fix1_interval(it.kids[0], env);
            let eiv: [int] = fix1_interval(it.kids[1], env);
            return siv[2] == 1 && eiv[0] == 1 && siv[3] < eiv[1];
        }
        if it.kind == 25 {
            return it.ival >= 1;
        }
        if it.kind == 34 {
            let sn: int = fix1_env_sized(env, it.name);
            if sn >= 0 {
                return sn > 0;
            }
            let iv: [int] = fix1_env_interval(env, it.name);
            return iv[0] == 1 && iv[1] >= 1;
        }
        return false;
    }
    return false;
}

// Fix 2 (b): true when `node` can exit the enclosing function or
// loop early: a Return anywhere, or a Break/Continue not nested
// inside a loop of its own (depth 0). While/For bodies nest one
// level deeper. Node kinds: Return 17, Break 18, Continue 19,
// While 15, For 16. Mirrors Python _may_exit_early.
fn fix1_may_exit_early(node: Node, depth: int) -> bool {
    if node.kind == 17 {
        return true;
    }
    if (node.kind == 18 || node.kind == 19) && depth == 0 {
        return true;
    }
    if node.kind == 15 || node.kind == 16 {
        let mut i: int = 0;
        while i < len(node.kids) {
            if fix1_may_exit_early(node.kids[i], depth + 1) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        if fix1_may_exit_early(node.kids[i], depth) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Fix 2 (b): true when any statement in `body` before `child`
// can exit early. `child` is identified by (line, col); when it
// is not a direct child statement of `body`, return true (block
// the move). Mirrors Python _prefix_early_exit.
fn fix1_prefix_early_exit(body: Node, child: Node) -> bool {
    let mut idx: int = -1;
    let mut i: int = 0;
    while i < len(body.kids) {
        if body.kids[i].line == child.line && body.kids[i].col == child.col {
            idx = i;
        }
        i = i + 1;
    }
    if idx < 0 {
        return true;
    }
    i = 0;
    while i < idx {
        if fix1_may_exit_early(body.kids[i], 0) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Fix 2 (b): the loop a guard recorded for the innermost loop
// should attach to, walking outward while every crossed ancestor
// passes the four gates: (1) the child loop is a direct child
// statement of the ancestor's body, (2) the ancestor provably
// runs >= 1 iteration at first entry, (3) the array and every
// free var are invariant in the ancestor's body, (4) no early
// exit in the ancestor's body before the child loop. Returns the
// target loop node; the innermost loop when no ancestor passes
// (B2 behavior). Mirrors Python _guard_move_target.
fn fix1_guard_move_target(loops: [Node], arr: str, free_vars: [str], res: Fix1Res) -> Node {
    let mut target: Node = loops[len(loops) - 1];
    let mut j: int = len(loops) - 2;
    while j >= 0 {
        let l: Node = loops[j];
        let child: Node = loops[j + 1];
        let lbody: Node = l.kids[1];
        // (1) child must be a direct child statement of L's body.
        let mut is_child: bool = false;
        let mut ci: int = 0;
        while ci < len(lbody.kids) {
            if lbody.kids[ci].line == child.line && lbody.kids[ci].col == child.col {
                is_child = true;
            }
            ci = ci + 1;
        }
        if !is_child {
            return target;
        }
        // (2) L provably runs >= 1 iteration at first entry.
        if !fix1_res_runs(res, l.line, l.col) {
            return target;
        }
        // (3) the array and every free var are invariant in L's body.
        if !fix1_array_ok(lbody, arr) {
            return target;
        }
        let mut vi: int = 0;
        let mut inv: bool = true;
        while vi < len(free_vars) {
            if fix1_write_count(lbody, free_vars[vi]) > 0 {
                inv = false;
            }
            vi = vi + 1;
        }
        if !inv {
            return target;
        }
        // (4) no early exit in L's body before the child loop.
        if fix1_prefix_early_exit(lbody, child) {
            return target;
        }
        target = l;
        j = j - 1;
    }
    return target;
}

// B2 (R2): `a[i % n]` — i >= 0, n > 0 proven, guard
// `n <= len(a)` on the innermost loop. The '%' node goes plain.
fn fix1_try_r2(ix: Node, env: Fix1Env, loops: [Node], res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    if len(loops) == 0 {
        return res;
    }
    let idx: Node = ix.kids[1];
    if idx.kind != 40 || idx.name != "%" {
        return res;
    }
    if idx.kids[0].kind != 34 || (idx.kids[1].kind != 34 && idx.kids[1].kind != 25) {
        return res;
    }
    let iiv: [int] = fix1_env_interval(env, idx.kids[0].name);
    if iiv[0] == 0 || iiv[1] < 0 {
        return res;
    }
    let mut n_ok: bool = false;
    if idx.kids[1].kind == 25 {
        if idx.kids[1].ival > 0 {
            n_ok = true;
        }
    } else {
        let niv: [int] = fix1_env_interval(env, idx.kids[1].name);
        if niv[0] == 1 && niv[1] > 0 {
            n_ok = true;
        }
    }
    if !n_ok {
        return res;
    }
    let loopn: Node = loops[len(loops) - 1];
    let body: Node = loopn.kids[1];
    let arr: str = ix.kids[0].name;
    if !fix1_is_array_type(fix1_env_type(env, arr)) {
        return res;
    }
    if !fix1_array_ok(body, arr) {
        return res;
    }
    // Only n's invariance is checked: i's interval comes from
    // the body env, which already dropped it when i is written
    // (except the sound loop-counter case, where the fact holds).
    if idx.kids[1].kind == 34 && fix1_write_count(body, idx.kids[1].name) > 0 {
        return res;
    }
    let ncode: str = fix1_c_expr(idx.kids[1]);
    let guard: str = "if (" + ncode + " > (" + arr + ").len) forge_fail(\"array index out of bounds\");";
    // Fix 2 (b): record the guard on the move target (outermost
    // provably-running, invariant ancestor), not unconditionally
    // on the innermost loop.
    let mut free_vars: [str] = [];
    if idx.kids[1].kind == 34 {
        push(free_vars, idx.kids[1].name);
    }
    let target: Node = fix1_guard_move_target(loops, arr, free_vars, res);
    res = fix1_res_add_guard(res, target.line, target.col, guard);
    res = fix1_res_add_cov(res, ix.line, ix.col);
    res = fix1_res_add_plain(res, idx.line, idx.col);
    return res;
}

// B2 (R3): `a[i*n+k]` — i and k each < the SAME n (relational
// fact), n in [lo,hi] with 1 <= lo and hi*hi <= INT_MAX, guard
// `n*n <= len(a)`. The '*' and '+' nodes go plain.
fn fix1_try_r3(ix: Node, env: Fix1Env, loops: [Node], res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    if len(loops) == 0 {
        return res;
    }
    let idx: Node = ix.kids[1];
    if idx.kind != 40 || idx.name != "+" {
        return res;
    }
    // One side is the '*' (either order: `i*n+k` or `n*i+k`),
    // the other side is the Var k.
    let mut star: Node = idx.kids[0];
    let mut other: Node = idx.kids[1];
    if star.kind != 40 || star.name != "*" {
        star = idx.kids[1];
        other = idx.kids[0];
    }
    if star.kind != 40 || star.name != "*" {
        return res;
    }
    if other.kind != 34 {
        return res;
    }
    // star sides: one Var (i), one Var|IntLit (n), either order.
    let mut i_node: Node = star.kids[0];
    let mut n_node: Node = star.kids[1];
    if i_node.kind != 34 && n_node.kind == 34 {
        let tmpn: Node = i_node;
        i_node = n_node;
        n_node = tmpn;
    }
    if i_node.kind != 34 || (n_node.kind != 34 && n_node.kind != 25) {
        return res;
    }
    // P3: n interval [lo,hi], 1 <= lo, hi <= floor(sqrt(INT_MAX)).
    let niv: [int] = fix1_env_interval(env, n_node.name);
    if n_node.kind == 25 {
        if n_node.ival < 1 || n_node.ival > 3037000499 {
            return res;
        }
    } else {
        if niv[0] == 0 || niv[1] < 1 || niv[2] == 0 || niv[3] > 3037000499 {
            return res;
        }
    }
    // P2: i < n and k < n (same n).
    if !fix1_lt_n(i_node.name, n_node, env) {
        return res;
    }
    if !fix1_lt_n(other.name, n_node, env) {
        return res;
    }
    let loopn: Node = loops[len(loops) - 1];
    let body: Node = loopn.kids[1];
    let arr: str = ix.kids[0].name;
    if !fix1_is_array_type(fix1_env_type(env, arr)) {
        return res;
    }
    if !fix1_array_ok(body, arr) {
        return res;
    }
    // Only n's invariance is checked (same reason as R2: i's and
    // k's intervals come from the body env, which already dropped
    // them when written outside the sound loop-counter case).
    if n_node.kind == 34 && fix1_write_count(body, n_node.name) > 0 {
        return res;
    }
    let ncode: str = fix1_c_expr(n_node);
    let guard: str = "if (" + ncode + " * " + ncode + " > (" + arr + ").len) forge_fail(\"array index out of bounds\");";
    // Fix 2 (b): record the guard on the move target.
    let mut free_vars: [str] = [];
    if n_node.kind == 34 {
        push(free_vars, n_node.name);
    }
    let target: Node = fix1_guard_move_target(loops, arr, free_vars, res);
    res = fix1_res_add_guard(res, target.line, target.col, guard);
    res = fix1_res_add_cov(res, ix.line, ix.col);
    res = fix1_res_add_plain(res, star.line, star.col);
    res = fix1_res_add_plain(res, idx.line, idx.col);
    return res;
}

// B2 (R5): `a[e]` with a proven interval [lo,hi], lo >= 0,
// guard `hi < len(a)`. Inside a loop the guard goes on the
// innermost loop; straight-line it rides on the Index node.
fn fix1_try_r5(ix: Node, env: Fix1Env, loops: [Node], res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let iv: [int] = fix1_interval(ix.kids[1], env);
    if iv[0] == 0 || iv[1] < 0 || iv[2] == 0 {
        return res;
    }
    let arr: str = ix.kids[0].name;
    if !fix1_is_array_type(fix1_env_type(env, arr)) {
        return res;
    }
    let guard: str = "if (" + itoa(iv[3]) + " >= (" + arr + ").len) forge_fail(\"array index out of bounds\");";
    if len(loops) > 0 {
        let loopn: Node = loops[len(loops) - 1];
        let body: Node = loopn.kids[1];
        if !fix1_array_ok(body, arr) {
            return res;
        }
        // No write check on the index vars: the interval comes
        // from the body env, which already dropped it when a var
        // is written (except the sound loop-counter case — e.g.
        // bid_px[j2] with j2 the scan-loop counter).
        // Fix 2 (b): record the guard on the move target (an R5
        // guard has no free vars).
        let free_vars: [str] = [];
        let target: Node = fix1_guard_move_target(loops, arr, free_vars, res);
        res = fix1_res_add_guard(res, target.line, target.col, guard);
    } else {
        res = fix1_res_add_idxguard(res, ix.line, ix.col, guard);
    }
    res = fix1_res_add_cov(res, ix.line, ix.col);
    return res;
}

// B2: scan one statement's own expressions with the current env
// for R2/R3/R5 uses. Skips Block and While/For subtrees (bodies
// are analysed separately); If conds ARE scanned (they are this
// statement's own expression). FieldAccess-base Indexes are
// never uses, but their index/base are scanned.
// B3 (O1): True when a BinOp/UnaryOp's checked helper can be
// dropped — the interval proof shows the operation cannot
// overflow (and, for / %, cannot divide by zero or hit
// INT_MIN / -1). Mirrors codegen's _binop_safe on the analysis's
// (loop-aware) intervals. Any known interval end is within
// ±2^40, so the explicit int64 check below is belt-and-braces.
fn fix1_o1_plain(e: Node, env: Fix1Env) -> bool {
    if e.kind == 41 && e.name == "-" {
        let inner: [int] = fix1_interval(e.kids[0], env);
        return inner[0] == 1;
    }
    if e.kind != 40 || (e.name != "+" && e.name != "-" && e.name != "*" && e.name != "/" && e.name != "%") {
        return false;
    }
    // Type gate (defense in depth): a KNOWN non-int operand type
    // disqualifies the node.
    let mut si: int = 0;
    while si < 2 {
        let side: Node = e.kids[si];
        if side.kind == 34 {
            let t: str = fix1_env_type(env, side.name);
            if t != "" && t != "int" {
                return false;
            }
        }
        si = si + 1;
    }
    if e.name == "+" || e.name == "-" || e.name == "*" {
        let iv: [int] = fix1_interval(e, env);
        if iv[0] == 1 && iv[2] == 1 && iv[1] >= fix1_int_min() && iv[3] <= fix1_int_max() {
            return true;
        }
        return false;
    }
    // / and %: divisor excludes 0, and not (dividend possibly
    // INT_MIN and divisor contains -1).
    let d: [int] = fix1_interval(e.kids[1], env);
    if !((d[0] == 1 && d[1] >= 1) || (d[2] == 1 && d[3] <= -1)) {
        return false;
    }
    let a: [int] = fix1_interval(e.kids[0], env);
    let mut contains_neg1: bool = false;
    if (d[0] == 0 || d[1] <= -1) && (d[2] == 0 || d[3] >= -1) {
        contains_neg1 = true;
    }
    if a[0] == 0 && contains_neg1 {
        return false;
    }
    return true;
}

// B3: scan a statement's OWN expressions for O1 plain
// BinOp/UnaryOp nodes with the current env. Same traversal
// discipline as fix1_scan_r_uses (stop at Block/While/For; If
// conds scanned; FieldAccess-base Index: scan index/base only),
// plus SKIP Defer (23) / Spawn (21) subtrees entirely — a
// deferred call's args are re-evaluated at block exit and a
// spawned call runs in another thread, so the current env is
// not valid for either.
fn fix1_scan_o1_uses(node: Node, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    if node.kind == 9 || node.kind == 15 || node.kind == 16 || node.kind == 21 || node.kind == 23 {
        return res;
    }
    if node.kind == 32 && node.kids[0].kind == 36 {
        res = fix1_scan_o1_uses(node.kids[0].kids[1], env, res);
        res = fix1_scan_o1_uses(node.kids[0].kids[0], env, res);
        return res;
    }
    if (node.kind == 40 || node.kind == 41) && fix1_o1_plain(node, env) {
        res = fix1_res_add_plain(res, node.line, node.col);
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        res = fix1_scan_o1_uses(node.kids[i], env, res);
        i = i + 1;
    }
    return res;
}

// Fix 2 (a2): scan a While cond's bound BinOp(s) with the
// pre-loop env. Only cond.right (the bound) is scanned, and only
// when no var in it is written in the body — the bound is
// re-evaluated every iteration, so the pre-loop env is valid for
// it only under that gate. The counter (cond.left) is never
// scanned: it varies across iterations. Reuses
// fix1_scan_o1_uses, so the Defer/Spawn skip applies
// automatically. Mirrors Python _scan_o1_cond.
fn fix1_scan_o1_cond(stmt: Node, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let cond: Node = stmt.kids[0];
    if cond.kind != 40 || (cond.name != "<" && cond.name != ">") || cond.kids[0].kind != 34 {
        return res;
    }
    let bound: Node = cond.kids[1];
    let body: Node = stmt.kids[1];
    if !fix1_bound_vars_invariant(bound, body) {
        return res;
    }
    return fix1_scan_o1_uses(bound, env, res);
}

fn fix1_scan_r_uses(node: Node, env: Fix1Env, loops: [Node], res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    if node.kind == 9 || node.kind == 15 || node.kind == 16 {
        return res;
    }
    if node.kind == 32 && node.kids[0].kind == 36 {
        res = fix1_scan_r_uses(node.kids[0].kids[1], env, loops, res);
        res = fix1_scan_r_uses(node.kids[0].kids[0], env, loops, res);
        return res;
    }
    if node.kind == 36 && node.kids[0].kind == 34 {
        if !fix1_res_covers(res, node.line, node.col) {
            res = fix1_try_r2(node, env, loops, res);
        }
        if !fix1_res_covers(res, node.line, node.col) {
            res = fix1_try_r3(node, env, loops, res);
        }
        if !fix1_res_covers(res, node.line, node.col) {
            res = fix1_try_r5(node, env, loops, res);
        }
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        res = fix1_scan_r_uses(node.kids[i], env, loops, res);
        i = i + 1;
    }
    return res;
}

// ---------- block analysis ----------

fn fix1_apply_let(stmt: Node, env0: Fix1Env) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let name: str = stmt.name;
    let ann: str = stmt.sval;
    let init: Node = stmt.kids[0];
    let mut t: str = ann;
    if t == "" {
        t = fix1_derive_type(init, env);
    }
    env = fix1_env_set_type(env, name, t);
    // B2: the mod fact is read on the pre-assign env (x and n must
    // be proven before this assignment); it then overwrites the
    // plain interval when it holds.
    let mrel: str = fix1_mod_rel(init, env);
    let miv: [int] = fix1_mod_iv(init, env);
    env = fix1_env_set_interval(env, name, fix1_interval(init, env));
    env = fix1_env_drop_rel(env, name);
    if mrel != "" {
        env = fix1_env_rel_add(env, name, mrel);
        if miv[0] == 1 {
            env = fix1_env_set_interval(env, name, [1, miv[1], 1, miv[2]]);
        }
    }
    let n: int = fix1_sized_len(ann);
    if n >= 0 {
        env = fix1_env_set_sized(env, name, n);
    } else if init.kind == 34 && fix1_env_sized(env, init.name) >= 0 {
        env = fix1_env_set_sized(env, name, fix1_env_sized(env, init.name));
    } else {
        env = fix1_env_drop_sized(env, name);
    }
    return env;
}

fn fix1_drop_written(node: Node, env0: Fix1Env) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let names: [str] = fix1_written_names(node);
    let mut i: int = 0;
    while i < len(names) {
        env = fix1_env_drop_interval(env, names[i]);
        env = fix1_env_drop_rel(env, names[i]);
        i = i + 1;
    }
    return env;
}

// R4 post-loop counter interval + stale intervals after a While.
fn fix1_loop_exit(stmt: Node, stmts: [Node], pos: int, env0: Fix1Env) -> Fix1Env {
    let mut env: Fix1Env = env0;
    let body: Node = stmt.kids[1];
    let cond: Node = stmt.kids[0];
    let mut ctr: str = "";
    let mut entry_lit: int = -1;
    let mut bound_hi: int = 0;
    let mut bound_has_hi: bool = false;
    let mut bound_ok: bool = true;
    if cond.kind == 40 && cond.name == "<" && cond.kids[0].kind == 34 {
        ctr = cond.kids[0].name;
        let k: int = fix1_nearest_entry(stmts, pos, ctr);
        if k >= 0 {
            let w: Node = stmts[k];
            if (w.kind == 10 || w.kind == 11) && w.kids[0].kind == 25 && w.kids[0].ival >= 0 {
                entry_lit = w.kids[0].ival;
            }
            // B1-FIX: a stale entry must not feed the R4 post-loop
            // interval (it would poison later H1-D proofs).
            if fix1_entry_stale(stmts, k, pos, ctr) {
                entry_lit = -1;
            }
        }
        let b: Node = cond.kids[1];
        if b.kind == 25 {
            bound_hi = b.ival;
            bound_has_hi = true;
        } else if b.kind == 34 {
            let iv: [int] = fix1_env_interval(env, b.name);
            if iv[2] == 1 {
                bound_hi = iv[3];
                bound_has_hi = true;
            }
            if fix1_write_count(body, b.name) > 0 {
                bound_ok = false;
            }
        }
    }
    env = fix1_drop_written(body, env);
    if ctr != "" && entry_lit >= 0 && bound_ok && fix1_counter_ok(body, ctr, "+") {
        let mut hik: int = 0;
        let mut hi: int = 0;
        if bound_has_hi {
            hik = 1;
            hi = bound_hi;
            if entry_lit > hi {
                hi = entry_lit;
            }
        }
        env = fix1_env_set_interval(env, ctr, [1, entry_lit, hik, hi]);
    }
    // B2 (R4): H1-D post-loop interval [min(E_lo, L_lo),
    // max(E_hi, L_hi)] — normal exit leaves k == L, break leaves
    // k in (L, E_hi], never-run leaves k in [E_lo, E_hi]. L is
    // read on the post-drop env, so a body-written L yields no
    // fact (conservative, like the Python mirror).
    if cond.kind == 40 && cond.name == ">" && cond.kids[0].kind == 34 {
        let ctr2: str = cond.kids[0].name;
        let lexpr: Node = cond.kids[1];
        let mut l_lok: int = 0;
        let mut l_lo: int = 0;
        let mut l_hik: int = 0;
        let mut l_hi: int = 0;
        if lexpr.kind == 25 {
            l_lok = 1;
            l_lo = lexpr.ival;
            l_hik = 1;
            l_hi = lexpr.ival;
        } else if lexpr.kind == 34 {
            let liv: [int] = fix1_env_interval(env, lexpr.name);
            l_lok = liv[0];
            l_lo = liv[1];
            l_hik = liv[2];
            l_hi = liv[3];
        }
        if l_lok == 1 && l_hik == 1 && fix1_counter_ok(body, ctr2, "-") {
            let k2: int = fix1_nearest_entry(stmts, pos, ctr2);
            let mut elo: int = 0;
            let mut ehi: int = 0;
            let mut eok: bool = false;
            if k2 >= 0 {
                let w2: Node = stmts[k2];
                if (w2.kind == 10 || w2.kind == 11) && !fix1_entry_stale(stmts, k2, pos, ctr2) {
                    let eiv: [int] = fix1_interval(w2.kids[0], env);
                    if eiv[0] == 1 && eiv[2] == 1 {
                        elo = eiv[1];
                        ehi = eiv[3];
                        eok = true;
                    }
                }
            }
            if eok {
                let mut nlo: int = elo;
                if l_lo < nlo {
                    nlo = l_lo;
                }
                let mut nhi: int = ehi;
                if l_hi > nhi {
                    nhi = l_hi;
                }
                env = fix1_env_set_interval(env, ctr2, [1, nlo, 1, nhi]);
            }
        }
    }
    return env;
}

// Recurse into every Block under `node` (If arms, Match arms,
// Scope bodies, bare blocks), analyzing each on a copy of env.
// Blocks already entered by analyze_block itself are not passed
// here (While/For bodies are handled by their own branches).
// B2: `loops` is threaded through for the R-scan's guard
// placement.
fn fix1_recurse_blocks(node: Node, env: Fix1Env, res0: Fix1Res, loops: [Node]) -> Fix1Res {
    let mut res: Fix1Res = res0;
    if node.kind == 9 {
        let pair: Fix1Pair = fix1_analyze_block(node.kids, env, res, loops);
        return pair.res;
    }
    let mut i: int = 0;
    while i < len(node.kids) {
        res = fix1_recurse_blocks(node.kids[i], env, res, loops);
        i = i + 1;
    }
    return res;
}

// B3 (O1-S2b): post-reset union interval for an If with no else
// whose cond is `idx == w` / `idx >= w` (Var vs Var/IntLit) and
// whose then-branch is exactly one `idx = c` (IntLit). Returns
// has=1 with the union of [c, c] and idx's pre-If interval, or
// has=0. Sound with no R1 proof needed: after the If, idx is
// either c (then taken) or its pre-If value.
fn fix1_reset_fact(stmt: Node, env: Fix1Env) -> Fix1Reset {
    let mut r: Fix1Reset = Fix1Reset { has: 0, name: "", lo: 0, hi: 0 };
    if stmt.kind != 14 || len(stmt.kids) != 2 {
        return r;
    }
    let cond: Node = stmt.kids[0];
    if cond.kind != 40 || (cond.name != "==" && cond.name != ">=") {
        return r;
    }
    if cond.kids[0].kind != 34 {
        return r;
    }
    if cond.kids[1].kind != 34 && cond.kids[1].kind != 25 {
        return r;
    }
    let idx: str = cond.kids[0].name;
    let thenb: Node = stmt.kids[1];
    if len(thenb.kids) != 1 {
        return r;
    }
    let rs: Node = thenb.kids[0];
    if rs.kind != 11 || rs.name != idx || rs.kids[0].kind != 25 {
        return r;
    }
    let c: int = rs.kids[0].ival;
    let pre: [int] = fix1_env_interval(env, idx);
    if pre[0] == 0 || pre[2] == 0 {
        return r;
    }
    let mut lo: int = c;
    if pre[1] < lo {
        lo = pre[1];
    }
    let mut hi: int = c;
    if pre[3] > hi {
        hi = pre[3];
    }
    r.has = 1;
    r.name = idx;
    r.lo = lo;
    r.hi = hi;
    return r;
}

// Fix 2 (b): record a loop statement's first-entry run verdict
// in the res (1 = provably runs >= 1 iteration).
fn fix1_record_run(stmt: Node, env: Fix1Env, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    let mut run_val: int = 0;
    if fix1_loop_runs(stmt, env) {
        run_val = 1;
    }
    return fix1_res_add_run(res, stmt.line, stmt.col, run_val);
}

fn fix1_analyze_block(stmts: [Node], env0: Fix1Env, res0: Fix1Res, loops: [Node]) -> Fix1Pair {
    let mut env: Fix1Env = env0;
    let mut res: Fix1Res = res0;
    let mut pos: int = 0;
    while pos < len(stmts) {
        let stmt: Node = stmts[pos];
        if stmt.kind == 15 {
            let before: int = len(res.cov_lines);
            res = fix1_try_h1(stmt, stmts, pos, env, res);
            if len(res.cov_lines) == before {
                res = fix1_try_h1d(stmt, stmts, pos, env, res);
            }
            // B2 R1 (independent shape — a loop can be H1 and R1).
            res = fix1_try_r1(stmt, stmts, pos, env, res);
            // Fix 2 (b): record whether this loop provably runs
            // >= 1 iteration at first entry (env at the loop
            // statement). Fix 2 (a2): scan the cond's bound
            // BinOp(s) with the pre-loop env.
            res = fix1_record_run(stmt, env, res);
            res = fix1_scan_o1_cond(stmt, env, res);
            let benv: Fix1Env = fix1_body_env(stmt, stmts, pos, env);
            let mut loops2: [Node] = loops;
            push(loops2, stmt);
            let pair: Fix1Pair = fix1_analyze_block(stmt.kids[1].kids, benv, res, loops2);
            res = pair.res;
            env = fix1_loop_exit(stmt, stmts, pos, env);
        } else if stmt.kind == 16 {
            res = fix1_try_h2(stmt, env, res);
            res = fix1_try_r1(stmt, stmts, pos, env, res);
            // Fix 2 (b): entry verdict for the For loop.
            res = fix1_record_run(stmt, env, res);
            let benv: Fix1Env = fix1_body_env(stmt, stmts, pos, env);
            let mut loops2: [Node] = loops;
            push(loops2, stmt);
            let pair: Fix1Pair = fix1_analyze_block(stmt.kids[1].kids, benv, res, loops2);
            res = pair.res;
            env = fix1_drop_written(stmt.kids[1], env);
            env = fix1_env_drop_interval(env, stmt.name);
            env = fix1_env_drop_rel(env, stmt.name);
        } else if stmt.kind == 14 {
            // B2: scan the condition (evaluated once, current
            // env), then analyse each arm with the condition's
            // facts (singleton var-vs-var included).
            res = fix1_scan_r_uses(stmt.kids[0], env, loops, res);
            // B3: same site for the O1 scan.
            res = fix1_scan_o1_uses(stmt.kids[0], env, res);
            // B3 (O1-S2b): post-reset union fact, read on the
            // pre-If env; applied after the arms drop idx's
            // interval.
            let rf: Fix1Reset = fix1_reset_fact(stmt, env);
            let mut then_env: Fix1Env = fix1_apply_cond_fact(env, stmt.kids[0], true);
            let pair: Fix1Pair = fix1_analyze_block(stmt.kids[1].kids, then_env, res, loops);
            res = pair.res;
            if len(stmt.kids) == 3 {
                let mut else_env: Fix1Env = fix1_apply_cond_fact(env, stmt.kids[0], false);
                let pair2: Fix1Pair = fix1_analyze_block(stmt.kids[2].kids, else_env, res, loops);
                res = pair2.res;
            }
            env = fix1_drop_written(stmt, env);
            if rf.has == 1 {
                env = fix1_env_set_interval(env, rf.name, [1, rf.lo, 1, rf.hi]);
            }
        } else if stmt.kind == 10 {
            res = fix1_scan_r_uses(stmt, env, loops, res);
            res = fix1_scan_o1_uses(stmt, env, res);
            env = fix1_apply_let(stmt, env);
        } else if stmt.kind == 11 {
            res = fix1_scan_r_uses(stmt, env, loops, res);
            res = fix1_scan_o1_uses(stmt, env, res);
            let rhs: Node = stmt.kids[0];
            // B2: the mod fact is read on the pre-assign env.
            let mrel: str = fix1_mod_rel(rhs, env);
            let miv: [int] = fix1_mod_iv(rhs, env);
            env = fix1_env_set_interval(env, stmt.name, fix1_interval(rhs, env));
            env = fix1_env_drop_rel(env, stmt.name);
            if mrel != "" {
                env = fix1_env_rel_add(env, stmt.name, mrel);
                if miv[0] == 1 {
                    env = fix1_env_set_interval(env, stmt.name, [1, miv[1], 1, miv[2]]);
                }
            }
            env = fix1_env_drop_sized(env, stmt.name);
            if rhs.kind == 34 && fix1_env_sized(env, rhs.name) >= 0 {
                env = fix1_env_set_sized(env, stmt.name, fix1_env_sized(env, rhs.name));
            }
        } else {
            res = fix1_scan_r_uses(stmt, env, loops, res);
            res = fix1_scan_o1_uses(stmt, env, res);
            let mut i: int = 0;
            while i < len(stmt.kids) {
                res = fix1_recurse_blocks(stmt.kids[i], env, res, loops);
                i = i + 1;
            }
            env = fix1_drop_written(stmt, env);
        }
        pos = pos + 1;
    }
    return Fix1Pair { env: env, res: res };
}

fn fix1_analyze_node(n: Node, res0: Fix1Res) -> Fix1Res {
    let mut res: Fix1Res = res0;
    if n.kind == 2 {
        if len(n.kids) == 0 {
            return res;
        }
        let body: Node = n.kids[len(n.kids) - 1];
        if body.kind != 9 {
            return res;
        }
        let mut env: Fix1Env = fix1_env_new();
        let mut i: int = 0;
        while i < len(n.kids) - 1 {
            let p: Node = n.kids[i];
            if p.kind == 43 {
                env = fix1_env_set_type(env, p.name, p.sval);
                let sn: int = fix1_sized_len(p.sval);
                if sn >= 0 {
                    env = fix1_env_set_sized(env, p.name, sn);
                }
            }
            i = i + 1;
        }
        let empty_loops: [Node] = [];
        let pair: Fix1Pair = fix1_analyze_block(body.kids, env, res, empty_loops);
        return pair.res;
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        res = fix1_analyze_node(n.kids[i], res);
        i = i + 1;
    }
    return res;
}

fn fix1_analyze_program(prog: Node) -> Fix1Res {
    let res: Fix1Res = fix1_res_new();
    return fix1_analyze_node(prog, res);
}

// ---------- b1fix2: per-function tagging ----------
//
// BUG (found by the full suite, 13 Nov 2026): the pooled Fix1Res
// keys proofs by bare (line, col), which is unique only within one
// source file. In a merged program the same position in different
// files collides, and fix1_tag_program stamped a guard proven for
// one function's loop onto the loop at that position in other
// functions — e.g. `if (3 > (cnt).len)` proven at demo line 57 was
// also emitted in logreg_train and prf (line 57 in ml_classical.fg
// and metrics.fg), where `cnt` is undeclared, so the C compiler
// rejected the program. (A covered Index at a colliding position
// would likewise have its check silently elided in the wrong file.)
// Python never had this bug: its codegen keys proofs by id(node).
//
// FIX: analyze and tag ONE FUNCTION AT A TIME. The analysis already
// runs with a fresh environment per FuncDef; only the pooling and
// the global tag pass were cross-function. fix1_tag_function
// analyzes a single FuncDef with a fresh Fix1Res and tags only
// that FuncDef's subtree, so a (line, col) entry can only land on
// nodes inside the function that proved it — and within one
// function (one file) positions are unique. fix1_tag_program_fns
// applies this to every FuncDef in the program (top-level or under
// an ImplDef). The pooled fix1_analyze_program / fix1_tag_program
// above are unchanged (lp_test still uses them for parity); the
// pooled Fix1Res is single-file-only and production must not use
// it — cg_fix1_run calls fix1_tag_program_fns.
// Frame-neutral: no struct grows, no new HCodegen field; the new
// walk has a small frame like fix1_tag_node, and fix1_tag_function
// holds one Fix1Res per FuncDef, not nested.

// Analyze one FuncDef with a fresh result and tag only its own
// subtree. Returns the number of nodes tagged.
fn fix1_tag_function(fn_node: Node) -> int {
    let res: Fix1Res = fix1_analyze_node(fn_node, fix1_res_new());
    return fix1_tag_node(fn_node, res);
}

// Walk `n`; on every FuncDef, analyze + tag that function only and
// do not recurse into it; otherwise recurse into kids. Returns the
// total number of nodes tagged.
fn fix1_tag_functions(n: Node) -> int {
    let mut tagged: int = 0;
    if n.kind == 2 {
        return fix1_tag_function(n);
    }
    let mut i: int = 0;
    while i < len(n.kids) {
        tagged = tagged + fix1_tag_functions(n.kids[i]);
        i = i + 1;
    }
    return tagged;
}

// Tag the whole program's proofs, one function at a time.
// Production entry point (called by cg_fix1_run); the pooled
// fix1_tag_program above is lp_test-only.
fn fix1_tag_program_fns(prog: Node) -> int {
    return fix1_tag_functions(prog);
}
