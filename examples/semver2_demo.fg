import "semver2.fg";

fn main() {
    println(sv2_satisfies("1.2.3", "^1.0.0"));
    println(sv2_satisfies("2.0.0", "^1.0.0"));
    println(sv2_satisfies("1.2.9", "~1.2.3"));
    println(sv2_satisfies("1.3.0", "~1.2.3"));
    println(sv2_satisfies("1.5.0", ">=1.0.0 <2.0.0"));
    println(sv2_satisfies("2.0.0", ">=1.0.0 <2.0.0"));
    println(sv2_satisfies("1.2.3", "1.2.3"));
    println(sv2_satisfies("1.2.4", "1.2.3"));
}
