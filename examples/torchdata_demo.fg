import "torchdata.fg";

fn main() {
    println(td_num_batches(10, 3));
    let r: [int] = td_batch_range(10, 3, 1);
    println(r[0], r[1]);
    let idx: [int] = td_shuffle(6, 7);
    println(idx[0], idx[1], idx[2], idx[3], idx[4], idx[5]);
    let data: [int] = [10, 20, 30, 40, 50, 60];
    println(td_gather(data, idx, 0), td_gather(data, idx, 1));
}
