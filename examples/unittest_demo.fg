// Unittest demo — daily-ten 14 Nov 2026 (library track).
// Verifies unittest.fg: four checks, three pass (2+2=4,
// 3*3=9, 1<2) and one fails (5=6). Passed 3, failed 1,
// total 4.
// Expected stdout:
// 3
// 1
// 4
import "unittest.fg";

fn main() {
    let mut u: Ut = ut_new();
    u = ut_eq_int(u, 2 + 2, 4);
    u = ut_eq_int(u, 3 * 3, 9);
    u = ut_true(u, 1 < 2);
    u = ut_eq_int(u, 5, 6);
    println(u.passed);
    println(u.failed);
    println(ut_total(u));
}
