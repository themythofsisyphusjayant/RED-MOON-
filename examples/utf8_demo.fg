// UTF-8 demo — Top-500 #151.
// Encode codepoints [72, 233, 8364, 128512] (H, e-acute, euro,
// grinning face), decode them back, byte lengths, char count,
// and one invalid sequence.
import "utf8.fg";

fn main() -> int {
    let bytes: [int] = utf8_encode([72, 233, 8364, 128512]);
    println(bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7], bytes[8], bytes[9]);
    let dec = utf8_decode(bytes);
    println(dec.0[0], dec.0[1], dec.0[2], dec.0[3]);
    println(utf8_byte_len(233));
    println(utf8_byte_len(8364));
    println(utf8_byte_len(128512));
    println(utf8_byte_len(72));
    println(utf8_char_count(bytes));
    println(utf8_valid(bytes));
    println(utf8_valid([195, 40]));
    return 0;
}
