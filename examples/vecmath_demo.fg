// Vector-operations demo — Top-500 #165.
// a=[1,2,3], b=[4,5,6]: dot, norm, cross, distance, cosine,
// add, scale.
import "vecmath.fg";

fn main() -> int {
    let a: [float] = [1.0, 2.0, 3.0];
    let b: [float] = [4.0, 5.0, 6.0];
    println(vm_dot(a, b));
    println(vm_norm(a));
    let cr: [float] = vm_cross(a, b);
    println(cr[0], cr[1], cr[2]);
    println(vm_dist(a, b));
    println(vm_cos(a, b));
    let ad: [float] = vm_add(a, b);
    println(ad[0], ad[1], ad[2]);
    let sc: [float] = vm_scale(a, 2.0);
    println(sc[0], sc[1], sc[2]);
    return 0;
}
