import "visionv3.fg";

fn main() -> int {
    let img: [int] = [1, 2, 3, 4, 5, 6];
    let fl: [int] = vv3_flip_h(img, 3, 2);
    println(fl[0], fl[1], fl[2], fl[3], fl[4], fl[5]);
    let big: [int] = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    let cr: [int] = vv3_crop(big, 3, 1, 1, 2, 2);
    println(cr[0], cr[1], cr[2], cr[3]);
    let gray: [int] = [10, 20, 30, 40, 50, 60, 70, 80, 90];
    let bl: [int] = vv3_blur3(gray, 3, 3);
    println(bl[0], bl[1], bl[2], bl[3], bl[4], bl[5], bl[6], bl[7], bl[8]);
    let vals: [int] = [0, 100, 128, 200, 255];
    let th: [int] = vv3_threshold(vals, 128);
    println(th[0], th[1], th[2], th[3], th[4]);
    return 0;
}
