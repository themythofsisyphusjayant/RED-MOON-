fn main() {
    let mut w: int = -1;
    {
        let mut a = [7, 8];
        w = weak_new(a);
        push(a, 9);
        let up = weak_upgrade(w);
        println(up.0);
        println(up.1[2]);
    }
    {
        let mut a = [5, 6];
        let w2 = weak_new(a);
        a[0] = 50;
        let up = weak_upgrade(w2);
        println(up.1[0]);
    }
    let up2 = weak_upgrade(w);
    println(up2.0);
    println(len(up2.1));
}
