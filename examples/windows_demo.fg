import "windows.fg";

fn main() -> int {
    let sw: [int] = win_sliding_sums([1, 2, 3, 4, 5], 3);
    println(sw[0], sw[1], sw[2]);
    let sf: [float] = win_sliding_sums_f([1.5, 2.5, 3.5, 4.5], 2);
    println(sf[0], sf[1], sf[2]);
    let ck: [int] = win_chunk_sums([1, 2, 3, 4, 5], 2);
    println(ck[0], ck[1], ck[2]);
    let cf: [float] = win_chunk_sums_f([1.5, 2.5, 3.5, 4.5, 5.5], 3);
    println(cf[0], cf[1]);
    return 0;
}
