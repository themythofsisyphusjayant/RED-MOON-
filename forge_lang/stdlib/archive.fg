fn tar_octal_str(v: int, width: int) -> str {
    let digits: str = "01234567";
    let mut out: str = "";
    let mut n: int = v;
    if n == 0 {
        out = "0";
    }
    while n > 0 {
        out = substr(digits, n % 8, 1) + out;
        n = n / 8;
    }
    let mut i: int = len(out);
    while i < width {
        out = "0" + out;
        i = i + 1;
    }
    return out;
}

fn tar_octal_bytes(v: int, width: int) -> [int] {
    let mut out: [int] = [];
    let s: str = tar_octal_str(v, width);
    let mut i: int = 0;
    while i < len(s) {
        let c: str = s[i];
        let mut d: int = 0;
        if c == "1" {
            d = 1;
        } else if c == "2" {
            d = 2;
        } else if c == "3" {
            d = 3;
        } else if c == "4" {
            d = 4;
        } else if c == "5" {
            d = 5;
        } else if c == "6" {
            d = 6;
        } else if c == "7" {
            d = 7;
        }
        push(out, 48 + d);
        i = i + 1;
    }
    return out;
}

fn tar_header(name: [int], size: int) -> [int] {
    let mut h: [int] = [];
    let mut i: int = 0;
    while i < 512 {
        push(h, 0);
        i = i + 1;
    }
    i = 0;
    while i < len(name) {
        h[i] = name[i];
        i = i + 1;
    }
    let mode: [int] = [48, 48, 48, 48, 54, 52, 52, 0];
    i = 0;
    while i < len(mode) {
        h[100 + i] = mode[i];
        i = i + 1;
    }
    let zeros7: [int] = [48, 48, 48, 48, 48, 48, 48, 0];
    i = 0;
    while i < len(zeros7) {
        h[108 + i] = zeros7[i];
        i = i + 1;
    }
    i = 0;
    while i < len(zeros7) {
        h[116 + i] = zeros7[i];
        i = i + 1;
    }
    let size_oct: [int] = tar_octal_bytes(size, 7);
    i = 0;
    while i < len(size_oct) {
        h[124 + i] = size_oct[i];
        i = i + 1;
    }
    h[131] = 0;
    let mtime_oct: [int] = tar_octal_bytes(0, 11);
    i = 0;
    while i < len(mtime_oct) {
        h[136 + i] = mtime_oct[i];
        i = i + 1;
    }
    h[147] = 0;
    i = 0;
    while i < 8 {
        h[148 + i] = 32;
        i = i + 1;
    }
    h[156] = 48;
    let magic: [int] = [117, 115, 116, 97, 114, 0, 48, 48];
    i = 0;
    while i < len(magic) {
        h[257 + i] = magic[i];
        i = i + 1;
    }
    return h;
}

fn tar_checksum(h: [int]) -> int {
    let mut sum: int = 0;
    let mut i: int = 0;
    while i < len(h) {
        sum = sum + h[i];
        i = i + 1;
    }
    return sum;
}

fn tar_checksum_field(h: [int]) -> str {
    return tar_octal_str(tar_checksum(h), 6);
}
