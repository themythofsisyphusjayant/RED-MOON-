// Qasida — stable AST API for tools (Top-500 #478).
// Import with: import "astapi.fg";
// Let tools read and rewrite programs through a small,
// stable node model instead of raw text: aa_parse()
// classifies source lines into fn / struct / let nodes
// (kind, name, 1-based line), aa_find() locates a node
// by name, aa_format() renders one node, and aa_rename()
// rewrites whole-word occurrences of a name across lines
// (identifier boundaries only, so `add` renames but
// `adder` does not).
// v1 limits: line-based parsing only (fn/struct/let at
// line start, no nesting, no string/comment awareness in
// rename — a name inside a string literal still renames).

import "fmtstr.fg";

struct ANode {
    kind: str;
    name: str;
    line: int;
}

fn aa_index_of(hay: str, needle: str) -> int {
    if len(needle) == 0 {
        return 0;
    }
    if len(needle) > len(hay) {
        return -1;
    }
    let mut i: int = 0;
    while i + len(needle) <= len(hay) {
        if substr(hay, i, len(needle)) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn aa_is_ident(c: str) -> bool {
    let letters: str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    let mut j: int = 0;
    while j < len(letters) {
        if substr(letters, j, 1) == c {
            return true;
        }
        j = j + 1;
    }
    return false;
}

fn aa_name_until(line: str, start: int) -> str {
    let mut out: str = "";
    let mut i: int = start;
    while i < len(line) && aa_is_ident(substr(line, i, 1)) {
        out = out + substr(line, i, 1);
        i = i + 1;
    }
    return out;
}

fn aa_parse(lines: [str]) -> [ANode] {
    let mut out: [ANode] = [];
    let mut i: int = 0;
    while i < len(lines) {
        let line: str = lines[i];
        if starts_with(line, "fn ") {
            push(out, ANode { kind: "fn", name: aa_name_until(line, 3), line: i + 1 });
        } else if starts_with(line, "struct ") {
            push(out, ANode { kind: "struct", name: aa_name_until(line, 7), line: i + 1 });
        } else if starts_with(line, "let ") {
            push(out, ANode { kind: "let", name: aa_name_until(line, 4), line: i + 1 });
        }
        i = i + 1;
    }
    return out;
}

fn aa_find(nodes: [ANode], name: str) -> int {
    let mut i: int = 0;
    while i < len(nodes) {
        if nodes[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn aa_format(n: ANode) -> str {
    return n.kind + " " + n.name + " @ " + fs_int_str(n.line);
}

fn aa_rename_line(line: str, old: str, new: str) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(line) {
        let mut hit: bool = false;
        if i + len(old) <= len(line) && substr(line, i, len(old)) == old {
            let before_ok: bool = i == 0 || !aa_is_ident(substr(line, i - 1, 1));
            let after_idx: int = i + len(old);
            let after_ok: bool = after_idx >= len(line) || !aa_is_ident(substr(line, after_idx, 1));
            if before_ok && after_ok {
                hit = true;
            }
        }
        if hit {
            out = out + new;
            i = i + len(old);
        } else {
            out = out + substr(line, i, 1);
            i = i + 1;
        }
    }
    return out;
}

fn aa_rename(lines: [str], old: str, new: str) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(lines) {
        push(out, aa_rename_line(lines[i], old, new));
        i = i + 1;
    }
    return out;
}
