// Qasida — audit logs (Top-500 #396).
// Import with: import "audit.fg";
// Security event trails in pure Qasida: append-only audit
// entries (timestamp, actor, action, target) over explicit
// microsecond stamps, with actor filtering and counts.
// Timestamps are caller-supplied (usually clock_micros),
// so entries are deterministic in tests. No redaction or
// signing in v1.

struct Audit {
    lines: [str];
}

fn au_digit(d: int) -> str {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

fn au_int_str(n: int) -> str {
    if n == 0 { return "0"; }
    let mut v: int = n;
    let mut rev: str = "";
    while v > 0 {
        rev = rev + au_digit(v % 10);
        v = v / 10;
    }
    let mut out: str = "";
    let mut i: int = len(rev) - 1;
    while i >= 0 {
        out = out + substr(rev, i, 1);
        i = i - 1;
    }
    return out;
}

fn au_new() -> Audit {
    return Audit { lines: [] };
}

fn au_log(a: Audit, ts_us: int, actor: str, action: str, target: str) -> Audit {
    let mut aa: Audit = a;
    push(aa.lines, au_int_str(ts_us) + "|" + actor + "|" + action + "|" + target);
    return aa;
}

fn au_lines(a: Audit) -> [str] {
    return a.lines;
}

fn au_count(a: Audit) -> int {
    return len(a.lines);
}

fn au_filter_actor(a: Audit, actor: str) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(a.lines) {
        let parts: [str] = split(a.lines[i], "|");
        if len(parts) >= 2 && parts[1] == actor {
            push(out, a.lines[i]);
        }
        i = i + 1;
    }
    return out;
}
