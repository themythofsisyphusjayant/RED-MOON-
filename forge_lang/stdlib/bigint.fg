// Qasida — big integers (Top-500 #163).
// Import with: import "bigint.fg";
// Arbitrary-precision non-negative integers: little-endian limbs
// in base 1e9, so every intermediate (limb product + carry) stays
// far below the int64 limit. add, sub (a >= b), mul, compare and
// decimal-string conversion. v1 limits: non-negative values only;
// from_str rejects "-"; no division yet.

struct Bi {
    limbs: [int];
}

fn bi_base() -> int {
    return 1000000000;
}

fn bi_trim(limbs: [int]) -> [int] {
    let mut out: [int] = limbs;
    while len(out) > 1 && out[len(out) - 1] == 0 {
        let mut cut: [int] = [];
        let mut i: int = 0;
        while i < len(out) - 1 {
            push(cut, out[i]);
            i = i + 1;
        }
        out = cut;
    }
    return out;
}

fn bi_from_int(n: int) -> Bi {
    if n == 0 {
        return Bi { limbs: [0] };
    }
    let mut limbs: [int] = [];
    let mut x: int = n;
    while x > 0 {
        push(limbs, x % bi_base());
        x = x / bi_base();
    }
    return Bi { limbs: limbs };
}

fn bi_is_zero(b: Bi) -> bool {
    return len(b.limbs) == 1 && b.limbs[0] == 0;
}

fn bi_from_str(s: str) -> Bi {
    let mut limbs: [int] = [0];
    let mut i: int = 0;
    while i < len(s) {
        let c: str = substr(s, i, 1);
        let digits: str = "0123456789";
        let mut d: int = 0;
        let mut j: int = 0;
        while j < 10 {
            if substr(digits, j, 1) == c {
                d = j;
            }
            j = j + 1;
        }
        let mut carry: int = d;
        let mut k: int = 0;
        while k < len(limbs) {
            let t: int = limbs[k] * 10 + carry;
            limbs[k] = t % bi_base();
            carry = t / bi_base();
            k = k + 1;
        }
        while carry > 0 {
            push(limbs, carry % bi_base());
            carry = carry / bi_base();
        }
        i = i + 1;
    }
    return Bi { limbs: bi_trim(limbs) };
}

fn bi_int_str(n: int) -> str {
    if n == 0 {
        return "0";
    }
    let digits: str = "0123456789";
    let mut out: str = "";
    let mut x: int = n;
    while x > 0 {
        out = substr(digits, x % 10, 1) + out;
        x = x / 10;
    }
    return out;
}

fn bi_pad9(n: int) -> str {
    let mut s: str = bi_int_str(n);
    while len(s) < 9 {
        s = "0" + s;
    }
    return s;
}

fn bi_to_string(b: Bi) -> str {
    let mut out: str = bi_int_str(b.limbs[len(b.limbs) - 1]);
    let mut k: int = len(b.limbs) - 2;
    while k >= 0 {
        out = out + bi_pad9(b.limbs[k]);
        k = k - 1;
    }
    return out;
}

fn bi_cmp(a: Bi, b: Bi) -> int {
    if len(a.limbs) > len(b.limbs) {
        return 1;
    }
    if len(a.limbs) < len(b.limbs) {
        return 0 - 1;
    }
    let mut k: int = len(a.limbs) - 1;
    while k >= 0 {
        if a.limbs[k] > b.limbs[k] {
            return 1;
        }
        if a.limbs[k] < b.limbs[k] {
            return 0 - 1;
        }
        k = k - 1;
    }
    return 0;
}

fn bi_add(a: Bi, b: Bi) -> Bi {
    let mut out: [int] = [];
    let mut carry: int = 0;
    let mut i: int = 0;
    let n: int = len(a.limbs);
    let m: int = len(b.limbs);
    let mut lim: int = n;
    if m > lim {
        lim = m;
    }
    while i < lim {
        let mut av2: int = 0;
        let mut bv2: int = 0;
        if i < n {
            av2 = a.limbs[i];
        }
        if i < m {
            bv2 = b.limbs[i];
        }
        let t: int = av2 + bv2 + carry;
        push(out, t % bi_base());
        carry = t / bi_base();
        i = i + 1;
    }
    if carry > 0 {
        push(out, carry);
    }
    return Bi { limbs: bi_trim(out) };
}

fn bi_sub(a: Bi, b: Bi) -> Bi {
    let mut out: [int] = [];
    let mut borrow: int = 0;
    let mut i: int = 0;
    while i < len(a.limbs) {
        let bv: int = 0;
        let mut bv2: int = bv;
        if i < len(b.limbs) {
            bv2 = b.limbs[i];
        }
        let mut t: int = a.limbs[i] - bv2 - borrow;
        if t < 0 {
            t = t + bi_base();
            borrow = 1;
        } else {
            borrow = 0;
        }
        push(out, t);
        i = i + 1;
    }
    return Bi { limbs: bi_trim(out) };
}

fn bi_mul(a: Bi, b: Bi) -> Bi {
    if bi_is_zero(a) || bi_is_zero(b) {
        return Bi { limbs: [0] };
    }
    let mut out: [int] = [];
    let mut t: int = 0;
    while t < len(a.limbs) + len(b.limbs) {
        push(out, 0);
        t = t + 1;
    }
    let mut i: int = 0;
    while i < len(a.limbs) {
        let mut carry: int = 0;
        let mut j: int = 0;
        while j < len(b.limbs) {
            let v: int = out[i + j] + a.limbs[i] * b.limbs[j] + carry;
            out[i + j] = v % bi_base();
            carry = v / bi_base();
            j = j + 1;
        }
        let mut k: int = len(b.limbs);
        while carry > 0 {
            let v: int = out[i + k] + carry;
            out[i + k] = v % bi_base();
            carry = v / bi_base();
            k = k + 1;
        }
        i = i + 1;
    }
    return Bi { limbs: bi_trim(out) };
}
