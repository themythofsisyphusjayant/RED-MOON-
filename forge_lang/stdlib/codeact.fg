// Qasida — code actions / quick fixes (Top-500 #367).
// Import with: import "codeact.fg";
// Apply suggestions from the editor: a table of
// (diagnostic, action, file, line, applied) rows.
// ca_apply() marks the first pending matching row applied
// and reports success in ca_last_ok(). v1 limits: the
// table only — no source files are edited.

struct CodeAct {
    diags: [str];
    actions: [str];
    files: [str];
    lines: [int];
    done: [bool];
    last_ok: bool;
}

fn ca_new() -> CodeAct {
    return CodeAct { diags: [], actions: [], files: [], lines: [], done: [], last_ok: false };
}

fn ca_add(c: CodeAct, diag: str, action: str, file: str, line: int) -> CodeAct {
    let mut n: CodeAct = c;
    push(n.diags, diag);
    push(n.actions, action);
    push(n.files, file);
    push(n.lines, line);
    push(n.done, false);
    return n;
}

fn ca_actions(c: CodeAct, diag: str) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(c.diags) {
        if c.diags[i] == diag {
            push(out, c.actions[i]);
        }
        i = i + 1;
    }
    return out;
}

fn ca_apply(c: CodeAct, diag: str, action: str) -> CodeAct {
    let mut n: CodeAct = c;
    let mut i: int = 0;
    while i < len(n.diags) {
        if n.diags[i] == diag {
            if n.actions[i] == action {
                if !n.done[i] {
                    n.done[i] = true;
                    n.last_ok = true;
                    return n;
                }
            }
        }
        i = i + 1;
    }
    n.last_ok = false;
    return n;
}

fn ca_last_ok(c: CodeAct) -> bool {
    return c.last_ok;
}

fn ca_pending(c: CodeAct) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(c.done) {
        if !c.done[i] {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn ca_applied(c: CodeAct) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(c.done) {
        if c.done[i] {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}
