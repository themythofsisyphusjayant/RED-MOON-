// Qasida — doc comments (Top-500 #491).
// Import with: import "doccomment.fg";
// /// comments that feed docgen: a run of /// lines directly
// above a fn line becomes one doc entry (name + joined text).
// A fn with no /// lines above it gets no entry; a /// run
// with no fn below it is dropped. Use the entries with
// docgen.fg's doc_fn_markdown() to render pages.
// v1 limits: fn lines only (no struct/enum docs), one space
// after /// is stripped along with the marker, multi-line
// docs join with a single space.

struct DocEntry {
    name: str;
    text: str;
}

fn dc_is_doc(line: str) -> bool {
    return starts_with(trim(line), "///");
}

fn dc_doc_text(line: str) -> str {
    let t: str = trim(line);
    let rest: str = substr(t, 3, len(t) - 3);
    return trim(rest);
}

fn dc_fn_name(line: str) -> str {
    let t: str = trim(line);
    if !starts_with(t, "fn ") {
        return "";
    }
    let parts: [str] = split(t, " ");
    if len(parts) < 2 {
        return "";
    }
    let head: [str] = split(parts[1], "(");
    return head[0];
}

fn dc_entries(lines: [str]) -> [DocEntry] {
    let mut out: [DocEntry] = [];
    let mut i: int = 0;
    while i < len(lines) {
        let name: str = dc_fn_name(lines[i]);
        if name != "" {
            let mut j: int = i - 1;
            let mut docs: [str] = [];
            while j >= 0 && dc_is_doc(lines[j]) {
                push(docs, dc_doc_text(lines[j]));
                j = j - 1;
            }
            let mut fwd: [str] = [];
            let mut k: int = len(docs) - 1;
            while k >= 0 {
                push(fwd, docs[k]);
                k = k - 1;
            }
            if len(fwd) > 0 {
                push(out, DocEntry { name: name, text: join(fwd, " ") });
            }
        }
        i = i + 1;
    }
    return out;
}

fn dc_count(lines: [str]) -> int {
    return len(dc_entries(lines));
}
