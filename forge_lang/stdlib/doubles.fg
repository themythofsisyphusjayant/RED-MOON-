// Qasida — test doubles: stubs and spies (Top-500 #309).
// Import with: import "doubles.fg";
// A spy records every call (name + one string argument) in
// order, so a test can assert a call happened, how often,
// and with which argument. arg() is "" out of range.
// v1 limits: one string argument per call; no return-value
// stubbing (there is no function to stub yet — spies record
// what the test itself reports, they cannot intercept).

struct Spy {
    names: [str];
    args: [str];
}

fn spy_new() -> Spy {
    return Spy { names: [], args: [] };
}

fn spy_call(s: Spy, name: str, arg: str) -> Spy {
    let mut names: [str] = [];
    let mut args: [str] = [];
    let mut i: int = 0;
    while i < len(s.names) {
        push(names, s.names[i]);
        push(args, s.args[i]);
        i = i + 1;
    }
    push(names, name);
    push(args, arg);
    return Spy { names: names, args: args };
}

fn spy_count(s: Spy) -> int {
    return len(s.names);
}

fn spy_called(s: Spy, name: str) -> bool {
    let mut i: int = 0;
    while i < len(s.names) {
        if s.names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn spy_count_named(s: Spy, name: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s.names) {
        if s.names[i] == name {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn spy_arg(s: Spy, i: int) -> str {
    if i < 0 {
        return "";
    }
    if i >= len(s.args) {
        return "";
    }
    return s.args[i];
}
