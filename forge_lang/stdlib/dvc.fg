// Qasida — dataset versioning (Top-500 #440).
// Import with: import "dvc.fg";
// Snapshots of datasets: a manifest lists each dataset file
// with its CRC32, and verification re-reads the files and
// compares. dvc_manifest renders "name hash" lines;
// dvc_file_ok compares one stored hash with a fresh one;
// dvc_changed_count counts files whose hash moved. Files are
// read with bio_read_file and hashed with crc32_bytes. v1
// limits: manifest is text, not a lockfile; no restore from
// snapshot yet; no directory recursion.

import "binio.fg";
import "checksum.fg";
import "checkread.fg";

fn dvc_hash_file(path: str) -> int {
    let data: [int] = bio_read_file(path);
    return crc32_bytes(data);
}

fn dvc_manifest(names: [str], hashes: [int]) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(names) {
        if i > 0 {
            out = out + "\n";
        }
        out = out + names[i] + " " + cr_int_str(hashes[i]);
        i = i + 1;
    }
    return out;
}

fn dvc_file_ok(stored: int, fresh: int) -> bool {
    return stored == fresh;
}

fn dvc_changed_count(stored: [int], fresh: [int]) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(stored) {
        if stored[i] != fresh[i] {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}
