// Qasida — held-out evaluation reports (eval-harness).
// Import with: import "evalharness.fg";
// LIMITS (honest v1): classification accuracy over int labels,
// mean squared error over floats, and perplexity from a mean
// negative log-likelihood (exp builtin). No batching, no splits —
// the caller supplies the held-out arrays.

fn eval_accuracy(preds: [int], labels: [int]) -> float {
    if len(preds) == 0 { return 0.0; }
    if len(preds) != len(labels) { return 0.0; }
    let mut ok: int = 0;
    let mut i: int = 0;
    while i < len(preds) {
        if preds[i] == labels[i] { ok = ok + 1; }
        i = i + 1;
    }
    return ok as float / len(preds) as float;
}

fn eval_mse(preds: [float], labels: [float]) -> float {
    if len(preds) == 0 { return 0.0; }
    if len(preds) != len(labels) { return 0.0; }
    let mut s: float = 0.0;
    let mut i: int = 0;
    while i < len(preds) {
        let d = preds[i] - labels[i];
        s = s + d * d;
        i = i + 1;
    }
    return s / len(preds) as float;
}

fn eval_perplexity(mean_nll: float) -> float {
    return exp(mean_nll);
}

fn eval_report(preds: [int], labels: [int]) -> float {
    return eval_accuracy(preds, labels);
}
