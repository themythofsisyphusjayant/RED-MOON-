// Qasida — checksums inside file formats (Top-500 #237).
// Import with: import "fmtcrc.fg";
// Records as "len:payload:crc" lines: the length is the
// payload's character count, the crc is CRC32 over the
// payload's ASCII bytes (decimal). read() verifies both and
// reports ok=false on the first bad line, keeping whatever
// records verified before it. Payloads must not contain ":"
// in v1; the byte table is printable ASCII 32..126, so a
// payload with other characters maps them to 0 on both sides
// of the checksum and still round-trips consistently.

import "checksum.fg";

struct FcRead {
    items: [str];
    ok: bool;
}

fn fc_byte(c: str) -> int {
    let table: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let mut j: int = 0;
    while j < len(table) {
        if substr(table, j, 1) == c {
            return j + 32;
        }
        j = j + 1;
    }
    return 0;
}

fn fc_bytes(s: str) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(s) {
        push(out, fc_byte(substr(s, i, 1)));
        i = i + 1;
    }
    return out;
}

fn fc_int_str(n: int) -> str {
    if n == 0 {
        return "0";
    }
    let digits: str = "0123456789";
    let mut out: str = "";
    let mut v: int = n;
    while v > 0 {
        out = substr(digits, v % 10, 1) + out;
        v = v / 10;
    }
    return out;
}

fn fc_write(records: [str]) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(records) {
        let crc: int = crc32_bytes(fc_bytes(records[i]));
        out = out + fc_int_str(len(records[i])) + ":" + records[i] + ":" + fc_int_str(crc) + "\n";
        i = i + 1;
    }
    return out;
}

fn fc_read(text: str) -> FcRead {
    let lines: [str] = split(text, "\n");
    let mut items: [str] = [];
    let mut i: int = 0;
    while i < len(lines) {
        if len(lines[i]) > 0 {
            let parts: [str] = split(lines[i], ":");
            if len(parts) != 3 {
                return FcRead { items: items, ok: false };
            }
            if parse_int(parts[0]) != len(parts[1]) {
                return FcRead { items: items, ok: false };
            }
            if parse_int(parts[2]) != crc32_bytes(fc_bytes(parts[1])) {
                return FcRead { items: items, ok: false };
            }
            push(items, parts[1]);
        }
        i = i + 1;
    }
    return FcRead { items: items, ok: true };
}
