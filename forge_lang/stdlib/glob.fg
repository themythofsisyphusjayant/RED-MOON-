// Qasida — glob patterns (Top-500 #191).
// Import with: import "glob.fg";
// `*` (any run), `?` (one char), and `[...]` classes (ranges
// a-z, negation [!...]) over strings. No filesystem listing in
// v1 — matching only; callers list names themselves. Character
// codes come from an alphabet search (no ord() builtin, the
// hashmap.fg idiom).

fn gl_char_code(c: str) -> int {
    let alpha: str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 _-.,:;!?@#$%^&*()[]{}<>/'+=~`|";
    let mut j: int = 0;
    while j < len(alpha) {
        if substr(alpha, j, 1) == c {
            return j + 1;
        }
        j = j + 1;
    }
    return 0;
}

fn gl_class_has(cls: str, c: str) -> bool {
    let mut neg: bool = false;
    let mut start: int = 0;
    if len(cls) > 0 && substr(cls, 0, 1) == "!" {
        neg = true;
        start = 1;
    }
    let code: int = gl_char_code(c);
    let mut hit: bool = false;
    let mut i: int = start;
    while i < len(cls) {
        if i + 2 < len(cls) && substr(cls, i + 1, 1) == "-" {
            let lo: int = gl_char_code(substr(cls, i, 1));
            let hi: int = gl_char_code(substr(cls, i + 2, 1));
            if code >= lo && code <= hi {
                hit = true;
            }
            i = i + 3;
        } else {
            if substr(cls, i, 1) == c {
                hit = true;
            }
            i = i + 1;
        }
    }
    if neg {
        return hit == false;
    }
    return hit;
}

fn gl_match(pat: str, s: str) -> bool {
    let mut p: int = 0;
    let mut t: int = 0;
    let mut star_p: int = 0 - 1;
    let mut star_t: int = 0;
    while t < len(s) {
        if p < len(pat) && pat[p] == "?" {
            p = p + 1;
            t = t + 1;
        } else if p < len(pat) && pat[p] == "*" {
            star_p = p;
            star_t = t;
            p = p + 1;
        } else if p < len(pat) && pat[p] == "[" {
            let mut j: int = p + 1;
            while j < len(pat) && pat[j] != "]" {
                j = j + 1;
            }
            if j >= len(pat) {
                return false;
            }
            let cls: str = substr(pat, p + 1, j - p - 1);
            if gl_class_has(cls, s[t]) == false {
                if star_p != 0 - 1 {
                    p = star_p + 1;
                    star_t = star_t + 1;
                    t = star_t;
                } else {
                    return false;
                }
            } else {
                p = j + 1;
                t = t + 1;
            }
        } else if p < len(pat) && pat[p] == s[t] {
            p = p + 1;
            t = t + 1;
        } else if star_p != 0 - 1 {
            p = star_p + 1;
            star_t = star_t + 1;
            t = star_t;
        } else {
            return false;
        }
    }
    while p < len(pat) && pat[p] == "*" {
        p = p + 1;
    }
    return p == len(pat);
}
