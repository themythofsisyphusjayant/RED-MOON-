// Qasida — grapheme clusters (Top-500 #144).
// Import with: import "grapheme.fg";
// Unicode-correct cluster segmentation over code points
// (extends utf8.fg, which only decodes bytes to code
// points). A cluster is a base code point plus its combining
// marks; two regional indicators pair into one cluster, and
// ZWJ (U+200D) joins the next base into the same cluster.
// lengths() returns the length of each cluster in order;
// count() is the number of clusters.
// v1 limits: combining marks are the five main ranges
// (U+0300-036F, U+1AB0-1AFF, U+1DC0-1DFF, U+20D0-20FF,
// U+FE20-FE2F); no Hangul syllable rules, no emoji
// presentation rules, no extended pictographic handling.

fn gr_is_combining(cp: int) -> bool {
    if cp >= 768 && cp <= 879 {
        return true;
    }
    if cp >= 6832 && cp <= 6911 {
        return true;
    }
    if cp >= 7616 && cp <= 7679 {
        return true;
    }
    if cp >= 8400 && cp <= 8447 {
        return true;
    }
    if cp >= 65056 && cp <= 65071 {
        return true;
    }
    return false;
}

fn gr_is_regional(cp: int) -> bool {
    return cp >= 127462 && cp <= 127487;
}

fn gr_lengths(cps: [int]) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(cps) {
        let start: int = i;
        i = i + 1;
        if gr_is_regional(cps[start]) && i < len(cps) && gr_is_regional(cps[i]) {
            i = i + 1;
        }
        let mut ext: bool = true;
        while ext {
            ext = false;
            if i < len(cps) && gr_is_combining(cps[i]) {
                i = i + 1;
                ext = true;
            } else if i < len(cps) && cps[i] == 8205 && i + 1 < len(cps) {
                i = i + 2;
                ext = true;
            }
        }
        push(out, i - start);
    }
    return out;
}

fn gr_count(cps: [int]) -> int {
    return len(gr_lengths(cps));
}
