// Gym-style environments (bandit, gridworld, cartpole-lite,
// mountaincar-lite), in pure Qasida.
// Import with: import "gym.fg";
// Each step is a pure function of (state, action [, seed]) so
// runs are exactly reproducible. Cartpole and mountain-car use
// linearised physics (documented approximations, not the full
// nonlinear dynamics).
import "rand.fg";

fn gym_bandit_step(arm: int, seed: int) -> [int] {
    // Two-arm bandit: arm 0 pays with p 0.8, arm 1 with p 0.3.
    // Returns [reward, new_seed].
    let mut p: float = 0.8;
    if arm == 1 {
        p = 0.3;
    }
    let r: float = rand_float(seed);
    let mut reward: int = 0;
    if r < p {
        reward = 1;
    }
    return [reward, rand_next(seed)];
}

fn gym_gridworld_step(state: int, action: int) -> [int] {
    // 1D line, states 0..4; 0 = left, 1 = right; goal is 4.
    // Returns [new_state, reward, done].
    let mut next: int = state;
    if action == 1 {
        next = state + 1;
    } else {
        next = state - 1;
    }
    if next < 0 {
        next = 0;
    }
    if next > 4 {
        next = 4;
    }
    let mut reward: int = 0;
    let mut done: int = 0;
    if next == 4 {
        reward = 1;
        done = 1;
    }
    return [next, reward, done];
}

fn gym_cartpole_step(state: [float], action: int) -> [float] {
    // Linearised cartpole-lite, dt 0.02: state [x, v, theta,
    // omega]. Push is +1 for action 1, -1 for action 0.
    let dt: float = 0.02;
    let mut push: float = -1.0;
    if action == 1 {
        push = 1.0;
    }
    let x: float = state[0] + state[1] * dt;
    let v: float = state[1] + push * dt;
    let theta: float = state[2] + state[3] * dt;
    let omega: float = state[3] + (state[2] * 9.8 - push) * dt;
    return [x, v, theta, omega];
}

fn gym_mountaincar_step(pos: float, vel: float, action: int) -> [float] {
    // MountainCar-lite with linearised gravity -0.0025 * 3 * pos.
    // Action 0 = left, 1 = coast, 2 = right. Returns [pos, vel].
    let acc: float = 0.001 * (action as float - 1.0) - 0.0025 * 3.0 * pos;
    let v: float = vel + acc;
    let p: float = pos + v;
    return [p, v];
}
