// Qasida — IPv6 addresses (Top-500 #216).
// Import with: import "ipv6.fg";
// Parse, expand and compress IPv6 text. Groups are [int]
// (8 of them); invalid text parses to [] and is_valid is
// just len(parse) == 8. Compression replaces the longest
// zero run of 2+ groups with "::" (a single zero group is
// never compressed, per RFC 5952). Uppercase hex is accepted.
// v1 limits: addresses only — no sockets, no DNS (items 201
// and 205, still GAP).

fn ip6_hex_val(c: str) -> int {
    let lo: str = "0123456789abcdef";
    let mut j: int = 0;
    while j < len(lo) {
        if substr(lo, j, 1) == c {
            return j;
        }
        j = j + 1;
    }
    let up: str = "0123456789ABCDEF";
    j = 0;
    while j < len(up) {
        if substr(up, j, 1) == c {
            return j;
        }
        j = j + 1;
    }
    return 0 - 1;
}

fn ip6_hex_group(s: str) -> int {
    let mut v: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        let d: int = ip6_hex_val(substr(s, i, 1));
        if d < 0 {
            return 0 - 1;
        }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

fn ip6_parse(s: str) -> [int] {
    if len(s) == 0 {
        return [];
    }
    let dbl: [str] = split(s, "::");
    if len(dbl) > 2 {
        return [];
    }
    let parts: [str] = split(s, ":");
    let mut given: int = 0;
    let mut gap_at: int = 0 - 1;
    let mut i: int = 0;
    while i < len(parts) {
        if len(parts[i]) == 0 {
            if gap_at < 0 {
                gap_at = i;
            }
        } else {
            if len(parts[i]) > 4 {
                return [];
            }
            if ip6_hex_group(parts[i]) < 0 {
                return [];
            }
            given = given + 1;
        }
        i = i + 1;
    }
    if len(dbl) == 1 {
        if given != 8 {
            return [];
        }
        let mut out: [int] = [];
        i = 0;
        while i < 8 {
            push(out, ip6_hex_group(parts[i]));
            i = i + 1;
        }
        return out;
    }
    let zeros: int = 8 - given;
    if zeros < 1 {
        return [];
    }
    let mut out: [int] = [];
    i = 0;
    while i < len(parts) {
        if len(parts[i]) == 0 {
            if i == gap_at {
                let mut z: int = 0;
                while z < zeros {
                    push(out, 0);
                    z = z + 1;
                }
            }
        } else {
            push(out, ip6_hex_group(parts[i]));
        }
        i = i + 1;
    }
    return out;
}

fn ip6_is_valid(s: str) -> bool {
    return len(ip6_parse(s)) == 8;
}

fn ip6_hex4(g: int) -> str {
    let digits: str = "0123456789abcdef";
    let mut out: str = "";
    out = out + substr(digits, (g / 4096) % 16, 1);
    out = out + substr(digits, (g / 256) % 16, 1);
    out = out + substr(digits, (g / 16) % 16, 1);
    out = out + substr(digits, g % 16, 1);
    return out;
}

fn ip6_hex_short(g: int) -> str {
    if g == 0 {
        return "0";
    }
    let digits: str = "0123456789abcdef";
    let divs: [int] = [4096, 256, 16, 1];
    let mut out: str = "";
    let mut started: bool = false;
    let mut k: int = 0;
    while k < 4 {
        let d: int = (g / divs[k]) % 16;
        if d != 0 {
            started = true;
        }
        if started {
            out = out + substr(digits, d, 1);
        }
        k = k + 1;
    }
    return out;
}

fn ip6_expand(g: [int]) -> str {
    if len(g) != 8 {
        return "";
    }
    let mut out: str = ip6_hex4(g[0]);
    let mut i: int = 1;
    while i < 8 {
        out = out + ":" + ip6_hex4(g[i]);
        i = i + 1;
    }
    return out;
}

fn ip6_compress(g: [int]) -> str {
    if len(g) != 8 {
        return "";
    }
    let mut best_start: int = 0 - 1;
    let mut best_len: int = 0;
    let mut i: int = 0;
    while i < 8 {
        if g[i] == 0 {
            let mut j: int = i;
            while j < 8 {
                if g[j] != 0 {
                    break;
                }
                j = j + 1;
            }
            if j - i > best_len {
                best_len = j - i;
                best_start = i;
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    if best_len < 2 {
        let mut out: str = ip6_hex_short(g[0]);
        i = 1;
        while i < 8 {
            out = out + ":" + ip6_hex_short(g[i]);
            i = i + 1;
        }
        return out;
    }
    let mut out: str = "";
    i = 0;
    while i < best_start {
        if i > 0 {
            out = out + ":";
        }
        out = out + ip6_hex_short(g[i]);
        i = i + 1;
    }
    out = out + "::";
    i = best_start + best_len;
    while i < 8 {
        if i > best_start + best_len {
            out = out + ":";
        }
        out = out + ip6_hex_short(g[i]);
        i = i + 1;
    }
    return out;
}
