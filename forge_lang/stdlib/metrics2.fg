// Qasida — evaluation metrics suite, part 2 (Top-500 #428).
// Import with: import "metrics2.fg";
// metrics.fg already covers accuracy, confusion, PRF, MSE, MAE,
// R2 and perplexity; this module grows it into a suite: AUC-ROC
// by pairwise comparison (ties count 0.5), log-loss over
// predicted probabilities, top-k hit for one ranked example,
// and the Brier score. v1 limits: binary labels only for AUC
// and log-loss; no multi-class averaging.

fn m2_auc(scores: [float], labels: [int]) -> float {
    let mut wins: float = 0.0;
    let mut npos: int = 0;
    let mut nneg: int = 0;
    let mut i: int = 0;
    while i < len(labels) {
        if labels[i] == 1 {
            npos = npos + 1;
        } else {
            nneg = nneg + 1;
        }
        i = i + 1;
    }
    let mut a: int = 0;
    while a < len(labels) {
        if labels[a] == 1 {
            let mut b: int = 0;
            while b < len(labels) {
                if labels[b] == 0 {
                    if scores[a] > scores[b] {
                        wins = wins + 1.0;
                    } else if scores[a] == scores[b] {
                        wins = wins + 0.5;
                    }
                }
                b = b + 1;
            }
        }
        a = a + 1;
    }
    return wins / ((npos * nneg) as float);
}

fn m2_logloss(probs: [float], labels: [int]) -> float {
    let mut total: float = 0.0;
    let mut i: int = 0;
    while i < len(labels) {
        if labels[i] == 1 {
            total = total + log(probs[i]);
        } else {
            total = total + log(1.0 - probs[i]);
        }
        i = i + 1;
    }
    return (0.0 - total) / (len(labels) as float);
}

fn m2_topk_hit(scores: [float], label: int, k: int) -> int {
    let mine: float = scores[label];
    let mut better: int = 0;
    let mut i: int = 0;
    while i < len(scores) {
        if scores[i] > mine {
            better = better + 1;
        }
        i = i + 1;
    }
    if better < k {
        return 1;
    }
    return 0;
}

fn m2_brier(probs: [float], labels: [int]) -> float {
    let mut total: float = 0.0;
    let mut i: int = 0;
    while i < len(labels) {
        let d: float = probs[i] - (labels[i] as float);
        total = total + d * d;
        i = i + 1;
    }
    return total / (len(labels) as float);
}
