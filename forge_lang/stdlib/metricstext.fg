// Text metrics (BLEU-lite, ROUGE-lite), in pure Qasida.
// Import with: import "metricstext.fg";
// Unigram BLEU-1 with the standard brevity penalty, and
// ROUGE-1 recall. (metrics.fg holds accuracy/MSE/perplexity.)

fn mt_contains(words: [str], w: str) -> int {
    let mut i: int = 0;
    while i < len(words) {
        if words[i] == w {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn mt_overlap(candidate: [str], reference: [str]) -> int {
    // Clipped unigram matches: each candidate word counted once
    // if it appears in the reference.
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(candidate) {
        if mt_contains(reference, candidate[i]) == 1 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn mt_bleu1(candidate: [str], reference: [str]) -> float {
    let m: int = mt_overlap(candidate, reference);
    let prec: float = m as float / len(candidate) as float;
    let mut bp: float = 1.0;
    if len(candidate) < len(reference) {
        bp = exp(1.0 - len(reference) as float / len(candidate) as float);
    }
    return bp * prec;
}

fn mt_rouge1(candidate: [str], reference: [str]) -> float {
    let m: int = mt_overlap(candidate, reference);
    return m as float / len(reference) as float;
}
