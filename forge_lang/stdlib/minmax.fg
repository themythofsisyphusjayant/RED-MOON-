fn array_min(xs: [int]) -> int {
    let mut m: int = xs[0];
    let mut i: int = 1;
    while i < len(xs) {
        if xs[i] < m {
            m = xs[i];
        }
        i = i + 1;
    }
    return m;
}

fn array_max(xs: [int]) -> int {
    let mut m: int = xs[0];
    let mut i: int = 1;
    while i < len(xs) {
        if xs[i] > m {
            m = xs[i];
        }
        i = i + 1;
    }
    return m;
}

fn array_sum(xs: [int]) -> int {
    let mut s: int = 0;
    let mut i: int = 0;
    while i < len(xs) {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}

fn array_avg(xs: [int]) -> int {
    return array_sum(xs) / len(xs);
}
