// Rule-based named-entity tagging (gazetteer), in pure Qasida.
// Import with: import "ner.fg";
// v1 tags by membership in small person/place/org lists; words
// in no list are "O". Model-based tagging is a later item.

fn ner_tag_one(word: str) -> str {
    let persons: [str] = ["Jayant", "Aarav", "Kavya"];
    let places: [str] = ["Delhi", "Mumbai", "Gorakhpur"];
    let orgs: [str] = ["Qasida", "ISRO", "UoPeople"];
    let mut i: int = 0;
    while i < len(persons) {
        if persons[i] == word {
            return "PERSON";
        }
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(places) {
        if places[j] == word {
            return "PLACE";
        }
        j = j + 1;
    }
    let mut k: int = 0;
    while k < len(orgs) {
        if orgs[k] == word {
            return "ORG";
        }
        k = k + 1;
    }
    return "O";
}

fn ner_tag(words: [str]) -> [str] {
    let mut tags: [str] = [];
    let mut i: int = 0;
    while i < len(words) {
        push(tags, ner_tag_one(words[i]));
        i = i + 1;
    }
    return tags;
}

fn ner_count_entities(tags: [str]) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(tags) {
        if tags[i] != "O" {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn ner_entities(words: [str], tags: [str]) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(words) {
        if tags[i] != "O" {
            push(out, words[i]);
        }
        i = i + 1;
    }
    return out;
}
