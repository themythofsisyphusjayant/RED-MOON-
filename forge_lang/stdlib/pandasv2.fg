// Qasida — pandas-lite v2 (library program item 13, v2).
// Import with: import "pandasv2.fg";
// More DataFrame-column helpers in pure Qasida, on top of
// pandas.fg (Frame, filter, sort, describe-by-mean) and
// frames.fg: pd2_describe returns [mean, min, max] of a float
// column, pd2_value_counts returns flat [value, count] pairs
// in ascending value order for an int column, and pd2_fillna
// replaces a sentinel value with the mean of the remaining
// (non-sentinel) values.
fn pd2_describe(col: [float]) -> [float] {
    if len(col) == 0 {
        fail("pd2_describe: empty column");
    }
    let mut s: float = 0.0;
    let mut mn: float = col[0];
    let mut mx: float = col[0];
    let mut i: int = 0;
    while i < len(col) {
        s = s + col[i];
        if col[i] < mn {
            mn = col[i];
        }
        if col[i] > mx {
            mx = col[i];
        }
        i = i + 1;
    }
    return [s / len(col) as float, mn, mx];
}

fn pd2_value_counts(col: [int]) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(col) {
        let v: int = col[i];
        let mut seen: bool = false;
        let mut k: int = 0;
        while k < i {
            if col[k] == v {
                seen = true;
            }
            k = k + 1;
        }
        if !seen {
            let mut n: int = 0;
            let mut j: int = 0;
            while j < len(col) {
                if col[j] == v {
                    n = n + 1;
                }
                j = j + 1;
            }
            push(out, v);
            push(out, n);
        }
        i = i + 1;
    }
    return out;
}

fn pd2_fillna(col: [float], sentinel: float) -> [float] {
    let mut s: float = 0.0;
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(col) {
        if col[i] != sentinel {
            s = s + col[i];
            n = n + 1;
        }
        i = i + 1;
    }
    if n == 0 {
        fail("pd2_fillna: no non-sentinel values");
    }
    let mean: float = s / n as float;
    let mut out: [float] = [];
    let mut j: int = 0;
    while j < len(col) {
        if col[j] == sentinel {
            push(out, mean);
        } else {
            push(out, col[j]);
        }
        j = j + 1;
    }
    return out;
}
