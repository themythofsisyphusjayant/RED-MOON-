import "checksum.fg";

fn password_hash(pass_bytes: [int], salt: [int]) -> int {
    let mut combined: [int] = [];
    let mut i: int = 0;
    while i < len(salt) {
        push(combined, salt[i]);
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(pass_bytes) {
        push(combined, pass_bytes[j]);
        j = j + 1;
    }
    return fnv1a_bytes(combined);
}

fn password_verify(pass_bytes: [int], salt: [int], expected: int) -> bool {
    return password_hash(pass_bytes, salt) == expected;
}
