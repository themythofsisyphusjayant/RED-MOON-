fn rand_seed(seed: int) -> int {
    let mut s = seed % 2147483647;
    if s < 0 {
        s = s + 2147483647;
    }
    if s == 0 {
        return 12345;
    }
    return s;
}

fn rand_next(state: int) -> (int, int) {
    let mut s = state % 2147483647;
    if s < 0 {
        s = s + 2147483647;
    }
    let v = (1103515245 * s + 12345) % 2147483647;
    return (v, v);
}

fn rand_choice(state: int, items: [int]) -> (int, int) {
    if len(items) == 0 {
        fail("rand_choice: empty list");
    }
    let r = rand_next(state);
    let idx = r.0 % len(items);
    return (items[idx], r.1);
}

fn rand_shuffle(state: int, items: [int]) -> ([int], int) {
    let mut out: [int] = [];
    let mut i = 0;
    while i < len(items) {
        push(out, items[i]);
        i = i + 1;
    }
    let mut s = state;
    let mut j = len(out) - 1;
    while j > 0 {
        let r = rand_next(s);
        s = r.1;
        let k = r.0 % (j + 1);
        let tmp = out[j];
        out[j] = out[k];
        out[k] = tmp;
        j = j - 1;
    }
    return (out, s);
}

fn rand_sample(state: int, items: [int], n: int) -> ([int], int) {
    if n < 0 {
        fail("rand_sample: negative n");
    }
    if n > len(items) {
        fail("rand_sample: n exceeds list length");
    }
    let sh = rand_shuffle(state, items);
    let mut out: [int] = [];
    let mut i = 0;
    while i < n {
        push(out, sh.0[i]);
        i = i + 1;
    }
    return (out, sh.1);
}
