// Qasida - random extensions (roadmap item 5).
// Import with: import "randext.fg";
// Uniform ints, choice and shuffle over rand.fg's LCG
// (rand_next / rand_float are the primitives; this module
// adds the distribution helpers the roadmap item names).
// Each returns (value, new seed) so callers thread the seed.
// Seed 7: rx_uniform(1, 10) = 10, rx_choice(["red", "green",
// "blue"]) = "green", rx_shuffle([1, 2, 3, 4, 5]) = [3, 2, 1, 4, 5].
import "rand.fg";

fn rx_uniform(seed: int, lo: int, hi: int) -> (int, int) {
    let s: int = rand_next(seed);
    return (lo + s % (hi - lo + 1), s);
}

fn rx_choice(seed: int, items: [str]) -> (str, int) {
    let s: int = rand_next(seed);
    return (items[s % len(items)], s);
}

fn rx_shuffle(seed: int, items: [int]) -> ([int], int) {
    let mut a: [int] = items;
    let mut s: int = seed;
    let mut i: int = len(a) - 1;
    while i > 0 {
        s = rand_next(s);
        let j: int = s % (i + 1);
        let tmp: int = a[i];
        a[i] = a[j];
        a[j] = tmp;
        i = i - 1;
    }
    return (a, s);
}
