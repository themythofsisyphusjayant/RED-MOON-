// Qasida — linear-scan register allocation (Top-500 #412).
// Import with: import "regalloc.fg";
// Assign 4 registers (r0..r3) to live intervals, given
// sorted by start: for each interval, expire the actives
// whose end is <= its start, take the lowest free
// register, and spill (-1) when none is free. Spilled
// intervals occupy no register. rg_spill_count counts
// the spills. v1 limits: intervals must arrive sorted
// by start (the caller sorts); 4 registers only; no
// splitting or rematerialization.

struct RgInterval {
    name: str;
    start: int;
    end: int;
}

fn rg_free_reg(active_regs: [int]) -> int {
    let mut r: int = 0;
    while r < 4 {
        let mut used: bool = false;
        let mut i: int = 0;
        while i < len(active_regs) {
            if active_regs[i] == r {
                used = true;
            }
            i = i + 1;
        }
        if !used {
            return r;
        }
        r = r + 1;
    }
    return -1;
}

fn rg_alloc(intervals: [RgInterval]) -> [int] {
    let mut out: [int] = [];
    let mut active_ends: [int] = [];
    let mut active_regs: [int] = [];
    let mut i: int = 0;
    while i < len(intervals) {
        let s: int = intervals[i].start;
        let e: int = intervals[i].end;
        let mut ne: [int] = [];
        let mut nr: [int] = [];
        let mut j: int = 0;
        while j < len(active_ends) {
            if active_ends[j] > s {
                push(ne, active_ends[j]);
                push(nr, active_regs[j]);
            }
            j = j + 1;
        }
        active_ends = ne;
        active_regs = nr;
        let r: int = rg_free_reg(active_regs);
        push(out, r);
        if r >= 0 {
            push(active_ends, e);
            push(active_regs, r);
        }
        i = i + 1;
    }
    return out;
}

fn rg_spill_count(alloc: [int]) -> int {
    let mut c: int = 0;
    let mut i: int = 0;
    while i < len(alloc) {
        if alloc[i] < 0 {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}
