// Qasida — rotary position embeddings (Top-500 #427).
// Import with: import "rope.fg";
// The remaining slice of full transformer blocks: gpt/gpt2 and
// nn.fg already have attention, so this module adds RoPE.
// rope_angle(pos, i, d) = pos / 10000^(2i/d); rope_apply rotates
// each consecutive pair (x[2i], x[2i+1]) by that angle. v1
// limits: even dimensions only; no precomputed cos/sin tables.

fn rope_angle(pos: int, i: int, d: int) -> float {
    let f: float = (2.0 * (i as float)) / (d as float);
    return (pos as float) / pow(10000.0, f);
}

fn rope_pair(x0: float, x1: float, angle: float) -> [float] {
    let c: float = cos(angle);
    let s: float = sin(angle);
    let mut out: [float] = [];
    push(out, x0 * c - x1 * s);
    push(out, x0 * s + x1 * c);
    return out;
}

fn rope_apply(x: [float], pos: int) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 0;
    while i < len(x) {
        let ang: float = rope_angle(pos, i / 2, len(x));
        let pr: [float] = rope_pair(x[i], x[i + 1], ang);
        push(out, pr[0]);
        push(out, pr[1]);
        i = i + 2;
    }
    return out;
}
