// Qasida — secrets handling (Top-500 #444).
// Import with: import "secrets.fg";
// Zeroing buffers and never logging secrets: a Secret stores
// its characters as codes (never as a plain string), redacts
// itself to a fixed "***" on display, and secret_zero returns
// a copy with every code cleared. The length survives zeroing
// (only the contents are wiped). v1 limits: no secure memory
// (no mlock); the codes live in a normal array.

import "checkread.fg";

struct Secret {
    chars: [int];
}

fn secret_new(s: str) -> Secret {
    return Secret { chars: cr_str_bytes(s) };
}

fn secret_len(s: Secret) -> int {
    return len(s.chars);
}

fn secret_redacted(s: Secret) -> str {
    return "***";
}

fn secret_zero(s: Secret) -> Secret {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(s.chars) {
        push(out, 0);
        i = i + 1;
    }
    return Secret { chars: out };
}

fn secret_is_zeroed(s: Secret) -> bool {
    let mut i: int = 0;
    while i < len(s.chars) {
        if s.chars[i] != 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}
