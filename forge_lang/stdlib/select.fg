// Qasida — select over channels (Top-500 #266).
// Import with: import "select.fg";
// Wait on many channels at once, over single-slot
// channels: each channel holds at most one buffered value
// (a send overwrites a full slot — the caller checks
// readiness first). sc_first_ready() names the first
// channel, in add order, with a value waiting; sc_value()
// reads it and sc_recv() clears the slot. The two-step
// shape (value query + state change) is deliberate:
// Qasida has no multi-value return.
// v1 limits: single-slot buffers (no queues); select
// picks the first ready channel, never a random one; no
// blocking wait (the caller polls readiness).

struct SelChans {
    names: [str];
    vals: [int];
    has: [bool];
}

fn sc_new() -> SelChans {
    return SelChans { names: [], vals: [], has: [] };
}

fn sc_add(c: SelChans, name: str) -> SelChans {
    let mut n: SelChans = c;
    push(n.names, name);
    push(n.vals, 0);
    push(n.has, false);
    return n;
}

fn sc_find(c: SelChans, name: str) -> int {
    let mut i: int = 0;
    while i < len(c.names) {
        if c.names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn sc_send(c: SelChans, name: str, v: int) -> SelChans {
    let mut n: SelChans = c;
    let at: int = sc_find(n, name);
    if at < 0 {
        return n;
    }
    n.vals[at] = v;
    n.has[at] = true;
    return n;
}

fn sc_ready_count(c: SelChans) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(c.has) {
        if c.has[i] {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn sc_first_ready(c: SelChans) -> str {
    let mut i: int = 0;
    while i < len(c.has) {
        if c.has[i] {
            return c.names[i];
        }
        i = i + 1;
    }
    return "";
}

fn sc_value(c: SelChans, name: str) -> int {
    let at: int = sc_find(c, name);
    if at < 0 {
        return -1;
    }
    if !c.has[at] {
        return -1;
    }
    return c.vals[at];
}

fn sc_recv(c: SelChans, name: str) -> SelChans {
    let mut n: SelChans = c;
    let at: int = sc_find(n, name);
    if at < 0 {
        return n;
    }
    n.has[at] = false;
    return n;
}

fn sc_has(c: SelChans, name: str) -> bool {
    let at: int = sc_find(c, name);
    if at < 0 {
        return false;
    }
    return c.has[at];
}
