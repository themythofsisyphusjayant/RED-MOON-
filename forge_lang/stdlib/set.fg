struct IntSet {
    items: [int];
}

fn set_new() -> IntSet {
    return IntSet { items: [] };
}

fn set_has(s: IntSet, v: int) -> int {
    let mut i: int = 0;
    while i < len(s.items) {
        if s.items[i] == v {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn set_add(s: IntSet, v: int) -> IntSet {
    if set_has(s, v) == 1 {
        return s;
    }
    let mut items: [int] = s.items;
    push(items, v);
    return IntSet { items: items };
}

fn set_remove(s: IntSet, v: int) -> IntSet {
    let mut items: [int] = [];
    let mut i: int = 0;
    while i < len(s.items) {
        if s.items[i] != v {
            push(items, s.items[i]);
        }
        i = i + 1;
    }
    return IntSet { items: items };
}

fn set_len(s: IntSet) -> int {
    return len(s.items);
}
