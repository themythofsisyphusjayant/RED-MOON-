// Qasida — set algebra (Top-500 #122).
// Import with: import "setops.fg";
// set.fg has only an int set with add/remove/has/len. This module
// adds the algebra: union, intersection, difference, symmetric
// difference and subset, for int sets and for string sets (StrSet
// is defined here, since set.fg has no string set at all). Fully
// generic sets still need generic equality, so v1 covers the two
// concrete element types.

import "set.fg";

struct StrSet {
    items: [str];
}

fn so_union(a: IntSet, b: IntSet) -> IntSet {
    let mut out: IntSet = set_new();
    let mut i: int = 0;
    while i < len(a.items) {
        out = set_add(out, a.items[i]);
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(b.items) {
        out = set_add(out, b.items[j]);
        j = j + 1;
    }
    return out;
}

fn so_inter(a: IntSet, b: IntSet) -> IntSet {
    let mut out: IntSet = set_new();
    let mut i: int = 0;
    while i < len(a.items) {
        if set_has(b, a.items[i]) == 1 {
            out = set_add(out, a.items[i]);
        }
        i = i + 1;
    }
    return out;
}

fn so_diff(a: IntSet, b: IntSet) -> IntSet {
    let mut out: IntSet = set_new();
    let mut i: int = 0;
    while i < len(a.items) {
        if set_has(b, a.items[i]) == 0 {
            out = set_add(out, a.items[i]);
        }
        i = i + 1;
    }
    return out;
}

fn so_symdiff(a: IntSet, b: IntSet) -> IntSet {
    let u: IntSet = so_union(a, b);
    let n: IntSet = so_inter(a, b);
    return so_diff(u, n);
}

fn so_subset(a: IntSet, b: IntSet) -> bool {
    let mut i: int = 0;
    while i < len(a.items) {
        if set_has(b, a.items[i]) == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ss_new() -> StrSet {
    return StrSet { items: [] };
}

fn ss_has(s: StrSet, v: str) -> int {
    let mut i: int = 0;
    while i < len(s.items) {
        if s.items[i] == v {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn ss_add(s: StrSet, v: str) -> StrSet {
    if ss_has(s, v) == 1 {
        return s;
    }
    let mut items: [str] = s.items;
    push(items, v);
    return StrSet { items: items };
}

fn ss_len(s: StrSet) -> int {
    return len(s.items);
}

fn ss_union(a: StrSet, b: StrSet) -> StrSet {
    let mut out: StrSet = ss_new();
    let mut i: int = 0;
    while i < len(a.items) {
        out = ss_add(out, a.items[i]);
        i = i + 1;
    }
    let mut j: int = 0;
    while j < len(b.items) {
        out = ss_add(out, b.items[j]);
        j = j + 1;
    }
    return out;
}

fn ss_inter(a: StrSet, b: StrSet) -> StrSet {
    let mut out: StrSet = ss_new();
    let mut i: int = 0;
    while i < len(a.items) {
        if ss_has(b, a.items[i]) == 1 {
            out = ss_add(out, a.items[i]);
        }
        i = i + 1;
    }
    return out;
}
