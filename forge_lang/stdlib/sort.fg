fn sort_insertion(xs: [int]) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(xs) {
        push(out, xs[i]);
        i = i + 1;
    }
    let mut j: int = 1;
    while j < len(out) {
        let mut v: int = out[j];
        let mut k: int = j - 1;
        while k >= 0 {
            if out[k] > v {
                out[k + 1] = out[k];
                k = k - 1;
            } else {
                break;
            }
        }
        out[k + 1] = v;
        j = j + 1;
    }
    return out;
}

fn sort_is_sorted(xs: [int]) -> bool {
    let mut i: int = 1;
    while i < len(xs) {
        if xs[i] < xs[i - 1] {
            return false;
        }
        i = i + 1;
    }
    return true;
}
