// Qasida — sparse arrays, COO vector (library program item 138).
// Import with: import "sparse.fg";
// A sparse vector of length n holding only its nonzero
// entries, as parallel sorted index/value arrays. sp_set
// inserts, replaces, or (for 0.0) removes an entry, keeping
// indices sorted; sp_get returns 0.0 for missing entries.
// sp_add and sp_dot require equal lengths. sp_to_dense
// expands back to a full [float] of length n.
struct SparseVec {
    idx: [int];
    val: [float];
    n: int;
}

fn sp_new(n: int) -> SparseVec {
    return SparseVec { idx: [], val: [], n: n };
}

fn sp_set(v: SparseVec, i: int, x: float) -> SparseVec {
    if i < 0 || i >= v.n {
        fail("sp_set: index out of range");
    }
    let mut idx: [int] = [];
    let mut val: [float] = [];
    let mut placed: bool = false;
    let mut k: int = 0;
    while k < len(v.idx) {
        if v.idx[k] == i {
            if x != 0.0 {
                push(idx, i);
                push(val, x);
            }
            placed = true;
        } else {
            if !placed && x != 0.0 && v.idx[k] > i {
                push(idx, i);
                push(val, x);
                placed = true;
            }
            push(idx, v.idx[k]);
            push(val, v.val[k]);
        }
        k = k + 1;
    }
    if !placed && x != 0.0 {
        push(idx, i);
        push(val, x);
    }
    return SparseVec { idx: idx, val: val, n: v.n };
}

fn sp_get(v: SparseVec, i: int) -> float {
    let mut k: int = 0;
    while k < len(v.idx) {
        if v.idx[k] == i {
            return v.val[k];
        }
        k = k + 1;
    }
    return 0.0;
}

fn sp_add(a: SparseVec, b: SparseVec) -> SparseVec {
    if a.n != b.n {
        fail("sp_add: length mismatch");
    }
    let mut out: SparseVec = sp_new(a.n);
    let mut k: int = 0;
    while k < len(a.idx) {
        out = sp_set(out, a.idx[k], a.val[k]);
        k = k + 1;
    }
    let mut j: int = 0;
    while j < len(b.idx) {
        let s: float = sp_get(out, b.idx[j]) + b.val[j];
        out = sp_set(out, b.idx[j], s);
        j = j + 1;
    }
    return out;
}

fn sp_dot(a: SparseVec, b: SparseVec) -> float {
    if a.n != b.n {
        fail("sp_dot: length mismatch");
    }
    let mut s: float = 0.0;
    let mut k: int = 0;
    while k < len(a.idx) {
        s = s + a.val[k] * sp_get(b, a.idx[k]);
        k = k + 1;
    }
    return s;
}

fn sp_to_dense(v: SparseVec) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 0;
    while i < v.n {
        push(out, sp_get(v, i));
        i = i + 1;
    }
    return out;
}
