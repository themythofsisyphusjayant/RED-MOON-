// Qasida — fuzz-tested stdlib (Top-500 #442).
// Import with: import "stdlibfuzz.fg";
// Fuzz every parser, as a driver: three tiny pure parsers
// (strict ints, booleans, balanced parens) are fed inputs
// generated by an LCG over small alphabets, and the driver
// counts how many inputs each parser accepts. The LCG is
// the glibc constants (1103515245, 12345, mod 2^31), the
// generation order is fixed (length first, then one char
// per step), and the seed is fixed, so the counts are
// exact and reproducible on both compilers.
// v1 limits: three toy parsers only (the real string
// parsers take structured inputs the generator does not
// build yet); acceptance is counted, crashes are the
// "bad" bucket (a parser that returns a wrong verdict).

fn sf_lcg_next(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648;
}

fn sf_is_digit(c: str) -> bool {
    let digits: str = "0123456789";
    let mut j: int = 0;
    while j < len(digits) {
        if substr(digits, j, 1) == c {
            return true;
        }
        j = j + 1;
    }
    return false;
}

fn sf_int_ok(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    let mut i: int = 0;
    if substr(s, 0, 1) == "-" {
        if len(s) == 1 {
            return false;
        }
        i = 1;
    }
    while i < len(s) {
        if !sf_is_digit(substr(s, i, 1)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn sf_int_val(s: str) -> int {
    if !sf_int_ok(s) {
        return 0;
    }
    return parse_int(s);
}

fn sf_bool_ok(s: str) -> bool {
    if s == "true" {
        return true;
    }
    if s == "false" {
        return true;
    }
    return false;
}

fn sf_bool_val(s: str) -> bool {
    return s == "true";
}

fn sf_balanced(s: str) -> bool {
    let mut depth: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        let c: str = substr(s, i, 1);
        if c == "(" {
            depth = depth + 1;
        } else {
            if c == ")" {
                depth = depth - 1;
                if depth < 0 {
                    return false;
                }
            }
        }
        i = i + 1;
    }
    return depth == 0;
}

fn sf_gen(state: int, alphabet: str) -> str {
    let mut st: int = state;
    st = sf_lcg_next(st);
    let length: int = 1 + st % 3;
    let mut out: str = "";
    let mut j: int = 0;
    while j < length {
        st = sf_lcg_next(st);
        out = out + substr(alphabet, st % len(alphabet), 1);
        j = j + 1;
    }
    return out;
}

fn sf_gen_state(state: int, alphabet: str) -> int {
    let mut st: int = state;
    st = sf_lcg_next(st);
    let length: int = 1 + st % 3;
    let mut j: int = 0;
    while j < length {
        st = sf_lcg_next(st);
        j = j + 1;
    }
    return st;
}

fn sf_fuzz(parser: str, n: int, seed: int) -> int {
    let mut alphabet: str = "0123456789-";
    if parser == "bool" {
        alphabet = "truefals";
    } else {
        if parser == "paren" {
            alphabet = "()ab";
        }
    }
    let mut ok: int = 0;
    let mut st: int = seed;
    let mut i: int = 0;
    while i < n {
        let s: str = sf_gen(st, alphabet);
        st = sf_gen_state(st, alphabet);
        if parser == "int" {
            if sf_int_ok(s) {
                ok = ok + 1;
            }
        } else {
            if parser == "bool" {
                if sf_bool_ok(s) {
                    ok = ok + 1;
                }
            } else {
                if sf_balanced(s) {
                    ok = ok + 1;
                }
            }
        }
        i = i + 1;
    }
    return ok;
}
