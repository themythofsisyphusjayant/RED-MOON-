fn tq_len(path: str) -> int {
    if !file_exists(path) {
        return 0;
    }
    let lines: [str] = split(read_file(path), "\n");
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(lines) {
        if len(lines[i]) > 0 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn tq_peek(path: str) -> str {
    if !file_exists(path) {
        return "";
    }
    let lines: [str] = split(read_file(path), "\n");
    let mut i: int = 0;
    while i < len(lines) {
        if len(lines[i]) > 0 {
            return lines[i];
        }
        i = i + 1;
    }
    return "";
}

fn tq_enqueue(path: str, task: str) -> bool {
    if file_exists(path) {
        return write_file(path, read_file(path) + task + "\n");
    }
    return write_file(path, task + "\n");
}

fn tq_dequeue(path: str) -> str {
    let first: str = tq_peek(path);
    if len(first) == 0 {
        return "";
    }
    let lines: [str] = split(read_file(path), "\n");
    let mut rest: str = "";
    let mut skipped: bool = false;
    let mut i: int = 0;
    while i < len(lines) {
        if len(lines[i]) > 0 {
            if !skipped {
                skipped = true;
            } else {
                rest = rest + lines[i] + "\n";
            }
        }
        i = i + 1;
    }
    let written: bool = write_file(path, rest);
    return first;
}
