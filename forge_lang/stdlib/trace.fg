// Qasida — tracing and spans (Top-500 #384).
// Import with: import "trace.fg";
// Distributed-trace spans in pure Qasida: start/end named
// spans over explicit microsecond stamps (deterministic —
// the caller supplies now, usually clock_micros), duration
// lookup, and a text report of closed spans. Spans are
// parallel arrays (the ordmap.fg idiom); tr_end closes the
// most recent still-open span with the name. No trace IDs
// or exporters in v1.

struct Trace {
    names: [str];
    starts: [int];
    ends: [int];
}

fn tr_new() -> Trace {
    return Trace { names: [], starts: [], ends: [] };
}

fn tr_start(t: Trace, name: str, now_us: int) -> Trace {
    let mut tt: Trace = t;
    push(tt.names, name);
    push(tt.starts, now_us);
    push(tt.ends, 0 - 1);
    return tt;
}

fn tr_end(t: Trace, name: str, now_us: int) -> Trace {
    let mut tt: Trace = t;
    let mut i: int = len(tt.names) - 1;
    while i >= 0 {
        if tt.names[i] == name && tt.ends[i] == 0 - 1 {
            tt.ends[i] = now_us;
            return tt;
        }
        i = i - 1;
    }
    return tt;
}

fn tr_duration(t: Trace, name: str) -> int {
    let mut i: int = len(t.names) - 1;
    while i >= 0 {
        if t.names[i] == name && t.ends[i] != 0 - 1 {
            return t.ends[i] - t.starts[i];
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn tr_digit(d: int) -> str {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

fn tr_int_str(n: int) -> str {
    if n == 0 { return "0"; }
    let mut v: int = n;
    let mut neg: bool = false;
    if n < 0 { neg = true; v = 0 - n; }
    let mut rev: str = "";
    while v > 0 {
        rev = rev + tr_digit(v % 10);
        v = v / 10;
    }
    let mut out: str = "";
    let mut i: int = len(rev) - 1;
    while i >= 0 {
        out = out + substr(rev, i, 1);
        i = i - 1;
    }
    if neg { out = "-" + out; }
    return out;
}

fn tr_report(t: Trace) -> [str] {
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(t.names) {
        if t.ends[i] != 0 - 1 {
            push(out, t.names[i] + ": " + tr_int_str(t.ends[i] - t.starts[i]) + " us");
        }
        i = i + 1;
    }
    return out;
}
