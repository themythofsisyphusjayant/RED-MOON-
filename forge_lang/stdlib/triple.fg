// Qasida — cross-compilation triples (Top-500 #326).
// Import with: import "triple.fg";
// Triples and sysroots, on top of the targets that
// already exist (native, WASM, big32, CUDA): a triple
// is arch-vendor-os, where the os part may itself hold
// dashes ("linux-gnu"). tr_arch()/tr_vendor()/tr_os()
// split one out, tr_known() checks it against the
// supported list, and tr_is_host() compares it with
// the host triple.
// v1 limits: no parsing of the os into kernel plus ABI
// parts. Sysroots landed 21 Nov 2026 (sprint batch 13):
// tr_roots_add() records a sysroot path per triple and
// tr_sysroot_for() looks it up ("" when absent) — that
// closes #326 PARTIAL.

fn tr_parts(triple: str) -> [str] {
    return split(triple, "-");
}

fn tr_arch(triple: str) -> str {
    return tr_parts(triple)[0];
}

fn tr_vendor(triple: str) -> str {
    return tr_parts(triple)[1];
}

fn tr_os(triple: str) -> str {
    let parts: [str] = tr_parts(triple);
    let mut out: str = parts[2];
    let mut i: int = 3;
    while i < len(parts) {
        out = out + "-" + parts[i];
        i = i + 1;
    }
    return out;
}

fn tr_known(triple: str) -> bool {
    let known: [str] = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "wasm32-unknown-unknown", "riscv64-unknown-none", "x86_64-pc-windows-msvc"];
    let mut i: int = 0;
    while i < len(known) {
        if known[i] == triple {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn tr_is_host(triple: str, host: str) -> bool {
    return triple == host;
}

// Sysroots (Top-500 #326, second half — closes PARTIAL).
// A sysroot is the per-triple root directory a cross
// toolchain searches for headers and libraries. Roots are
// plain data (triple -> path); no filesystem access happens
// here, so lookup stays pure and testable.

struct Sysroots {
    triples: [str];
    paths: [str];
}

fn tr_roots_new() -> Sysroots {
    return Sysroots { triples: [], paths: [] };
}

fn tr_roots_add(r: Sysroots, triple: str, path: str) -> Sysroots {
    let mut n: Sysroots = r;
    push(n.triples, triple);
    push(n.paths, path);
    return n;
}

fn tr_sysroot_for(r: Sysroots, triple: str) -> str {
    let mut i: int = 0;
    while i < len(r.triples) {
        if r.triples[i] == triple {
            return r.paths[i];
        }
        i = i + 1;
    }
    return "";
}

fn tr_sysroot_has(r: Sysroots, triple: str) -> bool {
    return tr_sysroot_for(r, triple) != "";
}

fn tr_sysroot_host(r: Sysroots, host: str) -> str {
    return tr_sysroot_for(r, host);
}

fn tr_sysroot_count(r: Sysroots) -> int {
    return len(r.triples);
}
