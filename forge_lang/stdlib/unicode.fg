fn uni_digit_value(c: str) -> int {
    if c == "0" {
        return 0;
    }
    if c == "1" {
        return 1;
    }
    if c == "2" {
        return 2;
    }
    if c == "3" {
        return 3;
    }
    if c == "4" {
        return 4;
    }
    if c == "5" {
        return 5;
    }
    if c == "6" {
        return 6;
    }
    if c == "7" {
        return 7;
    }
    if c == "8" {
        return 8;
    }
    if c == "9" {
        return 9;
    }
    return -1;
}

fn uni_lower(s: str) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(s) {
        out = out + uni_to_lower(s[i]);
        i = i + 1;
    }
    return out;
}

fn uni_upper(s: str) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(s) {
        out = out + uni_to_upper(s[i]);
        i = i + 1;
    }
    return out;
}

fn uni_count_alpha(s: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        if uni_is_alpha(s[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn uni_count_digit(s: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        if uni_is_digit(s[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn uni_count_space(s: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        if uni_is_space(s[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn uni_count_other(s: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        if !uni_is_alpha(s[i]) && !uni_is_digit(s[i]) && !uni_is_space(s[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn uni_count_upper(s: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        if uni_is_upper(s[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn uni_count_lower(s: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(s) {
        if uni_is_lower(s[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}
