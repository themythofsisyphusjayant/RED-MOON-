// Qasida — unified diff output (Top-500 #153).
// Import with: import "unidiff.fg";
// difflib.fg has only LCS length, similarity ratio and common
// prefix/suffix — no diff format at all. This module is the
// unified-diff slice: an LCS table over the two line arrays, a
// backtrack that emits context ("  "), removed ("- ") and added
// ("+ ") lines in order, plus added/removed counts. One hunk,
// no @@ header lines, in v1.

fn ud_diff(a: [str], b: [str]) -> [str] {
    let n: int = len(a);
    let m: int = len(b);
    let w: int = m + 1;
    let mut dp: [int] = [];
    let mut t: int = 0;
    while t < (n + 1) * w {
        push(dp, 0);
        t = t + 1;
    }
    let mut i: int = 1;
    while i <= n {
        let mut j: int = 1;
        while j <= m {
            if a[i - 1] == b[j - 1] {
                dp[i * w + j] = dp[(i - 1) * w + j - 1] + 1;
            } else {
                if dp[(i - 1) * w + j] >= dp[i * w + j - 1] {
                    dp[i * w + j] = dp[(i - 1) * w + j];
                } else {
                    dp[i * w + j] = dp[i * w + j - 1];
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let mut ops: [int] = [];
    let mut x: int = n;
    let mut y: int = m;
    while x > 0 || y > 0 {
        if x > 0 && y > 0 && a[x - 1] == b[y - 1] {
            push(ops, 0);
            x = x - 1;
            y = y - 1;
        } else {
            if y > 0 && (x == 0 || dp[x * w + y - 1] >= dp[(x - 1) * w + y]) {
                push(ops, 2);
                y = y - 1;
            } else {
                push(ops, 1);
                x = x - 1;
            }
        }
    }
    let mut out: [str] = [];
    let mut ai: int = 0;
    let mut bi: int = 0;
    let mut k: int = len(ops) - 1;
    while k >= 0 {
        if ops[k] == 0 {
            push(out, "  " + a[ai]);
            ai = ai + 1;
            bi = bi + 1;
        } else {
            if ops[k] == 1 {
                push(out, "- " + a[ai]);
                ai = ai + 1;
            } else {
                push(out, "+ " + b[bi]);
                bi = bi + 1;
            }
        }
        k = k - 1;
    }
    return out;
}

fn ud_added(lines: [str]) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(lines) {
        if substr(lines[i], 0, 1) == "+" {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn ud_removed(lines: [str]) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(lines) {
        if substr(lines[i], 0, 1) == "-" {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}
