// Qasida — UTF-8 encode and decode (Top-500 #151).
// Import with: import "utf8.fg";
// Encode and decode with validation. unicode.fg only classifies
// single characters (digit / upper / lower); it has no byte-level
// UTF-8 at all, so this is the missing slice. Codepoints travel
// as [int] (there is no ord() builtin to read a codepoint out of
// a str, and no chr() to build one) — encode takes codepoints,
// decode returns them. Validation rejects truncated sequences,
// bad continuations, overlong forms, surrogates and values above
// U+10FFFF. Division/modulo stand in for shifts and masks.

fn utf8_byte_len(cp: int) -> int {
    if cp < 128 {
        return 1;
    }
    if cp < 2048 {
        return 2;
    }
    if cp < 65536 {
        return 3;
    }
    return 4;
}

fn utf8_encode(cps: [int]) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(cps) {
        let cp: int = cps[i];
        if cp < 128 {
            push(out, cp);
        } else {
            if cp < 2048 {
                push(out, 192 + cp / 64);
                push(out, 128 + cp % 64);
            } else {
                if cp < 65536 {
                    push(out, 224 + cp / 4096);
                    push(out, 128 + (cp / 64) % 64);
                    push(out, 128 + cp % 64);
                } else {
                    push(out, 240 + cp / 262144);
                    push(out, 128 + (cp / 4096) % 64);
                    push(out, 128 + (cp / 64) % 64);
                    push(out, 128 + cp % 64);
                }
            }
        }
        i = i + 1;
    }
    return out;
}

fn utf8_decode(bytes: [int]) -> ([int], bool) {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(bytes) {
        let b0: int = bytes[i];
        if b0 < 128 {
            push(out, b0);
            i = i + 1;
        } else {
            if b0 >= 192 && b0 < 224 {
                if i + 1 >= len(bytes) {
                    return (out, false);
                }
                let b1: int = bytes[i + 1];
                if b1 < 128 || b1 >= 192 {
                    return (out, false);
                }
                let cp: int = (b0 % 32) * 64 + b1 % 64;
                if cp < 128 {
                    return (out, false);
                }
                push(out, cp);
                i = i + 2;
            } else {
                if b0 >= 224 && b0 < 240 {
                    if i + 2 >= len(bytes) {
                        return (out, false);
                    }
                    let b1: int = bytes[i + 1];
                    let b2: int = bytes[i + 2];
                    if b1 < 128 || b1 >= 192 || b2 < 128 || b2 >= 192 {
                        return (out, false);
                    }
                    let cp: int = (b0 % 16) * 4096 + (b1 % 64) * 64 + b2 % 64;
                    if cp < 2048 || (cp >= 55296 && cp < 57344) {
                        return (out, false);
                    }
                    push(out, cp);
                    i = i + 3;
                } else {
                    if b0 >= 240 && b0 < 248 {
                        if i + 3 >= len(bytes) {
                            return (out, false);
                        }
                        let b1: int = bytes[i + 1];
                        let b2: int = bytes[i + 2];
                        let b3: int = bytes[i + 3];
                        if b1 < 128 || b1 >= 192 || b2 < 128 || b2 >= 192 || b3 < 128 || b3 >= 192 {
                            return (out, false);
                        }
                        let cp: int = (b0 % 8) * 262144 + (b1 % 64) * 4096 + (b2 % 64) * 64 + b3 % 64;
                        if cp < 65536 || cp > 1114111 {
                            return (out, false);
                        }
                        push(out, cp);
                        i = i + 4;
                    } else {
                        return (out, false);
                    }
                }
            }
        }
    }
    return (out, true);
}

fn utf8_valid(bytes: [int]) -> bool {
    let d = utf8_decode(bytes);
    return d.1;
}

fn utf8_char_count(bytes: [int]) -> int {
    let d = utf8_decode(bytes);
    if d.1 == false {
        return 0 - 1;
    }
    return len(d.0);
}
