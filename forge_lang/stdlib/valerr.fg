// Qasida — validation error types (Top-500 #53).
// Import with: import "valerr.fg";
// Field-level error lists. A VList collects (field, message)
// pairs — one per failed check — so a caller can report every
// bad field at once (pairs with multierr.fg, which collects
// plain strings). has_field / count_field answer "is this field
// bad, and how many times", render joins "field: message" pairs
// with "; ".

struct VErr {
    field: str;
    msg: str;
}

struct VList {
    errs: [VErr];
}

fn ve_new() -> VList {
    return VList { errs: [] };
}

fn ve_add(v: VList, field: str, msg: str) -> VList {
    let mut errs: [VErr] = v.errs;
    push(errs, VErr { field: field, msg: msg });
    return VList { errs: errs };
}

fn ve_count(v: VList) -> int {
    return len(v.errs);
}

fn ve_has_field(v: VList, field: str) -> bool {
    let mut i: int = 0;
    while i < len(v.errs) {
        if v.errs[i].field == field {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ve_count_field(v: VList, field: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(v.errs) {
        if v.errs[i].field == field {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn ve_render(v: VList) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(v.errs) {
        if i > 0 {
            out = out + "; ";
        }
        out = out + v.errs[i].field + ": " + v.errs[i].msg;
        i = i + 1;
    }
    return out;
}
