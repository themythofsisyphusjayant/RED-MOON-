fn bitset_pow2(i: int) -> int {
    let mut p: int = 1;
    let mut k: int = 0;
    while k < i {
        p = p * 2;
        k = k + 1;
    }
    return p;
}

fn bitset_set(m: int, i: int) -> int {
    if bitset_test(m, i) {
        return m;
    }
    return m + bitset_pow2(i);
}

fn bitset_clear(m: int, i: int) -> int {
    if bitset_test(m, i) {
        return m - bitset_pow2(i);
    }
    return m;
}

fn bitset_test(m: int, i: int) -> bool {
    return m / bitset_pow2(i) % 2 == 1;
}

fn bitset_count(m: int) -> int {
    let mut n: int = 0;
    let mut v: int = m;
    while v > 0 {
        n = n + v % 2;
        v = v / 2;
    }
    return n;
}
