// The Jal Pari Language — entity/component store-lite (ecs-lite).
// Import with: import "ecs.fg";
// LIMITS (honest v1): two components only (position + velocity,
// parallel arrays); entities are integer ids, never reused after
// despawn in v1; the only system is movement integration.

struct World {
    px: [float];
    py: [float];
    vx: [float];
    vy: [float];
    alive: [bool];
}

fn ecs_new() -> World {
    return World { px: [], py: [], vx: [], vy: [], alive: [] };
}

fn ecs_spawn(w: World, x: float, y: float) -> (World, int) {
    let mut q = w;
    push(q.px, x);
    push(q.py, y);
    push(q.vx, 0.0);
    push(q.vy, 0.0);
    push(q.alive, true);
    return (q, len(q.alive) - 1);
}

fn ecs_set_vel(w: World, id: int, vx: float, vy: float) -> World {
    let mut q = w;
    if id < 0 { return q; }
    if id >= len(q.alive) { return q; }
    q.vx[id] = vx;
    q.vy[id] = vy;
    return q;
}

fn ecs_despawn(w: World, id: int) -> World {
    let mut q = w;
    if id < 0 { return q; }
    if id >= len(q.alive) { return q; }
    q.alive[id] = false;
    return q;
}

fn ecs_step(w: World, dt: float) -> World {
    let mut q = w;
    let mut i: int = 0;
    while i < len(q.alive) {
        if q.alive[i] {
            q.px[i] = q.px[i] + q.vx[i] * dt;
            q.py[i] = q.py[i] + q.vy[i] * dt;
        }
        i = i + 1;
    }
    return q;
}

fn ecs_count(w: World) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i < len(w.alive) {
        if w.alive[i] { n = n + 1; }
        i = i + 1;
    }
    return n;
}
