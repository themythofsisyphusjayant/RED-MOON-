struct MinHeap {
    items: [int];
}

fn heap_new() -> MinHeap {
    return MinHeap { items: [] };
}

fn heap_len(h: MinHeap) -> int {
    return len(h.items);
}

fn heap_peek(h: MinHeap) -> int {
    return h.items[0];
}

fn heap_push(h: MinHeap, v: int) -> MinHeap {
    let mut items: [int] = h.items;
    push(items, v);
    let mut i: int = len(items) - 1;
    while i > 0 {
        let mut p: int = (i - 1) / 2;
        if items[i] < items[p] {
            let mut t: int = items[i];
            items[i] = items[p];
            items[p] = t;
            i = p;
        } else {
            i = 0;
        }
    }
    return MinHeap { items: items };
}

fn heap_pop(h: MinHeap) -> MinHeap {
    if len(h.items) <= 1 {
        return MinHeap { items: [] };
    }
    let mut items: [int] = [];
    push(items, h.items[len(h.items) - 1]);
    let mut i: int = 1;
    while i < len(h.items) - 1 {
        push(items, h.items[i]);
        i = i + 1;
    }
    if len(items) > 0 {
        let mut k: int = 0;
        while 1 == 1 {
            let mut l: int = k * 2 + 1;
            let mut r: int = k * 2 + 2;
            let mut s: int = k;
            if l < len(items) {
                if items[l] < items[s] {
                    s = l;
                }
            }
            if r < len(items) {
                if items[r] < items[s] {
                    s = r;
                }
            }
            if s == k {
                break;
            }
            let mut t: int = items[k];
            items[k] = items[s];
            items[s] = t;
            k = s;
        }
    }
    return MinHeap { items: items };
}
