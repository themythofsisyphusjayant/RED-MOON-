struct Triangle {
    a: int;
    b: int;
    c: int;
}

fn triangle_new(a: int, b: int, c: int) -> Triangle {
    return Triangle { a: a, b: b, c: c };
}

fn triangle_perimeter(t: Triangle) -> int {
    return t.a + t.b + t.c;
}

fn triangle_is_right(t: Triangle) -> int {
    if t.a * t.a + t.b * t.b == t.c * t.c {
        return 1;
    }
    return 0;
}
