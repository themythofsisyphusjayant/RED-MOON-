struct Vec2 {
    x: int;
    y: int;
}

fn vec2_new(x: int, y: int) -> Vec2 {
    return Vec2 { x: x, y: y };
}

fn vec2_add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn vec2_dot(a: Vec2, b: Vec2) -> int {
    return a.x * b.x + a.y * b.y;
}

fn vec2_scale(a: Vec2, k: int) -> Vec2 {
    return Vec2 { x: a.x * k, y: a.y * k };
}
